+			conn := &shapeConn{Conn: under, writer: under, profile: profile}
+			if _, err := conn.Write(settings); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := conn.Write(ack); err != nil {
+				t.Fatal(err)
