@@ -0,0 +1,43 @@
+package dispatcher
+
+import (
+	"bytes"
+	"context"
+	"testing"
+
+	"github.com/xtls/xray-core/common"
+)
+
+// With "fakedns+others", a flow to a fake address the engine has no domain
+// for is sniffed by the other sniffers through a wrapper, which must hand the
+// sniffers that read datagrams apart the datagrams too: two uTP SYNs or a
+// Discord request read in one batch are still told.
+func TestFakeDNSThenOthersSniffsDatagramsApart(t *testing.T) {
+	inRange := protocolSnifferWithMetadata{
+		protocolSniffer: func(ctx context.Context, _ []byte) (SniffResult, error) {
+			yes := true
+			ctx.Value(ipAddressInRange).(*ipAddressInRangeOpt).addressInRange = &yes
+			return nil, common.ErrNoClue
+		},
+		metadataSniffer: true,
+	}
+	wrapper, err := newFakeDNSThenOthers(context.Background(), inRange, defaultProtocolSniffers)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for name, tc := range map[string]struct {
+		datagrams [][]byte
+		protocol  string
+	}{
+		"uTP SYN twice":     {[][]byte{vUTPSYN(), vUTPSYN()}, "bittorrent"},
+		"Discord, then RTP": {[][]byte{discordIPDiscovery(), make([]byte, 60)}, "discordrtc"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			result, err := wrapper.datagramSniffer(context.Background(), bytes.Join(tc.datagrams, nil), tc.datagrams)
+			others, ok := result.(DNSThenOthersSniffResult)
+			if err != nil || !ok || others.protocolOriginalName != tc.protocol {
+				t.Fatalf("sniffed %v, %v; want %s", result, err, tc.protocol)
+			}
+		})
+	}
+}
diff --git a/app/dispatcher/sniffer_helpers_test.go b/app/dispatcher/sniffer_helpers_test.go
new file mode 100644
index 00000000..5f2cb0c6
--- /dev/null
+++ b/app/dispatcher/sniffer_helpers_test.go
@@ -0,0 +1,84 @@
+package dispatcher
+
+import (
+	"context"
+	gotls "crypto/tls"
+	stdnet "net"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/core"
+)
+
+// The sniffer tests taken from Jolymmiles/Xray-core call its dispatcher by
+// these names.
+
+// snifferContext supplies the core instance newFakeDNSSniffer requires.
+func snifferContext() context.Context {
+	return context.WithValue(context.Background(), core.XrayKey(1), &core.Instance{})
+}
+
+func newCachedReader(reader buf.TimeoutReader) *cachedReader {
+	return &cachedReader{reader: reader}
+}
+
+func newSniffer(ctx context.Context) Sniffer {
+	return *NewSniffer(ctx)
+}
+
+func sniff(ctx context.Context, cReader *cachedReader, metadataOnly bool, network net.Network, _ Sniffer) (SniffResult, error) {
+	return sniffer(ctx, cReader, metadataOnly, network)
+}
+
+// defaultProtocolSniffers are the sniffers NewSniffer starts with, fake DNS
+// aside.
+var defaultProtocolSniffers = NewSniffer(snifferContext()).sniffer
+
+func tlsClientHello() []byte {
+	client, server := stdnet.Pipe()
+	defer client.Close()
+	defer server.Close()
+
+	captured := make(chan []byte, 1)
+	go func() {
+		record := make([]byte, 4096)
+		n, err := server.Read(record)
+		if err != nil {
+			captured <- nil
+			return
+		}
+		captured <- record[:n]
+	}()
+
+	conn := gotls.Client(client, &gotls.Config{ServerName: "example.com", InsecureSkipVerify: true})
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	_ = conn.HandshakeContext(ctx)
+
+	return <-captured
+}
+
+func newTestCachedReader(t *testing.T, link buf.TimeoutReader) *cachedReader {
+	t.Helper()
+	reader := newCachedReader(link)
+	t.Cleanup(func() {
+		reader.Lock()
+		buf.ReleaseMulti(reader.cache)
+		reader.cache = nil
+		reader.Unlock()
+	})
+	return reader
+}
+
+// countingReader is a datagramReader that counts the reads of its link.
+type countingReader struct {
+	datagramReader
+	reads int
+}
+
+func (r *countingReader) ReadMultiBufferTimeout(timeout time.Duration) (buf.MultiBuffer, error) {
+	r.reads++
+	return r.datagramReader.ReadMultiBufferTimeout(timeout)
+}
diff --git a/app/dispatcher/sniffer_quic_test.go b/app/dispatcher/sniffer_quic_test.go
new file mode 100644
index 00000000..679a1328
--- /dev/null
+++ b/app/dispatcher/sniffer_quic_test.go
@@ -0,0 +1,105 @@
+package dispatcher
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"path/filepath"
+	"strconv"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+)
+
+// readQUICCorpus returns the first n client datagrams of a capture in the
+// QUIC sniffer's corpus; see its PROVENANCE.md.
+func readQUICCorpus(t *testing.T, prefix string, n int) [][]byte {
+	t.Helper()
+	datagrams := make([][]byte, n)
+	for i := range datagrams {
+		datagram, err := os.ReadFile(filepath.Join("..", "..", "common", "protocol", "quic", "testdata", prefix+"-"+strconv.Itoa(i)+".bin"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		datagrams[i] = datagram
+	}
+	return datagrams
+}
+
+// datagramReader yields one datagram per read, each in its own buffer, as the
+// link of a UDP inbound does, and times out once all have been read.
+type datagramReader struct {
+	datagrams [][]byte
+}
+
+// ReadMultiBuffer returns the next datagram in a buffer of its own, or io.EOF
+// once all have been read.
+func (r *datagramReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	if len(r.datagrams) == 0 {
+		return nil, io.EOF
+	}
+	b := buf.New()
+	if _, err := b.Write(r.datagrams[0]); err != nil {
+		b.Release()
+		return nil, err
+	}
+	r.datagrams = r.datagrams[1:]
+	return buf.MultiBuffer{b}, nil
+}
+
+// ReadMultiBufferTimeout returns the next datagram, or buf.ErrReadTimeout once
+// all have been read, like a link that has nothing more to deliver.
+func (r *datagramReader) ReadMultiBufferTimeout(time.Duration) (buf.MultiBuffer, error) {
+	if len(r.datagrams) == 0 {
+		return nil, buf.ErrReadTimeout
+	}
+	return r.ReadMultiBuffer()
+}
+
+// Sniffing a QUIC flow must leave every cached datagram as it was received,
+// whether the ClientHello fits one datagram or spans several that are cached
+// one at a time, because the dispatcher forwards those datagrams afterwards.
+func TestSniffQUICFromCachedDatagramsKeepsThemIntact(t *testing.T) {
+	tests := []struct {
+		name      string
+		datagrams [][]byte
+		domain    string
+	}{
+		{"ClientHello in one datagram", readQUICCorpus(t, "quic-ngtcp2-1.11", 1), "ngtcp2.sniff.test"},
+		{"ClientHello across datagrams", readQUICCorpus(t, "quic-chrome153", 2), "chrome.sniff.test"},
+		{"ClientHello across padded datagrams", readQUICCorpus(t, "quic-firefox153esr", 2), "firefox.sniff.test"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			received := make([][]byte, len(tt.datagrams))
+			for i, datagram := range tt.datagrams {
+				received[i] = bytes.Clone(datagram)
+			}
+			reader := newCachedReader(&datagramReader{datagrams: received})
+			ctx := snifferContext()
+
+			result, err := sniff(ctx, reader, false, net.Network_UDP, newSniffer(ctx))
+			if err != nil {
+				t.Errorf("sniff() error = %v, want quic %q", err, tt.domain)
+			} else if result.Protocol() != "quic" || result.Domain() != tt.domain {
+				t.Errorf("sniff() = %s %q, want quic %q", result.Protocol(), result.Domain(), tt.domain)
+			}
+
+			forwarded, err := reader.ReadMultiBuffer()
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer buf.ReleaseMulti(forwarded)
+			if len(forwarded) != len(tt.datagrams) {
+				t.Fatalf("forwarded %d buffers, want one per datagram (%d)", len(forwarded), len(tt.datagrams))
+			}
+			for i, b := range forwarded {
+				if !bytes.Equal(b.Bytes(), tt.datagrams[i]) {
+					t.Errorf("forwarded datagram %d differs from the one received", i)
+				}
+			}
+		})
+	}
+}
diff --git a/app/dispatcher/sniffer_stun_test.go b/app/dispatcher/sniffer_stun_test.go
new file mode 100644
index 00000000..ca0fa6b2
--- /dev/null
+++ b/app/dispatcher/sniffer_stun_test.go
@@ -0,0 +1,77 @@
+package dispatcher
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/xtls/xray-core/common/net"
+)
+
+// stunBinding is an ICE binding request: USERNAME and PRIORITY.
+func stunBinding() []byte {
+	b := []byte{0x00, 0x01, 0x00, 0x18, 0x21, 0x12, 0xa4, 0x42}
+	b = append(b, "transaction1"...)
+	b = append(b, 0x00, 0x06, 0x00, 0x09)
+	b = append(b, "evtj:h6vY\x00\x00\x00"...)
+	return append(b, 0x00, 0x24, 0x00, 0x04, 0x6e, 0x00, 0x01, 0xff)
+}
+
+func sniffDatagrams(t *testing.T, network net.Network, datagrams ...[]byte) (SniffResult, error) {
+	t.Helper()
+	reader := newCachedReader(&datagramReader{datagrams: datagrams})
+	ctx := snifferContext()
+	return sniff(ctx, reader, false, network, newSniffer(ctx))
+}
+
+// A call's first datagram is a STUN check; DTLS and SRTP follow on the same
+// ports.
+func TestSniffSTUNFlow(t *testing.T) {
+	dtls := []byte{0x16, 0xfe, 0xfd, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x20}
+	for _, network := range []net.Network{net.Network_UDP, net.Network_TCP} {
+		result, err := sniffDatagrams(t, network, stunBinding(), dtls)
+		if err != nil || result.Protocol() != "stun" || result.Domain() != "" {
+			t.Fatalf("%v: sniff() = %v, %v; want stun without a domain", network, result, err)
+		}
+	}
+}
+
+// Over TCP a message may come in pieces: the sniffer waits for the rest once
+// the cookie is in.
+func TestSniffSTUNOverTCPInPieces(t *testing.T) {
+	b := stunBinding()
+	result, err := sniffDatagrams(t, net.Network_TCP, b[:10], b[10:30], b[30:])
+	if err != nil || result.Protocol() != "stun" {
+		t.Fatalf("sniff() = %v, %v; want stun", result, err)
+	}
+}
+
+// Over UDP the sniffer reads the first datagram on its own: a datagram with
+// bytes after the message is no STUN message, though the same bytes in a
+// stream would start with one.
+func TestSniffSTUNReadsTheFirstDatagram(t *testing.T) {
+	trailing := append(stunBinding(), 0, 0, 0, 0)
+	if result, err := sniffDatagrams(t, net.Network_UDP, trailing); err == nil && result.Protocol() == "stun" {
+		t.Fatal("a datagram longer than its STUN message taken for STUN")
+	}
+	split := stunBinding()
+	if result, err := sniffDatagrams(t, net.Network_UDP, split[:20], split[20:]); err == nil && result.Protocol() == "stun" {
+		t.Fatal("a STUN message split across datagrams taken for STUN")
+	}
+}
+
+// The UDP sniffers that were there before STUN keep their flows.
+func TestSniffSTUNLeavesOtherUDPFlows(t *testing.T) {
+	dns := []byte{0x41, 0x00, 0x01, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 7, 'e', 'x', 'a', 'm', 'p', 'l', 'e', 3, 'c', 'o', 'm', 0, 0, 1, 0, 1}
+	if result, err := sniffDatagrams(t, net.Network_UDP, dns); err == nil {
+		t.Fatalf("a DNS query sniffed as %s", result.Protocol())
+	}
+	tracker := binary.BigEndian.AppendUint64(nil, 0x41727101980)
+	tracker = append(tracker, 0, 0, 0, 0, 0x12, 0x34, 0x56, 0x78)
+	if result, err := sniffDatagrams(t, net.Network_UDP, tracker); err != nil || result.Protocol() != "bittorrent" {
+		t.Fatalf("a UDP tracker connect sniffed as %v, %v; want bittorrent", result, err)
+	}
+	quic := readQUICCorpus(t, "quic-ngtcp2-1.11", 1)
+	if result, err := sniffDatagrams(t, net.Network_UDP, quic...); err != nil || result.Protocol() != "quic" {
+		t.Fatalf("a QUIC Initial sniffed as %v, %v; want quic", result, err)
+	}
+}
diff --git a/app/dispatcher/sniffer_tracker_test.go b/app/dispatcher/sniffer_tracker_test.go
new file mode 100644
index 00000000..c113a6c5
--- /dev/null
+++ b/app/dispatcher/sniffer_tracker_test.go
@@ -0,0 +1,82 @@
+package dispatcher
+
+import (
+	"bytes"
+	"context"
+	"testing"
+
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+)
+
+// An HTTP tracker request is routed as bittorrent and keeps the HTTP Host as
+// its domain, which destOverride ["http"] still applies, so domain rules see
+// the tracker even for an IP destination.
+func TestSniffHTTPTrackerKeepsItsDomain(t *testing.T) {
+	ctx := snifferContext()
+	payload := []byte("GET /announce?info_hash=x&peer_id=y HTTP/1.1\r\nHost: tracker.example.com\r\n\r\n")
+	result, err := NewSniffer(ctx).Sniff(ctx, payload, net.Network_TCP)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Protocol() != "bittorrent" || result.Domain() != "tracker.example.com" {
+		t.Fatalf("protocol %q domain %q, want bittorrent for tracker.example.com", result.Protocol(), result.Domain())
+	}
+	dest := net.TCPDestination(net.IPAddress([]byte{192, 0, 2, 1}), 80)
+	request := session.SniffingRequest{OverrideDestinationForProtocol: []string{"http", "tls"}, RouteOnly: true}
+	if !new(DefaultDispatcher).shouldOverride(context.Background(), result, request, dest) {
+		t.Fatal("destOverride [http, tls] does not override a tracker request")
+	}
+}
+
+// Requests that only mention the parameter names stay HTTP.
+func TestSniffOrdinaryHTTPPathsStayHTTP(t *testing.T) {
+	for _, path := range []string{
+		"/docs/info_hash=x/peer_id=y",
+		"/api?previous_info_hash=abc&last_peer_id=def",
+		"/search?info_hash=abc&q=/scrape?",
+	} {
+		ctx := snifferContext()
+		result, err := NewSniffer(ctx).Sniff(ctx, []byte("GET "+path+" HTTP/1.1\r\nHost: example.com\r\n\r\n"), net.Network_TCP)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if result.Protocol() != "http1" || result.Domain() != "example.com" {
+			t.Errorf("%s: protocol %q domain %q, want http1 for example.com", path, result.Protocol(), result.Domain())
+		}
+	}
+}
+
+// A short datagram that does not open like LSD is turned down at once: the
+// LSD sniffer does not hold ordinary UDP for a second read.
+func TestSniffShortUDPReadsOnce(t *testing.T) {
+	for _, size := range []int{20, 21} {
+		ctx := snifferContext()
+		link := &countingReader{datagramReader: datagramReader{datagrams: [][]byte{make([]byte, size)}}}
+		reader := newTestCachedReader(t, link)
+		_, err := sniff(ctx, reader, false, net.Network_UDP, newSniffer(ctx))
+		if link.reads != 1 {
+			t.Errorf("%d-byte datagram: %d reads (%v), want 1", size, link.reads, err)
+		}
+	}
+}
+
+// uTP is sniffed on the first datagram: two SYNs read at once are still a
+// SYN, and an ST_DATA header followed by a datagram holding the peer
+// handshake is no handshake carried in uTP.
+func TestSniffUTPKeepsDatagramBoundaries(t *testing.T) {
+	ctx := snifferContext()
+	syns := [][]byte{vUTPSYN(), vUTPSYN()}
+	result, err := NewSniffer(ctx).SniffDatagrams(ctx, bytes.Join(syns, nil), syns, net.Network_UDP)
+	if err != nil || result.Protocol() != "bittorrent" {
+		t.Errorf("two SYN datagrams: %v, %v; want bittorrent", result, err)
+	}
+
+	header := make([]byte, 20)
+	header[0] = 0x01 // ST_DATA, version 1
+	split := [][]byte{header, vPeerHandshake()}
+	result, err = NewSniffer(ctx).SniffDatagrams(ctx, bytes.Join(split, nil), split, net.Network_UDP)
+	if err == nil && result.Protocol() == "bittorrent" {
+		t.Error("uTP handshake assembled from two datagrams")
+	}
+}
diff --git a/app/dispatcher/sniffer_utp_datagrams_test.go b/app/dispatcher/sniffer_utp_datagrams_test.go
new file mode 100644
index 00000000..05160e4a
--- /dev/null
+++ b/app/dispatcher/sniffer_utp_datagrams_test.go
@@ -0,0 +1,81 @@
+package dispatcher
+
+import (
+	"bytes"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+// A uTP SYN is a whole datagram. Several datagrams queued before the first
+// read must not hide it: the sniffer reads the first one on its own, as the
+// QUIC sniffer does, and every datagram is forwarded intact.
+func TestSniffUTPReadsTheFirstDatagram(t *testing.T) {
+	syn := vUTPSYN()
+	for name, datagrams := range map[string][][]byte{
+		"single SYN":       {syn},
+		"SYN then SYN":     {syn, syn},
+		"SYN then DHT":     {syn, vDHTGetPeers()},
+		"DHT then SYN":     {vDHTGetPeers(), syn},
+		"tracker then SYN": {vUDPTrackerConnect(), syn},
+	} {
+		t.Run(name, func(t *testing.T) {
+			r, w := pipe.New(pipe.WithSizeLimit(32768))
+			t.Cleanup(r.Interrupt)
+			for _, datagram := range datagrams {
+				b := buf.New()
+				if _, err := b.Write(datagram); err != nil {
+					b.Release()
+					t.Fatal(err)
+				}
+				if err := w.WriteMultiBuffer(buf.MultiBuffer{b}); err != nil {
+					t.Fatal(err)
+				}
+			}
+			reader := newTestCachedReader(t, r)
+			result, err := sniff(snifferContext(), reader, false, net.Network_UDP, newSniffer(snifferContext()))
+			forwarded, readErr := reader.ReadMultiBufferTimeout(time.Millisecond)
+			if readErr != nil {
+				t.Fatal(readErr)
+			}
+			defer buf.ReleaseMulti(forwarded)
+			if len(forwarded) != len(datagrams) {
+				t.Fatalf("forwarded %d datagrams, want %d", len(forwarded), len(datagrams))
+			}
+			for i, b := range forwarded {
+				if !bytes.Equal(b.Bytes(), datagrams[i]) {
+					t.Fatalf("datagram %d changed", i)
+				}
+			}
+			if err != nil || result == nil || result.Protocol() != "bittorrent" {
+				t.Fatalf("sniff() = %v, %v; want bittorrent", result, err)
+			}
+		})
+	}
+}
+
+// A datagram that only starts with a SYN is not one.
+func TestSniffUTPRejectsDataInTheFirstDatagram(t *testing.T) {
+	ctx := snifferContext()
+	first := append(vUTPSYN(), "data"...)
+	datagrams := [][]byte{first, vUTPSYN()}
+	result, err := NewSniffer(ctx).SniffDatagrams(ctx, bytes.Join(datagrams, nil), datagrams, net.Network_UDP)
+	if err == nil && result.Protocol() == "bittorrent" {
+		t.Fatal("SYN with data in its datagram classified as bittorrent")
+	}
+}
+
+// A first datagram too short for a uTP header is no SYN, and the datagrams
+// after it do not change that: the flow is not held for another read.
+func TestSniffShortUTPDatagramReadsOnce(t *testing.T) {
+	ctx := snifferContext()
+	link := &countingReader{datagramReader: datagramReader{datagrams: [][]byte{make([]byte, 19)}}}
+	reader := newTestCachedReader(t, link)
+	_, err := sniff(ctx, reader, false, net.Network_UDP, newSniffer(ctx))
+	if link.reads != 1 {
+		t.Errorf("19-byte datagram: %d reads (%v), want 1", link.reads, err)
+	}
+}
diff --git a/app/dispatcher/stun_route_process_test.go b/app/dispatcher/stun_route_process_test.go
new file mode 100644
index 00000000..c4f51f9b
--- /dev/null
+++ b/app/dispatcher/stun_route_process_test.go
@@ -0,0 +1,91 @@
+//go:build integration
+
+package dispatcher
+
+import (
+	"bytes"
+	"fmt"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// TestSTUNRouteProcessE2E is TestBitTorrentBlockProcessE2E for a routing rule
+// protocol ["stun"] -> block, on a real Xray process: STUN over UDP and TCP
+// never reaches the destination, while DNS, a plain datagram and a plain TCP
+// exchange through the same proxy are answered.
+func TestSTUNRouteProcessE2E(t *testing.T) {
+	workDir := t.TempDir()
+	xrayBin := btBuildXray(t, workDir)
+
+	udpEcho := btNewUDPResponder(t)
+	t.Cleanup(func() { _ = udpEcho.conn.Close() })
+	tcpEcho := btNewTCPResponder(t)
+	t.Cleanup(func() { _ = tcpEcho.listener.Close() })
+
+	socksPort := btFreeTCPPort(t)
+	config := fmt.Sprintf(`{
+		"log": {"loglevel": "warning"},
+		"inbounds": [{
+			"listen": "127.0.0.1",
+			"port": %d,
+			"protocol": "socks",
+			"settings": {"udp": true},
+			"sniffing": {"enabled": true}
+		}],
+		"outbounds": [
+			{"tag": "direct", "protocol": "freedom"},
+			{"tag": "block", "protocol": "blackhole", "settings": {"response": {"type": "none"}}}
+		],
+		"routing": {"rules": [
+			{"type": "field", "protocol": ["stun"], "outboundTag": "block"}
+		]}
+	}`, socksPort)
+	process := btStartXray(t, xrayBin, config, filepath.Join(workDir, "config.json"))
+	btWaitSOCKS(t, process, socksPort)
+
+	t.Run("dns query through proxy is answered", func(t *testing.T) {
+		response := btRoundTripUDP(t, socksPort, udpEcho.addr, btDNSQuery(0xBEEF), 5*time.Second)
+		if len(response) < 3 || response[2]&0x80 == 0 {
+			t.Fatalf("unexpected DNS response: % x", response)
+		}
+	})
+
+	t.Run("plain udp datagram through proxy is echoed", func(t *testing.T) {
+		payload := []byte("plain-udp-control")
+		if response := btRoundTripUDP(t, socksPort, udpEcho.addr, payload, 5*time.Second); !bytes.Equal(response, payload) {
+			t.Fatalf("echo mismatch: got %q", response)
+		}
+	})
+
+	t.Run("plain tcp exchange through proxy is echoed", func(t *testing.T) {
+		payload := []byte("plain-tcp-control")
+		if response := btRoundTripTCP(t, socksPort, tcpEcho.addr.Port, payload, 5*time.Second); !bytes.Equal(response, payload) {
+			t.Fatalf("echo mismatch: got %q", response)
+		}
+	})
+
+	t.Run("stun binding over udp is blocked", func(t *testing.T) {
+		btAssertBlockedUDP(t, socksPort, udpEcho, stunBinding(), "STUN binding")
+	})
+
+	t.Run("stun binding success over udp is blocked", func(t *testing.T) {
+		btAssertBlockedUDP(t, socksPort, udpEcho, btSTUNBindingSuccess(), "STUN binding success")
+	})
+
+	t.Run("stun over tcp is blocked", func(t *testing.T) {
+		message := stunBinding()
+		conn := btSOCKSConnect(t, socksPort, tcpEcho.addr.Port)
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+		if _, err := conn.Write(message); err != nil {
+			t.Fatalf("write STUN: %v\nserver logs:\n%s", err, process.logs())
+		}
+		if _, err := conn.Read(make([]byte, len(message))); err == nil {
+			t.Fatal("proxy echoed a STUN message over TCP")
+		}
+		if tcpEcho.recorded(message) {
+			t.Fatal("STUN over TCP reached the destination")
+		}
+	})
+}
