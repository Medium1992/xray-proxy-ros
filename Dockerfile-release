# Сборка ядра Xray из исходников. Образ отсюда не собирается: последняя стадия
# отдаёт наружу один бинарник, который воркфлоу кладёт в релиз, а уже оттуда его
# забирает основной Dockerfile.
#
#   docker buildx build -f Dockerfile-release \
#     --platform linux/arm64 \
#     --build-arg XRAY_REF=v26.7.28 \
#     --build-arg GO_VERSION=1.27 \
#     --output type=local,dest=out .
#
# Xray собирается стоковым Go, поэтому тулчейн берётся официальным образом
# golang, а не тарболлом форка, как это приходится делать для mihomo.
# Значение по умолчанию нужно только локальным запускам и линтеру: без него
# базовый образ раскрывается в невалидное имя. Воркфлоу всегда передаёт
# GO_VERSION явно, свежим стабильным релизом с go.dev, так что в CI это число
# не участвует и устареть там не может.
#
# По умолчанию стоит минорная версия без патча — ровно та, что объявлена в
# go.mod апстрима. Официальный релиз собирается через setup-go с
# go-version-file: go.mod, то есть тем же 1.27, а тег golang:1.27-alpine сам
# раскрывается в свежий патч этой линейки.
ARG GO_VERSION=1.27
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS package
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
ARG XRAY_REPO=XTLS/Xray-core
ARG XRAY_REF

# Метка своей сборки. Пустое значение собирает ядро как есть.
ARG XRAY_VERSION_SUFFIX=ros

# Два буфера по 512 КБ, которые ядро держит на каждое соединение и которые
# нельзя опустить ни конфигом, ни переменной окружения. Пустое значение любого
# из них отключает соответствующую правку.
#
# Лимит пайпов диспетчера (два на соединение) берётся из policy.levels только
# у VMess, Trojan и Shadowsocks. VLESS кладёт его в контекст лишь в ветке
# fallback, а socks/http/dokodemo не кладут никогда, так что в обычной связке
# VLESS-клиент - VLESS-сервер работает захардкоженный дефолт по архитектуре:
# 0 на arm, 4 КБ на arm64 и 512 КБ на всё остальное. Правка трогает только
# последнюю ветку, поэтому на arm64 она ничего не меняет.
ARG PIPE_BUFFER_KB=64

# Скретч-буфер записи HTTP/2 (stdlib или x/net/http2): min(SETTINGS пира, 512 КиБ) на
# каждый аплинк-стрим, от архитектуры не зависит. У XHTTP через io.Pipe за раз
# приходит buf.Size = 8192 байт, то есть буфер заполняется на 1.6% и держится
# всю жизнь стрима. Апстримный proposal golang/go#79831 предлагает ровно это
# значение, пока не принят.
ARG H2_SCRATCH_KB=32

# http2legacy возвращает x/net/http2 его собственный пул соединений. Под Go 1.27
# без тега x/net оборачивает net/http, а тот дозванивается отдельно для каждого
# запроса, пока соединения нет: когда TLS-хендшейк глохнет на пути, каждая
# сессия открывает свой TCP, xmux.maxConnections перестаёт ограничивать сокеты,
# и память растёт до OOM (XTLS/Xray-core#6797). Замер на сервере, который не
# отвечает на ClientHello: 40 сессий — 40 дозвонов без тега и 3 с ним. Пустое
# значение собирает без тегов. Убрать, когда это починят в Xray или Go.
ARG GO_BUILD_TAGS=http2legacy

# Регулятор окон HTTP/2 для XHTTP из форка mux-ka (patches/xhttp-flow): окно
# приёма загрузки стартует с 64 КиБ и растёт только по тому, что читатель
# реально вычитал за RTT, как автоподстройка TCP. Без него Go держит до 4 МиБ
# непрочитанного на каждый стрим. required — патчи обязаны лечь, иначе сборка
# падает; off — ядро без регулятора. На роутере его выключает переменная
# окружения XRAY_XHTTP_FLOW=off без пересборки.
ARG XHTTP_FLOW=required

# GOTOOLCHAIN=local запрещает Go молча подтянуть себе другой тулчейн: собираем
# ровно тем, что в образе, а несовместимость с go.mod апстрима всплывает
# ошибкой, а не тихой подменой.
ENV GOTOOLCHAIN=local \
    CGO_ENABLED=0
RUN apk add --no-cache git && go version

RUN mkdir -p /final

RUN set -eu; \
    [ -n "$XRAY_REF" ] || { echo "XRAY_REF build arg is required" >&2; exit 1; }; \
    for attempt in 1 2 3 4 5; do \
      git clone "https://github.com/${XRAY_REPO}.git" /src && exit 0; \
      echo "clone failed (attempt ${attempt}), retrying" >&2; \
      rm -rf /src; \
      sleep 5; \
    done; \
    echo "Failed to clone ${XRAY_REPO}" >&2; \
    exit 1

WORKDIR /src

RUN git checkout --detach "$XRAY_REF" \
    || { echo "Failed to check out ${XRAY_REPO}@${XRAY_REF}" >&2; exit 1; }

# git apply, а не git am: HEAD остаётся коммитом апстрима, и в core.build
# уходит его хэш. Хуки проверяются отдельно: патч может лечь, но не туда.
COPY patches/xhttp-flow /patches/xhttp-flow
RUN set -eu; \
    case "$XHTTP_FLOW" in \
      off) echo "XHTTP flow governor: off"; exit 0 ;; \
      required) ;; \
      *) echo "XHTTP_FLOW must be required or off, got '$XHTTP_FLOW'" >&2; exit 1 ;; \
    esac; \
    for p in /patches/xhttp-flow/*.patch; do \
      git apply "$p" \
        || { echo "XHTTP flow patch $(basename "$p") no longer applies" >&2; exit 1; }; \
    done; \
    grep -q 'flowListener{' transport/internet/splithttp/hub.go \
      && grep -q 'newFlowClientConn(conn)' transport/internet/splithttp/dialer.go \
      || { echo "XHTTP flow governor hooks are missing after patching" >&2; exit 1; }; \
    echo "XHTTP flow governor: included"

# Единственное место, по которому панель может увидеть, что ядро не
# официальное. Version_x/y/z объявлены как byte, поэтому -X до них не
# дотянется — правим саму Version().
#
# Суффикс обязан быть валидным semver prerelease: remnanode отдаёт панели
# semver.valid(semver.coerce(первая строка "xray version", includePrerelease)),
# и из всей строки доживает только prerelease. Метаданные сборки через "+"
# semver отбрасывает, а codename в разбор вообще не попадает.
#
# sed молча ничего не заменяет, если апстрим перепишет функцию, поэтому и
# исходная форма, и результат проверяются тут же.
RUN set -eu; \
    if [ -z "$XRAY_VERSION_SUFFIX" ]; then \
      echo "No version suffix requested, building the core as is"; \
      exit 0; \
    fi; \
    printf '%s' "$XRAY_VERSION_SUFFIX" | grep -Eq '^[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*$' \
      || { echo "XRAY_VERSION_SUFFIX is not a valid semver prerelease: $XRAY_VERSION_SUFFIX" >&2; exit 1; }; \
    grep -Fq 'fmt.Sprintf("%v.%v.%v", Version_x, Version_y, Version_z)' core/core.go \
      || { echo "core.Version() no longer has the shape this patch expects" >&2; exit 1; }; \
    sed -i "s|\"%v\.%v\.%v\", Version_x|\"%v.%v.%v-${XRAY_VERSION_SUFFIX}\", Version_x|" core/core.go; \
    grep -Fq "\"%v.%v.%v-${XRAY_VERSION_SUFFIX}\", Version_x" core/core.go \
      || { echo "version suffix patch did not apply (core/core.go)" >&2; exit 1; }; \
    echo "Core version marked as X.Y.Z-${XRAY_VERSION_SUFFIX}"

# Дефолт лимита пайпа для amd64. Ветки arm и arm64 не трогаются: там уже 0 и
# 4 КБ. Как и выше, sed молча ничего не заменит, если апстрим перепишет
# readDefaultBufferSize, поэтому форма проверяется до и после.
RUN set -eu; \
    if [ -z "$PIPE_BUFFER_KB" ]; then \
      echo "Dispatcher pipe buffer left at upstream defaults"; \
      exit 0; \
    fi; \
    printf '%s' "$PIPE_BUFFER_KB" | grep -Eq '^[1-9][0-9]*$' \
      || { echo "PIPE_BUFFER_KB is not a positive number: $PIPE_BUFFER_KB" >&2; exit 1; }; \
    grep -Fq 'return 512 * 1024' features/policy/policy.go \
      || { echo "readDefaultBufferSize no longer has the shape this patch expects" >&2; exit 1; }; \
    sed -i "s|return 512 \* 1024|return ${PIPE_BUFFER_KB} * 1024|" features/policy/policy.go; \
    grep -Fq "return ${PIPE_BUFFER_KB} * 1024" features/policy/policy.go \
      || { echo "pipe buffer patch did not apply (features/policy/policy.go)" >&2; exit 1; }; \
    echo "Dispatcher pipe buffer set to ${PIPE_BUFFER_KB} KiB (non-ARM branch)"

RUN set -eu; \
    for attempt in 1 2 3 4 5; do \
      go mod download && exit 0; \
      echo "go mod download failed (attempt ${attempt}), retrying" >&2; \
      sleep 5; \
    done; \
    echo "go mod download failed after 5 attempts" >&2; \
    exit 1

# Где живёт frameScratchBufferLen, зависит от тулчейна. С Go 1.27 x/net/http2
# стал обёрткой над stdlib: его transport.go собирается только с тегом
# http2legacy (//go:build !(go1.27 && !http2legacy)), а работает копия в
# $GOROOT/src/net/http/internal/http2. Правка только в vendor/ поэтому ничего
# не меняла — это показал замер памяти, куча на соединение не сдвинулась.
# Патчим оба места: какое из них скомпилируется, то и будет с правкой.
# Stdlib собирается из исходников GOROOT, изменённый файл пересоберётся сам.
# Дерево вендорится ради копии в x/net; без правки vendor/ не создаётся и
# сборка идёт по модулям, как у апстрима.
RUN set -eu; \
    if [ -z "$H2_SCRATCH_KB" ]; then \
      echo "HTTP/2 scratch buffer left at upstream defaults"; \
      exit 0; \
    fi; \
    printf '%s' "$H2_SCRATCH_KB" | grep -Eq '^[1-9][0-9]*$' \
      || { echo "H2_SCRATCH_KB is not a positive number: $H2_SCRATCH_KB" >&2; exit 1; }; \
    go mod vendor; \
    patched=0; \
    for T in "$(go env GOROOT)/src/net/http/internal/http2/transport.go" \
             vendor/golang.org/x/net/http2/transport.go; do \
      [ -f "$T" ] || continue; \
      grep -Fq 'const max = 512 << 10' "$T" \
        || { echo "frameScratchBufferLen no longer has the shape this patch expects ($T)" >&2; exit 1; }; \
      sed -i "s|const max = 512 << 10|const max = ${H2_SCRATCH_KB} << 10|" "$T"; \
      grep -Fq "const max = ${H2_SCRATCH_KB} << 10" "$T" \
        || { echo "h2 scratch patch did not apply ($T)" >&2; exit 1; }; \
      echo "HTTP/2 uplink scratch buffer capped at ${H2_SCRATCH_KB} KiB in $T"; \
      patched=$((patched+1)); \
    done; \
    [ "$patched" -gt 0 ] || { echo "no HTTP/2 transport source found to patch" >&2; exit 1; }

# Флаги один в один с XTLS/Xray-core .github/workflows/release.yml, чтобы свой
# бинарник отличался от официального только версией тулчейна и правками выше.
#
# core.build апстрим берёт из git describe, но у него чекаут поверхностный и
# без тегов, поэтому describe всегда сваливается в короткий SHA. У нас клон
# полный, и describe видит теги — причём только аннотированные: версионные
# теги вроде v26.7.28 лёгкие, ближайший аннотированный это v1.260327.0, и
# строка сборки получалась как v1.260327.0-226-gcd4ce973. Берём SHA напрямую.
#
# Режим модулей задаётся явно. Go включил бы vendor-режим и сам, раз каталог
# есть, но тогда сбой автоопределения означал бы тихую сборку по модулям — то
# есть без правки в x/net, и узнать об этом было бы неоткуда. С -mod=vendor
# отсутствующий или рассогласованный vendor/ роняет сборку.
RUN set -eu; \
    if [ -d vendor ]; then \
      MODMODE=-mod=vendor; \
    else \
      MODMODE=-mod=mod; \
    fi; \
    echo "Module mode: ${MODMODE}"; \
    echo "Build tags: ${GO_BUILD_TAGS:-none}"; \
    case ",${GO_BUILD_TAGS}," in \
      *,http2legacy,*) \
        go list "$MODMODE" -tags "$GO_BUILD_TAGS" -f '{{join .GoFiles " "}}' golang.org/x/net/http2 \
          | tr ' ' '\n' | grep -qx transport.go \
          || { echo "http2legacy no longer selects x/net's own transport" >&2; exit 1; }; \
        ;; \
    esac; \
    case "$TARGETARCH" in \
      arm) \
        case "$TARGETVARIANT" in \
          v5) GOARM=5 ;; \
          v6) GOARM=6 ;; \
          v7|"") GOARM=7 ;; \
          *) echo "Unsupported ARM variant: $TARGETVARIANT" >&2; exit 1 ;; \
        esac; \
        export GOARM; \
        ;; \
    esac; \
    COMMID="$(git rev-parse --short=7 HEAD)"; \
    echo "Building ${XRAY_REPO}@${XRAY_REF} (${COMMID}) for ${TARGETOS}/${TARGETARCH}${TARGETVARIANT:+/}${TARGETVARIANT} with $(go version)"; \
    GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
    go build "$MODMODE" -tags "$GO_BUILD_TAGS" -o /final/xray -trimpath -buildvcs=false \
      -gcflags="all=-l=4" \
      -ldflags="-X github.com/xtls/xray-core/core.build=${COMMID} -s -w -buildid=" \
      -v ./main

FROM scratch AS export
COPY --from=package /final /
