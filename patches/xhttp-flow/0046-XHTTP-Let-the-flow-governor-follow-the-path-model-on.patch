From ff58e545585e2881f445729376b7b9fc68867687 Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Tue, 13 Oct 2026 17:01:03 +0300
Subject: [PATCH] XHTTP: Let the flow governor follow the path model only once
 the reader has settled

A window went over to the path model after one round trip without growth. The end of a round may fall between the reader getting data and returning its credit, so that it reads low and the next makes up for it. At the start of a stream the model then had that one small round to go by: the window fell from 256 KiB to little over 64 KiB and grew back a quarter a round trip. With a governor at both ends 10 of 300 first downloads of 3 MB took 0.82 to 0.83 s for 0.53 s at 100 Mbit/s and RTT 50 ms.

The model now waits until the reader has taken less than a quarter more than the round before for two round trips in a row. What ends the ramp, one round without growth, stays: asked two rounds as well, a slow reader's irregular rounds kept being taken for a ramp.
---
 transport/internet/splithttp/h2flow.go        | 24 ++++++++++-
 .../internet/splithttp/h2flow_ramp_test.go    | 40 +++++++++++++++++++
 2 files changed, 62 insertions(+), 2 deletions(-)

diff --git a/transport/internet/splithttp/h2flow.go b/transport/internet/splithttp/h2flow.go
index c04837ddb..215dde016 100644
--- a/transport/internet/splithttp/h2flow.go
+++ b/transport/internet/splithttp/h2flow.go
@@ -68,6 +68,10 @@ const (
 	flowConnFloor   = 1 << 20
 	flowSmallCredit = 64 << 10
 	flowShrinkAfter = 3
+	// flowSettledRounds is how many round trips in a row a reader must
+	// take less than a quarter more than before to be modelled, see
+	// settled.
+	flowSettledRounds = 2
 	flowKernelEvery = 20 * time.Millisecond
 	flowQueueHold   = 15 * time.Millisecond
 	flowQueueShrink = 40 * time.Millisecond
@@ -390,6 +394,10 @@ type flowWindow struct {
 // Until the first round trip is measured the cap opens with every credit, and
 // while the reader keeps speeding up it also covers the sender doubling its
 // rate, as Linux receive autotuning does. hold keeps the cap from growing.
+//
+// One round trip without growth ends that: ramped. A reader that takes a
+// little, irregularly, would otherwise have every larger round taken for a
+// ramp. It does not yet say the reader has found its rate, see settled.
 func (w *flowWindow) adjust(now time.Time, rtt time.Duration, init, limit int32, shrink, hold bool) {
 	if w.mark.IsZero() {
 		w.mark, w.markBase = now, w.returned
@@ -448,6 +456,18 @@ const (
 	flowModelMinRound    = 20 * time.Millisecond
 )
 
+// settled reports whether the reader has found its rate: ramped, and less
+// than a quarter faster than the round before for flowSettledRounds rounds in
+// a row. Only then does a window follow the path model. One round without
+// growth is not enough for that: the end of a round may fall between the
+// reader getting data and returning its credit, so that it reads low and the
+// next makes up for it. A window that took such a round at the start of a
+// stream for its rate had that one small round to model the path from, fell
+// to it, and grew back a quarter at a time.
+func (w *flowWindow) settled() bool {
+	return w.ramped && w.flat >= flowSettledRounds
+}
+
 // model sets the cap from the path model; rtprop is the empty path's round
 // trip.
 func (w *flowWindow) model(now time.Time, rtprop time.Duration, init, limit int32) {
@@ -1547,7 +1567,7 @@ func (r *flowReader) control(f h2Frame, header, payload, out []byte) []byte {
 			q = c.queueing(now)
 		}
 		switch {
-		case c.client && c.modelled(now) && s.down.ramped:
+		case c.client && c.modelled(now) && s.down.settled():
 			s.down.model(now, c.currentRTT(), c.down.init, c.down.max)
 		case !c.client && c.incremental && s.down.flat >= flowFullRounds && c.modelled(now):
 			// Only clients that credit in small steps: one that waits for
@@ -1690,7 +1710,7 @@ func (w *flowWriter) control(f h2Frame, header, payload, out []byte) []byte {
 		s.up.returned += inc
 		var q int
 		switch {
-		case c.modelled(now) && s.up.ramped:
+		case c.modelled(now) && s.up.settled():
 			s.up.model(now, c.currentRTT(), c.up.init, c.up.max)
 		case c.modelled(now):
 			s.up.adjust(now, c.currentRTT(), c.up.init, c.up.max, true, false)
diff --git a/transport/internet/splithttp/h2flow_ramp_test.go b/transport/internet/splithttp/h2flow_ramp_test.go
index a64d9b771..113967a2f 100644
--- a/transport/internet/splithttp/h2flow_ramp_test.go
+++ b/transport/internet/splithttp/h2flow_ramp_test.go
@@ -33,6 +33,46 @@ func TestFlowWindowRamp(t *testing.T) {
 	}
 }
 
+// TestFlowWindowSettles is a reader that doubles its rate every round trip,
+// with one round that reads low and the next that makes up for it. The low
+// round ends the ramp, as any round without growth does, but the window has
+// not settled: it does not follow the path model yet, which would have that
+// one small round to go by. Two round trips at the same rate settle it.
+func TestFlowWindowSettles(t *testing.T) {
+	const rtt = 50 * time.Millisecond
+	start := time.Unix(0, 0)
+	w := flowWindow{cap: flowStartWindow}
+	at := time.Duration(0)
+	round := func(credit int64) {
+		w.returned += credit
+		w.adjust(start.Add(at), rtt, h2InitWindow, 1<<30, true, false)
+		at += rtt
+	}
+	round(0)
+	for _, credit := range []int64{16 << 10, 32 << 10, 64 << 10, 56 << 10, 200 << 10, 400 << 10} {
+		round(credit)
+		if w.settled() {
+			t.Fatalf("a round of %d KiB settled a reader that still doubles its rate", credit>>10)
+		}
+	}
+	if !w.ramped {
+		t.Fatal("a round under the one before did not end the ramp")
+	}
+	// Twice the reader's rate still lets the sender double.
+	if want := int32(2 * 400 << 10); w.cap != want {
+		t.Fatalf("the cap is %d after a round of 400 KiB, want twice that, %d", w.cap, want)
+	}
+	for i := 0; i < flowSettledRounds; i++ {
+		if w.settled() {
+			t.Fatalf("settled after %d round trips at the same rate, want %d", i, flowSettledRounds)
+		}
+		round(400 << 10)
+	}
+	if !w.settled() {
+		t.Fatalf("%d round trips at the same rate did not settle the reader", flowSettledRounds)
+	}
+}
+
 func TestFlowLearnedHalfLife(t *testing.T) {
 	var l flowLearned
 	start := time.Unix(0, 0)
-- 
