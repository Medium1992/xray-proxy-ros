From 2944303aa5a301761439030e468c9efc0650e5b0 Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Sat, 24 Oct 2026 18:10:01 +0300
Subject: [PATCH] XHTTP: Count the connection window net/http really grants
 when the config's is out of range

---
 .../internet/splithttp/h2flow_config_test.go    | 17 +++++++++++++++++
 .../internet/splithttp/h2flow_transport.go      | 10 ++++++++++
 transport/internet/splithttp/hub.go             |  6 +-----
 3 files changed, 28 insertions(+), 5 deletions(-)

diff --git a/transport/internet/splithttp/h2flow_config_test.go b/transport/internet/splithttp/h2flow_config_test.go
index 66845a1c..72494833 100644
--- a/transport/internet/splithttp/h2flow_config_test.go
+++ b/transport/internet/splithttp/h2flow_config_test.go
@@ -155,6 +155,10 @@ func TestH2ServerGrantsWindows(t *testing.T) {
 		// The server grants flowServerReceiveWindow on the connection; the
 		// governor shows Go's default until readers take more.
 		{"governor on, default", &H2FlowConfig{Mode: 1}, flowServerReceiveWindow, flowConnFloor, true},
+		// A connection window under HTTP/2's own, which a proto config can
+		// carry: net/http grants its default instead, and so does the
+		// governor's accounting.
+		{"governor on, connection window under 65535", &H2FlowConfig{Mode: 1, MaxConnectionReceiveWindow: 1000}, flowServerReceiveWindow, flowConnFloor, true},
 	} {
 		t.Run(tc.name, func(t *testing.T) {
 			port := tcp.PickPort()
@@ -254,3 +258,16 @@ func TestH2WindowsEndToEnd(t *testing.T) {
 		}
 	}
 }
+
+// TestH2ConnWindowFollowsNetHTTP checks the connection window the governor
+// counts as granted against what net/http grants for the same setting.
+func TestH2ConnWindowFollowsNetHTTP(t *testing.T) {
+	for set, want := range map[int]int32{0: 1 << 20, 1000: 1 << 20, 65534: 1 << 20, 65535: 65535, 3 << 20: 3 << 20, 1 << 31: 1 << 20} {
+		if got := h2ConnWindow(&http.HTTP2Config{MaxReceiveBufferPerConnection: set}); got != want {
+			t.Errorf("MaxReceiveBufferPerConnection %d: counted %d, want %d", set, got, want)
+		}
+	}
+	if got := h2ConnWindow(nil); got != 1<<20 {
+		t.Errorf("no HTTP/2 config: counted %d, want %d", got, 1<<20)
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_transport.go b/transport/internet/splithttp/h2flow_transport.go
index 7e5108e0..82c1f2e1 100644
--- a/transport/internet/splithttp/h2flow_transport.go
+++ b/transport/internet/splithttp/h2flow_transport.go
@@ -44,6 +44,16 @@ func (c *Config) h2SendWindow() int64 {
 	}
 }
 
+// h2ConnWindow is the connection receive window net/http grants for h2: a
+// value outside [65535, 2^31-1], which a proto config can carry, is its
+// default, as in its setDefault.
+func h2ConnWindow(h2 *http.HTTP2Config) int32 {
+	if h2 != nil && h2.MaxReceiveBufferPerConnection >= h2InitWindow && h2.MaxReceiveBufferPerConnection <= h2MaxWindow {
+		return int32(h2.MaxReceiveBufferPerConnection)
+	}
+	return 1 << 20 // Go's default
+}
+
 // h2ReceiveConfig returns the HTTP/2 receive windows this side grants, or nil
 // to keep Go's defaults.
 func (c *Config) h2ReceiveConfig(server bool) *http.HTTP2Config {
diff --git a/transport/internet/splithttp/hub.go b/transport/internet/splithttp/hub.go
index 4bf7973a..c5a2b4ea 100644
--- a/transport/internet/splithttp/hub.go
+++ b/transport/internet/splithttp/hub.go
@@ -569,11 +569,7 @@ func ListenXH(ctx context.Context, address net.Address, port net.Port, streamSet
 		}
 		if l.config.h2FlowOn() {
 			fl := &flowListener{Listener: l.listener, up: flowDefault, down: flowDefault, sendWindow: l.config.h2SendWindow(), noQueueCuts: l.config.GetH2Flow().GetNoQueueCuts()}
-			if h2 := l.server.HTTP2; h2 != nil && h2.MaxReceiveBufferPerConnection > 0 {
-				fl.connWindow = int32(min(h2.MaxReceiveBufferPerConnection, h2MaxWindow))
-			} else {
-				fl.connWindow = 1 << 20 // Go's default
-			}
+			fl.connWindow = h2ConnWindow(l.server.HTTP2)
 			l.listener = fl
 		}
 		go func() {
-- 
