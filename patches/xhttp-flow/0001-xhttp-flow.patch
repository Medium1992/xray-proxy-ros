diff --git a/transport/internet/splithttp/h2flow_ramp_test.go b/transport/internet/splithttp/h2flow_ramp_test.go
new file mode 100644
index 00000000..ab271ea0
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_ramp_test.go
@@ -0,0 +1,178 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+)
+
+func TestFlowWindowRamp(t *testing.T) {
+	const rtt = 50 * time.Millisecond
+	start := time.Unix(0, 0)
+	w := flowWindow{cap: flowStartWindow}
+	step := func(at time.Duration, credit int64) {
+		w.returned += credit
+		w.adjust(start.Add(at), rtt, h2InitWindow, 1<<30, true, false)
+	}
+
+	step(0, 32<<10)
+	step(10*time.Millisecond, 200<<10)
+	if want := int32(h2InitWindow + 2*(232<<10)); w.cap != want {
+		t.Fatalf("before the first round trip the cap should open with every credit: got %d, want %d", w.cap, want)
+	}
+
+	step(rtt, 56<<10)
+	step(2*rtt, 512<<10)
+	if want := int32(3 << 20); w.cap != want {
+		t.Fatalf("a reader doubling its rate should get room for the sender doubling too: got %d, want %d", w.cap, want)
+	}
+
+	step(3*rtt, 512<<10)
+	step(4*rtt, 2<<20)
+	if want := int32(4 << 20); w.cap != want {
+		t.Fatalf("after the reader stopped speeding up the cap should follow twice its rate: got %d, want %d", w.cap, want)
+	}
+}
+
+// TestFlowWindowSettles is a reader that doubles its rate every round trip,
+// with one round that reads low and the next that makes up for it. The low
+// round ends the ramp, as any round without growth does, but the window has
+// not settled: it does not follow the path model yet, which would have that
+// one small round to go by. Two round trips at the same rate settle it.
+func TestFlowWindowSettles(t *testing.T) {
+	const rtt = 50 * time.Millisecond
+	start := time.Unix(0, 0)
+	w := flowWindow{cap: flowStartWindow}
+	at := time.Duration(0)
+	round := func(credit int64) {
+		w.returned += credit
+		w.adjust(start.Add(at), rtt, h2InitWindow, 1<<30, true, false)
+		at += rtt
+	}
+	round(0)
+	for _, credit := range []int64{16 << 10, 32 << 10, 64 << 10, 56 << 10, 200 << 10, 400 << 10} {
+		round(credit)
+		if w.settled() {
+			t.Fatalf("a round of %d KiB settled a reader that still doubles its rate", credit>>10)
+		}
+	}
+	if !w.ramped {
+		t.Fatal("a round under the one before did not end the ramp")
+	}
+	// Twice the reader's rate still lets the sender double.
+	if want := int32(2 * 400 << 10); w.cap != want {
+		t.Fatalf("the cap is %d after a round of 400 KiB, want twice that, %d", w.cap, want)
+	}
+	for i := 0; i < flowSettledRounds; i++ {
+		if w.settled() {
+			t.Fatalf("settled after %d round trips at the same rate, want %d", i, flowSettledRounds)
+		}
+		round(400 << 10)
+	}
+	if !w.settled() {
+		t.Fatalf("%d round trips at the same rate did not settle the reader", flowSettledRounds)
+	}
+}
+
+// TestFlowWindowGrowingSlowlyIsNotSettled is a reader a tenth faster every
+// round trip. Its rounds are flat, under a quarter more each, but none has
+// ended the ramp: it still speeds up, and stays with adjust, which follows
+// it at twice its rate, as before.
+func TestFlowWindowGrowingSlowlyIsNotSettled(t *testing.T) {
+	const rtt = 50 * time.Millisecond
+	start := time.Unix(0, 0)
+	w := flowWindow{cap: flowStartWindow}
+	credit := int64(400 << 10)
+	for i := 0; i < 6; i++ {
+		w.returned += credit
+		w.adjust(start.Add(time.Duration(i)*rtt), rtt, h2InitWindow, 1<<30, true, false)
+		credit += credit / 10
+	}
+	if w.flat < flowSettledRounds {
+		t.Fatalf("%d flat rounds counted for a reader that grows a tenth a round, want at least %d", w.flat, flowSettledRounds)
+	}
+	if w.ramped || w.settled() {
+		t.Fatalf("a reader that still speeds up counts as ramped %v, settled %v", w.ramped, w.settled())
+	}
+}
+
+// TestFlowWindowSlowGrowthThenLowRoundIsNotSettled is that reader followed
+// by one round that reads low, as a start in congestion avoidance may give.
+// The low round ends the ramp. The flat rounds before it are not rounds at a
+// found rate, and the model would have the low round to go by.
+func TestFlowWindowSlowGrowthThenLowRoundIsNotSettled(t *testing.T) {
+	const rtt = 50 * time.Millisecond
+	start := time.Unix(0, 0)
+	w := flowWindow{cap: flowStartWindow}
+	credit := int64(400 << 10)
+	at := time.Duration(0)
+	round := func(credit int64) {
+		w.returned += credit
+		w.adjust(start.Add(at), rtt, h2InitWindow, 1<<30, true, false)
+		at += rtt
+	}
+	for i := 0; i < 6; i++ {
+		round(credit)
+		credit += credit / 10
+	}
+	round(8 << 10)
+	if !w.ramped {
+		t.Fatal("a round under the one before did not end the ramp")
+	}
+	if w.settled() {
+		t.Fatalf("one low round after slow growth settled the window, with %d to model the path from", w.prev)
+	}
+	round(8 << 10)
+	if !w.settled() {
+		t.Fatalf("%d round trips at the same rate after the ramp did not settle the reader", flowSettledRounds)
+	}
+}
+
+func TestFlowLearnedHalfLife(t *testing.T) {
+	var l flowLearned
+	start := time.Unix(0, 0)
+	l.note(start, h2InitWindow, 2<<20)
+	if got, want := l.value(start.Add(flowLearnHalf), h2InitWindow), int32(h2InitWindow+(2<<20-h2InitWindow)/2); got != want {
+		t.Fatalf("learned cap after one half-life: got %d, want %d", got, want)
+	}
+}
+
+func TestFlowWindowHold(t *testing.T) {
+	const rtt = 50 * time.Millisecond
+	start := time.Unix(0, 0)
+	w := flowWindow{cap: flowStartWindow}
+	for i, credit := range []int64{32 << 10, 200 << 10, 512 << 10, 1 << 20} {
+		w.returned += credit
+		w.adjust(start.Add(time.Duration(i)*rtt), rtt, h2InitWindow, 1<<30, true, true)
+	}
+	if w.cap != flowStartWindow {
+		t.Fatalf("the cap grew to %d while a queue was building", w.cap)
+	}
+}
+
+func TestFlowQueueing(t *testing.T) {
+	ms := time.Millisecond
+	for _, tc := range []struct {
+		rtt, min time.Duration
+		ok       bool
+		want     int
+	}{
+		{60 * ms, 50 * ms, true, 0},
+		{110 * ms, 50 * ms, true, 1},
+		{160 * ms, 50 * ms, true, 2},
+		{10 * ms, ms, true, 0},
+		{30 * ms, ms, true, 1},
+		{50 * ms, ms, true, 2},
+		{500 * ms, 50 * ms, false, 0},
+	} {
+		c := &flowConn{tcp: fakeRawConn{}, kAt: time.Unix(0, 0), kstat: tcpStats{rtt: tc.rtt, minRTT: tc.min}, kOK: tc.ok}
+		if got := c.queueing(time.Unix(0, 0)); got != tc.want {
+			t.Errorf("rtt %v over min %v (stats %v): got %d, want %d", tc.rtt, tc.min, tc.ok, got, tc.want)
+		}
+	}
+}
+
+type fakeRawConn struct{}
+
+func (fakeRawConn) Control(func(uintptr)) error    { return nil }
+func (fakeRawConn) Read(func(uintptr) bool) error  { return nil }
+func (fakeRawConn) Write(func(uintptr) bool) error { return nil }
diff --git a/transport/internet/splithttp/h2flow_read_test.go b/transport/internet/splithttp/h2flow_read_test.go
new file mode 100644
index 00000000..fdeb8e65
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_read_test.go
@@ -0,0 +1,162 @@
+package splithttp
+
+import (
+	"bytes"
+	mrand "math/rand/v2"
+	"net"
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// chunkConn serves data in random pieces and swallows writes.
+type chunkConn struct {
+	net.Conn
+	data []byte
+	rnd  *mrand.Rand
+}
+
+func (c *chunkConn) Read(b []byte) (int, error) {
+	if len(c.data) == 0 {
+		return 0, net.ErrClosed
+	}
+	n := min(len(b), len(c.data), 1+c.rnd.IntN(3000))
+	copy(b, c.data[:n])
+	c.data = c.data[n:]
+	return n, nil
+}
+
+func (c *chunkConn) Write(b []byte) (int, error)      { return len(b), nil }
+func (c *chunkConn) SetDeadline(time.Time) error      { return nil }
+func (c *chunkConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *chunkConn) SetWriteDeadline(time.Time) error { return nil }
+func (c *chunkConn) Close() error                     { return nil }
+
+func frameStream(clientSide bool) ([]byte, map[uint32][]byte) {
+	var s bytes.Buffer
+	if clientSide {
+		s.WriteString(h2Preface)
+	}
+	fr := http2.NewFramer(&s, nil)
+	fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 1 << 20})
+	data := map[uint32][]byte{}
+	// A client may send no more than the windows it starts with: a governed
+	// server ends the connection past them.
+	budget := h2InitWindow
+	for i := 0; i < 400; i++ {
+		id := uint32(1 + 2*(i%7))
+		if clientSide && i < 7 {
+			fr.WriteHeaders(http2.HeadersFrameParam{StreamID: id, BlockFragment: []byte{0x82}, EndHeaders: true})
+		}
+		n := mrand.IntN(16384)
+		if clientSide {
+			n = min(mrand.IntN(300), budget)
+			budget -= n
+		}
+		p := make([]byte, n)
+		for j := range p {
+			p[j] = byte(i*31 + j)
+		}
+		fr.WriteData(id, false, p)
+		data[id] = append(data[id], p...)
+		if i%5 == 0 {
+			fr.WriteWindowUpdate(0, 1000)
+			fr.WriteWindowUpdate(id, 70000)
+		}
+	}
+	return s.Bytes(), data
+}
+
+// TestFlowReadChunked reads frames through the governor in random pieces
+// into buffers of random size: what it holds back of a split frame makes its
+// output longer than a read at times, and none of it may be lost or reordered.
+func TestFlowReadChunked(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		client   bool
+		governed bool
+	}{
+		{"server passthrough", false, false},
+		{"server governed", false, true},
+		{"client passthrough", true, false},
+		{"client governed", true, true},
+	} {
+		in, want := frameStream(!tc.client)
+		for round := 0; round < 100; round++ {
+			rnd := mrand.New(mrand.NewPCG(uint64(round), 7))
+			cc := &chunkConn{data: append([]byte(nil), in...), rnd: rnd}
+			var c *flowConn
+			switch {
+			case tc.client:
+				c = newFlowClientConn(cc)
+				c.mode.Store(flowH2)
+				if !tc.governed {
+					c.down = flowLimit{}
+				}
+			case tc.governed:
+				c = newFlowConn(cc, flowDefault, flowDefault)
+			default:
+				c = newFlowConn(cc, flowLimit{}, flowLimit{})
+			}
+			var got []byte
+			for {
+				b := make([]byte, 1+rnd.IntN(5000))
+				n, err := c.Read(b)
+				got = append(got, b[:n]...)
+				if err != nil {
+					break
+				}
+			}
+			if !tc.governed {
+				if !bytes.Equal(got, in) {
+					t.Fatalf("%s round %d: output differs from input", tc.name, round)
+				}
+				continue
+			}
+			if !tc.client {
+				got = got[len(h2Preface):]
+			}
+			fr := http2.NewFramer(nil, bytes.NewReader(got))
+			fr.SetMaxReadFrameSize(1 << 24)
+			data := map[uint32][]byte{}
+			for {
+				f, err := fr.ReadFrame()
+				if err != nil {
+					break
+				}
+				if d, ok := f.(*http2.DataFrame); ok {
+					data[d.StreamID] = append(data[d.StreamID], d.Data()...)
+				}
+			}
+			for id, w := range want {
+				if !bytes.Equal(data[id], w) {
+					t.Fatalf("%s round %d: stream %d data differs", tc.name, round, id)
+				}
+			}
+		}
+	}
+}
+
+// TestFlowReadStaysInBuffer reads a client's opening frames into a buffer
+// that is a slice of a larger one: the credit the governor adds for the new
+// stream makes its output longer than the read, and none of it may land past
+// the buffer, in memory the caller still owns.
+func TestFlowReadStaysInBuffer(t *testing.T) {
+	sc := &scriptConn{}
+	c := newFlowConn(sc, flowDefault, flowDefault)
+	in := append([]byte(h2Preface), frames(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20})
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: []byte{0x82}, EndHeaders: true})
+	})...)
+	sc.feed(in)
+	buf := bytes.Repeat([]byte{0xee}, 1024)
+	if _, err := c.Read(buf[:len(in)]); err != nil {
+		t.Fatal(err)
+	}
+	for i, v := range buf[len(in):] {
+		if v != 0xee {
+			t.Fatalf("Read wrote past the %d-byte buffer it was given, at %d", len(in), len(in)+i)
+		}
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_rebase_test.go b/transport/internet/splithttp/h2flow_rebase_test.go
new file mode 100644
index 00000000..9c1c61c8
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_rebase_test.go
@@ -0,0 +1,175 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+)
+
+// TestFlowRebase steps the path's round trip from 20 to 120 ms under a
+// kernel whose min_rtt stays at 20: with cuts that do not move the queue the
+// queue is counted from 120 ms once flowBaseWindow has passed, a queue of
+// the server's own on top of that does not raise it, and the path coming
+// back drops it. With cuts that work, the same round trip stays a queue.
+func TestFlowRebase(t *testing.T) {
+	const kernel = 20 * time.Millisecond
+	run := func(c *flowConn, now time.Time, rtt time.Duration, gain float64, d time.Duration) time.Time {
+		for end := now.Add(d); now.Before(end); now = now.Add(flowKernelEvery) {
+			c.effect.active, c.effect.gain, c.pinned = gain < 1, gain, true
+			c.kstat = tcpStats{rtt: rtt, minRTT: kernel, rttVar: time.Millisecond}
+			c.rebase(now)
+		}
+		return now
+	}
+	now := time.Unix(1, 0)
+
+	c := &flowConn{}
+	now = run(c, now, kernel, 1, time.Second)
+	now = run(c, now, 120*time.Millisecond, 0, flowBaseWindow/2)
+	if c.kstat.minRTT != kernel {
+		t.Fatalf("rebased to %v before cuts had failed for %v", c.kstat.minRTT, flowBaseWindow)
+	}
+	now = run(c, now, 120*time.Millisecond, 0, 2*flowBaseWindow)
+	if c.kstat.minRTT != 120*time.Millisecond {
+		t.Fatalf("after the path moved to 120 ms the queue counts from %v", c.kstat.minRTT)
+	}
+	now = run(c, now, 140*time.Millisecond, 1, 3*flowBaseWindow)
+	if c.kstat.minRTT != 120*time.Millisecond {
+		t.Fatalf("a queue of the server's own raised the base to %v", c.kstat.minRTT)
+	}
+	run(c, now, kernel, 1, 2*flowBaseWindow)
+	if c.kstat.minRTT != kernel || c.base != 0 {
+		t.Fatalf("the path came back and the queue still counts from %v", c.kstat.minRTT)
+	}
+
+	c = &flowConn{}
+	now = run(c, now, kernel, 1, time.Second)
+	run(c, now, 120*time.Millisecond, 1, 3*flowBaseWindow)
+	if c.kstat.minRTT != kernel {
+		t.Fatalf("cuts that work, and the queue still counts from %v", c.kstat.minRTT)
+	}
+}
+
+// TestFlowRebaseNotOwnQueue reads a low gain beside downloads whose caps are
+// well above init: the queue is their data, a gain that reads low now and
+// then on connections that share it, and the base stays the kernel's.
+func TestFlowRebaseNotOwnQueue(t *testing.T) {
+	c := &flowConn{}
+	now := time.Unix(1, 0)
+	for end := now.Add(3 * flowBaseWindow); now.Before(end); now = now.Add(flowKernelEvery) {
+		c.effect.active, c.effect.gain, c.pinned = true, 0.1, false
+		c.kstat = tcpStats{rtt: 110 * time.Millisecond, minRTT: 50 * time.Millisecond, rttVar: 100 * time.Microsecond}
+		c.rebase(now)
+	}
+	if c.kstat.minRTT != 50*time.Millisecond {
+		t.Fatalf("a queue of the server's own was taken for the path: the queue counts from %v", c.kstat.minRTT)
+	}
+}
+
+// TestFlowRebaseKeepsBaseThroughJitter steps the path by 20 ms and then has
+// the round trip's variance grow to 5 ms, a setpoint as large as the step:
+// the base stays until the path comes back.
+func TestFlowRebaseKeepsBaseThroughJitter(t *testing.T) {
+	c := &flowConn{}
+	now := time.Unix(1, 0)
+	step := func(rtt, rttVar time.Duration, gain float64, d time.Duration) {
+		for end := now.Add(d); now.Before(end); now = now.Add(flowKernelEvery) {
+			c.effect.active, c.effect.gain, c.pinned = gain < 1, gain, true
+			c.kstat = tcpStats{rtt: rtt, minRTT: 20 * time.Millisecond, rttVar: rttVar}
+			c.rebase(now)
+		}
+	}
+	step(40*time.Millisecond, time.Millisecond, 0, 2*flowBaseWindow)
+	step(40*time.Millisecond, 5*time.Millisecond, 1, 2*flowBaseWindow)
+	if c.kstat.minRTT != 40*time.Millisecond {
+		t.Fatalf("jitter on the moved path dropped the base: the queue counts from %v", c.kstat.minRTT)
+	}
+	step(20*time.Millisecond, time.Millisecond, 1, 2*flowBaseWindow)
+	if c.base != 0 {
+		t.Fatalf("the path came back and the base stayed at %v", c.base)
+	}
+}
+
+// TestFlowRebaseWhereGainFroze has the empty path's round trip step from 20
+// to 120 ms under a download whose cap is above twice init, from the start
+// window and from 512 KiB, while the kernel keeps its min_rtt at 20 ms. The
+// first cut lands in flight and the queue, the path's own, does not move:
+// the gain goes to none, the cuts stop and the cap stays above twice init.
+// rebase waited for caps at init and never ran; the gain of none is now
+// enough for it. A smoothed round trip that wanders by 8 ms either way on a
+// path that moved to 70 ms is still the path's: the base was taken only
+// where the round trip stood within a tenth. Where the queue keeps moving by
+// two fifths, as a queue of the server's own does while the connections
+// that share it cut and grow, with the cap still over twice init, it is not
+// the path's, and rebase does not run.
+func TestFlowRebaseWhereGainFroze(t *testing.T) {
+	const oldMinRTT = 20 * time.Millisecond
+	const newPathRTT = 120 * time.Millisecond
+	for _, tc := range []struct {
+		name   string
+		rtt    func(since time.Duration) time.Duration
+		caps   []int32
+		rebase bool
+	}{
+		{"path moved", func(time.Duration) time.Duration { return newPathRTT }, []int32{flowStartWindow, 512 << 10}, true},
+		{"path moved with jitter", func(since time.Duration) time.Duration {
+			// A triangle of ±8 ms around 70 ms, 400 ms round.
+			const amp = 8 * time.Millisecond
+			p := since % (400 * time.Millisecond)
+			off := amp - 2*amp*p/(200*time.Millisecond)
+			if p >= 200*time.Millisecond {
+				off = -3*amp + 2*amp*p/(200*time.Millisecond)
+			}
+			return 70*time.Millisecond + off
+		}, []int32{flowStartWindow, 512 << 10}, true},
+		// From 512 KiB the cap stays over twice init as it follows the round
+		// trip: it is the queue that does not stand that tells this from a
+		// path.
+		{"queue moves", func(since time.Duration) time.Duration {
+			if since < time.Second || since/(400*time.Millisecond)%2 == 0 {
+				return newPathRTT
+			}
+			return 80 * time.Millisecond
+		}, []int32{512 << 10}, false},
+	} {
+		for _, startCap := range tc.caps {
+			h, s := queuedDownload(t)
+			now := time.Unix(1000, 0)
+			h.c.mu.Lock()
+			h.c.incremental = true
+			h.c.rttBase = oldMinRTT
+			s.down.cap = startCap
+			s.down.flat = flowFullRounds
+			s.down.mark, s.down.markBase = now, s.down.returned
+			s.down.qAt = now
+			h.c.mu.Unlock()
+			// A second at the old path's setpoint seeds the base window.
+			for end := now.Add(time.Second); now.Before(end); now = now.Add(oldMinRTT) {
+				h.c.mu.Lock()
+				h.c.kstat = tcpStats{rtt: oldMinRTT + flowPIMinSet, minRTT: oldMinRTT, rttVar: time.Millisecond, inFlight: int64(s.down.cap)}
+				h.c.rebase(now)
+				s.down.returned += int64(s.down.cap)
+				h.c.governDown(now, s)
+				h.c.mu.Unlock()
+			}
+			// The round trip rises; the kernel's min_rtt stays. The download
+			// is held by its cap, and the reader returns a cap per round trip.
+			step := now
+			for end := now.Add(3 * flowBaseWindow); now.Before(end); now = now.Add(oldMinRTT) {
+				rtt := tc.rtt(now.Sub(step))
+				h.c.mu.Lock()
+				h.c.kstat = tcpStats{rtt: rtt, minRTT: oldMinRTT, rttVar: time.Millisecond, inFlight: int64(s.down.cap)}
+				h.c.rebase(now)
+				s.down.returned += int64(s.down.cap) * int64(oldMinRTT) / int64(rtt)
+				h.c.governDown(now, s)
+				h.c.mu.Unlock()
+			}
+			h.c.mu.Lock()
+			base, cap, pinned, gain := h.c.base, s.down.cap, h.c.pinned, h.c.effect.gain
+			h.c.mu.Unlock()
+			if (base != 0) != tc.rebase {
+				t.Fatalf("%s, cap %d: base %v (cap %d, pinned %v, gain %v), want a rebase: %v",
+					tc.name, startCap, base, cap, pinned, gain, tc.rebase)
+			}
+		}
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_rebaseping_test.go b/transport/internet/splithttp/h2flow_rebaseping_test.go
new file mode 100644
index 00000000..3be6e6f8
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_rebaseping_test.go
@@ -0,0 +1,41 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+)
+
+// TestFlowRebasePing has PINGs at 20 ms, then the path move to 80 ms, as a
+// client without the kernel's view sees a WiFi to cellular move: once the
+// least PING over a window stands there, the queue is counted from it, and
+// once the path is back it is counted from 20 ms again. A queue that drains
+// now and then, as an own queue under the cuts does, is no move.
+func TestFlowRebasePing(t *testing.T) {
+	c := &flowConn{}
+	now := time.Unix(1, 0)
+	feed := func(d time.Duration, rtts ...time.Duration) {
+		for end, i := now.Add(d), 0; now.Before(end); now, i = now.Add(time.Second), i+1 {
+			c.sampleRTT(now, rtts[i%len(rtts)])
+		}
+	}
+	feed(5*time.Second, 20*time.Millisecond)
+	feed(5*time.Second, 80*time.Millisecond)
+	if got := c.pingFloor(now); got != 20*time.Millisecond {
+		t.Fatalf("five seconds after the move the floor is %v, want 20ms still", got)
+	}
+	feed(2*flowRTTWindow, 80*time.Millisecond)
+	if got := c.pingFloor(now); got != 80*time.Millisecond {
+		t.Fatalf("after the path moved to 80ms the floor is %v", got)
+	}
+	feed(2*flowRTTWindow+time.Second, 20*time.Millisecond)
+	if got := c.pingFloor(now); got != 20*time.Millisecond {
+		t.Fatalf("the path came back and the floor is %v", got)
+	}
+
+	c = &flowConn{}
+	feed(5*time.Second, 20*time.Millisecond)
+	feed(3*flowRTTWindow, 90*time.Millisecond, 120*time.Millisecond, 25*time.Millisecond)
+	if got := c.pingFloor(now); got != 20*time.Millisecond {
+		t.Fatalf("a queue that drains every few seconds moved the floor to %v", got)
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_records_test.go b/transport/internet/splithttp/h2flow_records_test.go
new file mode 100644
index 00000000..878548c5
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_records_test.go
@@ -0,0 +1,117 @@
+package splithttp
+
+import (
+	"context"
+	gotls "crypto/tls"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+
+	"golang.org/x/net/http2"
+)
+
+// writeSizes records the size of each write to the connection under it: what
+// a TLS layer above the TCP connection would send as one record each.
+type writeSizes struct {
+	net.Conn
+	mu    sync.Mutex
+	sizes []int
+}
+
+func (w *writeSizes) Write(b []byte) (int, error) {
+	w.mu.Lock()
+	w.sizes = append(w.sizes, len(b))
+	w.mu.Unlock()
+	return w.Conn.Write(b)
+}
+
+// TestFlowClientRecordSizes logs the writes a client makes toward the server
+// at the start of a download, the TLS records an observer of the path would
+// see, for a stock client, a governed client toward a stock server and a
+// governed client toward a governed server, which sees the server govern and
+// sends its own SETTINGS. That SETTINGS goes in a write the client makes in
+// any case: toward a governed server it makes no more writes than a stock
+// client does.
+func TestFlowClientRecordSizes(t *testing.T) {
+	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write(make([]byte, 256<<10))
+	})
+	sizes := map[string][]int{}
+	for _, tc := range []struct {
+		name             string
+		server, governed bool
+	}{
+		{"stock client, stock server", false, false},
+		{"stock client, governed server", true, false},
+		{"governed client, stock server", false, true},
+		{"governed client, governed server", true, true},
+	} {
+		up, down := flowLimit{}, flowLimit{}
+		if tc.server {
+			up, down = testUp, testDown
+		}
+		_, addr := startFlowServer(t, up, down, false, handler)
+		rec := &writeSizes{}
+		var fc *flowConn
+		tr := &http2.Transport{
+			AllowHTTP: true,
+			DialTLSContext: func(ctx context.Context, network, _ string, _ *gotls.Config) (net.Conn, error) {
+				c, err := (&net.Dialer{}).DialContext(ctx, network, addr)
+				if err != nil {
+					return nil, err
+				}
+				rec.Conn = c
+				if tc.governed {
+					g := newFlowClientConn(rec)
+					rec.mu.Lock()
+					fc = g
+					rec.mu.Unlock()
+					return g, nil
+				}
+				return rec, nil
+			},
+		}
+		// A governed connection holds its flowGroup until it closes: close
+		// it with the test, whichever way the test ends.
+		t.Cleanup(func() {
+			tr.CloseIdleConnections()
+			rec.mu.Lock()
+			g := fc
+			rec.mu.Unlock()
+			if g != nil {
+				g.Close()
+			}
+		})
+		client := &http.Client{Transport: tr}
+		resp, err := client.Get("http://x/")
+		if err != nil {
+			t.Fatal(err)
+		}
+		io.Copy(io.Discard, resp.Body)
+		resp.Body.Close()
+		client.CloseIdleConnections()
+		rec.mu.Lock()
+		got := append([]int(nil), rec.sizes...)
+		rec.mu.Unlock()
+		sizes[tc.name] = got
+		var b strings.Builder
+		for i, n := range got {
+			if i == 16 {
+				fmt.Fprintf(&b, " ... (%d writes)", len(got))
+				break
+			}
+			fmt.Fprintf(&b, " %d", n)
+		}
+		t.Logf("%s:%s", tc.name, b.String())
+	}
+	// Toward a governed server, the governed client differs from a stock one
+	// by its SETTINGS alone, 15 bytes in a write both make.
+	stock, governed := sizes["stock client, governed server"], sizes["governed client, governed server"]
+	if len(governed) > len(stock) {
+		t.Errorf("toward a governed server a governed client made %d writes, a stock one %d", len(governed), len(stock))
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_restock_test.go b/transport/internet/splithttp/h2flow_restock_test.go
new file mode 100644
index 00000000..176f1982
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_restock_test.go
@@ -0,0 +1,178 @@
+package splithttp
+
+import (
+	"context"
+	gotls "crypto/tls"
+	"encoding/binary"
+	"io"
+	"net"
+	"net/http"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// TestFlowChainedPausedReaderKeepsConnection has a governed client behind a
+// governed server, as ListenXH and the dialer set them up, and a reader that
+// waits until the server can send no more before it reads the body. Credit
+// the client forwarded before it saw the server's tag went against the
+// protocol default; a restock that raised the shown window to the stack's
+// own added the raise on top of it, the server sent past the stack's window,
+// and the stack closed the connection with FLOW_CONTROL_ERROR. A stock client
+// is the control.
+func TestFlowChainedPausedReaderKeepsConnection(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		window   int
+		governed bool
+	}{
+		{"governed 96 KiB", 96 << 10, true},
+		{"governed 512 KiB", 512 << 10, true},
+		{"governed 2 MiB", 2 << 20, true},
+		{"governed default", 0, true},
+		{"stock 256 KiB", 256 << 10, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var written atomic.Int64
+			tl, addr := startFlowServer(t, testUp, testDown, false, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(http.StatusOK)
+				w.(http.Flusher).Flush()
+				buf := make([]byte, 16<<10)
+				for range 640 {
+					n, err := w.Write(buf)
+					written.Add(int64(n))
+					if err != nil {
+						return
+					}
+					w.(http.Flusher).Flush()
+				}
+			}))
+			tl.mu.Lock()
+			tl.sendWindow = flowServerSendWindow
+			tl.mu.Unlock()
+			var conf *http.HTTP2Config
+			if tc.window != 0 {
+				conf = &http.HTTP2Config{MaxReceiveBufferPerStream: tc.window}
+			}
+			tr := newH2Transport(conf)
+			tr.AllowHTTP = true
+			var mu sync.Mutex
+			var gc *flowConn
+			tr.DialTLSContext = func(ctx context.Context, network, _ string, _ *gotls.Config) (net.Conn, error) {
+				c, err := (&net.Dialer{}).DialContext(ctx, network, addr)
+				if err != nil || !tc.governed {
+					return c, err
+				}
+				g := newFlowClientConn(c)
+				mu.Lock()
+				gc = g
+				mu.Unlock()
+				return g, nil
+			}
+			t.Cleanup(func() {
+				tr.CloseIdleConnections()
+				mu.Lock()
+				defer mu.Unlock()
+				if gc != nil {
+					gc.Close()
+				}
+			})
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			req, err := http.NewRequestWithContext(ctx, http.MethodGet, "http://x/", nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			resp, err := (&http.Client{Transport: tr}).Do(req)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer resp.Body.Close()
+			// The reader waits until the server's writes stop: its window
+			// at the server is used up.
+			last, still := int64(-1), 0
+			for still < 10 {
+				time.Sleep(20 * time.Millisecond)
+				if n := written.Load(); n == last {
+					still++
+				} else {
+					last, still = n, 0
+				}
+			}
+			if tc.governed {
+				mu.Lock()
+				g := gc
+				mu.Unlock()
+				g.mu.Lock()
+				peer := g.peerGoverned
+				g.mu.Unlock()
+				if !peer {
+					t.Fatal("the client did not see the server govern: no restock to test")
+				}
+			}
+			if n, err := io.Copy(io.Discard, resp.Body); err != nil {
+				t.Fatalf("server wrote %d before the reader read; read %d of the body: %v", last, n, err)
+			}
+		})
+	}
+}
+
+// TestFlowClientRestockedLaterSettings has a governed client restock to a
+// governed server and its stack then send another SETTINGS with its initial
+// window: the window goes on as it is. Before, a later SETTINGS was shown
+// the protocol default again, as before restock.
+func TestFlowClientRestockedLaterSettings(t *testing.T) {
+	sc := &scriptConn{}
+	c := newFlowClientConn(sc)
+	t.Cleanup(func() { c.Close() })
+	c.mode.Store(flowH2)
+
+	// 1. Client sends initial SETTINGS(INITIAL_WINDOW_SIZE = 4 MiB).
+	if _, err := c.writeToServer(frames(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20})
+	})); err != nil {
+		t.Fatal(err)
+	}
+	// 2. Governed server replies with SETTINGS + tagged PING.
+	c.fromServer(frames(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 1 << 20})
+		fr.WritePing(false, [8]byte{0x6b, 0x7a, 0x3f, 0x91, 1, 2, 3, 4})
+	}), nil)
+	// 3. Client sends PING ACK; appendRestock restores clientShown = 4 MiB.
+	if _, err := c.writeToServer(frames(func(fr *http2.Framer) {
+		fr.WritePing(true, [8]byte{0x6b, 0x7a, 0x3f, 0x91, 1, 2, 3, 4})
+	})); err != nil {
+		t.Fatal(err)
+	}
+	c.mu.Lock()
+	if !c.peerGoverned || c.clientShown != 4<<20 {
+		c.mu.Unlock()
+		t.Fatalf("after restock: peerGoverned=%v clientShown=%d, want true and %d", c.peerGoverned, c.clientShown, 4<<20)
+	}
+	c.mu.Unlock()
+
+	// 4. Client stack later sends another SETTINGS with INITIAL_WINDOW_SIZE = 4 MiB.
+	sc.take()
+	if _, err := c.writeToServer(frames(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20})
+	})); err != nil {
+		t.Fatal(err)
+	}
+	sent := sc.take()
+	var wireWin uint32
+	for _, f := range rawFrames(t, sent) {
+		if f.typ == h2Settings && f.flags == 0 && len(f.payload) == 6 {
+			wireWin = binary.BigEndian.Uint32(f.payload[2:])
+		}
+	}
+	c.mu.Lock()
+	shown := c.clientShown
+	c.mu.Unlock()
+	t.Logf("after later client SETTINGS(4 MiB) on peerGoverned conn: wire INITIAL_WINDOW_SIZE=%d, clientShown=%d", wireWin, shown)
+	if wireWin != 4<<20 || shown != 4<<20 {
+		t.Fatalf("peerGoverned client rewrote later SETTINGS(4 MiB) down to wire=%d, clientShown=%d", wireWin, shown)
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_sendwindow_test.go b/transport/internet/splithttp/h2flow_sendwindow_test.go
new file mode 100644
index 00000000..5228149a
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_sendwindow_test.go
@@ -0,0 +1,756 @@
+package splithttp
+
+import (
+	"errors"
+	"fmt"
+	"math"
+	"os"
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// openStreams starts a governed server connection whose client grants
+// clientWindow per stream, opens n request streams on it and returns the
+// harness; h.toServer then holds what the server may send on each.
+func openStreams(t *testing.T, sendWindow int64, clientWindow uint32, n int) *flowHarness {
+	t.Helper()
+	h := newFlowHarness(t)
+	h.c.sendWindow = sendWindow
+	h.track()
+	h.fromClient(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: clientWindow})
+	})
+	h.fromServer(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 6 << 20})
+	})
+	for i := 0; i < n; i++ {
+		h.fromClient(func(fr *http2.Framer) {
+			fr.WriteHeaders(http2.HeadersFrameParam{StreamID: uint32(2*i + 1), BlockFragment: []byte{0x82}, EndHeaders: true})
+		})
+	}
+	return h
+}
+
+// granted sums what the server may send, and counts the streams that have
+// only the window every stream has.
+func granted(h *flowHarness) (total int64, atDefault int) {
+	for _, w := range h.toServer.streams {
+		total += w
+		if w == flowShownLimited {
+			atDefault++
+		}
+	}
+	return total, atDefault
+}
+
+// TestFlowSendWindowBoundsManyStreams opens forty streams at once. Without a
+// limit each starts with flowStartWindow, 10 MiB in all that the client must
+// be ready to hold. With the limit the streams share it; those opened once it
+// is used up keep the window every stream has, which cannot be withheld, and
+// nothing more.
+func TestFlowSendWindowBoundsManyStreams(t *testing.T) {
+	const n = 40
+	total, _ := granted(openStreams(t, 0, 4<<20, n))
+	if total != n*flowStartWindow {
+		t.Fatalf("without a limit the server may send %d on %d streams, want %d", total, n, n*flowStartWindow)
+	}
+
+	h := openStreams(t, flowServerSendWindow, 4<<20, n)
+	total, atDefault := granted(h)
+	if atDefault == 0 || atDefault == n {
+		t.Fatalf("%d of %d streams have only the window every stream has", atDefault, n)
+	}
+	// The streams that got more than the default fill the limit and stop.
+	above := total - int64(atDefault)*flowShownLimited
+	if above > flowServerSendWindow || above < flowServerSendWindow-flowStartWindow {
+		t.Fatalf("streams above the default window may send %d, the limit is %d", above, flowServerSendWindow)
+	}
+	for id, w := range h.toServer.streams {
+		if w < flowShownLimited {
+			t.Fatalf("stream %d was left with a window of %d, below what every stream has", id, w)
+		}
+	}
+	t.Logf("%d streams: %d in all with the limit, %d without", n, total, n*flowStartWindow)
+}
+
+// TestFlowSendWindowIgnoresClientWindow gives the same streams to a client
+// that grants 16 MiB per stream. The limit is what was configured, not what
+// the client announces: a client with a governor of its own announces the
+// protocol default whatever its window, so the announcement says nothing.
+func TestFlowSendWindowIgnoresClientWindow(t *testing.T) {
+	const n = 40
+	with4, _ := granted(openStreams(t, flowServerSendWindow, 4<<20, n))
+	with16, _ := granted(openStreams(t, flowServerSendWindow, 16<<20, n))
+	if with16 != with4 {
+		t.Fatalf("server may send %d to a client granting 16 MiB a stream and %d to one granting 4 MiB", with16, with4)
+	}
+}
+
+// TestFlowSendWindowBelowClientWindow sets a limit under the 4 MiB a Go
+// client grants one stream: it holds, for forty streams and for one.
+func TestFlowSendWindowBelowClientWindow(t *testing.T) {
+	const limit = 1 << 20
+	h := openStreams(t, limit, 4<<20, 40)
+	total, atLeast := granted(h)
+	if above := total - int64(atLeast)*flowShownLimited; above > limit || above < limit-flowStartWindow {
+		t.Fatalf("streams above the least window may send %d, the limit is %d", above, limit)
+	}
+	// One stream alone grows as its reader takes, but not past the limit.
+	h = openStreams(t, limit, 4<<20, 1)
+	sent := int64(0)
+	for round := 0; round < 64; round++ {
+		w := h.toServer.streams[1] - sent
+		if w > limit {
+			t.Fatalf("round %d: one stream may be sent %d at once, the limit is %d", round, w, limit)
+		}
+		h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, 1, int(w)) })
+		sent += w
+		for left := w; left > 0; left -= min(left, 16<<10) {
+			h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(1, uint32(min(left, 16<<10))) })
+		}
+	}
+	if sent < 8*limit {
+		t.Fatalf("one stream was sent %d in 64 rounds: the limit stops it instead of pacing it", sent)
+	}
+}
+
+// TestFlowSendWindowIsReturned fills the limit with forty downloads, lets the
+// server end eight of them, and has only the last one read. A stream is
+// looked at when its own client returns credit, so the reader that reads is
+// the one that gets the room: it comes to its opening window with its first
+// credit and keeps it, whatever the streams before it that nobody reads.
+func TestFlowSendWindowIsReturned(t *testing.T) {
+	const n = 40
+	h := openStreams(t, flowServerSendWindow, 4<<20, n)
+	t.Cleanup(func() { h.c.Close() })
+	last := uint32(2*n - 1)
+	if got := h.toServer.streams[last]; got != flowShownLimited {
+		t.Fatalf("the last stream opened with %d, want %d once the limit is used up", got, flowShownLimited)
+	}
+	for id := uint32(1); id <= 15; id += 2 {
+		w := int(h.toServer.streams[id])
+		h.fromServer(func(fr *http2.Framer) {
+			writeDataSplit(fr, id, w)
+			fr.WriteData(id, true, nil)
+		})
+		h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(id, uint32(w)) })
+		delete(h.toServer.streams, id)
+	}
+	sent := int64(0)
+	for turn := 0; turn < 64; turn++ {
+		window := h.toServer.streams[last] - sent
+		if want := int64(flowShownLimited); turn > 0 {
+			want = openingWindow(flowServerSendWindow)
+			if window < want {
+				t.Fatalf("turn %d: the reading stream may send %d, want at least %d", turn, window, want)
+			}
+		} else if window != want {
+			t.Fatalf("turn 0: the reading stream may send %d, want %d", window, want)
+		}
+		h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, last, int(window)) })
+		sent += window
+		h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(last, uint32(window)) })
+	}
+	total, _ := granted(h)
+	if above := total - sent - int64(n-9)*flowShownLimited; above > flowServerSendWindow {
+		t.Fatalf("the reading stream and the limit's own streams may send %d more, the limit is %d", above, flowServerSendWindow)
+	}
+}
+
+// finishedRounds opens downloads in rounds of twenty on h, enough to use up
+// the default limit in one. The server sends each all it may and ends it,
+// and the client reads nothing. It returns what each round was sent.
+func finishedRounds(h *flowHarness, rounds int) (sent []int64) {
+	next := uint32(1)
+	for id := range h.toServer.streams {
+		next = max(next, id+2)
+	}
+	for ; rounds > 0; rounds-- {
+		var ids []uint32
+		for i := 0; i < 20; i++ {
+			ids = append(ids, next)
+			id := next
+			next += 2
+			h.fromClient(func(fr *http2.Framer) {
+				fr.WriteHeaders(http2.HeadersFrameParam{StreamID: id, BlockFragment: []byte{0x82}, EndHeaders: true, EndStream: true})
+			})
+		}
+		total := int64(0)
+		for _, id := range ids {
+			w := h.toServer.streams[id]
+			h.fromServer(func(fr *http2.Framer) {
+				fr.WriteHeaders(http2.HeadersFrameParam{StreamID: id, BlockFragment: []byte{0x88}, EndHeaders: true})
+				writeDataSplit(fr, id, int(w))
+				fr.WriteData(id, true, nil)
+			})
+			total += w
+		}
+		sent = append(sent, total)
+	}
+	return sent
+}
+
+// goClientStart is how a Go client opens a connection and shows that it
+// returns connection credit as it reads: it raises the connection window to
+// 1 GiB, and after one small download returns its bytes to the connection.
+func goClientStart(t *testing.T, h *flowHarness) {
+	t.Helper()
+	const first = 8 << 10
+	h.fromClient(func(fr *http2.Framer) {
+		fr.WriteWindowUpdate(0, 1<<30-h2InitWindow)
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: []byte{0x82}, EndHeaders: true, EndStream: true})
+	})
+	h.fromServer(func(fr *http2.Framer) {
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: []byte{0x88}, EndHeaders: true})
+		fr.WriteData(1, true, make([]byte, first))
+	})
+	h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, first) })
+	if !h.c.downConnSmall || h.c.clientHolds() != 0 {
+		t.Fatalf("after one download read to the end: small connection credit seen %v, client holds %d, want true and 0",
+			h.c.downConnSmall, h.c.clientHolds())
+	}
+}
+
+// TestFlowSendWindowCountsFinishedDownloads has downloads the server ends and
+// the client does not read: their data is still the client's to hold, and
+// only the connection's credit tells. Once the limit is used up a new stream
+// has the window every stream has and no more, until the client returns
+// connection credit for what it read.
+func TestFlowSendWindowCountsFinishedDownloads(t *testing.T) {
+	h := openStreams(t, flowServerSendWindow, 4<<20, 0)
+	goClientStart(t, h)
+	sent := finishedRounds(h, 2)
+	if sent[0] != flowServerSendWindow {
+		t.Fatalf("the first twenty downloads were sent %d, want the limit %d", sent[0], flowServerSendWindow)
+	}
+	if sent[1] != 20*flowShownLimited {
+		t.Fatalf("with %d unread the next twenty downloads were sent %d, want that window each, %d", sent[0], sent[1], 20*flowShownLimited)
+	}
+	// The client reads it all, 16 KiB at a time.
+	for left := sent[0] + sent[1]; left > 0; left -= min(left, 16<<10) {
+		h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, uint32(min(left, 16<<10))) })
+	}
+	if again := finishedRounds(h, 1); again[0] != flowServerSendWindow {
+		t.Fatalf("once the client had read everything twenty downloads were sent %d, want %d", again[0], flowServerSendWindow)
+	}
+}
+
+// TestFlowSendWindowWithoutConnectionCredit is the same on a client that has
+// not returned connection credit in small steps: it may be one that returns
+// it at half of a large window, which would look as if it held that half for
+// good. The connection's count is not used for it, and ended downloads are
+// outside the limit.
+func TestFlowSendWindowWithoutConnectionCredit(t *testing.T) {
+	h := openStreams(t, flowServerSendWindow, 4<<20, 0)
+	h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, 15<<20) })
+	for n, sent := range finishedRounds(h, 2) {
+		if sent != flowServerSendWindow {
+			t.Fatalf("round %d: twenty downloads were sent %d, want the limit %d", n+1, sent, flowServerSendWindow)
+		}
+	}
+	// Half of its window read, it returns that at once.
+	h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, 7<<20) })
+	if h.c.downConnSmall {
+		t.Fatal("a 7 MiB connection credit was taken for a small step")
+	}
+}
+
+// TestFlowSendWindowCreditFollowsData is the opening of a download on a
+// server with a send window. The stack is shown one frame, not 65535, and
+// what it is shown less is forwarded only behind data it has sent: a stream
+// opens with that much less, so that the credit the stack has not used is
+// what it was before, and comes to its whole cap once data moves.
+func TestFlowSendWindowCreditFollowsData(t *testing.T) {
+	h := newFlowHarnessWindow(t, flowServerSendWindow)
+	t.Cleanup(func() { h.c.Close() })
+	h.c.down.max = flowStartWindow // the cap stays where it starts
+	h.track()
+	h.openStream(4 << 20)
+	if got, want := h.toServer.streams[1], openingWindow(flowServerSendWindow); got != want {
+		t.Fatalf("the stream opened with %d, want %d", got, want)
+	}
+	if unused := h.c.streams[1].downForwarded; unused != flowStartWindow-flowShownFull {
+		t.Fatalf("%d forwarded before any data, want %d as with %d shown", unused, flowStartWindow-flowShownFull, flowShownFull)
+	}
+	// The server sends all it may; the client reads it 16 KiB at a time and
+	// the server sends again whatever that brings.
+	sent, most := int64(0), int64(0)
+	send := func() {
+		if w := h.toServer.streams[1] - sent; w > 0 {
+			h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, 1, int(w)) })
+			sent += w
+		}
+	}
+	send()
+	for read := int64(0); read < 4<<20; read += 16 << 10 {
+		h.fromClient(func(fr *http2.Framer) {
+			fr.WriteWindowUpdate(1, 16<<10)
+			fr.WriteWindowUpdate(0, 16<<10)
+		})
+		send()
+		most = max(most, sent-read-16<<10)
+		if unused := h.c.streams[1].downForwarded - h.c.streams[1].downSent; unused > flowStartWindow-flowShownFull {
+			t.Fatalf("after %d read the stack has %d forwarded and not sent, more than the %d of a stack shown %d", read, unused, flowStartWindow-flowShownFull, flowShownFull)
+		}
+	}
+	if most < flowStartWindow-32<<10 {
+		t.Fatalf("the client held at most %d of a cap of %d: the window never opened", most, flowStartWindow)
+	}
+}
+
+// TestFlowSendWindowLoweringUnderForwarded fixes what the send window leaves
+// as it was: a client's initial window lowered under what the stack has been
+// forwarded cannot be passed on, and the connection is given up, with the
+// send window as without. That the stack has sent all it was forwarded does
+// not change it.
+func TestFlowSendWindowLoweringUnderForwarded(t *testing.T) {
+	for _, lowered := range []uint32{100000, 65536, 65535, 60000} {
+		eachSendWindow(t, func(t *testing.T, sendWindow int64) {
+			h := newFlowHarnessWindow(t, sendWindow)
+			t.Cleanup(func() { h.c.Close() })
+			h.track()
+			h.openStream(4 << 20)
+			sent := h.toServer.streams[1]
+			h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, 1, int(sent)) })
+			h.fromClient(func(fr *http2.Framer) {
+				fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: lowered})
+			})
+			if h.readErr == nil || !h.c.isBroken() {
+				t.Fatalf("a lowering to %d under the %d forwarded was passed on", lowered, h.c.streams[1].downForwarded)
+			}
+		})
+	}
+}
+
+// TestFlowSendWindowSettingsWithoutWindow sends a SETTINGS frame that carries
+// no initial window between the opening of a download and a lowering of the
+// window that can be passed on. Such a frame changes nothing about what the
+// stack was shown: taking it for a client that announces no window let the
+// next credit forward the stack what it had been shown less, and the lowering
+// then closed the connection.
+func TestFlowSendWindowSettingsWithoutWindow(t *testing.T) {
+	for _, other := range []bool{false, true} {
+		t.Run(map[bool]string{false: "no other SETTINGS", true: "SETTINGS without an initial window first"}[other], func(t *testing.T) {
+			h := openStreams(t, flowServerSendWindow, 4<<20, 1)
+			t.Cleanup(func() { h.c.Close() })
+			if other {
+				h.fromClient(func(fr *http2.Framer) {
+					fr.WriteSettings(http2.Setting{ID: http2.SettingMaxConcurrentStreams, Val: 100})
+				})
+				h.fromClient(func(fr *http2.Framer) { fr.WriteSettings() })
+			}
+			h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, 1, 4096) })
+			h.fromClient(func(fr *http2.Framer) {
+				fr.WriteWindowUpdate(1, 4096)
+				fr.WriteWindowUpdate(0, 4096)
+			})
+			if !h.c.shownLimited || h.c.clientShown != flowShownLimited {
+				t.Fatalf("the stack is shown %d, limited %v; want %d and true", h.c.clientShown, h.c.shownLimited, flowShownLimited)
+			}
+			h.fromClient(func(fr *http2.Framer) {
+				fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 200000})
+			})
+			if h.readErr != nil || h.c.isBroken() {
+				t.Fatalf("a lowering to 200000 closed the connection: %v", h.readErr)
+			}
+		})
+	}
+}
+
+// nothingShown brings a connection to a full limit with the stack shown
+// nothing. An idle stream holds credit it has not used; downloads the server
+// has ended and the client has not read fill the rest of the limit; the
+// client lowers its initial window to just what the idle stream was
+// forwarded. It returns the harness and what lies unread.
+func nothingShown(t *testing.T) (h *flowHarness, unread int64) {
+	t.Helper()
+	const limit = 1 << 20
+	h = openStreams(t, limit, 4<<20, 0)
+	t.Cleanup(func() { h.c.Close() })
+	goClientStart(t, h)
+	h.openRequest(3) // stays idle
+	idle := h.c.streams[3].downForwarded
+	for id := uint32(5); id <= 15; id += 2 {
+		h.openRequest(id)
+		n := h.toServer.streams[id]
+		h.fromServer(func(fr *http2.Framer) {
+			writeDataSplit(fr, id, int(n))
+			fr.WriteData(id, true, nil)
+		})
+		unread += n
+	}
+	// One more download opens at the full limit: it has its frame, shown.
+	h.openRequest(waitingStream)
+	if got := h.toServer.streams[waitingStream]; got != flowShownLimited {
+		t.Fatalf("a stream opened at the full limit with %d, want a frame, %d", got, flowShownLimited)
+	}
+	h.fromClient(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: uint32(idle)})
+	})
+	if h.readErr != nil || h.c.clientShown != 0 {
+		t.Fatalf("after a lowering to the %d forwarded: error %v, stack shown %d, want none and 0", idle, h.readErr, h.c.clientShown)
+	}
+	if h.c.clientHolds() < limit {
+		t.Fatalf("the client holds %d, want the limit %d used up", h.c.clientHolds(), limit)
+	}
+	return h, unread
+}
+
+// waitingStream is the download nothingShown leaves open and unused at the
+// full limit, besides the idle one.
+const waitingStream = 101
+
+// lateStream is a download opened after nothingShown; a client's stream
+// numbers only go up.
+const lateStream = waitingStream + 2
+
+// TestFlowSendWindowLoweringKeepsFrame looks at a stream that was open when
+// the stack came to be shown nothing. It held one frame of window, all of it
+// shown; the lowering took that from the stack, the client holds nothing of
+// the stream and so owes it no credit, and nothing would look at it again.
+// It is forwarded the frame with the SETTINGS frame that took it.
+func TestFlowSendWindowLoweringKeepsFrame(t *testing.T) {
+	h, _ := nothingShown(t)
+	s := h.c.streams[waitingStream]
+	if got := h.toServer.streams[waitingStream]; got != flowShownLimited || s.downForwarded != flowShownLimited {
+		t.Fatalf("with nothing shown the waiting stream may send %d, %d of it forwarded; want a frame, %d, all forwarded",
+			got, s.downForwarded, flowShownLimited)
+	}
+}
+
+// openRequest opens a download on id.
+func (h *flowHarness) openRequest(id uint32) {
+	h.fromClient(func(fr *http2.Framer) {
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: id, BlockFragment: []byte{0x82}, EndHeaders: true, EndStream: true})
+	})
+}
+
+// TestFlowSendWindowFrameWhateverShown opens a download at a full limit with
+// the stack shown nothing. The stream has a frame of window all the same, by
+// credit: with none it sent nothing that would bring credit of its own, and
+// with less than a Go client returns credit for it sent that once, and stayed
+// there when the limit freed, whether the client or the server freed it. With
+// a frame it goes on as its reader reads, a frame at a time while the limit
+// is full.
+func TestFlowSendWindowFrameWhateverShown(t *testing.T) {
+	h, _ := nothingShown(t)
+	h.openRequest(lateStream)
+	sent := int64(0)
+	for turn := 0; turn < 8; turn++ {
+		window := h.toServer.streams[lateStream] - sent
+		if window != flowShownLimited {
+			t.Fatalf("turn %d: the new stream may send %d at a full limit with nothing shown, want a frame, %d", turn, window, flowShownLimited)
+		}
+		h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, lateStream, int(window)) })
+		sent += window
+		h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(lateStream, uint32(window)) })
+	}
+}
+
+// TestFlowSendWindowServerFreesRoom is the same connection when the server
+// ends the idle stream, by END_STREAM or by RST_STREAM, and the client sends
+// nothing: it waits for the new stream's answer. The stream needs no frame
+// from the client to have a window.
+func TestFlowSendWindowServerFreesRoom(t *testing.T) {
+	for _, reset := range []bool{false, true} {
+		t.Run(map[bool]string{false: "END_STREAM", true: "RST_STREAM"}[reset], func(t *testing.T) {
+			h, _ := nothingShown(t)
+			h.openRequest(lateStream)
+			h.fromServer(func(fr *http2.Framer) {
+				if reset {
+					fr.WriteRSTStream(3, http2.ErrCodeCancel)
+				} else {
+					fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 3, BlockFragment: []byte{0x88}, EndHeaders: true, EndStream: true})
+				}
+			})
+			if got := h.toServer.streams[lateStream]; got < flowShownLimited {
+				t.Fatalf("the new stream may send %d and the client owes no frame, want at least %d", got, flowShownLimited)
+			}
+		})
+	}
+}
+
+// stuckAtLimit opens twenty downloads on a connection with the default limit,
+// lets the server use all its window and runs the guard as if every stream
+// had waited it out. With creditFirst the client returns 4 KiB before that.
+func stuckAtLimit(t *testing.T, creditFirst bool) *flowHarness {
+	t.Helper()
+	h := openStreams(t, flowServerSendWindow, 4<<20, 20)
+	t.Cleanup(func() { h.c.Close() })
+	for id := uint32(1); id < 40; id += 2 {
+		n := h.toServer.streams[id]
+		h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, id, int(n)) })
+		h.toServer.streams[id] -= n
+	}
+	if creditFirst {
+		h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(1, 4<<10) })
+	}
+	h.c.mu.Lock()
+	if h.c.guard != nil {
+		h.c.guard.Stop()
+	}
+	out := h.c.unstick(time.Now().Add(time.Hour), nil)
+	h.c.mu.Unlock()
+	h.toServer.receive(t, out)
+	return h
+}
+
+// TestFlowGuardLiftsSendWindow has a client that returns no credit until half
+// of its window is read. At the limit twenty streams share 4 MiB and none
+// reaches that half, so the client would never credit and the downloads would
+// stop for good. The guard lifts the limit on such a connection.
+func TestFlowGuardLiftsSendWindow(t *testing.T) {
+	h := stuckAtLimit(t, false)
+	if h.c.sendWindow != 0 {
+		t.Fatalf("the guard left the limit at %d on a client that has returned no credit", h.c.sendWindow)
+	}
+	for id, w := range h.toServer.streams {
+		if all := h.c.streams[id].downSent + w; all < 2<<20 {
+			t.Fatalf("stream %d may be sent %d in all, under half of the client's window: it will never credit", id, all)
+		}
+	}
+}
+
+// TestFlowGuardKeepsSendWindow is the same connection once the client has
+// returned 4 KiB: it credits as it reads, so it cannot be stuck for want of
+// its half, and the limit stays.
+func TestFlowGuardKeepsSendWindow(t *testing.T) {
+	h := stuckAtLimit(t, true)
+	if h.c.sendWindow != flowServerSendWindow {
+		t.Fatalf("the limit is %d after the guard, want %d", h.c.sendWindow, flowServerSendWindow)
+	}
+	total := int64(0)
+	for _, w := range h.toServer.streams {
+		total += w
+	}
+	if total > 8<<10 {
+		t.Fatalf("the guard handed out %d on a connection at its limit", total)
+	}
+}
+
+// TestFlowGuardLiftIsForGood fixes how far the guard's lift goes. One
+// download, far under the limit: the server uses its window, and the reader
+// has taken less than a Go client returns at once, so no credit has come.
+// The guard cannot tell that from a client waiting for half of its window,
+// and lifts the limit with the client holding half of it. When the reader
+// goes on and credit comes in small steps, the limit does not come back: one
+// stream returning small credit does not show that the others do.
+func TestFlowGuardLiftIsForGood(t *testing.T) {
+	h := openStreams(t, flowServerSendWindow, 4<<20, 1)
+	t.Cleanup(func() { h.c.Close() })
+	n := h.toServer.streams[1]
+	h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, 1, int(n)) })
+	h.c.mu.Lock()
+	if h.c.guard != nil {
+		h.c.guard.Stop()
+	}
+	out := h.c.unstick(time.Now().Add(time.Hour), nil)
+	holds, lifted := h.c.clientHolds(), h.c.sendWindow == 0
+	h.c.mu.Unlock()
+	h.toServer.receive(t, out)
+	if !lifted || holds >= flowServerSendWindow {
+		t.Fatalf("after the guard: limit lifted %v with the client holding %d of %d", lifted, holds, flowServerSendWindow)
+	}
+	h.fromClient(func(fr *http2.Framer) {
+		fr.WriteWindowUpdate(1, 8<<10)
+		fr.WriteWindowUpdate(0, 8<<10)
+	})
+	if !h.c.incremental || h.c.sendWindow != 0 {
+		t.Fatalf("after 8 KiB of credit: small steps seen %v, limit %d, want true and 0", h.c.incremental, h.c.sendWindow)
+	}
+}
+
+// feedFrames passes frame from the client through the governor n times.
+func feedFrames(tb testing.TB, h *flowHarness, frame []byte, n int) {
+	buf := make([]byte, 64<<10)
+	for i := 0; i < n; i++ {
+		h.conn.feed(frame)
+		for {
+			if _, err := h.c.Read(buf); err != nil {
+				if !errors.Is(err, os.ErrDeadlineExceeded) {
+					tb.Fatal(err)
+				}
+				break
+			}
+		}
+		h.conn.take()
+	}
+}
+
+// TestFlowSendWindowSettingsCost times SETTINGS frames on connections with
+// two hundred and two thousand streams past the limit. A SETTINGS frame looks
+// at every stream once, so ten times the streams may cost ten times as much;
+// when each look walked all the streams again it cost a hundred times.
+//
+// The number of frames is found first: doubled until two hundred streams
+// take long enough for the clock to tell, which on Windows is milliseconds.
+func TestFlowSendWindowSettingsCost(t *testing.T) {
+	const enough, mostFrames = 2 * time.Millisecond, 1 << 16
+	settings := frames(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20})
+	})
+	connection := func(streams int) *flowHarness {
+		h := openStreams(t, flowServerSendWindow, 4<<20, streams)
+		t.Cleanup(func() { h.c.Close() })
+		return h
+	}
+	cost := func(h *flowHarness, n int) time.Duration {
+		best := time.Duration(math.MaxInt64)
+		for try := 0; try < 5; try++ {
+			start := time.Now()
+			feedFrames(t, h, settings, n)
+			best = min(best, time.Since(start))
+		}
+		return best
+	}
+	hFew, hMany := connection(200), connection(2000)
+	n := 50
+	few := cost(hFew, n)
+	for few < enough && n < mostFrames {
+		n = min(2*n, mostFrames)
+		few = cost(hFew, n)
+	}
+	if few < enough {
+		t.Fatalf("%d SETTINGS frames with 200 streams read as %v: the clock cannot time them", n, few)
+	}
+	many := cost(hMany, n)
+	t.Logf("%d SETTINGS frames: %v with 200 streams, %v with 2000", n, few, many)
+	if many > 40*few {
+		t.Fatalf("ten times the streams made a SETTINGS frame %d times dearer", many/few)
+	}
+}
+
+// refusedAtFullLimit stages a connection at a full limit where every credit
+// from the client frees less than a frame: n streams the limit kept credit
+// from, at a slow reader's cap and with a frame of window each, and
+// completed bodies the client holds and returns 4 KiB of at a time. It
+// returns the connection and where its connection window stood, to put back
+// before each frame.
+func refusedAtFullLimit(tb testing.TB, n int) (c *flowConn, window int64) {
+	tb.Helper()
+	c = newFlowConn(&scriptConn{}, flowDefault, flowDefault)
+	tb.Cleanup(func() { c.Close() })
+	c.sendWindow = flowServerSendWindow
+	c.readFrames([]byte(h2Preface), nil)
+	c.readFrames(frames(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20})
+		for i := 0; i < n+32; i++ {
+			fr.WriteHeaders(http2.HeadersFrameParam{StreamID: uint32(2*i + 1), BlockFragment: []byte{0x82}, EndHeaders: true, EndStream: true})
+		}
+	}), nil)
+	// The streams that took the limit complete; the ones it kept credit
+	// from stay open, at a slow reader's cap.
+	for id, s := range c.streams {
+		if s.downForwarded > 0 {
+			c.drop(id)
+			continue
+		}
+		s.down.cap = h2InitWindow
+	}
+	if len(c.streams) < n {
+		tb.Fatalf("%d streams were kept credit from, want at least %d", len(c.streams), n)
+	}
+	// What the client holds of the completed bodies leaves no room.
+	held := c.downOpen*int64(c.clientShown) + c.downOpenForwarded
+	c.downConnHigh = 1 << 30
+	c.downConnWindow = c.downConnHigh - max(flowServerSendWindow-held, 0)
+	c.downConnSmall = true
+	c.lastPing = time.Now()
+	if c.clientHolds() < flowServerSendWindow {
+		tb.Fatalf("the client holds %d, want the limit %d used up", c.clientHolds(), flowServerSendWindow)
+	}
+	return c, c.downConnWindow
+}
+
+// TestFlowSendWindowConnectionCreditAllocs counts what a connection
+// WINDOW_UPDATE of 4 KiB allocates on that connection, with sixty streams
+// open. Such a frame looks at no stream and allocates nothing; a walk over
+// the streams after every frame from the client would allocate once a frame.
+// The count does not depend on the clock; BenchmarkFlowConnectionCredit has
+// the time, which a walk that allocated nothing would show only there.
+func TestFlowSendWindowConnectionCreditAllocs(t *testing.T) {
+	credit := frames(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, 4<<10) })
+	c, window := refusedAtFullLimit(t, 60)
+	// The state under test: room for the credit, and under a frame.
+	c.downConnWindow = window + 4<<10
+	if room := flowServerSendWindow - c.clientHolds(); room <= 0 || room >= h2MinMaxFrameSize {
+		t.Fatalf("a credit leaves %d of room, want some and under a frame, %d", room, h2MinMaxFrameSize)
+	}
+	out := make([]byte, 0, 64)
+	allocs := testing.AllocsPerRun(1000, func() {
+		c.downConnWindow = window
+		out = c.readFrames(credit, out[:0])
+	})
+	if allocs != 0 {
+		t.Fatalf("connection credit allocated %g times a frame, want none", allocs)
+	}
+}
+
+// BenchmarkFlowConnectionCredit is the cost of that frame.
+func BenchmarkFlowConnectionCredit(b *testing.B) {
+	credit := frames(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, 4<<10) })
+	for _, n := range []int{60, 240} {
+		b.Run(fmt.Sprintf("streams=%d", n), func(b *testing.B) {
+			c, window := refusedAtFullLimit(b, n)
+			out := make([]byte, 0, 64)
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				c.downConnWindow = window
+				out = c.readFrames(credit, out[:0])
+			}
+		})
+	}
+}
+
+// BenchmarkFlowClientFrame is the cost of one frame from the client on a
+// server connection with many streams open, with and without the limit.
+func BenchmarkFlowClientFrame(b *testing.B) {
+	for _, kind := range []string{"settings", "windowupdate"} {
+		for _, n := range []int{100, 1000} {
+			for _, sendWindow := range []int64{0, flowServerSendWindow} {
+				b.Run(fmt.Sprintf("%s/streams=%d/sendWindow=%d", kind, n, sendWindow), func(b *testing.B) {
+					sc := &scriptConn{}
+					h := &flowHarness{t: b, conn: sc, c: newFlowConn(sc, flowDefault, flowDefault)}
+					h.fromClientRaw([]byte(h2Preface))
+					h.c.sendWindow = sendWindow
+					h.fromClient(func(fr *http2.Framer) {
+						fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20})
+					})
+					for i := 0; i < n; i++ {
+						h.fromClient(func(fr *http2.Framer) {
+							fr.WriteHeaders(http2.HeadersFrameParam{StreamID: uint32(2*i + 1), BlockFragment: []byte{0x82}, EndHeaders: true})
+						})
+					}
+					frame := frames(func(fr *http2.Framer) {
+						if kind == "settings" {
+							fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20})
+						} else {
+							fr.WriteWindowUpdate(uint32(2*n-1), 1)
+						}
+					})
+					b.ResetTimer()
+					feedFrames(b, h, frame, b.N)
+				})
+			}
+		}
+	}
+}
+
+// TestH2SendWindow checks what "maxConnectionSendWindow" means.
+func TestH2SendWindow(t *testing.T) {
+	for _, tc := range []struct {
+		set  int32
+		want int64
+	}{{0, flowServerSendWindow}, {-1, 0}, {8 << 20, 8 << 20}} {
+		c := &Config{H2Flow: &H2FlowConfig{Mode: 1, MaxConnectionSendWindow: tc.set}}
+		if got := c.h2SendWindow(); got != tc.want {
+			t.Errorf("maxConnectionSendWindow %d: limit %d, want %d", tc.set, got, tc.want)
+		}
+	}
+	if got := (&Config{}).h2SendWindow(); got != flowServerSendWindow {
+		t.Errorf("no h2Flow: limit %d, want %d", got, flowServerSendWindow)
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_settled_test.go b/transport/internet/splithttp/h2flow_settled_test.go
new file mode 100644
index 00000000..0ea1831e
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_settled_test.go
@@ -0,0 +1,121 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// vouchedPath makes c take the kernel's word for a round trip of 50 ms, as a
+// connection on Linux does once TCP_INFO agrees with its PINGs: the state in
+// which a window may follow the path model. The kernel is not asked again
+// for the length of a test.
+func vouchedPath(c *flowConn) {
+	const rtt = 50 * time.Millisecond
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.tcp, c.kAt, c.kOK = fakeRawConn{}, time.Now().Add(time.Hour), true
+	c.kstat = tcpStats{rtt: rtt, minRTT: rtt}
+	c.rttBase = rtt
+}
+
+// lowRoundBehind puts w where a stream is after one round trip that read low
+// at its start: ramped, since that round was not above the one before, with
+// steady flat rounds since, a small round to go by, and a round trip that
+// ends with the next credit.
+func lowRoundBehind(w *flowWindow, steady int) {
+	w.ramped, w.flat, w.steady = true, steady, steady
+	w.prev, w.measured = 8<<10, true
+	w.mark, w.markBase = time.Now().Add(-time.Second), w.returned
+}
+
+// TestFlowUploadFollowsModelOnceSettled is a server whose kernel vouches for
+// the path, and an upload one low round into its start. Its window stays
+// where it started: the path model, which would have that one small round to
+// go by, is not asked yet. After a second such round it is, and the window
+// goes where the model puts it.
+func TestFlowUploadFollowsModelOnceSettled(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		flat    int
+		modeled bool
+	}{
+		{"one flat round", flowSettledRounds - 1, false},
+		{"settled", flowSettledRounds, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			const id = 1
+			h := newFlowHarness(t)
+			t.Cleanup(func() { h.c.Close() })
+			h.track()
+			h.openStream(4 << 20)
+			// Connection credit, so the client may send the upload.
+			h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, 8<<20) })
+			h.fromClient(func(fr *http2.Framer) { writeDataSplit(fr, id, 200<<10) })
+			vouchedPath(h.c)
+			h.c.mu.Lock()
+			s := h.c.streams[id]
+			start := s.up.cap
+			lowRoundBehind(&s.up, tc.flat)
+			h.c.mu.Unlock()
+			if start != flowStartWindow {
+				t.Fatalf("the upload starts with a cap of %d, want %d", start, flowStartWindow)
+			}
+			h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(id, 4<<10) })
+			h.c.mu.Lock()
+			got, floor := s.up.cap, h.c.up.init
+			h.c.mu.Unlock()
+			if tc.modeled && got != floor {
+				t.Fatalf("a settled upload has a cap of %d, want the %d the path model gives a reader this slow", got, floor)
+			}
+			if !tc.modeled && got != start {
+				t.Fatalf("one low round took the cap from %d to %d: the window follows the path model before its reader has settled", start, got)
+			}
+		})
+	}
+}
+
+// TestFlowClientDownloadFollowsModelOnceSettled is the same for a governed
+// client's download, the window that follows the model on that side.
+func TestFlowClientDownloadFollowsModelOnceSettled(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		flat    int
+		modeled bool
+	}{
+		{"one flat round", flowSettledRounds - 1, false},
+		{"settled", flowSettledRounds, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			const id = 1
+			ch := newChain(t, 0)
+			ch.start()
+			ch.open(id)
+			if sent := ch.sendAll(id); sent == 0 {
+				t.Fatal("the server sent nothing")
+			}
+			vouchedPath(ch.cg)
+			ch.cg.mu.Lock()
+			// The model is for a server that does not govern: the chain's
+			// does, and the client would leave the window to it.
+			ch.cg.peerGoverned = false
+			s := ch.cg.streams[id]
+			start := s.down.cap
+			lowRoundBehind(&s.down, tc.flat)
+			ch.cg.mu.Unlock()
+			if _, err := ch.cg.Write(frames(func(fr *http2.Framer) { fr.WriteWindowUpdate(id, 4<<10) })); err != nil {
+				t.Fatal(err)
+			}
+			ch.cg.mu.Lock()
+			got, floor := s.down.cap, ch.cg.down.init
+			ch.cg.mu.Unlock()
+			if tc.modeled && got != floor {
+				t.Fatalf("a settled download has a cap of %d, want the %d the path model gives a reader this slow", got, floor)
+			}
+			if !tc.modeled && got < start {
+				t.Fatalf("one low round took the cap from %d to %d: the window follows the path model before its reader has settled", start, got)
+			}
+		})
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_share_test.go b/transport/internet/splithttp/h2flow_share_test.go
new file mode 100644
index 00000000..95c90a7a
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_share_test.go
@@ -0,0 +1,37 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+)
+
+// TestFlowPIStepsUpAtShare has two downloads of one connection under the
+// setpoint, one taking four times what the other does: at the connection's
+// share both grow by the same bytes, where each growing by its own rate keeps
+// the split. Over the setpoint each still shrinks by its own rate, as without
+// a share.
+func TestFlowPIStepsUpAtShare(t *testing.T) {
+	ms := time.Millisecond
+	now := time.Unix(1e6, 0)
+	pi := func(cap int32, copied int64, rtt time.Duration, share float64) int32 {
+		w := flowWindow{cap: cap, mark: now.Add(-110 * ms), returned: copied}
+		w.pi(now, tcpStats{rtt: rtt, minRTT: 100 * ms}, h2InitWindow, 1<<30, 1, share)
+		return w.cap - cap
+	}
+	share := (300e3 + 1200e3) / 2 / 0.11
+	small, large := pi(1<<20, 300e3, 110*ms, share), pi(4<<20, 1200e3, 110*ms, share)
+	if small <= 0 || small != large {
+		t.Fatalf("under the setpoint at share %.0f B/s the downloads grew by %d and %d", share, small, large)
+	}
+	if own := pi(1<<20, 300e3, 110*ms, 0); own >= small {
+		t.Fatalf("the smaller download grew by %d at its own rate, %d at the share", own, small)
+	}
+	for _, d := range []struct {
+		cap    int32
+		copied int64
+	}{{1 << 20, 300e3}, {4 << 20, 1200e3}} {
+		if got, want := pi(d.cap, d.copied, 160*ms, share), pi(d.cap, d.copied, 160*ms, 0); got != want || got >= 0 {
+			t.Fatalf("over the setpoint a cap of %d moved by %d at the share, %d at its own rate", d.cap, got, want)
+		}
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_shown_test.go b/transport/internet/splithttp/h2flow_shown_test.go
new file mode 100644
index 00000000..b51596c9
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_shown_test.go
@@ -0,0 +1,145 @@
+package splithttp
+
+import (
+	"encoding/binary"
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// TestFlowClientPastShownWindow sends upload data up to the windows the
+// client was shown, which the server takes, and then a byte more, which a
+// stack shown those windows answers as the stock one does: past the stream's
+// window the stream is reset with FLOW_CONTROL_ERROR, to the stack and to the
+// client, and another stream goes on; past the connection's the connection
+// ends. The server's stack is given larger windows than the client is shown,
+// so without the governor's check a client could leave it several times as
+// much unread.
+func TestFlowClientPastShownWindow(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		connCredit uint32
+		streamCred uint32
+		// wideConn shows the client more of the connection than any stream
+		// holds, so that the stream's window is the one it sends past.
+		wideConn bool
+	}{
+		{"no credit", 0, 0, false},
+		{"connection credit", 8 << 20, 0, false},
+		{"stream and connection credit", 8 << 20, 4 << 20, false},
+		{"connection window over the stream's", 8 << 20, 0, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			h := newFlowHarness(t)
+			t.Cleanup(func() { h.c.Close() })
+			h.track()
+			h.openStream(4 << 20)
+			h.toClient.open(1)
+			h.fromServer(func(fr *http2.Framer) {
+				if tc.connCredit > 0 {
+					fr.WriteWindowUpdate(0, tc.connCredit)
+				}
+				if tc.streamCred > 0 {
+					fr.WriteWindowUpdate(1, tc.streamCred)
+				}
+			})
+			conn := int64(h2InitWindow)
+			for _, f := range h.toClient.frames {
+				if wu, ok := f.(*http2.WindowUpdateFrame); ok && wu.StreamID == 0 {
+					conn += int64(wu.Increment)
+				}
+			}
+			if tc.wideConn {
+				h.c.mu.Lock()
+				h.c.upConnForwarded += 8 << 20
+				h.c.mu.Unlock()
+				conn += 8 << 20
+			}
+			shown := min(conn, h.toClient.streams[1])
+			h.fromClient(func(fr *http2.Framer) { writeDataSplit(fr, 1, int(shown)) })
+			if h.readErr != nil || h.c.isBroken() {
+				t.Fatalf("data within the %d shown ended the connection: %v", shown, h.readErr)
+			}
+			h.conn.take()
+			h.c.mu.Lock()
+			unread := h.c.upConnSent - h.c.upConnReturned
+			h.c.mu.Unlock()
+			got := h.fromClient(func(fr *http2.Framer) { fr.WriteData(1, false, []byte{0}) })
+			if h.toClient.streams[1] >= conn {
+				if h.readErr == nil || !h.c.isBroken() {
+					t.Fatalf("a byte past the connection's %d shown was taken", shown)
+				}
+				return
+			}
+			if h.readErr != nil || h.c.isBroken() {
+				t.Fatalf("a byte past stream 1's %d shown ended the connection: %v", shown, h.readErr)
+			}
+			if !hasReset(t, got, 1) {
+				t.Fatal("the stack was not told stream 1 was reset")
+			}
+			// Of the frame past the window the stack takes nothing into the
+			// body, and the connection counts it returned, as a stack that
+			// refused it returns its connection credit.
+			if d := dataFrames(got); len(d) != 0 {
+				t.Fatalf("%d bytes of the frame past stream 1's window reached the stack", len(d)-4)
+			}
+			h.c.mu.Lock()
+			after := h.c.upConnSent - h.c.upConnReturned
+			h.c.mu.Unlock()
+			if after != unread {
+				t.Fatalf("the refused frame left %d bytes unread on the connection", after-unread)
+			}
+			h.sync()
+			if !hasReset(t, h.conn.take(), 1) {
+				t.Fatal("the client was not told stream 1 was reset")
+			}
+			// Another stream is still usable.
+			got = h.fromClient(func(fr *http2.Framer) {
+				fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 3, BlockFragment: []byte{0x82}, EndHeaders: true})
+				fr.WriteData(3, false, make([]byte, 100))
+			})
+			if h.readErr != nil || h.c.isBroken() || len(dataFrames(got)) != 4+100 {
+				t.Fatalf("stream 3 after the reset: %d bytes of data reached the stack, error %v", len(dataFrames(got)), h.readErr)
+			}
+		})
+	}
+}
+
+// TestFlowWindowHugeCredit hands a window more credit in a round than a
+// reader could take, as a hostile client may: the cap grows to its limit
+// and stays there, where products of such rounds wrapped to a cap at init.
+func TestFlowWindowHugeCredit(t *testing.T) {
+	const limit = 1 << 30
+	start := time.Unix(1, 0)
+	var w flowWindow
+	w.cap = flowStartWindow
+	now := start
+	w.adjust(now, 50*time.Millisecond, h2InitWindow, limit, true, false)
+	w.returned += 1 << 20
+	now = now.Add(60 * time.Millisecond)
+	w.adjust(now, 50*time.Millisecond, h2InitWindow, limit, true, false)
+	w.returned += 1 << 34
+	now = now.Add(60 * time.Millisecond)
+	w.adjust(now, 50*time.Millisecond, h2InitWindow, limit, true, false)
+	if w.cap != limit {
+		t.Fatalf("adjust: cap %d after a round of 2^34, want the limit %d", w.cap, limit)
+	}
+	w.returned += 1 << 40
+	now = now.Add(60 * time.Millisecond)
+	w.model(now, 50*time.Millisecond, h2InitWindow, limit, 1)
+	if w.cap != limit {
+		t.Fatalf("model: cap %d after a round of 2^40, want the limit %d", w.cap, limit)
+	}
+}
+
+// hasReset reports whether b carries an RST_STREAM with FLOW_CONTROL_ERROR
+// for id.
+func hasReset(t *testing.T, b []byte, id uint32) bool {
+	for _, f := range rawFrames(t, b) {
+		if f.typ == h2RSTStream && f.stream == id && len(f.payload) == 4 && binary.BigEndian.Uint32(f.payload) == h2ErrFlowControl {
+			return true
+		}
+	}
+	return false
+}
diff --git a/transport/internet/splithttp/h2flow_shrink_test.go b/transport/internet/splithttp/h2flow_shrink_test.go
new file mode 100644
index 00000000..6b900758
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_shrink_test.go
@@ -0,0 +1,79 @@
+package splithttp
+
+import (
+	"net/http"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// TestFlowWindowShrinks reads fast until the window has grown, then slowly, as
+// a video player does once its buffer is full: the window must come back
+// down instead of keeping a slow reader's unread data at the fast size.
+func TestFlowWindowShrinks(t *testing.T) {
+	if testing.Short() {
+		t.Skip("slow")
+	}
+	for _, role := range []string{"server", "client"} {
+		up, down := testUp, testDown
+		if role == "client" {
+			up, down = flowLimit{}, flowLimit{}
+		}
+		tl, addr := startFlowServer(t, up, down, false, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			buf := make([]byte, 16<<10)
+			for {
+				if _, err := w.Write(buf); err != nil {
+					return
+				}
+			}
+		}))
+		proxy := lagProxy(t, addr, 20*time.Millisecond)
+		var get func(string) (*http.Response, error)
+		var client *flowClient
+		if role == "client" {
+			client = newFlowTestClient(t, proxy, true)
+			get = client.Get
+		} else {
+			get = h2Client(proxy).Get
+		}
+		resp, err := get("http://x/down")
+		if err != nil {
+			t.Fatal(err)
+		}
+		state := func() (unread int64, cap int32) {
+			f := func(c *flowConn) {
+				for _, s := range c.streams {
+					unread, cap = max(unread, s.downSent-s.down.returned), max(cap, s.down.cap)
+				}
+			}
+			if client != nil {
+				client.each(f)
+			} else {
+				tl.each(f)
+			}
+			return
+		}
+		deadline := time.Now().Add(2 * time.Second)
+		buf := make([]byte, 64<<10)
+		for time.Now().Before(deadline) {
+			if _, err := resp.Body.Read(buf); err != nil {
+				t.Fatal(err)
+			}
+		}
+		fastUnread, fastCap := state()
+		var consumed atomic.Int64
+		stop := make(chan struct{})
+		go slowCopy(resp.Body, 1<<20, &consumed, stop)
+		time.Sleep(8 * time.Second)
+		slowUnread, slowCap := state()
+		close(stop)
+		resp.Body.Close()
+		t.Logf("%s: after the fast phase cap %d unread %d; after the slow phase cap %d unread %d", role, fastCap, fastUnread, slowCap, slowUnread)
+		if fastCap < 1<<20 {
+			t.Fatalf("%s: the window did not grow in the fast phase (%d)", role, fastCap)
+		}
+		if slowCap > 256<<10 || slowUnread > 256<<10 {
+			t.Fatalf("%s: the window stayed at %d with %d unread after slowing down", role, slowCap, slowUnread)
+		}
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_tcpinfo_linux.go b/transport/internet/splithttp/h2flow_tcpinfo_linux.go
new file mode 100644
index 00000000..29f31653
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_tcpinfo_linux.go
@@ -0,0 +1,74 @@
+//go:build linux
+
+package splithttp
+
+import (
+	"net"
+	"reflect"
+	"syscall"
+	"time"
+
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"golang.org/x/sys/unix"
+)
+
+func rawTCP(c net.Conn) syscall.RawConn {
+	for range 8 {
+		switch v := c.(type) {
+		case *net.TCPConn:
+			rc, err := v.SyscallConn()
+			if err != nil {
+				return nil
+			}
+			return rc
+		case *stat.CounterConnection:
+			c = v.Connection
+		case interface{ NetConn() net.Conn }:
+			c = v.NetConn()
+		case interface{ Raw() net.Conn }:
+			c = v.Raw()
+		default:
+			if c = embeddedConn(c); c == nil {
+				return nil
+			}
+		}
+	}
+	return nil
+}
+
+// embeddedConn is the net.Conn a wrapper embeds, such as finalmask's, which
+// offer no NetConn: the kernel's view of the TCP socket under a mask is still
+// that connection's round trip and what it has in flight.
+func embeddedConn(c net.Conn) net.Conn {
+	v := reflect.ValueOf(c)
+	if v.Kind() == reflect.Pointer {
+		v = v.Elem()
+	}
+	if v.Kind() != reflect.Struct {
+		return nil
+	}
+	f := v.FieldByName("Conn")
+	if !f.IsValid() || !f.CanInterface() {
+		return nil
+	}
+	inner, _ := f.Interface().(net.Conn)
+	return inner
+}
+
+func readTCPStats(rc syscall.RawConn) (s tcpStats, ok bool) {
+	if rc == nil {
+		return
+	}
+	rc.Control(func(fd uintptr) {
+		info, err := unix.GetsockoptTCPInfo(int(fd), unix.IPPROTO_TCP, unix.TCP_INFO)
+		if err != nil {
+			return
+		}
+		s.rtt = time.Duration(info.Rtt) * time.Microsecond
+		s.minRTT = time.Duration(info.Min_rtt) * time.Microsecond
+		s.rttVar = time.Duration(info.Rttvar) * time.Microsecond
+		s.inFlight = int64(info.Unacked) * int64(info.Snd_mss)
+		ok = s.rtt > 0
+	})
+	return
+}
diff --git a/transport/internet/splithttp/h2flow_tcpinfo_linux_test.go b/transport/internet/splithttp/h2flow_tcpinfo_linux_test.go
new file mode 100644
index 00000000..dfe7c316
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_tcpinfo_linux_test.go
@@ -0,0 +1,131 @@
+//go:build linux
+
+package splithttp
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	gotls "crypto/tls"
+	"crypto/x509"
+	"math/big"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/pires/go-proxyproto"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+func testCert(t *testing.T) gotls.Certificate {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tpl := &x509.Certificate{SerialNumber: big.NewInt(1), NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour)}
+	der, err := x509.CreateCertificate(rand.Reader, tpl, tpl, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return gotls.Certificate{Certificate: [][]byte{der}, PrivateKey: key}
+}
+
+// TestFlowTCPStats checks that the kernel TCP stats are reachable through the
+// wrappers an XHTTP connection really has: TLS, PROXY protocol and stats.
+func TestFlowTCPStats(t *testing.T) {
+	cert := testCert(t)
+	for _, tc := range []struct {
+		name  string
+		proxy bool
+		stats bool
+	}{{"tls", false, false}, {"proxy+tls", true, false}, {"stats+tls", false, true}} {
+		t.Run(tc.name, func(t *testing.T) {
+			ln, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer ln.Close()
+			var l net.Listener = ln
+			if tc.proxy {
+				l = &proxyproto.Listener{Listener: ln}
+			}
+			got := make(chan net.Conn, 1)
+			go func() {
+				c, err := l.Accept()
+				if err != nil {
+					got <- nil
+					return
+				}
+				if tc.stats {
+					c = &stat.CounterConnection{Connection: c}
+				}
+				s := gotls.Server(c, &gotls.Config{Certificates: []gotls.Certificate{cert}})
+				if s.Handshake() != nil {
+					got <- nil
+					return
+				}
+				got <- s
+			}()
+			c, err := net.Dial("tcp", ln.Addr().String())
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			if tc.proxy {
+				c.Write([]byte("PROXY TCP4 192.0.2.1 192.0.2.2 1111 2222\r\n"))
+			}
+			cl := gotls.Client(c, &gotls.Config{InsecureSkipVerify: true})
+			if err := cl.Handshake(); err != nil {
+				t.Fatal(err)
+			}
+			s := <-got
+			if s == nil {
+				t.Fatal("server handshake failed")
+			}
+			defer s.Close()
+			rc := rawTCP(s)
+			if rc == nil {
+				t.Fatal("no raw TCP socket under the connection")
+			}
+			st, ok := readTCPStats(rc)
+			if !ok || st.rtt <= 0 || st.minRTT <= 0 {
+				t.Fatalf("no TCP stats: %+v %v", st, ok)
+			}
+		})
+	}
+}
+
+// maskedConn wraps a connection the way finalmask's connections do: it
+// embeds it and offers no NetConn.
+type maskedConn struct {
+	net.Conn
+}
+
+// TestFlowRawTCPUnderMask finds the TCP socket under a wrapper that only
+// embeds it, as with finalmask, and under one that embeds such a wrapper.
+func TestFlowRawTCPUnderMask(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() {
+		if c, err := ln.Accept(); err == nil {
+			defer c.Close()
+			time.Sleep(time.Second)
+		}
+	}()
+	c, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	for _, w := range []net.Conn{&maskedConn{Conn: c}, &maskedConn{Conn: &maskedConn{Conn: c}}} {
+		if rawTCP(w) == nil {
+			t.Fatalf("no TCP socket found under %T", w)
+		}
+	}
+	if rawTCP(&maskedConn{}) != nil {
+		t.Fatal("a wrapper with no connection under it gave a socket")
+	}
+}
