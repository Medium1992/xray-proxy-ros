+// TestH2ConnWindowFollowsNetHTTP checks the connection window the governor
+// counts as granted against what net/http grants for the same setting.
+func TestH2ConnWindowFollowsNetHTTP(t *testing.T) {
+	for set, want := range map[int]int32{0: 1 << 20, 1000: 1 << 20, 65534: 1 << 20, 65535: 65535, 3 << 20: 3 << 20, 1 << 31: 1 << 20} {
+		if got := h2ConnWindow(&http.HTTP2Config{MaxReceiveBufferPerConnection: set}); got != want {
+			t.Errorf("MaxReceiveBufferPerConnection %d: counted %d, want %d", set, got, want)
+		}
+	}
+	if got := h2ConnWindow(nil); got != 1<<20 {
+		t.Errorf("no HTTP/2 config: counted %d, want %d", got, 1<<20)
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_conn_test.go b/transport/internet/splithttp/h2flow_conn_test.go
new file mode 100644
index 00000000..fc73ebac
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_conn_test.go
@@ -0,0 +1,176 @@
+package splithttp
+
+import (
+	"bytes"
+	"testing"
+
+	"golang.org/x/net/http2"
+)
+
+// connCredit sums the connection-level credit in frames read by the client.
+func connCredit(t *testing.T, b []byte) int64 {
+	t.Helper()
+	var n int64
+	fr := http2.NewFramer(nil, bytes.NewReader(b))
+	for {
+		f, err := fr.ReadFrame()
+		if err != nil {
+			return n
+		}
+		if w, ok := f.(*http2.WindowUpdateFrame); ok && w.StreamID == 0 {
+			n += int64(w.Increment)
+		}
+	}
+}
+
+// TestFlowUploadConnectionWindow checks the connection window the client is
+// shown for uploads: Go's 1 MiB while no reader has taken anything, whatever
+// the server grants, and room for the streams whose readers do take data on
+// top of that once they do, never beyond what the server really granted.
+func TestFlowUploadConnectionWindow(t *testing.T) {
+	const granted = 6 << 20
+	h := newFlowHarness(t)
+	h.openStream(4 << 20)
+	credit := connCredit(t, h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, granted-h2InitWindow) }))
+	sent, returned := int64(0), int64(granted-h2InitWindow)
+	shown := func() int64 { return h2InitWindow + credit - sent }
+	if got := shown(); got != flowConnFloor {
+		t.Fatalf("client shown a connection window of %d before any read, want %d", got, flowConnFloor)
+	}
+
+	const chunk = 200 << 10
+	h.fromClient(func(fr *http2.Framer) { writeDataSplit(fr, 1, chunk) })
+	sent += chunk
+	if got := shown(); got != flowConnFloor-chunk {
+		t.Fatalf("client shown %d after sending %d, want %d", got, chunk, flowConnFloor-chunk)
+	}
+
+	// The handler reads what came; its stream then may hold 4 MiB.
+	credit += connCredit(t, h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(1, chunk) }))
+	h.c.mu.Lock()
+	h.c.streams[1].up.cap = 4 << 20
+	h.c.mu.Unlock()
+	credit += connCredit(t, h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, chunk) }))
+	returned += chunk
+	if got, want := shown(), int64(flowConnFloor+4<<20); got != want {
+		t.Fatalf("client shown %d with a reader that keeps up, want %d", got, want)
+	}
+	if real := h2InitWindow + returned - sent; shown() > real {
+		t.Fatalf("client shown %d, server accepts %d", shown(), real)
+	}
+}
+
+// TestFlowSlowReaderLeavesConnectionRoom fills eight streams whose readers
+// are slow to their caps, together more than Go's 1 MiB: a new stream must
+// still get connection credit, or slow uploads would hold up every request
+// behind them on the connection.
+func TestFlowSlowReaderLeavesConnectionRoom(t *testing.T) {
+	h := newFlowHarness(t)
+	h.openStream(4 << 20)
+	credit := connCredit(t, h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, 6<<20-h2InitWindow) }))
+	var sent, held int64
+	for id := uint32(1); id <= 15; id += 2 {
+		if id > 1 {
+			h.fromClient(func(fr *http2.Framer) {
+				fr.WriteHeaders(http2.HeadersFrameParam{StreamID: id, BlockFragment: []byte{0x82}, EndHeaders: true})
+			})
+		}
+		// The reader takes a little, then stalls with its stream full.
+		h.fromClient(func(fr *http2.Framer) { writeDataSplit(fr, id, 16<<10) })
+		sent += 16 << 10
+		credit += connCredit(t, h.fromServer(func(fr *http2.Framer) {
+			fr.WriteWindowUpdate(id, 16<<10)
+			fr.WriteWindowUpdate(0, 16<<10)
+		}))
+		h.c.mu.Lock()
+		full := int64(h.c.streams[id].up.cap)
+		h.c.mu.Unlock()
+		h.fromClient(func(fr *http2.Framer) { writeDataSplit(fr, id, int(full)) })
+		sent += full
+		held += full
+	}
+	credit += connCredit(t, h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, 1) }))
+
+	if room := h2InitWindow + credit - sent; room < flowConnFloor/2 {
+		t.Fatalf("slow readers holding %d leave %d of connection window for new streams", held, room)
+	}
+}
+
+// TestFlowNoCreditAtStreamOpen checks the upload window a server shows: Go's
+// own 1 MiB, so the client gets no WINDOW_UPDATE the moment a stream opens.
+func TestFlowNoCreditAtStreamOpen(t *testing.T) {
+	h := newFlowHarness(t)
+	h.track()
+	h.fromClient(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20})
+	})
+	h.fromServer(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 6 << 20})
+	})
+	if h.toClient.init != flowShownUp {
+		t.Fatalf("server SETTINGS show %d, want Go's %d", h.toClient.init, flowShownUp)
+	}
+	before := len(h.toClient.frames)
+	h.fromClient(func(fr *http2.Framer) {
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: []byte{0x82}, EndHeaders: true})
+	})
+	h.sync()
+	h.toClient.receive(t, h.conn.take())
+	for _, f := range h.toClient.frames[before:] {
+		if w, ok := f.(*http2.WindowUpdateFrame); ok && w.StreamID == 1 {
+			t.Fatalf("client got %d of credit as stream 1 opened", w.Increment)
+		}
+	}
+}
+
+// TestFlowShrunkCapsLeaveConnectionRoom stalls sixteen readers with their
+// streams full and then lets their caps shrink, as they do while a reader
+// stays slow. What those streams already hold is theirs: it must not count
+// against the room other streams share, or a request opened meanwhile gets
+// no connection credit until the slow ones drain.
+func TestFlowShrunkCapsLeaveConnectionRoom(t *testing.T) {
+	h := newFlowHarness(t)
+	h.openStream(4 << 20)
+	credit := connCredit(t, h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, 6<<20-h2InitWindow) }))
+	var sent int64
+	for id := uint32(1); id <= 31; id += 2 {
+		if id > 1 {
+			h.fromClient(func(fr *http2.Framer) {
+				fr.WriteHeaders(http2.HeadersFrameParam{StreamID: id, BlockFragment: []byte{0x82}, EndHeaders: true})
+			})
+		}
+		h.fromClient(func(fr *http2.Framer) { writeDataSplit(fr, id, 16<<10) })
+		sent += 16 << 10
+		credit += connCredit(t, h.fromServer(func(fr *http2.Framer) {
+			fr.WriteWindowUpdate(id, 16<<10)
+			fr.WriteWindowUpdate(0, 16<<10)
+		}))
+		h.c.mu.Lock()
+		full := int64(h.c.streams[id].up.cap)
+		h.c.mu.Unlock()
+		h.fromClient(func(fr *http2.Framer) { writeDataSplit(fr, id, int(full)) })
+		sent += full
+	}
+	h.c.mu.Lock()
+	for _, s := range h.c.streams {
+		s.up.cap = h2InitWindow
+	}
+	h.c.mu.Unlock()
+
+	// Another request uploads 512 KiB twice; its handler reads each at once.
+	const id, chunk = 33, 512 << 10
+	h.fromClient(func(fr *http2.Framer) {
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: id, BlockFragment: []byte{0x82}, EndHeaders: true})
+	})
+	for range 2 {
+		h.fromClient(func(fr *http2.Framer) { writeDataSplit(fr, id, chunk) })
+		sent += chunk
+		credit += connCredit(t, h.fromServer(func(fr *http2.Framer) {
+			fr.WriteWindowUpdate(id, chunk)
+			fr.WriteWindowUpdate(0, chunk)
+		}))
+	}
+	if room := h2InitWindow + credit - sent; room < flowConnFloor/2 {
+		t.Fatalf("with the slow streams' caps shrunk, %d of connection window is left for the others", room)
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_credit_test.go b/transport/internet/splithttp/h2flow_credit_test.go
new file mode 100644
index 00000000..74172dfc
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_credit_test.go
@@ -0,0 +1,276 @@
+package splithttp
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// windowUpdates counts the WINDOW_UPDATE frames in b by stream and adds up
+// what they carry.
+func windowUpdates(t *testing.T, b []byte, count map[uint32]int, sum map[uint32]uint64) {
+	t.Helper()
+	fr := http2.NewFramer(nil, bytes.NewReader(b))
+	for {
+		f, err := fr.ReadFrame()
+		if errors.Is(err, io.EOF) {
+			return
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		if w, ok := f.(*http2.WindowUpdateFrame); ok {
+			count[w.StreamID]++
+			sum[w.StreamID] += uint64(w.Increment)
+		}
+	}
+}
+
+// rampStates are the two states of a stream's window that credit must not
+// depend on: its reader still speeding up, as every stream starts, and no
+// longer.
+var rampStates = []struct {
+	name   string
+	ramped bool
+}{
+	{"speeding up", false},
+	{"no longer speeding up", true},
+}
+
+// owesNothing fails the test if the governor still has upload credit for the
+// client that it could hand on now, for the stream or for the connection:
+// credit that goes on a round late adds up to the right sums from then on.
+func owesNothing(t *testing.T, h *flowHarness, id uint32) {
+	t.Helper()
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if rel := h.c.upRelease(h.c.streams[id]); rel > 0 {
+		t.Fatalf("%d bytes of stream credit are due and were not handed on", rel)
+	}
+	if rel := h.c.upConnRelease(); rel > 0 {
+		t.Fatalf("%d bytes of connection credit are due and were not handed on", rel)
+	}
+}
+
+// TestFlowUploadCreditNotHeld is the upload side of a server. The local
+// server returns an upload's credit 4 KiB at a time, and the client is handed
+// each piece as it comes, for the stream and for the connection, whether or
+// not the upload still speeds up. Go's server returns the connection's credit
+// before the stream's, and the governor then hands it on where it reads that
+// frame; returned after the stream's it goes on with the stream's. Both ways
+// are run. Credit quanta held such pieces back until 16 to 32 KiB had
+// gathered: 4 WINDOW_UPDATE frames for these 32, on either stream.
+func TestFlowUploadCreditNotHeld(t *testing.T) {
+	const id, piece, pieces = 1, 4 << 10, 32
+	for _, order := range []struct {
+		name  string
+		first uint32
+	}{
+		{"connection credit first", 0},
+		{"stream credit first", id},
+	} {
+		for _, state := range rampStates {
+			t.Run(order.name+", "+state.name, func(t *testing.T) {
+				h := newFlowHarness(t)
+				t.Cleanup(func() { h.c.Close() })
+				h.c.up.init = flowShownUp
+				h.c.up.max = flowShownUp // the cap stays where it starts
+				h.track()
+				h.openStream(4 << 20)
+				h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, 6<<20-h2InitWindow) })
+				h.fromClient(func(fr *http2.Framer) { writeDataSplit(fr, id, 512<<10) })
+				if h.c.streams[id].up.ramped {
+					t.Fatal("a new upload counts as one that has stopped speeding up")
+				}
+				credit := func() []byte {
+					return h.fromServer(func(fr *http2.Framer) {
+						fr.WriteWindowUpdate(order.first, piece)
+						fr.WriteWindowUpdate(id-order.first, piece)
+					})
+				}
+				// The first of it shows the reader reads and funds the connection's floor.
+				for i := 0; i < 8; i++ {
+					credit()
+				}
+				h.c.mu.Lock()
+				h.c.streams[id].up.ramped = state.ramped
+				h.c.mu.Unlock()
+				for i := 0; i < pieces; i++ {
+					count, sum := map[uint32]int{}, map[uint32]uint64{}
+					windowUpdates(t, credit(), count, sum)
+					for _, stream := range []uint32{0, id} {
+						if sum[stream] != piece {
+							t.Fatalf("piece %d, stream %d: %d updates carrying %d bytes went on, want the %d the server returned", i, stream, count[stream], sum[stream], piece)
+						}
+					}
+				}
+				owesNothing(t, h, id)
+				if got := h.c.streams[id].up.ramped; got != state.ramped {
+					t.Fatalf("the upload ended the test with ramped %v, want %v", got, state.ramped)
+				}
+			})
+		}
+	}
+}
+
+// TestFlowUploadConnectionCreditFollowsCap covers the connection credit that
+// goes on with a stream's. Until an upload's first round trip is measured its
+// cap opens with every credit, and the room its stream has on the connection
+// opens with it: that credit is due where the stream's WINDOW_UPDATE is read,
+// after the connection's own has been handed on. Each piece of 4 KiB here
+// opens the cap by 8 KiB. The two frames are fed one at a time, so that each
+// answers for what it frees: credit that left a round late would still add
+// up over the two.
+func TestFlowUploadConnectionCreditFollowsCap(t *testing.T) {
+	const id, piece, pieces = 1, 4 << 10, 16
+	for _, state := range rampStates {
+		t.Run(state.name, func(t *testing.T) {
+			h := newFlowHarness(t)
+			t.Cleanup(func() { h.c.Close() })
+			h.track()
+			h.openStream(4 << 20)
+			h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, 6<<20-h2InitWindow) })
+			// Under the cap a stream starts with, so the cap is what the stream
+			// counts for on the connection, and more than is returned below.
+			h.fromClient(func(fr *http2.Framer) { writeDataSplit(fr, id, 200<<10) })
+			// The cap opens with every credit only until the first round trip
+			// is measured, and the governor measures real time against a round
+			// trip of 200 ms here. The round is started anew before every
+			// frame, so that a stall of the machine cannot end it.
+			credit := func(stream uint32) map[uint32]uint64 {
+				h.c.mu.Lock()
+				if s := h.c.streams[id]; !s.up.mark.IsZero() {
+					s.up.mark = time.Now()
+				}
+				h.c.mu.Unlock()
+				count, sum := map[uint32]int{}, map[uint32]uint64{}
+				windowUpdates(t, h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(stream, piece) }), count, sum)
+				return sum
+			}
+			// Enough for the cap to start opening with every piece.
+			for i := 0; i < 32; i++ {
+				credit(0)
+				credit(id)
+			}
+			owesNothing(t, h, id)
+			h.c.mu.Lock()
+			h.c.streams[id].up.ramped = state.ramped
+			h.c.mu.Unlock()
+			for i := 0; i < pieces; i++ {
+				if sum := credit(0); sum[0] != piece || sum[id] != 0 {
+					t.Fatalf("piece %d, the connection's frame: %d bytes of connection credit and %d of stream credit went on, want its own %d and none", i, sum[0], sum[id], piece)
+				}
+				before := h.c.streams[id].up.cap
+				sum := credit(id)
+				opened := uint64(h.c.streams[id].up.cap - before)
+				if opened == 0 {
+					t.Fatalf("piece %d: the cap stayed at %d, so no connection credit followed it", i, before)
+				}
+				if h.c.streams[id].up.measured {
+					t.Fatalf("piece %d: a round trip was measured, and the cap no longer opens with every credit", i)
+				}
+				if sum[0] != opened {
+					t.Fatalf("piece %d, the stream's frame: %d bytes of connection credit went on, want the %d the cap opened by", i, sum[0], opened)
+				}
+			}
+			owesNothing(t, h, id)
+		})
+	}
+}
+
+// TestFlowEndedUploadConnectionCreditNotHeld returns connection credit on its
+// own, as Go's server does for a request whose body has ended, every
+// packet-up POST among them: no stream credit follows that could carry it.
+func TestFlowEndedUploadConnectionCreditNotHeld(t *testing.T) {
+	h := newFlowHarness(t)
+	t.Cleanup(func() { h.c.Close() })
+	h.c.up.init, h.c.up.max = flowShownUp, flowShownUp
+	h.track()
+	h.openStream(4 << 20)
+	h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, 6<<20-h2InitWindow) })
+	h.fromClient(func(fr *http2.Framer) { fr.WriteData(1, true, make([]byte, 4<<10)) })
+	count, sum := map[uint32]int{}, map[uint32]uint64{}
+	windowUpdates(t, h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, 4<<10) }), count, sum)
+	if count[0] != 1 || sum[0] != 4<<10 {
+		t.Fatalf("ended upload: %d connection updates carrying %d, want the 4096 at once", count[0], sum[0])
+	}
+}
+
+// TestFlowDownloadCreditNotHeld is the download side of a server: the client
+// returns a download's credit 4 KiB at a time, and the local server is
+// handed each piece as it comes, whether or not the download still speeds
+// up.
+func TestFlowDownloadCreditNotHeld(t *testing.T) {
+	const id, piece, pieces = 1, 4 << 10, 16
+	for _, state := range rampStates {
+		t.Run(state.name, func(t *testing.T) {
+			h := newFlowHarness(t)
+			t.Cleanup(func() { h.c.Close() })
+			h.c.down.max = flowStartWindow // the cap stays where it starts
+			h.track()
+			h.openStream(4 << 20)
+			h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, id, flowStartWindow/2) })
+			if h.c.streams[id].down.ramped {
+				t.Fatal("a new download counts as one that has stopped speeding up")
+			}
+			h.c.mu.Lock()
+			h.c.streams[id].down.ramped = state.ramped
+			h.c.mu.Unlock()
+			for i := 0; i < pieces; i++ {
+				before := h.toServer.streams[id]
+				h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(id, piece) })
+				if got := h.toServer.streams[id] - before; got != piece {
+					t.Fatalf("piece %d: the server was handed %d of credit, want the %d the client returned", i, got, piece)
+				}
+			}
+			if got := h.c.streams[id].down.ramped; got != state.ramped {
+				t.Fatalf("the download ended the test with ramped %v, want %v", got, state.ramped)
+			}
+		})
+	}
+}
+
+// TestFlowClientDownloadCreditNotHeld is the same for a governed client: the
+// local client returns a download's credit 4 KiB at a time, and each piece
+// goes on to the server as it comes. On a client it is the download's credit
+// that crosses the network.
+func TestFlowClientDownloadCreditNotHeld(t *testing.T) {
+	const id, piece, pieces = 1, 4 << 10, 16
+	for _, state := range rampStates {
+		t.Run(state.name, func(t *testing.T) {
+			ch := newChain(t, 0)
+			ch.start()
+			ch.open(id)
+			sent := ch.sendAll(id)
+			if sent < 2*pieces*piece {
+				t.Fatalf("the server sent %d, want room for %d pieces of credit", sent, pieces)
+			}
+			ch.cg.mu.Lock()
+			// A client that governs: toward a server that does, it leaves the
+			// window to the server, see peerGoverned.
+			ch.cg.peerGoverned = false
+			ch.cg.streams[id].down.ramped = state.ramped
+			ch.cg.mu.Unlock()
+			for i := 0; i < pieces; i++ {
+				if _, err := ch.cg.Write(frames(func(fr *http2.Framer) { fr.WriteWindowUpdate(id, piece) })); err != nil {
+					t.Fatal(err)
+				}
+				count, sum := map[uint32]int{}, map[uint32]uint64{}
+				windowUpdates(t, ch.cconn.take(), count, sum)
+				if sum[id] != piece {
+					t.Fatalf("piece %d: %d updates carrying %d bytes reached the wire, want the %d the client returned", i, count[id], sum[id], piece)
+				}
+			}
+			ch.cg.mu.Lock()
+			got := ch.cg.streams[id].down.ramped
+			ch.cg.mu.Unlock()
+			if got != state.ramped {
+				t.Fatalf("the download ended the test with ramped %v, want %v", got, state.ramped)
+			}
+		})
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_cutaccount_test.go b/transport/internet/splithttp/h2flow_cutaccount_test.go
new file mode 100644
index 00000000..6cc9f51b
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_cutaccount_test.go
@@ -0,0 +1,132 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// TestFlowEffectPostCutSpikeIsNoCut has what is in flight double after a cut
+// and come back to where it stood before it, with the queue above where it
+// was: nothing fell below the round before the cut, so the cut is not judged
+// and the gain stays 1. Peaks raised after the cut took the fall back from
+// the spike for the cut's effect.
+func TestFlowEffectPostCutSpikeIsNoCut(t *testing.T) {
+	var e flowEffect
+	t0 := time.Unix(1, 0)
+	e.note(t0, 300*time.Millisecond, 100*time.Millisecond, 20*time.Millisecond, 1024, 1024)
+	e.cutBy(256)
+	e.note(t0.Add(time.Second), 500*time.Millisecond, 100*time.Millisecond, 20*time.Millisecond, 2048, 1024)
+	if gain := e.note(t0.Add(2*time.Second), 450*time.Millisecond, 100*time.Millisecond, 20*time.Millisecond, 1024, 768); gain != 1 {
+		t.Fatalf("gain=%g: what is in flight never fell below the round before the cut", gain)
+	}
+}
+
+// TestFlowFinishedDownloadCutNotCounted has the server finish a download and
+// the client then return credit on it, as it legally may, beside a long
+// queue: what the cut at a long queue takes off that cap is no cut of a
+// download that takes part in the gain, and is not noted.
+func TestFlowFinishedDownloadCutNotCounted(t *testing.T) {
+	h, s := queuedDownload(t)
+	h.fromServer(func(fr *http2.Framer) { fr.WriteData(1, true, nil) })
+	h.c.mu.Lock()
+	done := s.serverDone
+	h.c.mu.Unlock()
+	if !done {
+		t.Fatal("the server did not finish the download")
+	}
+	credit(h, s)
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if h.c.effect.cut != 0 {
+		t.Fatalf("%v bytes of cut noted on a download the server had finished", h.c.effect.cut)
+	}
+}
+
+// TestFlowFinishedPICutNotCounted is the same late credit where PI holds the
+// download instead, on a path whose queue stands at 60 ms over a 50 ms
+// setpoint floor: what pi cuts off that cap is not noted either.
+func TestFlowFinishedPICutNotCounted(t *testing.T) {
+	h, s := queuedDownload(t)
+	h.fromServer(func(fr *http2.Framer) { fr.WriteData(1, true, nil) })
+	h.c.mu.Lock()
+	h.c.incremental = true
+	h.c.kstat.rtt = 110 * time.Millisecond
+	s.down.flat = flowFullRounds
+	s.down.mark = time.Now().Add(-200 * time.Millisecond)
+	h.c.mu.Unlock()
+	credit(h, s)
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if h.c.effect.cut != 0 {
+		t.Fatalf("pi noted %g bytes of cut on a download the server had finished", h.c.effect.cut)
+	}
+}
+
+// TestFlowPISlowReaderNoOverflow has a reader that took one byte over an hour,
+// and a 1 GiB cap over ten seconds, at the last slow round before the cap
+// shrinks: the cap shrinks. The cap times the round in nanoseconds wrapped,
+// and the cap grew instead.
+func TestFlowPISlowReaderNoOverflow(t *testing.T) {
+	for _, tc := range []struct {
+		cap   int32
+		round time.Duration
+	}{{4 << 20, time.Hour}, {1 << 30, 10 * time.Second}} {
+		now := time.Unix(1e6, 0)
+		w := flowWindow{cap: tc.cap, returned: 1, slow: flowShrinkAfter - 1}
+		w.mark = now.Add(-tc.round)
+		st := tcpStats{rtt: 100 * time.Millisecond, minRTT: 100 * time.Millisecond}
+		w.pi(now, st, h2InitWindow, 1<<30, 1, 0)
+		if w.cap >= tc.cap {
+			t.Fatalf("cap %d after a byte in %v: did not shrink from %d", w.cap, tc.round, tc.cap)
+		}
+	}
+}
+
+// TestFlowLongQueueCutRounding cuts caps one to three bytes over a multiple
+// of four at full gain: the cap goes to three quarters as it always did,
+// before/4*3.
+func TestFlowLongQueueCutRounding(t *testing.T) {
+	for _, before := range []int32{1048577, 1048578, 1048579} {
+		h, s := queuedDownload(t)
+		h.c.mu.Lock()
+		s.down.cap = before
+		h.c.mu.Unlock()
+		if got, want := credit(h, s), before/4*3; got != want {
+			t.Fatalf("cap %d cut at full gain to %d, want %d", before, got, want)
+		}
+	}
+}
+
+// TestFlowCoarseClientCutAboveHalfWindow has a client that credits in large
+// steps, one that may wait for half of its 4 MiB window before it credits,
+// beside a long queue: cut after cut takes its cap no lower than half that
+// window and the credit the guard adds, where the download would stop until
+// the guard lifts it. A client that credits in small steps is cut on down.
+func TestFlowCoarseClientCutAboveHalfWindow(t *testing.T) {
+	for _, step := range []uint32{128 << 10, 4 << 10} {
+		h, s := queuedDownload(t)
+		h.c.mu.Lock()
+		s.down.cap = 4 << 20
+		floor := int32(h.c.clientInit/2 + flowSmallCredit)
+		h.c.mu.Unlock()
+		var low int32 = 4 << 20
+		for range 8 {
+			h.c.mu.Lock()
+			s.down.qAt = time.Time{}
+			h.c.mu.Unlock()
+			h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(1, step) })
+			h.c.mu.Lock()
+			low = min(low, s.down.cap)
+			h.c.mu.Unlock()
+		}
+		coarse := step >= flowSmallCredit
+		if coarse && low < floor {
+			t.Fatalf("a client crediting %d at a time was cut to %d, under half its window and the guard's credit, %d", step, low, floor)
+		}
+		if !coarse && low >= floor {
+			t.Fatalf("a client crediting %d at a time was held at %d, not cut under %d", step, low, floor)
+		}
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_effect.go b/transport/internet/splithttp/h2flow_effect.go
new file mode 100644
index 00000000..5d544cbf
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_effect.go
@@ -0,0 +1,149 @@
+package splithttp
+
+import "time"
+
+// A server cuts its downloads against the queue its kernel sees. Where the
+// queue is its own, it shortens as the cuts take effect; where other traffic
+// keeps it full, it does not, and cut after cut, a PI controller's integral
+// winding up against an error nothing it does removes, takes the downloads
+// to init per round trip. So each connection measures what its cuts do:
+// over an episode of standing queue, how far the queue fell from its peak
+// for the share of the caps the controller cut, once the cut has landed in
+// what the kernel has in flight. Where the queue is the server's own, by
+// Little's law it falls with what is in flight; where it is foreign only the
+// download's share of the rate does. Only the controller's own cuts count: a
+// loss that drops what is in flight, the caps following the round trip down
+// and a dip of other traffic's queue move together now and then, and read
+// together as a cut that worked.
+//
+// Cuts are scaled by that gain; growth is not, and where cuts have less
+// gain the caps follow the round trip by as much more, so the download keeps
+// its rate. A small gain is no noise to be cut off: where the client's
+// connections share a queue of the server's own, each one's cut moves the
+// queue by its share, and all of them cutting by their shares drain it.
+const (
+	// flowEffectProbe is the share of the caps a cut must take, and of what
+	// is in flight it must bring down, before the queue's answer counts:
+	// until then cuts work in full.
+	flowEffectProbe = 0.2
+	// An episode is a queue over flowEffectAbove times the setpoint: the PI
+	// controller holds the queue at the setpoint, and an episode that took
+	// that for standing queue would never end, and judge a later queue by
+	// an old peak. flowEffectClear rounds in a row back under it end one.
+	flowEffectAbove = 1.25
+	flowEffectClear = 2
+	// flowEffectRecent is the round trips of the empty path, and at least a
+	// second, within which a download that took data counts as taking it.
+	flowEffectRecent = 8
+)
+
+type flowEffect struct {
+	at        time.Time
+	queue     float64
+	active    bool
+	clear     int
+	flightTop float64
+	capsTop   float64
+	qTop      float64
+	cut       float64
+	gain      float64
+	// flight and caps are what the last note saw.
+	flight, caps float64
+}
+
+// cutBy notes bytes the controller cut from the caps against the queue. The
+// first cut of a measurement is judged from the last note before it: what was
+// in flight and the queue then, not their peaks since the measurement began,
+// which a drop before the cut would otherwise count for it.
+func (e *flowEffect) cutBy(bytes float64) {
+	if bytes <= 0 {
+		return
+	}
+	if e.active && e.cut == 0 {
+		e.flightTop, e.capsTop, e.qTop = e.flight, e.caps, e.queue
+	}
+	e.cut += bytes
+}
+
+// note takes the round trip the kernel reads and that of the empty path, the
+// setpoint, the bytes in flight and the caps of the downloads that took data,
+// once per round. It returns the gain cuts are scaled by: 1 outside an
+// episode, until the controller has cut flowEffectProbe of the caps and what
+// is in flight has come down as far, and once the queue halves; otherwise
+// the share by which the queue fell for the share of the last such cut.
+func (e *flowEffect) note(now time.Time, rtt, minRTT, set time.Duration, inFlight, caps int64) float64 {
+	e.at = now
+	// The kernel's smoothed round trip, as it is: smoothing it again would
+	// have the queue lag behind what is in flight by rounds, and a cut that
+	// took effect read as one that did not.
+	e.queue = float64(rtt - minRTT)
+	x, c := float64(inFlight), float64(caps)
+	e.flight, e.caps = x, c
+	if e.queue <= flowEffectAbove*float64(set) {
+		if e.clear++; e.clear >= flowEffectClear {
+			e.active = false
+		}
+		return e.value()
+	}
+	e.clear = 0
+	if !e.active {
+		e.active, e.gain = true, 1
+		e.start(x, c)
+		return 1
+	}
+	// A cut is judged from the round before it, see cutBy: peaks after it,
+	// a burst of flight it did not cause or a queue that rose on, would
+	// have a fall back from them read as the cut's.
+	if e.cut == 0 {
+		e.flightTop, e.qTop = max(e.flightTop, x), max(e.qTop, e.queue)
+	}
+	// A queue that halved since the last judgement drained by the client's
+	// own cuts, this connection's or its neighbours': cuts have their gain
+	// back. Other traffic's queue at a full buffer wanders by a tenth, and
+	// halves only as that traffic leaves.
+	if e.gain < 1 && e.queue <= e.qTop/2 {
+		e.gain = 1
+		e.start(x, c)
+		return 1
+	}
+	// Only what the controller cut counts, and only once it has landed in
+	// what is in flight. The caps following the round trip down, a loss that
+	// drops what is in flight, and a dip of other traffic's queue each move
+	// with the others now and then, and taken together read as a cut that
+	// worked. Without a cut deep enough to judge by, the gain stays what the
+	// last one showed; without gain the controller does not cut, and the gain
+	// stays none until the queue halves or is gone.
+	if e.capsTop <= 0 {
+		return e.gain
+	}
+	// A cut taken in a round with nothing in flight has no flight to fall
+	// from: the first round after it with some is its reference, and until
+	// then it is not judged. Judged against none, it never would be, and
+	// the gain would stay where it was for the rest of the episode.
+	if e.flightTop <= 0 {
+		e.flightTop = x
+		return e.gain
+	}
+	if cut := min(e.cut/e.capsTop, 1-x/e.flightTop); cut >= flowEffectProbe {
+		e.gain = min(max((1-e.queue/e.qTop)/cut, 0), 1)
+		e.start(x, c)
+	}
+	return e.gain
+}
+
+// start begins a measurement from now: the next cut is judged from here.
+func (e *flowEffect) start(x, c float64) {
+	e.flightTop, e.capsTop, e.qTop, e.cut = x, c, e.queue, 0
+}
+
+// due reports whether a round has passed since the last note.
+func (e *flowEffect) due(now time.Time, round time.Duration) bool {
+	return e.at.IsZero() || now.Sub(e.at) >= round
+}
+
+func (e *flowEffect) value() float64 {
+	if !e.active {
+		return 1
+	}
+	return e.gain
+}
diff --git a/transport/internet/splithttp/h2flow_effect_test.go b/transport/internet/splithttp/h2flow_effect_test.go
new file mode 100644
index 00000000..4a8ac7a3
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_effect_test.go
@@ -0,0 +1,373 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+)
+
+// rounds feeds e one round each 100 ms from start: the queue and the bytes
+// in flight of each step, with caps as large as what is in flight unless a
+// third value gives them, against a 20 ms setpoint. What the caps fell by
+// since the step before counts as the controller's cut unless a fourth value
+// gives the cut. It returns the last gain.
+func rounds(e *flowEffect, start time.Time, steps [][]int64) float64 {
+	g := e.value()
+	var prev int64
+	for i, s := range steps {
+		caps := s[1]
+		if len(s) > 2 {
+			caps = s[2]
+		}
+		cut := max(0, prev-caps)
+		if len(s) > 3 {
+			cut = s[3]
+		}
+		if i > 0 {
+			e.cutBy(float64(cut))
+		}
+		prev = caps
+		g = e.note(start.Add(time.Duration(i)*100*time.Millisecond), time.Duration(100+s[0])*time.Millisecond, 100*time.Millisecond, 20*time.Millisecond, s[1], caps)
+	}
+	return g
+}
+
+// TestFlowEffectOwnQueue is a queue that falls as what is in flight does:
+// the cuts work, and keep their full gain.
+func TestFlowEffectOwnQueue(t *testing.T) {
+	var e flowEffect
+	g := rounds(&e, time.Now(), [][]int64{{100, 1000}, {90, 900}, {70, 750}, {50, 600}})
+	if g != 1 {
+		t.Fatalf("gain %v for a queue that fell with what is in flight", g)
+	}
+}
+
+// TestFlowEffectForeignQueue is a queue that does not move when what is in
+// flight falls by a third: the cuts do nothing, and stop.
+func TestFlowEffectForeignQueue(t *testing.T) {
+	var e flowEffect
+	g := rounds(&e, time.Now(), [][]int64{{100, 1000}, {105, 900}, {110, 750}, {120, 650}})
+	if g != 0 {
+		t.Fatalf("gain %v for a queue that grew while what is in flight fell", g)
+	}
+}
+
+// TestFlowEffectWaitsForCut is a queue that stands while what is in flight
+// has not yet come down: a cut that has not landed says nothing, and cuts
+// keep their full gain.
+func TestFlowEffectWaitsForCut(t *testing.T) {
+	var e flowEffect
+	g := rounds(&e, time.Now(), [][]int64{{100, 1000}, {120, 1100}, {140, 1200}, {150, 1050}})
+	if g != 1 {
+		t.Fatalf("gain %v before what is in flight fell by %v", g, flowEffectProbe)
+	}
+}
+
+// TestFlowEffectKeepsGain is a cap held where cuts did nothing: what is in
+// flight climbs back to its peak, and the gain stays as the last cut
+// showed it, so that the climb is not taken for leave to cut again.
+func TestFlowEffectKeepsGain(t *testing.T) {
+	var e flowEffect
+	g := rounds(&e, time.Now(), [][]int64{{100, 1000}, {110, 700}, {130, 900}, {160, 1000}, {200, 1100}})
+	if g != 0 {
+		t.Fatalf("gain %v once what is in flight came back", g)
+	}
+}
+
+// TestFlowEffectEpisodeEnds is a queue back under the bar for two rounds:
+// the episode ends, cuts have their full gain again, and the next queue is
+// judged by its own peak, not the last one's.
+func TestFlowEffectEpisodeEnds(t *testing.T) {
+	var e flowEffect
+	start := time.Now()
+	rounds(&e, start, [][]int64{{100, 1000}, {110, 700}, {20, 700}})
+	if g := e.value(); g != 0 {
+		t.Fatalf("one round under the bar ended the episode: gain %v", g)
+	}
+	if g := rounds(&e, start.Add(300*time.Millisecond), [][]int64{{20, 700}}); g != 1 {
+		t.Fatalf("gain %v after two rounds under the bar", g)
+	}
+	if g := rounds(&e, start.Add(400*time.Millisecond), [][]int64{{60, 800}, {40, 600}}); g != 1 {
+		t.Fatalf("gain %v for a new queue that falls with its cuts", g)
+	}
+}
+
+// TestFlowEffectLossIsNoCut is a held cap beside other traffic: a loss
+// halves what is in flight and the other senders back off, so the queue
+// falls with it, but the caps did not move. That is no cut of the server's,
+// and the gain stays as it was.
+func TestFlowEffectLossIsNoCut(t *testing.T) {
+	var e flowEffect
+	g := rounds(&e, time.Now(), [][]int64{{100, 1000}, {110, 700}, {120, 1000, 1000}, {85, 500, 1000}, {80, 450, 1000}})
+	if g != 0 {
+		t.Fatalf("gain %v after a loss under a held cap", g)
+	}
+}
+
+// TestFlowEffectFollowIsNoCut is a held cap that follows the round trip down
+// as the foreign queue ebbs: caps and what is in flight fall, the queue with
+// them, but the rate the caps allow does not. That is no cut, and the gain
+// stays as it was.
+func TestFlowEffectFollowIsNoCut(t *testing.T) {
+	var e flowEffect
+	g := rounds(&e, time.Now(), [][]int64{{900, 1000}, {950, 700}, {1000, 1100, 1100, 0}, {800, 900, 900, 0}, {600, 700, 700, 0}})
+	if g != 0 {
+		t.Fatalf("gain %v for a cap that followed the round trip down", g)
+	}
+}
+
+// TestFlowPIGainHolds is the PI controller over a queue far above the
+// setpoint: with the full gain it cuts; with none it does not, and the cap
+// follows the round trip as it grows, so the reader keeps its rate.
+func TestFlowPIGainHolds(t *testing.T) {
+	st := tcpStats{rtt: 300 * time.Millisecond, minRTT: 100 * time.Millisecond}
+	for _, tc := range []struct {
+		gain float64
+		cut  bool
+	}{{1, true}, {0, false}} {
+		w := flowWindow{cap: 1 << 20, mark: time.Now(), piRTT: 250 * time.Millisecond}
+		w.returned = 1 << 20
+		w.pi(w.mark.Add(st.rtt), st, h2InitWindow, 1<<30, tc.gain, 0)
+		if got := w.cap < 1<<20; got != tc.cut {
+			t.Fatalf("gain %v: cap %d from %d", tc.gain, w.cap, 1<<20)
+		}
+		if !tc.cut && float64(w.cap) < float64(1<<20)*1.15 {
+			t.Fatalf("gain 0: cap %d did not follow the round trip up a fifth", w.cap)
+		}
+	}
+}
+
+// TestFlowPIFollowsOnlyABindingCap is a cap that some other limit keeps the
+// reader under: it does not follow the round trip up, so that a later cut
+// still lands on it.
+func TestFlowPIFollowsOnlyABindingCap(t *testing.T) {
+	st := tcpStats{rtt: 300 * time.Millisecond, minRTT: 100 * time.Millisecond}
+	w := flowWindow{cap: 4 << 20, mark: time.Now(), piRTT: 250 * time.Millisecond}
+	w.returned = 1 << 20
+	w.pi(w.mark.Add(st.rtt), st, h2InitWindow, 1<<30, 0, 0)
+	if w.cap > 4<<20 {
+		t.Fatalf("cap %d grew over the %d the reader is held under", w.cap, 4<<20)
+	}
+}
+
+// TestFlowEffectShare is one of three connections that share a queue of the
+// server's own: its cut halves what it has in flight, and the queue falls by
+// its share of it. The gain is that share, not none, so that each cutting
+// by its share drains the queue.
+func TestFlowEffectShare(t *testing.T) {
+	var e flowEffect
+	g := rounds(&e, time.Now(), [][]int64{{110, 480}, {100, 400}, {85, 240}})
+	if g < 0.3 || g > 0.6 {
+		t.Fatalf("gain %v for a share of a third", g)
+	}
+}
+
+// TestFlowPIReaderBesideQueue is a reader that takes all it is given beside
+// a queue of over a second: per round of the empty path it copies only that
+// round's share of the cap. It does not limit itself, and its cap holds.
+func TestFlowPIReaderBesideQueue(t *testing.T) {
+	st := tcpStats{rtt: 1500 * time.Millisecond, minRTT: 150 * time.Millisecond}
+	w := flowWindow{cap: 4 << 20, mark: time.Now()}
+	for range 2 * flowShrinkAfter {
+		w.returned += int64(w.cap) * int64(st.minRTT) / int64(st.rtt)
+		w.pi(w.mark.Add(st.minRTT), st, h2InitWindow, 1<<30, 0, 0)
+	}
+	if w.cap < 4<<20 {
+		t.Fatalf("cap %d, from %d, for a reader that takes all it is given", w.cap, 4<<20)
+	}
+}
+
+// TestFlowEffectCountsDownloadsOnly is a connection with a download and a
+// stream that carries nothing beside it, as an upload's. The download's
+// cut is a cut of the connection's: the idle stream's cap does not dilute it.
+func TestFlowEffectCountsDownloadsOnly(t *testing.T) {
+	down := &flowStream{}
+	down.down.cap = 1 << 20
+	idle := &flowStream{}
+	idle.down.cap = 4 << 20
+	c := &flowConn{streams: map[uint32]*flowStream{1: down, 3: idle}, kOK: true}
+	c.kstat = tcpStats{rtt: 300 * time.Millisecond, minRTT: 100 * time.Millisecond, inFlight: 1 << 20}
+	now := time.Now()
+	down.down.returned = 1
+	c.cutGain(now)
+	// The download is cut by a third and takes data; the queue stands.
+	down.down.cap, down.down.returned = 700<<10, 2
+	c.kstat.inFlight = 700 << 10
+	t.Logf("before the cut: %+v", c.effect)
+	c.effect.cutBy(300 << 10)
+	t.Logf("after the cut: %+v", c.effect)
+	if g := c.cutGain(now.Add(time.Second)); g != 0 {
+		t.Fatalf("gain %v for a download cut against a queue that did not move", g)
+	}
+}
+
+// TestFlowPIFollowsOneStep is a round trip that rose tenfold in one round:
+// a cut that does not move the queue has the cap follow it by no more than
+// pi's own largest step.
+func TestFlowPIFollowsOneStep(t *testing.T) {
+	st := tcpStats{rtt: time.Second, minRTT: 100 * time.Millisecond}
+	w := flowWindow{cap: 1 << 20, mark: time.Now(), piRTT: 100 * time.Millisecond}
+	w.returned = 1 << 20
+	w.pi(w.mark.Add(st.minRTT), st, h2InitWindow, 1<<30, 0, 0)
+	if float64(w.cap) > float64(1<<20)*(1+flowPIMaxStep) {
+		t.Fatalf("cap %d from %d in one step", w.cap, 1<<20)
+	}
+}
+
+// TestFlowEffectCountsSlowDownload has two downloads beside a queue that does
+// not move, one of which returns no credit in the round before a cut, as one
+// beside a long queue does. Its cap stays in the sum: the cut of 300 KiB is
+// under a fifth of the 2 MiB of caps, not judged yet, and the gain stays 1.
+// Taken out of the sum, the same cut is three tenths of 1 MiB, judged against
+// a queue that stood, and the gain falls to none.
+func TestFlowEffectCountsSlowDownload(t *testing.T) {
+	fast, slow := &flowStream{}, &flowStream{}
+	fast.down.cap, slow.down.cap = 1<<20, 1<<20
+	c := &flowConn{streams: map[uint32]*flowStream{1: fast, 3: slow}, kOK: true}
+	c.kstat = tcpStats{rtt: 300 * time.Millisecond, minRTT: 100 * time.Millisecond, inFlight: 1 << 20}
+	now := time.Now()
+	fast.down.returned, slow.down.returned = 1, 1
+	c.cutGain(now)
+	// The slow download returns nothing in the next round.
+	now = now.Add(200 * time.Millisecond)
+	fast.down.returned = 2
+	c.cutGain(now)
+	c.effect.cutBy(300 << 10)
+	// The cut lands: what is in flight falls three tenths; the queue stands.
+	now = now.Add(200 * time.Millisecond)
+	fast.down.returned = 3
+	c.kstat.inFlight = 700 << 10
+	if g := c.cutGain(now); g != 1 {
+		t.Fatalf("gain %v: the slow download's cap left the sum, and a cut under a fifth of the caps was judged", g)
+	}
+}
+
+// TestFlowEffectNoiseIsNoCut is a held cap beside other traffic in the
+// minute after cuts lost their gain: a loss halves what is in flight, the
+// caps follow the round trip down a quarter, and the other traffic's queue
+// dips a tenth, all at once. None of it is a cut of the controller's, and the
+// gain stays none.
+func TestFlowEffectNoiseIsNoCut(t *testing.T) {
+	var e flowEffect
+	g := rounds(&e, time.Now(), [][]int64{{1000, 2000}, {1010, 1400}, {1300, 2800, 2800, 0}, {1170, 1400, 2100, 0}, {1150, 1300, 2000, 0}})
+	if g != 0 {
+		t.Fatalf("gain %v from a loss, a follow and a dip together", g)
+	}
+}
+
+// TestFlowEffectHalvedQueueGivesGainBack is a queue cuts did nothing against
+// that then halves, drained by the client's other connections: the cuts have
+// their full gain back.
+func TestFlowEffectHalvedQueueGivesGainBack(t *testing.T) {
+	var e flowEffect
+	if g := rounds(&e, time.Now(), [][]int64{{100, 1000}, {105, 700}, {80, 700, 700, 0}, {50, 700, 700, 0}}); g != 1 {
+		t.Fatalf("gain %v once the queue halved", g)
+	}
+}
+
+// TestFlowEffectCutMustLand is a cut of three tenths of the caps that what
+// is in flight has not come down by yet: the queue cannot have answered it,
+// and the gain stays full.
+func TestFlowEffectCutMustLand(t *testing.T) {
+	var e flowEffect
+	if g := rounds(&e, time.Now(), [][]int64{{100, 1000}, {105, 1000, 700, 300}}); g != 1 {
+		t.Fatalf("gain %v for a cut that has not landed", g)
+	}
+}
+
+// TestFlowPIReturnsCut is pi over a queue far above the setpoint: it returns
+// the bytes it took off the cap, scaled by the gain.
+func TestFlowPIReturnsCut(t *testing.T) {
+	st := tcpStats{rtt: 300 * time.Millisecond, minRTT: 100 * time.Millisecond}
+	for _, gain := range []float64{1, 0.5} {
+		w := flowWindow{cap: 1 << 20, mark: time.Now()}
+		w.returned = 1 << 20
+		cut := w.pi(w.mark.Add(st.rtt), st, h2InitWindow, 1<<30, gain, 0)
+		if got := float64(1<<20 - w.cap); cut <= 0 || got < cut-1 || got > cut+1 {
+			t.Fatalf("gain %v: pi returned %v, the cap fell by %v", gain, cut, got)
+		}
+	}
+}
+
+// TestFlowPIReturnsCutThatLanded is pi cutting a cap just over init: it
+// returns what the cap fell by, not the step it could not take.
+func TestFlowPIReturnsCutThatLanded(t *testing.T) {
+	st := tcpStats{rtt: 300 * time.Millisecond, minRTT: 100 * time.Millisecond}
+	w := flowWindow{cap: h2InitWindow + 1000, mark: time.Now()}
+	w.returned = 1 << 20
+	if cut := w.pi(w.mark.Add(st.rtt), st, h2InitWindow, 1<<30, 1, 0); cut > 1000 {
+		t.Fatalf("pi returned %v for a cap that could fall by 1000", cut)
+	}
+}
+
+// TestFlowEffectDoesNotAttributePreCutFlightDrop (from the review of the
+// change) has what is in flight fall before the controller cuts: the cut is
+// judged from the round before it, and what is in flight has not come down
+// since.
+func TestFlowEffectDoesNotAttributePreCutFlightDrop(t *testing.T) {
+	var e flowEffect
+	start := time.Unix(1, 0)
+	e.note(start, 200*time.Millisecond, 100*time.Millisecond,
+		20*time.Millisecond, 1024, 1024)
+
+	// Flight falls before any controller cut; queue delay rises.
+	e.note(start.Add(time.Second), 300*time.Millisecond,
+		100*time.Millisecond, 20*time.Millisecond, 768, 1024)
+
+	e.cutBy(256)
+	gain := e.note(start.Add(2*time.Second), 275*time.Millisecond,
+		100*time.Millisecond, 20*time.Millisecond, 768, 768)
+	if gain != 1 {
+		t.Fatalf("gain=%g: no flight reduction occurred after the cut", gain)
+	}
+}
+
+// TestFlowEffectZeroFlightFirstCut takes the first cut of an episode in a
+// round with nothing in flight, as a peer that has acknowledged all it was
+// sent before it credits does, and then a second cut that halves what is in
+// flight while the queue stays: the gain goes to none. Judged against no
+// flight, 1 - x/0, the cut was never judged and the gain stayed 1.
+func TestFlowEffectZeroFlightFirstCut(t *testing.T) {
+	for _, first := range []int64{1 << 20, 0} {
+		t.Run(map[bool]string{true: "positive-first-flight", false: "zero-first-flight"}[first > 0], func(t *testing.T) {
+			var e flowEffect
+			now := time.Unix(100, 0)
+			note := func(flight, caps int64) float64 {
+				now = now.Add(time.Second)
+				return e.note(now, 300*time.Millisecond, 100*time.Millisecond, 20*time.Millisecond, flight, caps)
+			}
+			note(first, 1<<20)
+			e.cutBy(256 << 10)
+			note(1<<20, 768<<10)
+			e.cutBy(256 << 10)
+			gain := note(512<<10, 512<<10)
+			t.Logf("first-flight=%d flightTop=%g flight=%g capsTop=%g cut=%g gain=%g", first, e.flightTop, e.flight, e.capsTop, e.cut, gain)
+			if gain != 0 {
+				t.Fatalf("gain=%g after a later 50%% flight reduction with a standing queue; flight reference remains %g", gain, e.flightTop)
+			}
+		})
+	}
+}
+
+// TestFlowEffectZeroFlightThroughCredit is the same through WINDOW_UPDATE
+// frames on a server: the first credit comes with nothing in flight, and the
+// cut that later lands in flight is judged.
+func TestFlowEffectZeroFlightThroughCredit(t *testing.T) {
+	h, s := queuedDownload(t)
+	for i, flight := range []int64{0, 128 << 10, 64 << 10} {
+		h.c.mu.Lock()
+		h.c.kstat.inFlight = flight
+		h.c.effect.at = time.Now().Add(-time.Second)
+		s.down.qAt = time.Time{}
+		s.down.mark = time.Now()
+		h.c.mu.Unlock()
+		cap := credit(h, s)
+		h.c.mu.Lock()
+		t.Logf("credit %d: flight=%d cap=%d reference=%g cut=%g gain=%g", i+1, flight, cap, h.c.effect.flightTop, h.c.effect.cut, h.c.effect.gain)
+		h.c.mu.Unlock()
+	}
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if h.c.effect.gain != 0 {
+		t.Fatalf("real WINDOW_UPDATE path never judges the later landed cut: %+v", h.c.effect)
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_frame_test.go b/transport/internet/splithttp/h2flow_frame_test.go
new file mode 100644
index 00000000..2e5b2af4
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_frame_test.go
@@ -0,0 +1,144 @@
+package splithttp
+
+import (
+	"bytes"
+	"io"
+	"net"
+	"net/http"
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+// frameSizes records the largest DATA frame seen in each direction.
+type frameSizes struct {
+	up, down atomic.Int64
+}
+
+type dataSniffer struct {
+	max *atomic.Int64
+}
+
+func (d dataSniffer) frame(f h2Frame) bool {
+	if f.typ == h2Data {
+		for {
+			cur := d.max.Load()
+			if int64(f.length) <= cur || d.max.CompareAndSwap(cur, int64(f.length)) {
+				return false
+			}
+		}
+	}
+	return false
+}
+
+func (dataSniffer) control(_ h2Frame, header, payload, out []byte) []byte {
+	return out
+}
+
+func (dataSniffer) boundary(out []byte) []byte { return out }
+
+// sniffConn watches the frames on the wire of a server-side connection.
+type sniffConn struct {
+	net.Conn
+	sizes   *frameSizes
+	mu      sync.Mutex
+	rp, wp  frameParser
+	preface int
+	upMax   dataSniffer
+	downMax dataSniffer
+}
+
+func (c *sniffConn) Read(b []byte) (int, error) {
+	n, err := c.Conn.Read(b)
+	in := b[:n]
+	if skip := min(len(h2Preface)-c.preface, len(in)); skip > 0 {
+		c.preface += skip
+		in = in[skip:]
+	}
+	c.rp.feed(in, nil, c.upMax)
+	return n, err
+}
+
+func (c *sniffConn) Write(b []byte) (int, error) {
+	c.mu.Lock()
+	c.wp.feed(b, nil, c.downMax)
+	c.mu.Unlock()
+	return c.Conn.Write(b)
+}
+
+type sniffListener struct {
+	net.Listener
+	sizes *frameSizes
+}
+
+func (l sniffListener) Accept() (net.Conn, error) {
+	c, err := l.Listener.Accept()
+	if err != nil {
+		return nil, err
+	}
+	return &sniffConn{Conn: c, sizes: l.sizes, upMax: dataSniffer{&l.sizes.up}, downMax: dataSniffer{&l.sizes.down}}, nil
+}
+
+func transferBoth(t *testing.T, client *http.Client) {
+	resp, err := client.Post("http://x/", "", bytes.NewReader(make([]byte, 8<<20)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n, _ := io.Copy(io.Discard, resp.Body); n != 8<<20 {
+		t.Fatalf("echoed %d bytes", n)
+	}
+	resp.Body.Close()
+}
+
+func TestFlowCapsFrameSize(t *testing.T) {
+	echo := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		buf := make([]byte, 256<<10)
+		for {
+			n, err := io.ReadFull(r.Body, buf)
+			if n > 0 {
+				w.Write(buf[:n])
+			}
+			if err != nil {
+				return
+			}
+		}
+	})
+	for _, tc := range []struct {
+		name           string
+		server, client bool
+	}{
+		{"stock both", false, false},
+		{"stock server, x/net client", false, false},
+		{"governed server, stock client", true, false},
+		{"stock server, governed client", false, true},
+	} {
+		ln, err := net.Listen("tcp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		sizes := &frameSizes{}
+		tl := &testListener{Listener: sniffListener{ln, sizes}}
+		if tc.server {
+			tl.up, tl.down = testUp, testDown
+		}
+		protocols := new(http.Protocols)
+		protocols.SetHTTP1(true)
+		protocols.SetUnencryptedHTTP2(true)
+		srv := &http.Server{Handler: echo, Protocols: protocols}
+		go srv.Serve(tl)
+		addr := ln.Addr().String()
+		if tc.client {
+			transferBoth(t, newFlowTestClient(t, addr, true).Client)
+		} else if tc.name == "stock server, x/net client" {
+			transferBoth(t, newFlowTestClient(t, addr, false).Client)
+		} else {
+			transferBoth(t, h2Client(addr))
+		}
+		srv.Close()
+		up, down := sizes.up.Load(), sizes.down.Load()
+		t.Logf("%s: largest DATA frame client to server %d, server to client %d", tc.name, up, down)
+		if (tc.server || tc.client) && (up > h2MinMaxFrameSize || down > h2MinMaxFrameSize) {
+			t.Fatalf("%s: frames above %d on the wire", tc.name, h2MinMaxFrameSize)
+		}
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_fuzz_test.go b/transport/internet/splithttp/h2flow_fuzz_test.go
new file mode 100644
index 00000000..72ba1512
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_fuzz_test.go
@@ -0,0 +1,144 @@
+package splithttp
+
+import (
+	"bytes"
+	"encoding/binary"
+	mrand "math/rand/v2"
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// FuzzFlowConn feeds arbitrary bytes to both directions of the governor after
+// a valid preface: whatever a broken or hostile peer sends, it must not panic,
+// must not hold on to more than a bounded amount of state, and must pass every
+// byte of a stream it does not rewrite.
+func FuzzFlowConn(f *testing.F) {
+	var seed bytes.Buffer
+	fr := http2.NewFramer(&seed, nil)
+	fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20})
+	fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: []byte{0x82}, EndHeaders: true})
+	fr.WriteData(1, false, make([]byte, 1000))
+	fr.WriteWindowUpdate(1, 70000)
+	fr.WriteWindowUpdate(0, 70000)
+	fr.WritePing(true, [8]byte{0x78, 0x66, 0x6c, 0x77, 0, 0, 0, 1})
+	fr.WriteRSTStream(1, http2.ErrCodeCancel)
+	f.Add(seed.Bytes(), seed.Bytes(), uint8(7))
+	f.Add([]byte{0, 0, 0, 4, 0, 0, 0, 0, 0}, []byte{0, 0, 6, 4, 0, 0, 0, 0, 0, 0, 4, 0, 0, 0, 1}, uint8(1))
+	f.Add([]byte{0xff, 0xff, 0xff, 1, 0xff, 0x7f, 0xff, 0xff, 0xff}, []byte{0, 0, 4, 8, 0, 0, 0, 0, 3, 0, 0, 0, 0}, uint8(3))
+
+	// A client that announces a large window, opens a stream and lowers the
+	// window under what the server was forwarded: the governor gives the
+	// connection up, and the server's write fails.
+	f.Add([]byte("\x00\x00\x06\x040\x00\x00\x00\x00\x00\x040000\x00\x00\x01\x01700010\x00\x00\x1e\x040\x00\x00\x00\x00000000\x00\x04\x00\x0000000000000000000000"), []byte("0"), uint8(3))
+
+	f.Fuzz(func(t *testing.T, fromClient, fromServer []byte, cut uint8) {
+		// The same input with the send window off and at its default, and
+		// with a kernel that reports a queue of 0 to 350 ms over a 50 ms
+		// path, so the cuts and the models run.
+		for i, sendWindow := range []int64{0, flowServerSendWindow, flowServerSendWindow} {
+			capture := &captureConn{}
+			c := newFlowConn(capture, testUp, testDown)
+			c.sendWindow = sendWindow
+			c.rtt = 1
+			if i == 2 {
+				c.tcp, c.kAt, c.kOK = fakeRawConn{}, time.Now().Add(time.Hour), true
+				c.kstat = tcpStats{rtt: time.Duration(cut%8+1) * 50 * time.Millisecond, minRTT: 50 * time.Millisecond}
+				c.rttBase = 50 * time.Millisecond
+			}
+			step := int(cut%16) + 1
+			out := c.readFrames([]byte(h2Preface), nil)
+			for in := fromClient; len(in) > 0; {
+				n := min(step, len(in))
+				out = c.readFrames(append([]byte(nil), in[:n]...), out)
+				in = in[n:]
+			}
+			for in := fromServer; len(in) > 0; {
+				n := min(step, len(in))
+				if _, err := c.Write(in[:n]); err != nil {
+					// A connection the governor gave up takes no more.
+					if !c.isBroken() {
+						t.Fatal(err)
+					}
+					break
+				}
+				in = in[n:]
+			}
+			c.wmu.Lock()
+			c.wmu.Unlock()
+			c.mu.Lock()
+			streams, queued := len(c.streams), queuedBytes(c)
+			c.mu.Unlock()
+			if streams > len(fromClient)/h2FrameHeader+1 {
+				t.Fatalf("%d streams tracked from %d input bytes", streams, len(fromClient))
+			}
+			if queued > 1<<16 {
+				t.Fatalf("%d bytes queued for the client", queued)
+			}
+			if limit := len(h2Preface) + len(fromClient) + 64*(len(fromClient)/h2FrameHeader+2); len(out) > limit {
+				t.Fatalf("read side produced %d bytes from %d", len(out), len(fromClient))
+			}
+			if err := downCountersAgree(c); err != nil {
+				t.Fatalf("send window %d: %v", sendWindow, err)
+			}
+			// The governor rewrites credit and SETTINGS, never data: what
+			// the server reads of each stream is what the client sent, as
+			// far as the frames parse and the connection was not given up.
+			if !c.isBroken() {
+				if sent, got := dataFrames(fromClient), dataFrames(out[len(h2Preface):]); !bytes.Equal(sent, got) {
+					t.Fatalf("send window %d: the server read %d bytes of data frames, the client sent %d", sendWindow, len(got), len(sent))
+				}
+			}
+			c.Close()
+		}
+
+		for _, client := range []bool{false, true} {
+			in := append([]byte(h2Preface), fromClient...)
+			if client {
+				in = fromServer
+			}
+			rnd := mrand.New(mrand.NewPCG(uint64(cut), uint64(len(in))))
+			cc := &chunkConn{data: in, rnd: rnd}
+			rc := newFlowConn(cc, testUp, testDown)
+			rc.sendWindow = flowServerSendWindow
+			if client {
+				rc = newFlowClientConn(cc)
+				rc.mode.Store(flowH2)
+			}
+			var got []byte
+			for {
+				b := make([]byte, 1+rnd.IntN(64))
+				n, err := rc.Read(b)
+				got = append(got, b[:n]...)
+				if err != nil {
+					break
+				}
+			}
+			if len(got) > len(in)+64*(len(in)/h2FrameHeader+2) {
+				t.Fatalf("Read produced %d bytes from %d", len(got), len(in))
+			}
+			if err := downCountersAgree(rc); err != nil {
+				t.Fatalf("client %v: %v", client, err)
+			}
+		}
+	})
+}
+
+// dataFrames is the stream id and payload of each DATA frame in b, in order,
+// up to the first frame that does not parse.
+func dataFrames(b []byte) []byte {
+	fr := http2.NewFramer(nil, bytes.NewReader(b))
+	fr.SetMaxReadFrameSize(1 << 24)
+	var out []byte
+	for {
+		f, err := fr.ReadFrame()
+		if err != nil {
+			return out
+		}
+		if d, ok := f.(*http2.DataFrame); ok {
+			out = binary.BigEndian.AppendUint32(out, d.StreamID)
+			out = append(out, d.Data()...)
+		}
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_fuzzclient_test.go b/transport/internet/splithttp/h2flow_fuzzclient_test.go
new file mode 100644
index 00000000..54b8d7aa
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_fuzzclient_test.go
@@ -0,0 +1,199 @@
+package splithttp
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"os"
+	"testing"
+
+	"golang.org/x/net/http2"
+)
+
+// FuzzFlowClientConn drives a client's governor through both of its paths:
+// the client stack's bytes go out through Write and the server's come in
+// through Read, a frame at a time, with each PING the governor sent answered
+// between the server's frames, so the round trip and what follows it run:
+// the models, the cuts and the server's tagged PING. Whatever either peer
+// sends, the governor holds bounded state and passes every byte of data
+// either way.
+func FuzzFlowClientConn(f *testing.F) {
+	var cl bytes.Buffer
+	fc := http2.NewFramer(&cl, nil)
+	fc.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20})
+	fc.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: []byte{0x82}, EndHeaders: true, EndStream: true})
+	fc.WriteWindowUpdate(1, 70000)
+	fc.WriteWindowUpdate(0, 70000)
+	fc.WriteHeaders(http2.HeadersFrameParam{StreamID: 3, BlockFragment: []byte{0x82}, EndHeaders: true})
+	fc.WriteData(3, true, make([]byte, 100))
+	// A stock server, which the client pings, and a governed one, whose
+	// tagged PING hands the client over.
+	for _, governed := range []bool{false, true} {
+		var srv bytes.Buffer
+		fs := http2.NewFramer(&srv, nil)
+		fs.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 1 << 20})
+		if governed {
+			var tagged [8]byte
+			binary.BigEndian.PutUint32(tagged[:], flowPingTag)
+			fs.WritePing(false, tagged)
+		}
+		fs.WriteSettings()
+		fs.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: []byte{0x88}, EndHeaders: true})
+		// Under the 65535 the connection starts with: the client's credit
+		// may come after.
+		for range 3 {
+			fs.WriteData(1, false, make([]byte, 16000))
+		}
+		fs.WriteRSTStream(3, http2.ErrCodeCancel)
+		fs.WriteGoAway(1, http2.ErrCodeNo, nil)
+		f.Add(cl.Bytes(), srv.Bytes(), uint8(5))
+		f.Add(cl.Bytes(), srv.Bytes(), uint8(15))
+	}
+
+	f.Fuzz(fuzzFlowClient)
+}
+
+func fuzzFlowClient(t *testing.T, fromClient, fromServer []byte, cut uint8) {
+	sc := &scriptConn{}
+	c := newFlowClientConn(sc)
+	defer c.Close()
+	step := int(cut%16) + 1
+	frames := serverFrames(fromServer)
+	in := append([]byte(h2Preface), fromClient...)
+	var toServer, toClient []byte
+	scanned, cutShort := len(h2Preface), false
+	buf := make([]byte, 64<<10)
+	for len(in) > 0 || len(frames) > 0 {
+		if len(in) > 0 {
+			n := min(step, len(in))
+			if _, err := c.Write(in[:n]); err != nil {
+				if !c.isBroken() {
+					t.Fatal(err)
+				}
+				break
+			}
+			in = in[n:]
+		}
+		c.wmu.Lock()
+		//nolint:staticcheck // empty critical section: only waits for the holder
+		c.wmu.Unlock()
+		toServer = append(toServer, sc.take()...)
+		// Answers go in only between whole frames outside a header
+		// block, where the server's stack could send them, and not after
+		// a piece that ends inside a frame.
+		if !cutShort && (len(frames) == 0 || frames[0].between) {
+			var pings [][8]byte
+			pings, scanned = unansweredPings(toServer, scanned)
+			for _, p := range pings {
+				sc.feed(frames2(func(fr *http2.Framer) { fr.WritePing(true, p) }))
+			}
+		}
+		if len(frames) > 0 {
+			sc.feed(frames[0].b)
+			cutShort = frames[0].partial
+			frames = frames[1:]
+		}
+		got, err := readAvailable(c, buf)
+		toClient = append(toClient, got...)
+		if err != nil {
+			if !c.isBroken() {
+				t.Fatal(err)
+			}
+			break
+		}
+	}
+	c.mu.Lock()
+	streams := len(c.streams)
+	c.mu.Unlock()
+	if streams > len(fromClient)/h2FrameHeader+1 {
+		t.Fatalf("%d streams tracked from %d input bytes", streams, len(fromClient))
+	}
+	if err := downCountersAgree(c); err != nil {
+		t.Fatal(err)
+	}
+	if c.isBroken() {
+		return
+	}
+	if len(toServer) < len(h2Preface) {
+		t.Fatalf("%d bytes reached the server", len(toServer))
+	}
+	if sent, got := dataFrames(fromClient), dataFrames(toServer[len(h2Preface):]); !bytes.Equal(sent, got) {
+		t.Fatalf("the server read %d bytes of data frames, the client sent %d", len(got), len(sent))
+	}
+	if sent, got := dataFrames(fromServer), dataFrames(toClient); !bytes.Equal(sent, got) {
+		t.Fatalf("the client read %d bytes of data frames, the server sent %d", len(got), len(sent))
+	}
+}
+
+func frames2(f func(fr *http2.Framer)) []byte {
+	var b bytes.Buffer
+	f(http2.NewFramer(&b, nil))
+	return b.Bytes()
+}
+
+// serverFrame is one frame of the server's bytes, whether an answer may come
+// before it, not inside a header block, and whether it ends inside a frame.
+type serverFrame struct {
+	b       []byte
+	between bool
+	partial bool
+}
+
+// serverFrames splits b into frames by their headers; what is left past the
+// last whole one comes as one more piece.
+func serverFrames(b []byte) []serverFrame {
+	var out []serverFrame
+	inBlock := false
+	for len(b) >= h2FrameHeader {
+		n := h2FrameHeader + (int(b[0])<<16 | int(b[1])<<8 | int(b[2]))
+		if n > len(b) {
+			break
+		}
+		out = append(out, serverFrame{b: b[:n], between: !inBlock})
+		switch b[3] {
+		case h2Headers, h2PushPromise, h2Continuation:
+			inBlock = b[4]&h2FlagEndHeaders == 0
+		}
+		b = b[n:]
+	}
+	if len(b) > 0 {
+		out = append(out, serverFrame{b: b, between: !inBlock, partial: true})
+	}
+	return out
+}
+
+// unansweredPings walks the whole frames of b past from and returns the
+// payloads of the PINGs among them that ask for an answer, and where the
+// walk stopped.
+func unansweredPings(b []byte, from int) ([][8]byte, int) {
+	var out [][8]byte
+	for len(b)-from >= h2FrameHeader {
+		h := b[from:]
+		n := int(h[0])<<16 | int(h[1])<<8 | int(h[2])
+		if len(h) < h2FrameHeader+n {
+			break
+		}
+		if h[3] == h2Ping && h[4]&h2FlagAck == 0 && n == 8 {
+			var p [8]byte
+			copy(p[:], h[h2FrameHeader:])
+			out = append(out, p)
+		}
+		from += h2FrameHeader + n
+	}
+	return out, from
+}
+
+// readAvailable reads what the governor passes on of what was fed so far.
+func readAvailable(c *flowConn, buf []byte) ([]byte, error) {
+	var got []byte
+	for {
+		n, err := c.Read(buf)
+		got = append(got, buf[:n]...)
+		if err != nil {
+			if errors.Is(err, os.ErrDeadlineExceeded) {
+				return got, nil
+			}
+			return got, err
+		}
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_goaway_test.go b/transport/internet/splithttp/h2flow_goaway_test.go
new file mode 100644
index 00000000..8b4a69e8
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_goaway_test.go
@@ -0,0 +1,81 @@
+package splithttp
+
+import (
+	"bytes"
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// TestFlowGoAwayDropsStreamsPastLast has the server send GOAWAY naming
+// stream 1 as its last, with downloads open on 1 and 3: stream 3 is one the
+// server will not take up, and the governor forgets it as the stacks do,
+// where it held its share of the client's credit and a stream's slot until
+// the connection closed. Stream 1 stays, and the GOAWAY reaches the client as
+// it was sent.
+func TestFlowGoAwayDropsStreamsPastLast(t *testing.T) {
+	h := newFlowHarness(t)
+	t.Cleanup(func() { h.c.Close() })
+	h.openRequest(1)
+	h.openRequest(3)
+	goAway := frames(func(fr *http2.Framer) { fr.WriteGoAway(1, http2.ErrCodeNo, []byte("bye")) })
+	got, err := h.fromServerRaw(goAway)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(got, goAway) {
+		t.Fatalf("the GOAWAY reached the client as %x, sent %x", got, goAway)
+	}
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if h.c.streams[3] != nil || h.c.downOpen != 1 {
+		t.Fatalf("after GOAWAY(last=1) stream 3 tracked: %v, %d downloads open", h.c.streams[3] != nil, h.c.downOpen)
+	}
+	if h.c.streams[1] == nil {
+		t.Fatal("stream 1, the last the server takes up, was dropped")
+	}
+}
+
+// TestFlowGoAwayLaterStreamNotTaken has the server send GOAWAY naming stream 1
+// as its last, and then the client's HEADERS for stream 3, sent before it saw
+// the GOAWAY, arrive: the server takes up no stream past its last, and the
+// governor neither tracks stream 3 nor credits it. Before, it did both, and
+// the credit counted against the send window of the streams still draining.
+func TestFlowGoAwayLaterStreamNotTaken(t *testing.T) {
+	h := newFlowHarnessWindow(t, flowServerSendWindow)
+	t.Cleanup(func() { h.c.Close() })
+	h.track()
+	h.openStream(4 << 20) // opens stream 1
+	h.fromServer(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: flowServerReceiveWindow})
+	})
+	now := time.Now()
+	h.c.mu.Lock()
+	h.c.downLearned.note(now, h.c.down.init, flowServerSendWindow)
+	h.c.upLearned.note(now, h.c.up.init, 2<<20)
+	h.c.mu.Unlock()
+
+	// Server sends GOAWAY(last=1) while stream 1 is still active.
+	goAway := frames(func(fr *http2.Framer) { fr.WriteGoAway(1, http2.ErrCodeNo, nil) })
+	if _, err := h.fromServerRaw(goAway); err != nil {
+		t.Fatal(err)
+	}
+
+	// Client's in-flight HEADERS for stream 3 arrives at flowReader after GOAWAY(last=1).
+	h.conn.take()
+	h.fromClient(func(fr *http2.Framer) {
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 3, BlockFragment: []byte{0x82}, EndHeaders: true})
+	})
+	h.sync()
+	toClient := h.conn.take()
+
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	t.Logf("after post-GOAWAY HEADERS(3): streams[3]=%v, downOpen=%d, downOpenForwarded=%d, clientHolds=%d (sendWindow=%d), toClient=%x",
+		h.c.streams[3] != nil, h.c.downOpen, h.c.downOpenForwarded, h.c.clientHolds(), h.c.sendWindow, toClient)
+	if h.c.streams[3] != nil || h.c.downOpen != 1 || len(toClient) != 0 {
+		t.Fatalf("post-GOAWAY(last=1) in-flight stream 3 was tracked, leaked, and credited: streams[3]=%v, downOpen=%d, clientHolds=%d/%d, toClient=%x",
+			h.c.streams[3] != nil, h.c.downOpen, h.c.clientHolds(), h.c.sendWindow, toClient)
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_group.go b/transport/internet/splithttp/h2flow_group.go
new file mode 100644
index 00000000..642750a9
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_group.go
@@ -0,0 +1,140 @@
+package splithttp
+
+import (
+	"math"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// A client's governed connections to one server share the path to it. One
+// connection cannot tell a path whose round trip has risen from a queue its
+// siblings and it fill: in both its windows sit at init with the round trip
+// over the kernel's floor, and a wider window of its own takes a larger share
+// of a full link as it fills an empty one. The client as a whole can: where
+// the path has room, wider windows on every connection carry more in all;
+// where the client fills the link, they carry the same and only queue. So the
+// connections of a group probe together, and a path that answers the probe
+// is one whose round trip has moved.
+const (
+	// flowProbeGain widens the windows during a probe, and flowProbeAnswer
+	// is the rise in what the group carries that counts as an answer.
+	flowProbeGain   = 1.25
+	flowProbeAnswer = 1.15
+	// A probe that got no answer is not tried again for flowProbeQuiet, twice
+	// that after each further one up to flowProbeQuietMost: a client that
+	// fills its link keeps its own queue, and each probe adds to it for a
+	// while. One that did is tried again after flowProbeAgain.
+	flowProbeQuiet     = 30 * time.Second
+	flowProbeQuietMost = 5 * time.Minute
+	flowProbeAgain     = 10 * time.Second
+	// flowProbeAfter is how long downloads sit at init under a raised round
+	// trip before their connection asks for a probe.
+	flowProbeAfter = 5 * time.Second
+	// flowProbeLeast is the least time each half of a probe measures over.
+	flowProbeLeast = 400 * time.Millisecond
+	// A probe is only asked for once what the group carries has fallen under
+	// flowProbeDrop of the most it carried lately, the most halving every
+	// flowProbePeakHalf: a path whose round trip rose took the rate with it,
+	// while a client that fills its link carries the same as before.
+	flowProbeDrop     = 0.5
+	flowProbePeakHalf = time.Minute
+)
+
+const (
+	flowProbeIdle = iota
+	flowProbeBefore
+	flowProbeWide
+)
+
+// flowGroup is what a client's connections to one server share: the bytes
+// they have received, and the probe.
+type flowGroup struct {
+	key   string
+	refs  int
+	bytes atomic.Int64
+
+	mu    sync.Mutex
+	phase int
+	at    time.Time
+	mark  int64
+	span  time.Duration
+	rate  float64
+	moved time.Time
+	next  time.Time
+	quiet time.Duration
+	// cur is what the group carried over the last second, peak the most it
+	// carried lately; rAt and rMark start the second.
+	cur, peak float64
+	rAt       time.Time
+	rMark     int64
+}
+
+var flowGroups = struct {
+	sync.Mutex
+	m map[string]*flowGroup
+}{m: map[string]*flowGroup{}}
+
+func joinFlowGroup(key string) *flowGroup {
+	flowGroups.Lock()
+	defer flowGroups.Unlock()
+	g := flowGroups.m[key]
+	if g == nil {
+		g = &flowGroup{key: key}
+		flowGroups.m[key] = g
+	}
+	g.refs++
+	return g
+}
+
+func (g *flowGroup) leave() {
+	flowGroups.Lock()
+	defer flowGroups.Unlock()
+	if g.refs--; g.refs <= 0 {
+		delete(flowGroups.m, g.key)
+	}
+}
+
+// request starts a probe unless one runs or one ended lately. rtt is the
+// round trip the requester sees; each half measures over four of them.
+func (g *flowGroup) request(now time.Time, rtt time.Duration) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.phase != flowProbeIdle || now.Before(g.next) || g.cur >= flowProbeDrop*g.peak {
+		return
+	}
+	g.phase, g.at, g.mark, g.span = flowProbeBefore, now, g.bytes.Load(), max(4*rtt, flowProbeLeast)
+}
+
+// step moves the probe on and reports whether windows are to be wide now,
+// and when the path last answered a probe.
+func (g *flowGroup) step(now time.Time) (wide bool, moved time.Time) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.rAt.IsZero() {
+		g.rAt, g.rMark = now, g.bytes.Load()
+	} else if d := now.Sub(g.rAt); d >= time.Second {
+		got := g.bytes.Load()
+		g.cur = float64(got-g.rMark) / d.Seconds()
+		g.peak = max(g.cur, g.peak*math.Exp2(-d.Seconds()/flowProbePeakHalf.Seconds()))
+		g.rAt, g.rMark = now, got
+	}
+	if g.phase != flowProbeIdle && now.Sub(g.at) >= g.span {
+		got := g.bytes.Load()
+		rate := float64(got-g.mark) / now.Sub(g.at).Seconds()
+		switch g.phase {
+		case flowProbeBefore:
+			g.phase, g.rate = flowProbeWide, rate
+		case flowProbeWide:
+			g.phase = flowProbeIdle
+			if g.rate > 0 && rate >= flowProbeAnswer*g.rate {
+				g.moved, g.next, g.quiet = now, now.Add(flowProbeAgain), 0
+			} else {
+				g.quiet = min(max(2*g.quiet, flowProbeQuiet), flowProbeQuietMost)
+				g.next = now.Add(g.quiet)
+			}
+		}
+		g.at, g.mark = now, got
+	}
+	return g.phase == flowProbeWide, g.moved
+}
diff --git a/transport/internet/splithttp/h2flow_group_test.go b/transport/internet/splithttp/h2flow_group_test.go
new file mode 100644
index 00000000..be3d32ba
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_group_test.go
@@ -0,0 +1,195 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// TestFlowGroupProbe runs a probe of a group whose connections carry a
+// steady rate before it and, while their windows are wide, a quarter more:
+// the path answered, so it has moved. Then one where the rate stays: a link
+// the client fills, no answer, and no new probe until flowProbeQuiet.
+func TestFlowGroupProbe(t *testing.T) {
+	run := func(g *flowGroup, now time.Time, before, wide int64) (time.Time, time.Time) {
+		g.peak = 4 * float64(before) // the rate fell, as when the path moved
+		g.request(now, 100*time.Millisecond)
+		for range 2 * 10 {
+			is, _ := g.step(now)
+			rate := before
+			if is {
+				rate = wide
+			}
+			g.bytes.Add(rate / 20)
+			now = now.Add(50 * time.Millisecond)
+		}
+		_, moved := g.step(now)
+		return now, moved
+	}
+	g := &flowGroup{key: "a"}
+	now, moved := run(g, time.Unix(1, 0), 1e6, 1.25e6)
+	if moved.IsZero() {
+		t.Fatal("a quarter more over the probe read as no answer")
+	}
+
+	g = &flowGroup{key: "b"}
+	now, moved = run(g, now, 1e6, 1e6)
+	if !moved.IsZero() {
+		t.Fatal("the same rate over the probe read as an answer")
+	}
+	g.request(now.Add(flowProbeQuiet/2), 100*time.Millisecond)
+	if g.phase != flowProbeIdle {
+		t.Fatalf("a probe started %v after one with no answer", flowProbeQuiet/2)
+	}
+}
+
+// TestFlowGroupShared has two connections join the same server's group and a
+// third another's; the group goes once the last of its connections does.
+func TestFlowGroupShared(t *testing.T) {
+	a, b, c := joinFlowGroup("s:1"), joinFlowGroup("s:1"), joinFlowGroup("s:2")
+	if a != b || a == c {
+		t.Fatal("connections to one server do not share a group, or to two servers do")
+	}
+	a.leave()
+	if joinFlowGroup("s:1") != b {
+		t.Fatal("the group went while a connection still used it")
+	}
+	b.leave()
+	b.leave()
+	c.leave()
+	flowGroups.Lock()
+	left := len(flowGroups.m)
+	flowGroups.Unlock()
+	if left != 0 {
+		t.Fatalf("%d groups left after every connection went", left)
+	}
+}
+
+// TestFlowGroupQuietGrows has probe after probe go unanswered: each waits
+// twice as long as the one before, up to flowProbeQuietMost, and an answer
+// brings the wait back.
+func TestFlowGroupQuietGrows(t *testing.T) {
+	g := &flowGroup{key: "q"}
+	now := time.Unix(1, 0)
+	var waits []time.Duration
+	for range 6 {
+		g.peak, g.cur = 1e6, 0
+		g.request(now, 100*time.Millisecond)
+		for g.phase != flowProbeIdle {
+			now = now.Add(100 * time.Millisecond)
+			g.bytes.Add(1000)
+			g.step(now)
+		}
+		waits = append(waits, g.next.Sub(now))
+		now = g.next
+	}
+	want := []time.Duration{30 * time.Second, time.Minute, 2 * time.Minute, 4 * time.Minute, 5 * time.Minute, 5 * time.Minute}
+	for i := range want {
+		if waits[i] != want[i] {
+			t.Fatalf("waits after unanswered probes %v, want %v", waits, want)
+		}
+	}
+}
+
+// TestFlowGroupNoProbeAtSteadyRate has a group carry the same every second, as
+// a client that fills its link does: no connection's request starts a probe.
+// Once the rate falls to a quarter, one does.
+func TestFlowGroupNoProbeAtSteadyRate(t *testing.T) {
+	g := &flowGroup{key: "steady"}
+	now := time.Unix(1, 0)
+	feed := func(rate int64, d time.Duration) {
+		for end := now.Add(d); now.Before(end); now = now.Add(100 * time.Millisecond) {
+			g.bytes.Add(rate / 10)
+			g.step(now)
+		}
+	}
+	feed(10e6, 20*time.Second)
+	g.request(now, 100*time.Millisecond)
+	if g.phase != flowProbeIdle {
+		t.Fatal("a probe started at a steady rate")
+	}
+	feed(2.5e6, 3*time.Second)
+	g.request(now, 100*time.Millisecond)
+	if g.phase == flowProbeIdle {
+		t.Fatal("no probe once the rate fell to a quarter")
+	}
+}
+
+// TestFlowClientProbeWidensOnce is a client whose group probes while a
+// settled download credits forty times within one model round: the probe
+// widens the round's target once, not the cap with every credit.
+func TestFlowClientProbeWidensOnce(t *testing.T) {
+	h, s := queuedDownload(t)
+	now := time.Now()
+	h.c.mu.Lock()
+	h.c.client = true
+	h.c.group = joinFlowGroup("probe-once")
+	h.c.group.phase, h.c.group.at, h.c.group.span = flowProbeWide, now, time.Second
+	h.c.rebase(now)
+	s.down.cap = h2InitWindow
+	s.down.steady = flowSettledRounds
+	s.down.mark = now
+	h.c.kAt = now.Add(time.Hour)
+	h.c.mu.Unlock()
+	if _, err := h.c.Write(frames(func(fr *http2.Framer) {
+		for range 40 {
+			fr.WriteWindowUpdate(1, 4096)
+		}
+	})); err != nil {
+		t.Fatal(err)
+	}
+	h.c.mu.Lock()
+	if s.down.cap > h2InitWindow*5/4+1 {
+		h.c.mu.Unlock()
+		t.Fatalf("cap=%d after one model round", s.down.cap)
+	}
+	// The round is over: the next credit sets the cap to the widened target
+	// of a reader that took 10 MB/s.
+	s.down.mark = s.down.mark.Add(-time.Second)
+	s.down.rates[0], s.down.rateAt = 10e6, 1
+	plain := s.down
+	plain.returned += 4096
+	plain.model(time.Now(), h.c.currentRTT(), h.c.down.init, h.c.down.max, 1)
+	h.c.mu.Unlock()
+	if plain.cap <= h2InitWindow*2 {
+		t.Fatalf("cap=%d without the probe, too low to tell a widening", plain.cap)
+	}
+	if _, err := h.c.Write(frames(func(fr *http2.Framer) { fr.WriteWindowUpdate(1, 4096) })); err != nil {
+		t.Fatal(err)
+	}
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if float64(s.down.cap) < float64(plain.cap)*(1+flowProbeGain)/2 {
+		t.Fatalf("cap=%d in a new round of a probe, %d without it", s.down.cap, plain.cap)
+	}
+}
+
+// TestFlowClientProbeWidensFromInit is a probe of a client whose download's
+// model sits under init, as it does where the kernel's floor stayed at the
+// path's old round trip: the new round widens the cap from init, or the
+// probe would see no answer for a path that moved.
+func TestFlowClientProbeWidensFromInit(t *testing.T) {
+	h, s := queuedDownload(t)
+	now := time.Now()
+	h.c.mu.Lock()
+	h.c.client = true
+	h.c.group = joinFlowGroup("probe-init")
+	h.c.group.phase, h.c.group.at, h.c.group.span = flowProbeWide, now, time.Second
+	h.c.rebase(now)
+	s.down.cap = h2InitWindow
+	s.down.steady = flowSettledRounds
+	s.down.rates, s.down.rateAt = [flowModelRounds]int64{}, 1
+	s.down.mark, s.down.markBase = now.Add(-time.Second), s.down.returned
+	h.c.kAt = now.Add(time.Hour)
+	h.c.mu.Unlock()
+	if _, err := h.c.Write(frames(func(fr *http2.Framer) { fr.WriteWindowUpdate(1, 4096) })); err != nil {
+		t.Fatal(err)
+	}
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	gain := flowProbeGain
+	if want := int32(h2InitWindow * gain); s.down.cap != want {
+		t.Fatalf("cap=%d in a new round of a probe from init, want %d", s.down.cap, want)
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_guard_test.go b/transport/internet/splithttp/h2flow_guard_test.go
new file mode 100644
index 00000000..a3a617d5
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_guard_test.go
@@ -0,0 +1,214 @@
+package splithttp
+
+import (
+	"context"
+	gotls "crypto/tls"
+	"io"
+	"net"
+	"net/http"
+	"sync"
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// TestFlowGuardNotPutOffByNewStreams has a stream run out of window with a
+// client that credits in large steps, and then another one every 40 ms,
+// sooner than the guard's delay: the guard still fires for the first.
+// Moved for each new stream, it fired only once they stopped coming.
+func TestFlowGuardNotPutOffByNewStreams(t *testing.T) {
+	defer func(d time.Duration) { flowGuardMin = d }(flowGuardMin)
+	flowGuardMin = 100 * time.Millisecond
+	c := newFlowConn(&scriptConn{}, flowDefault, flowDefault)
+	t.Cleanup(func() { c.Close() })
+	c.mu.Lock()
+	c.clientInit, c.clientShown = 1<<20, h2InitWindow
+	c.incremental = false
+	c.rtt = 20 * time.Millisecond
+	c.mu.Unlock()
+	stuck := func(id uint32) {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		s := &flowStream{downSent: h2InitWindow}
+		c.streams[id] = s
+		c.armGuard(s)
+	}
+	stuck(1)
+	for id := uint32(3); id < 23; id += 2 {
+		time.Sleep(40 * time.Millisecond)
+		c.mu.Lock()
+		fired := c.guardProbe
+		c.mu.Unlock()
+		if fired {
+			return
+		}
+		stuck(id)
+	}
+	t.Fatalf("stream 1 has waited %v with no probe, the guard's delay being %v", 400*time.Millisecond, flowGuardMin)
+}
+
+// TestFlowClientSeesGovernedServer feeds a governed client the server's first
+// frames: a PING ahead of any reply marks the server as one that governs its
+// downloads, a PING after a reply, as a stock server's keepalive, does not.
+func TestFlowClientSeesGovernedServer(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		frames   func(fr *http2.Framer)
+		governed bool
+	}{
+		{"tagged PING with the first SETTINGS", func(fr *http2.Framer) {
+			fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 1 << 20})
+			fr.WritePing(false, [8]byte{0x6b, 0x7a, 0x3f, 0x91, 1, 2, 3, 4})
+		}, true},
+		// A stock server's health check, as http2.Server with ReadIdleTimeout
+		// sends while a handler holds its first reply.
+		{"untagged early PING", func(fr *http2.Framer) {
+			fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 1 << 20})
+			fr.WritePing(false, [8]byte{1})
+		}, false},
+		{"PING after a reply", func(fr *http2.Framer) {
+			fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 1 << 20})
+			fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: []byte{0x88}, EndHeaders: true})
+			fr.WritePing(false, [8]byte{0x6b, 0x7a, 0x3f, 0x91, 1, 2, 3, 4})
+		}, false},
+		{"no PING", func(fr *http2.Framer) {
+			fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 1 << 20})
+		}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c := newFlowClientConn(&scriptConn{})
+			t.Cleanup(func() { c.Close() })
+			c.mode.Store(flowH2)
+			c.fromServer(frames(tc.frames), nil)
+			c.mu.Lock()
+			got := c.peerGoverned
+			c.mu.Unlock()
+			if got != tc.governed {
+				t.Fatalf("server taken as governed: %v, want %v", got, tc.governed)
+			}
+		})
+	}
+}
+
+// TestFlowClientNotFooledByStockHealthCheck puts a governed client in front of
+// an unmodified x/net HTTP/2 server with a 10 ms ReadIdleTimeout whose handler
+// holds its first reply: the server's health-check PINGs come before any
+// reply, and the client must keep governing.
+func TestFlowClientNotFooledByStockHealthCheck(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fc *flowConn
+	var served []net.Conn
+	var mu sync.Mutex
+	tr := &http2.Transport{
+		AllowHTTP: true,
+		DialTLSContext: func(ctx context.Context, network, addr string, _ *gotls.Config) (net.Conn, error) {
+			c, err := (&net.Dialer{}).DialContext(ctx, network, ln.Addr().String())
+			if err != nil {
+				return nil, err
+			}
+			g := newFlowClientConn(c)
+			mu.Lock()
+			fc = g
+			mu.Unlock()
+			return g, nil
+		},
+	}
+	// The client connection holds a flowGroup until it closes: close it,
+	// whatever the test ends with, so that no group outlives the test.
+	t.Cleanup(func() {
+		ln.Close()
+		tr.CloseIdleConnections()
+		mu.Lock()
+		defer mu.Unlock()
+		if fc != nil {
+			fc.Close()
+		}
+		for _, c := range served {
+			c.Close()
+		}
+	})
+	srv := &http2.Server{ReadIdleTimeout: 10 * time.Millisecond, PingTimeout: time.Second}
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			served = append(served, c)
+			mu.Unlock()
+			go srv.ServeConn(c, &http2.ServeConnOpts{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				time.Sleep(300 * time.Millisecond)
+				w.Write([]byte("ok"))
+			})})
+		}
+	}()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, "http://x/", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := (&http.Client{Transport: tr}).Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	io.ReadAll(resp.Body)
+	resp.Body.Close()
+	mu.Lock()
+	defer mu.Unlock()
+	fc.mu.Lock()
+	defer fc.mu.Unlock()
+	if fc.peerGoverned {
+		t.Fatal("a stock server's health-check PING was taken for a governed server")
+	}
+}
+
+// TestFlowClientMalformedOwnedAckReachesStack drives a governed client through
+// its SETTINGS, a governed server's tagged PING and the write that carries
+// the client's own SETTINGS, forwards the ACK of the stack's SETTINGS, and
+// then has the server send a SETTINGS ACK with a payload, a FRAME_SIZE_ERROR:
+// it reaches the stack whole, for the stack to raise, and does not stand for
+// the ACK of the governor's SETTINGS.
+func TestFlowClientMalformedOwnedAckReachesStack(t *testing.T) {
+	sc := &scriptConn{}
+	c := newFlowClientConn(sc)
+	t.Cleanup(func() { c.Close() })
+	c.mode.Store(flowH2)
+	if _, err := c.writeToServer(frames(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20})
+	})); err != nil {
+		t.Fatal(err)
+	}
+	c.fromServer(frames(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 1 << 20})
+		fr.WritePing(false, [8]byte{0x6b, 0x7a, 0x3f, 0x91, 1, 2, 3, 4})
+	}), nil)
+	if _, err := c.writeToServer(frames(func(fr *http2.Framer) {
+		fr.WritePing(true, [8]byte{0x6b, 0x7a, 0x3f, 0x91, 1, 2, 3, 4})
+	})); err != nil {
+		t.Fatal(err)
+	}
+	c.mu.Lock()
+	owned := len(c.settingsOwn) == 2 && c.settingsOwn[1]
+	c.mu.Unlock()
+	if !owned {
+		t.Fatal("the client sent no SETTINGS of its own")
+	}
+	if out := c.fromServer(frames(func(fr *http2.Framer) { fr.WriteSettingsAck() }), nil); len(out) != h2FrameHeader {
+		t.Fatalf("the ACK of the stack's SETTINGS reached it as %d bytes", len(out))
+	}
+	bad := []byte{0, 0, 6, h2Settings, h2FlagAck, 0, 0, 0, 0, 0, 4, 0, 0, 0, 1}
+	if out := c.fromServer(append([]byte(nil), bad...), nil); len(out) != len(bad) {
+		t.Fatalf("a SETTINGS ACK with a payload reached the stack as %d of its %d bytes", len(out), len(bad))
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if len(c.settingsOwn) != 1 || !c.settingsOwn[0] {
+		t.Fatalf("the malformed ACK took the governor's SETTINGS off the queue: %v", c.settingsOwn)
+	}
+}
