From 6cc42c2370f6f4243161c5f7ba65e4fde1f1b3e9 Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Tue, 13 Oct 2026 18:17:51 +0300
Subject: [PATCH] XHTTP: Check each frame's own flow governor credit and that
 none stays owed

A hold on the connection credit released where a stream's WINDOW_UPDATE is read moved it a round later for good, and the sums over a round still came out. The two frames are fed one at a time and each checked for what it frees, and both upload tests end by asserting that no credit is still due.
---
 .../internet/splithttp/h2flow_credit_test.go  | 44 ++++++++++++++-----
 .../splithttp/h2flow_sendwindow_test.go       |  6 +--
 2 files changed, 36 insertions(+), 14 deletions(-)

diff --git a/transport/internet/splithttp/h2flow_credit_test.go b/transport/internet/splithttp/h2flow_credit_test.go
index e417c9e43..62f80c305 100644
--- a/transport/internet/splithttp/h2flow_credit_test.go
+++ b/transport/internet/splithttp/h2flow_credit_test.go
@@ -40,6 +40,21 @@ var rampStates = []struct {
 	{"no longer speeding up", true},
 }
 
+// owesNothing fails the test if the governor still has upload credit for the
+// client that it could hand on now, for the stream or for the connection:
+// credit that goes on a round late adds up to the right sums from then on.
+func owesNothing(t *testing.T, h *flowHarness, id uint32) {
+	t.Helper()
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if rel := h.c.upRelease(h.c.streams[id]); rel > 0 {
+		t.Fatalf("%d bytes of stream credit are due and were not handed on", rel)
+	}
+	if rel := h.c.upConnRelease(); rel > 0 {
+		t.Fatalf("%d bytes of connection credit are due and were not handed on", rel)
+	}
+}
+
 // TestFlowUploadCreditNotHeld is the upload side of a server. The local
 // server returns an upload's credit 4 KiB at a time, and the client is handed
 // each piece as it comes, for the stream and for the connection, whether or
@@ -92,6 +107,7 @@ func TestFlowUploadCreditNotHeld(t *testing.T) {
 						}
 					}
 				}
+				owesNothing(t, h, id)
 				if got := h.c.streams[id].up.ramped; got != state.ramped {
 					t.Fatalf("the upload ended the test with ramped %v, want %v", got, state.ramped)
 				}
@@ -105,7 +121,9 @@ func TestFlowUploadCreditNotHeld(t *testing.T) {
 // cap opens with every credit, and the room its stream has on the connection
 // opens with it: that credit is due where the stream's WINDOW_UPDATE is read,
 // after the connection's own has been handed on. Each piece of 4 KiB here
-// opens the cap by 8 KiB, and the client is handed both at once.
+// opens the cap by 8 KiB. The two frames are fed one at a time, so that each
+// answers for what it frees: credit that left a round late would still add
+// up over the two.
 func TestFlowUploadConnectionCreditFollowsCap(t *testing.T) {
 	const id, piece, pieces = 1, 4 << 10, 16
 	for _, state := range rampStates {
@@ -118,31 +136,35 @@ func TestFlowUploadConnectionCreditFollowsCap(t *testing.T) {
 			// Under the cap a stream starts with, so the cap is what the stream
 			// counts for on the connection, and more than is returned below.
 			h.fromClient(func(fr *http2.Framer) { writeDataSplit(fr, id, 200<<10) })
-			credit := func() []byte {
-				return h.fromServer(func(fr *http2.Framer) {
-					fr.WriteWindowUpdate(0, piece)
-					fr.WriteWindowUpdate(id, piece)
-				})
+			credit := func(stream uint32) map[uint32]uint64 {
+				count, sum := map[uint32]int{}, map[uint32]uint64{}
+				windowUpdates(t, h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(stream, piece) }), count, sum)
+				return sum
 			}
 			// Enough for the cap to start opening with every piece.
 			for i := 0; i < 32; i++ {
-				credit()
+				credit(0)
+				credit(id)
 			}
+			owesNothing(t, h, id)
 			h.c.mu.Lock()
 			h.c.streams[id].up.ramped = state.ramped
 			h.c.mu.Unlock()
 			for i := 0; i < pieces; i++ {
+				if sum := credit(0); sum[0] != piece || sum[id] != 0 {
+					t.Fatalf("piece %d, the connection's frame: %d bytes of connection credit and %d of stream credit went on, want its own %d and none", i, sum[0], sum[id], piece)
+				}
 				before := h.c.streams[id].up.cap
-				count, sum := map[uint32]int{}, map[uint32]uint64{}
-				windowUpdates(t, credit(), count, sum)
+				sum := credit(id)
 				opened := uint64(h.c.streams[id].up.cap - before)
 				if opened == 0 {
 					t.Fatalf("piece %d: the cap stayed at %d, so no connection credit followed it", i, before)
 				}
-				if sum[0] != piece+opened {
-					t.Fatalf("piece %d: %d connection updates carrying %d bytes went on, want the %d returned and the %d the cap opened by", i, count[0], sum[0], piece, opened)
+				if sum[0] != opened {
+					t.Fatalf("piece %d, the stream's frame: %d bytes of connection credit went on, want the %d the cap opened by", i, sum[0], opened)
 				}
 			}
+			owesNothing(t, h, id)
 		})
 	}
 }
diff --git a/transport/internet/splithttp/h2flow_sendwindow_test.go b/transport/internet/splithttp/h2flow_sendwindow_test.go
index e3b8b343a..24777abfc 100644
--- a/transport/internet/splithttp/h2flow_sendwindow_test.go
+++ b/transport/internet/splithttp/h2flow_sendwindow_test.go
@@ -609,7 +609,7 @@ func TestFlowSendWindowSettingsCost(t *testing.T) {
 	n := 50
 	few := cost(hFew, n)
 	for few < enough && n < mostFrames {
-		n *= 2
+		n = min(2*n, mostFrames)
 		few = cost(hFew, n)
 	}
 	if few < enough {
@@ -669,8 +669,8 @@ func refusedAtFullLimit(tb testing.TB, n int) (c *flowConn, window int64) {
 // no stream and allocates nothing. A queue of the streams the limit kept
 // credit from, walked after every frame from the client, handed nothing on
 // here while credit quanta held a grant of 4 KiB back, and put every stream
-// back: it allocated once a frame with sixty streams. The quanta are gone
-// and so is the queue; that connection credit looks at no stream stays. The count does not depend on
+// back: it allocated once a frame with sixty streams. The quanta and the
+// queue are gone; connection credit still looks at no stream. The count does not depend on
 // the clock; BenchmarkFlowConnectionCredit has the time, which a walk that
 // allocated nothing would show only there.
 func TestFlowSendWindowConnectionCreditAllocs(t *testing.T) {
-- 
