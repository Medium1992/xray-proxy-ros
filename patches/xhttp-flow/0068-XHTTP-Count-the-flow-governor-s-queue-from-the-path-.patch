From 5c915b79e52ee6bd351801676ef14970ae0e461a Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Sat, 24 Oct 2026 14:22:43 +0300
Subject: [PATCH] XHTTP: Count the flow governor's queue from the path's own
 round trip once the path has moved

---
 transport/internet/splithttp/h2flow.go        | 85 +++++++++++++++++-
 .../internet/splithttp/h2flow_rebase_test.go  | 90 +++++++++++++++++++
 2 files changed, 174 insertions(+), 1 deletion(-)
 create mode 100644 transport/internet/splithttp/h2flow_rebase_test.go

diff --git a/transport/internet/splithttp/h2flow.go b/transport/internet/splithttp/h2flow.go
index f7e77688b..d8499aaef 100644
--- a/transport/internet/splithttp/h2flow.go
+++ b/transport/internet/splithttp/h2flow.go
@@ -725,6 +725,17 @@ type flowConn struct {
 	kstat tcpStats
 	kAt   time.Time
 	kOK   bool
+	// base is the round trip of the empty path once the path itself has
+	// moved, see kernelStats: zero while the kernel's min_rtt stands for it.
+	base time.Duration
+	// baseStep is what the path added to the kernel's floor when base was
+	// last taken.
+	baseStep time.Duration
+	baseWin  flowMinWindow
+	lowGain  time.Time
+	// pinned says the downloads that took data lately all have caps at
+	// init, see cutGain.
+	pinned bool
 
 	// noQueueCuts leaves the queue on the path to TCP: a server that sets
 	// it neither runs pi nor cuts against a long queue, and its downloads'
@@ -767,15 +778,17 @@ func (c *flowConn) cutGain(now time.Time) float64 {
 	if !c.kOK || !c.effect.due(now, max(c.kstat.minRTT, flowModelMinRound)) {
 		return c.effect.value()
 	}
-	var caps int64
+	var caps, n int64
 	for _, s := range c.streams {
 		if s.down.returned != s.down.noted {
 			s.down.noted, s.down.tookAt = s.down.returned, now
 		}
 		if !s.serverDone && now.Sub(s.down.tookAt) < max(flowEffectRecent*c.kstat.minRTT, time.Second) {
 			caps += int64(s.down.cap)
+			n++
 		}
 	}
+	c.pinned = n > 0 && caps <= 2*n*int64(c.down.init)
 	set := max(c.kstat.minRTT/4, 4*c.kstat.rttVar, flowPIMinSet)
 	return c.effect.note(now, c.kstat.rtt, c.kstat.minRTT, set, c.kstat.inFlight, caps)
 }
@@ -789,10 +802,80 @@ func (c *flowConn) kernelStats(now time.Time) bool {
 	if now.Sub(c.kAt) >= flowKernelEvery {
 		c.kAt = now
 		c.kstat, c.kOK = readTCPStats(c.tcp)
+		if c.kOK && c.kstat.minRTT > 0 {
+			c.rebase(now)
+		}
 	}
 	return c.kOK && c.kstat.minRTT > 0
 }
 
+// flowBaseWindow is how long the round trip must stand over the kernel's
+// min_rtt, with cuts that do not move it, before that is the path's own.
+const flowBaseWindow = 2500 * time.Millisecond
+
+// rebase has the queue counted from the path's round trip where the path
+// itself has moved. The kernel keeps its min_rtt for minutes, so a route or
+// cell that adds to the round trip reads as a standing queue: cuts do not
+// shorten it, the gain comes down, and with an error that never turns the
+// caps never grow back. Once cuts have done nothing for flowBaseWindow, with
+// the downloads' caps at init all that time, and the round trip has not come
+// under the kernel's floor plus twice the setpoint since, its least value
+// over that time is the path's. A queue of the server's own is its downloads'
+// data: their caps are well above init, and the gain of connections that
+// share it reads low now and then, which alone took a queue of the server's
+// own for the path's. The base only falls after that, with the round trip,
+// so a queue of the server's own on top of it never raises it; it is dropped
+// once the round trip has come back by half of what the path added. Half of
+// that, not the setpoint: the setpoint grows with the round trip's variance,
+// and a step of a few setpoints would lose its base to a jittery round.
+func (c *flowConn) rebase(now time.Time) {
+	floor := c.kstat.minRTT
+	least := c.baseWin.note(now, c.kstat.rtt)
+	set := max(floor/4, 4*c.kstat.rttVar, flowPIMinSet)
+	if c.base != 0 {
+		c.base = min(c.base, least)
+		if c.base-floor <= c.baseStep/2 {
+			c.base = 0
+		}
+	}
+	if c.effect.active && c.effect.gain < 0.5 && c.pinned {
+		if c.lowGain.IsZero() {
+			c.lowGain = now
+		}
+	} else {
+		c.lowGain = time.Time{}
+	}
+	if c.base == 0 && !c.lowGain.IsZero() && now.Sub(c.lowGain) >= flowBaseWindow && c.baseWin.full(now) &&
+		least > floor+2*set {
+		c.base, c.baseStep = least, least-floor
+		c.lowGain = time.Time{}
+	}
+	c.kstat.minRTT = max(floor, c.base)
+}
+
+// flowMinWindow is the least of a value over the last one to two
+// flowBaseWindow halves.
+type flowMinWindow struct {
+	start, at time.Time
+	cur, prev time.Duration
+}
+
+func (w *flowMinWindow) note(now time.Time, v time.Duration) time.Duration {
+	if w.start.IsZero() {
+		w.start, w.at, w.cur, w.prev = now, now, v, v
+	}
+	if now.Sub(w.at) >= flowBaseWindow/2 {
+		w.at, w.prev, w.cur = now, w.cur, v
+	}
+	w.cur = min(w.cur, v)
+	return min(w.cur, w.prev)
+}
+
+// full reports whether the window has covered flowBaseWindow.
+func (w *flowMinWindow) full(now time.Time) bool {
+	return !w.start.IsZero() && now.Sub(w.start) >= flowBaseWindow
+}
+
 // pingFloor is the round trip of the empty path for pingQueueing. The first
 // PING's ACK can already wait behind data the peer pushed while its TCP was
 // still in slow start, so the kernel's min_rtt, taken at the TCP handshake,
diff --git a/transport/internet/splithttp/h2flow_rebase_test.go b/transport/internet/splithttp/h2flow_rebase_test.go
new file mode 100644
index 000000000..d2d1296ca
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_rebase_test.go
@@ -0,0 +1,90 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+)
+
+// TestFlowRebase steps the path's round trip from 20 to 120 ms under a
+// kernel whose min_rtt stays at 20: with cuts that do not move the queue the
+// queue is counted from 120 ms once flowBaseWindow has passed, a queue of
+// the server's own on top of that does not raise it, and the path coming
+// back drops it. With cuts that work, the same round trip stays a queue.
+func TestFlowRebase(t *testing.T) {
+	const kernel = 20 * time.Millisecond
+	run := func(c *flowConn, now time.Time, rtt time.Duration, gain float64, d time.Duration) time.Time {
+		for end := now.Add(d); now.Before(end); now = now.Add(flowKernelEvery) {
+			c.effect.active, c.effect.gain, c.pinned = gain < 1, gain, true
+			c.kstat = tcpStats{rtt: rtt, minRTT: kernel, rttVar: time.Millisecond}
+			c.rebase(now)
+		}
+		return now
+	}
+	now := time.Unix(1, 0)
+
+	c := &flowConn{}
+	now = run(c, now, kernel, 1, time.Second)
+	now = run(c, now, 120*time.Millisecond, 0, flowBaseWindow/2)
+	if c.kstat.minRTT != kernel {
+		t.Fatalf("rebased to %v before cuts had failed for %v", c.kstat.minRTT, flowBaseWindow)
+	}
+	now = run(c, now, 120*time.Millisecond, 0, 2*flowBaseWindow)
+	if c.kstat.minRTT != 120*time.Millisecond {
+		t.Fatalf("after the path moved to 120 ms the queue counts from %v", c.kstat.minRTT)
+	}
+	now = run(c, now, 140*time.Millisecond, 1, 3*flowBaseWindow)
+	if c.kstat.minRTT != 120*time.Millisecond {
+		t.Fatalf("a queue of the server's own raised the base to %v", c.kstat.minRTT)
+	}
+	run(c, now, kernel, 1, 2*flowBaseWindow)
+	if c.kstat.minRTT != kernel || c.base != 0 {
+		t.Fatalf("the path came back and the queue still counts from %v", c.kstat.minRTT)
+	}
+
+	c = &flowConn{}
+	now = run(c, now, kernel, 1, time.Second)
+	run(c, now, 120*time.Millisecond, 1, 3*flowBaseWindow)
+	if c.kstat.minRTT != kernel {
+		t.Fatalf("cuts that work, and the queue still counts from %v", c.kstat.minRTT)
+	}
+}
+
+// TestFlowRebaseNotOwnQueue reads a low gain beside downloads whose caps are
+// well above init: the queue is their data, a gain that reads low now and
+// then on connections that share it, and the base stays the kernel's.
+func TestFlowRebaseNotOwnQueue(t *testing.T) {
+	c := &flowConn{}
+	now := time.Unix(1, 0)
+	for end := now.Add(3 * flowBaseWindow); now.Before(end); now = now.Add(flowKernelEvery) {
+		c.effect.active, c.effect.gain, c.pinned = true, 0.1, false
+		c.kstat = tcpStats{rtt: 110 * time.Millisecond, minRTT: 50 * time.Millisecond, rttVar: 100 * time.Microsecond}
+		c.rebase(now)
+	}
+	if c.kstat.minRTT != 50*time.Millisecond {
+		t.Fatalf("a queue of the server's own was taken for the path: the queue counts from %v", c.kstat.minRTT)
+	}
+}
+
+// TestFlowRebaseKeepsBaseThroughJitter steps the path by 20 ms and then has
+// the round trip's variance grow to 5 ms, a setpoint as large as the step:
+// the base stays until the path comes back.
+func TestFlowRebaseKeepsBaseThroughJitter(t *testing.T) {
+	c := &flowConn{}
+	now := time.Unix(1, 0)
+	step := func(rtt, rttVar time.Duration, gain float64, d time.Duration) {
+		for end := now.Add(d); now.Before(end); now = now.Add(flowKernelEvery) {
+			c.effect.active, c.effect.gain, c.pinned = gain < 1, gain, true
+			c.kstat = tcpStats{rtt: rtt, minRTT: 20 * time.Millisecond, rttVar: rttVar}
+			c.rebase(now)
+		}
+	}
+	step(40*time.Millisecond, time.Millisecond, 0, 2*flowBaseWindow)
+	step(40*time.Millisecond, 5*time.Millisecond, 1, 2*flowBaseWindow)
+	if c.kstat.minRTT != 40*time.Millisecond {
+		t.Fatalf("jitter on the moved path dropped the base: the queue counts from %v", c.kstat.minRTT)
+	}
+	step(20*time.Millisecond, time.Millisecond, 1, 2*flowBaseWindow)
+	if c.base != 0 {
+		t.Fatalf("the path came back and the base stayed at %v", c.base)
+	}
+}
-- 
