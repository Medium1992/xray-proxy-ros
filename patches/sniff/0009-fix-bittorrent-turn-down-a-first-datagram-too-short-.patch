From 5ddb61fae9135e2fef4a956cf5ff318eed22a758 Mon Sep 17 00:00:00 2001
From: medium <medium@debian.debian>
Date: Thu, 12 Nov 2026 02:40:39 +0300
Subject: [PATCH] fix(bittorrent): turn down a first datagram too short for a
 uTP header

The datagram sniffer passed such a datagram to SniffUTP, which asked for
more data, and the flow waited out the sniffing deadline although no later
datagram could change the first one. SniffUTPDatagram rejects it, as
SniffSTUNDatagram does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/dispatcher/sniffer.go                           |  2 +-
 app/dispatcher/sniffer_utp_datagrams_test.go        | 12 ++++++++++++
 common/protocol/bittorrent/bittorrent.go            |  9 +++++++++
 .../bittorrent/realworld_validation_test.go         | 13 +++++++++++++
 4 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/app/dispatcher/sniffer.go b/app/dispatcher/sniffer.go
index 46a50a7c..eb93a97b 100644
--- a/app/dispatcher/sniffer.go
+++ b/app/dispatcher/sniffer.go
@@ -75,7 +75,7 @@ func NewSniffer(ctx context.Context) *Sniffer {
 				protocolSniffer: func(c context.Context, b []byte) (SniffResult, error) { return bittorrent.SniffUTP(b) },
 				// A SYN is a whole datagram: read the first one, not the batch.
 				datagramSniffer: func(_ context.Context, _ []byte, datagrams [][]byte) (SniffResult, error) {
-					return bittorrent.SniffUTP(datagrams[0])
+					return bittorrent.SniffUTPDatagram(datagrams[0])
 				},
 				network: net.Network_UDP,
 			},
diff --git a/app/dispatcher/sniffer_utp_datagrams_test.go b/app/dispatcher/sniffer_utp_datagrams_test.go
index 4fc16a80..05160e4a 100644
--- a/app/dispatcher/sniffer_utp_datagrams_test.go
+++ b/app/dispatcher/sniffer_utp_datagrams_test.go
@@ -67,3 +67,15 @@ func TestSniffUTPRejectsDataInTheFirstDatagram(t *testing.T) {
 		t.Fatal("SYN with data in its datagram classified as bittorrent")
 	}
 }
+
+// A first datagram too short for a uTP header is no SYN, and the datagrams
+// after it do not change that: the flow is not held for another read.
+func TestSniffShortUTPDatagramReadsOnce(t *testing.T) {
+	ctx := snifferContext()
+	link := &countingReader{datagramReader: datagramReader{datagrams: [][]byte{make([]byte, 19)}}}
+	reader := newTestCachedReader(t, link)
+	_, err := sniff(ctx, reader, false, net.Network_UDP, newSniffer(ctx))
+	if link.reads != 1 {
+		t.Errorf("19-byte datagram: %d reads (%v), want 1", link.reads, err)
+	}
+}
diff --git a/common/protocol/bittorrent/bittorrent.go b/common/protocol/bittorrent/bittorrent.go
index a7eef454..fe229a11 100644
--- a/common/protocol/bittorrent/bittorrent.go
+++ b/common/protocol/bittorrent/bittorrent.go
@@ -195,6 +195,15 @@ func SniffLSD(b []byte) (*SniffHeader, error) {
 	return &SniffHeader{}, nil
 }
 
+// SniffUTPDatagram is SniffUTP for a whole datagram: one too short for the
+// header is no SYN, and no later datagram makes it one.
+func SniffUTPDatagram(d []byte) (*SniffHeader, error) {
+	if len(d) < 20 {
+		return nil, errNotBittorrent
+	}
+	return SniffUTP(d)
+}
+
 // isDNSQuery reports whether b reads as a DNS query: query flags with no
 // response code, and a first question whose name ends inside b and whose
 // class is one a query asks for. A SYN reads its connection id as the flags
diff --git a/common/protocol/bittorrent/realworld_validation_test.go b/common/protocol/bittorrent/realworld_validation_test.go
index 39c86c4b..ddf01e51 100644
--- a/common/protocol/bittorrent/realworld_validation_test.go
+++ b/common/protocol/bittorrent/realworld_validation_test.go
@@ -450,6 +450,19 @@ func TestSniffUTPIgnoresDNSQueries(t *testing.T) {
 	}
 }
 
+// A whole datagram shorter than the header is turned down, not waited on.
+func TestSniffUTPDatagramRejectsShortDatagrams(t *testing.T) {
+	syn := utpPacket(4, 0x07E1, someTimestamp(), 0, 0x100000, 0x7A10, 0, nil, nil)
+	for _, n := range []int{0, 1, 19} {
+		if _, err := SniffUTPDatagram(syn[:n]); err == nil || err == common.ErrNoClue {
+			t.Errorf("%d-byte datagram: %v, want a rejection", n, err)
+		}
+	}
+	if header, err := SniffUTPDatagram(syn); err != nil || header == nil {
+		t.Errorf("whole SYN: %v", err)
+	}
+}
+
 // TestSniffUTPTakesDNSCountShapedTimestamps keeps SYNs whose timestamp reads
 // as DNS QDCOUNT and ANCOUNT: without query flags and a question after them
 // they are no DNS query, whatever the timestamp.
-- 
