diff --git a/third_party/reality/input_pending.go b/third_party/reality/input_pending.go
new file mode 100644
index 00000000..42713f5b
--- /dev/null
+++ b/third_party/reality/input_pending.go
@@ -0,0 +1,41 @@
+package reality
+
+import "net"
+
+// Reality specific file: whether the client's next bytes already wait, as
+// a target that reads after its handshake would find them.
+
+// inputPending reports whether client data is buffered: read already, or
+// held by the kernel for the socket under the connection.
+func (c *Conn) inputPending() bool {
+	if c.rawInput != nil && c.rawInput.Len() > 0 {
+		return true
+	}
+	conn := c.conn
+	for {
+		switch inner := conn.(type) {
+		case interface{ NetConn() net.Conn }:
+			conn = inner.NetConn()
+			continue
+		case interface{ Raw() net.Conn }: // a PROXY protocol connection
+			conn = inner.Raw()
+			continue
+		case interface {
+			RawConn() net.Conn
+			Splice() bool
+		}: // a FinalMask wrapper
+			if !inner.Splice() {
+				// It may re-encode the stream (Sudoku), so the socket's
+				// bytes need not be the client's data and only what was
+				// read counts. The server-side fragment mask also lands
+				// here: it reports false for its writes, though its reads
+				// pass through.
+				return false
+			}
+			conn = inner.RawConn()
+			continue
+		}
+		break
+	}
+	return socketInputPending(conn)
+}
diff --git a/third_party/reality/input_pending_linux.go b/third_party/reality/input_pending_linux.go
new file mode 100644
index 00000000..d060e971
--- /dev/null
+++ b/third_party/reality/input_pending_linux.go
@@ -0,0 +1,29 @@
+package reality
+
+import (
+	"net"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+// socketInputPending asks the kernel how many bytes wait on conn's socket.
+func socketInputPending(conn net.Conn) bool {
+	sc, ok := conn.(syscall.Conn)
+	if !ok {
+		return false
+	}
+	raw, err := sc.SyscallConn()
+	if err != nil {
+		return false
+	}
+	pending := 0
+	if err := raw.Control(func(fd uintptr) {
+		if n, err := unix.IoctlGetInt(int(fd), unix.SIOCINQ); err == nil {
+			pending = n
+		}
+	}); err != nil {
+		return false
+	}
+	return pending > 0
+}
