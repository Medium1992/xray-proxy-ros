 		return
 	}
-	if s := 2 * (w.returned - w.markBase); s > int64(w.cap) {
+	s := 2 * (w.returned - w.markBase)
+	w.mark, w.markBase = now, w.returned
+	switch {
+	case s > int64(w.cap):
 		w.cap = int32(min(s, int64(limit)))
+		w.slow = 0
+	case shrink && 2*s < int64(w.cap):
