Date: Thu, 5 Nov 2026 23:38:15 +0300
Subject: [PATCH 106/106] fix(xhttp): pi forgets the reader's rate outside pi

rate and capped are written only by pi, but a stream that left pi kept
them, and cutGain counted them into downShare: with two or more
downloads, a sibling still in pi stepped up by a share that held a rate
from before the stream left. Cleared with piRTT and piPrev, so a stream
comes back to pi as a new one starts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 9c2fb23788ee370a4902e19b9bc2fb63056888db)
---
 transport/internet/splithttp/h2flow.go        |  7 +++-
 .../splithttp/h2flow_queuecuts_test.go        | 42 +++++++++++++++++++
 2 files changed, 47 insertions(+), 2 deletions(-)

diff --git a/transport/internet/splithttp/h2flow.go b/transport/internet/splithttp/h2flow.go
index 2b0a97f0..70a4cca5 100644
--- a/transport/internet/splithttp/h2flow.go
+++ b/transport/internet/splithttp/h2flow.go
@@ -2330,9 +2330,12 @@ func (c *flowConn) governDown(now time.Time, s *flowStream) {
 	default:
 		s.down.adjust(now, c.currentRTT(), c.down.init, c.down.max, c.client || c.incremental, q > 0)
 		// A round trip pi saw before the stream left it is no step to
-		// follow when it comes back, and its last error is no derivative
-		// for its first step back.
+		// follow when it comes back, and an error it saw then is no change
+		// to step by. Nor does a cap of pi's hold the stream out here, so
+		// its rate is no part of the share the downloads in pi step up by:
+		// the stream comes back as a new one starts.
 		s.down.piRTT, s.down.piPrev = 0, 0
+		s.down.rate, s.down.capped = 0, false
 	}
 	switch {
 	case c.client:
diff --git a/transport/internet/splithttp/h2flow_queuecuts_test.go b/transport/internet/splithttp/h2flow_queuecuts_test.go
index 4931b4ce..3bb2cfe0 100644
--- a/transport/internet/splithttp/h2flow_queuecuts_test.go
+++ b/transport/internet/splithttp/h2flow_queuecuts_test.go
@@ -106,6 +106,48 @@ func TestFlowPIForgetsErrorOutside(t *testing.T) {
 	}
 }
 
+// TestFlowPIForgetsRateOutside is the same for the rate pi saw the reader
+// take and whether the cap held it: outside pi no cap of pi's holds it.
+func TestFlowPIForgetsRateOutside(t *testing.T) {
+	h, s := queuedDownload(t)
+	h.c.mu.Lock()
+	s.down.rate, s.down.capped = 10<<20, true
+	h.c.mu.Unlock()
+	credit(h, s)
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if s.down.rate != 0 || s.down.capped {
+		t.Fatalf("pi's rate %v, capped %v kept outside pi", s.down.rate, s.down.capped)
+	}
+}
+
+// TestFlowShareLeavesOutsideStreams is two downloads that both took data
+// lately: stream 1 has left pi, stream 3 is in it. The share stream 3 steps
+// up by is its own alone, not a mean with a rate stream 1 had in pi.
+func TestFlowShareLeavesOutsideStreams(t *testing.T) {
+	h, s1 := queuedDownload(t)
+	h.openRequest(3)
+	h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, 3, 200<<10) })
+	h.c.mu.Lock()
+	h.c.incremental = true
+	h.c.kstat.rtt = 110 * time.Millisecond
+	s3 := h.c.streams[3]
+	s3.down.cap = 1 << 20
+	s3.down.flat = flowFullRounds
+	s3.down.mark, s3.down.markBase = time.Now().Add(-200*time.Millisecond), s3.down.returned
+	s3.down.rate, s3.down.capped = 1<<20, true
+	s1.down.rate, s1.down.capped = 10<<20, true
+	h.c.mu.Unlock()
+	credit(h, s1) // flat 0: outside pi
+	h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(3, 4<<10) })
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if h.c.downShare != 0 {
+		t.Fatalf("outside pi: s1.down.capped=%v s1.down.rate=%v c.downShare=%v; want false, 0, 0",
+			s1.down.capped, s1.down.rate, h.c.downShare)
+	}
+}
+
 // TestFlowCutsAreCounted is a download against a standing queue, cut by pi
 // and by the cut at a long queue in turn: each cut is noted for flowEffect
 // to judge by.
