From 930da0b56909219c9eb712a4a6cbee64cf315421 Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Wed, 11 Nov 2026 16:06:55 +0300
Subject: [PATCH] XHTTP client: Bound the TLS/REALITY handshake to 10s

A handshake blackholed after ClientHello never ended, and every request
queued behind that dial waited with it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 transport/internet/splithttp/dialer.go        |  4 ++
 .../internet/splithttp/splithttp_test.go      | 45 +++++++++++++++++++
 2 files changed, 49 insertions(+)

diff --git a/transport/internet/splithttp/dialer.go b/transport/internet/splithttp/dialer.go
index e124db29..87a93f5b 100644
--- a/transport/internet/splithttp/dialer.go
+++ b/transport/internet/splithttp/dialer.go
@@ -126,6 +126,10 @@ func createHTTPClient(dest net.Destination, streamSettings *internet.MemoryStrea
 			return nil, err
 		}
 
+		// a handshake blackholed after ClientHello would hold every request queued behind this dial
+		ctxInner, cancel := context.WithTimeout(ctxInner, 10*time.Second)
+		defer cancel()
+
 		if realityConfig != nil {
 			return reality.UClient(conn, realityConfig, ctxInner, dest)
 		}
diff --git a/transport/internet/splithttp/splithttp_test.go b/transport/internet/splithttp/splithttp_test.go
index 434108f9..3d80d8dd 100644
--- a/transport/internet/splithttp/splithttp_test.go
+++ b/transport/internet/splithttp/splithttp_test.go
@@ -599,3 +599,48 @@ func Test_ServerMaxHeaderBytes(t *testing.T) {
 		t.Fatalf("oversized header status = %d, want 431", resp.StatusCode)
 	}
 }
+
+func Test_DialBlackholedHandshake(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	common.Must(err)
+	defer listener.Close()
+	go func() {
+		for {
+			conn, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			defer conn.Close() // the kernel takes the ClientHello, nobody answers
+		}
+	}()
+
+	ct, ctHash := cert.MustGenerate(nil, cert.CommonName("localhost"))
+	streamSettings := &internet.MemoryStreamConfig{
+		ProtocolName:     "splithttp",
+		ProtocolSettings: &Config{Path: "shs"},
+		SecurityType:     "tls",
+		SecuritySettings: &tls.Config{
+			Certificate:          []*tls.Certificate{tls.ParseCertificate(ct)},
+			PinnedPeerCertSha256: [][]byte{ctHash[:]},
+		},
+	}
+	port := net.Port(listener.Addr().(*net.TCPAddr).Port)
+
+	done := make(chan error, 1)
+	go func() {
+		conn, err := Dial(context.Background(), net.TCPDestination(net.DomainAddress("localhost"), port), streamSettings)
+		if err == nil {
+			_, err = conn.Read(make([]byte, 1))
+			conn.Close()
+		}
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("read through a blackholed handshake succeeded")
+		}
+	case <-time.After(15 * time.Second):
+		t.Fatal("dial still waits on a handshake blackholed after ClientHello")
+	}
+}
