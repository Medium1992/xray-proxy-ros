From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Mon, 2 Nov 2026 00:29:10 +0300
Subject: [PATCH 104/105] fix(xhttp): a download the server ended waits for no
 credit

The DATA frame that uses the last of a stream's window arms the guard for
the stream before its END_STREAM ends it, and endDown left the stream
marked as waiting. With the client's side still open, as in stream-one,
the guard then probed for it, handed it credit with a WINDOW_UPDATE, and
on a client that credits in large steps lifted the connection's send
window for good. endDown now clears the mark.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 171b6c30060da9ad188f9760019c0cfc71f9760f)
(cherry picked from commit fb3845fd8b92ed510f7ce62b92c497ff160aad53)
---
 transport/internet/splithttp/h2flow.go        |  3 ++
 .../splithttp/h2flow_verify_ended_test.go     | 31 +++++++++++++++++++
 2 files changed, 34 insertions(+)

diff --git a/transport/internet/splithttp/h2flow.go b/transport/internet/splithttp/h2flow.go
index 1c8f40b3..a71cf313 100644
--- a/transport/internet/splithttp/h2flow.go
+++ b/transport/internet/splithttp/h2flow.go
@@ -1465,6 +1465,9 @@ func (c *flowConn) endDown(s *flowStream) {
 		return
 	}
 	s.serverDone = true
+	// The frame that ended the stream may have armed the guard for it, see
+	// armGuard: a stream the server has finished waits for no credit.
+	s.down.waiting = time.Time{}
 	c.downOpen--
 	c.downOpenForwarded -= s.downForwarded
 	c.downOpenSent -= s.downSent
diff --git a/transport/internet/splithttp/h2flow_verify_ended_test.go b/transport/internet/splithttp/h2flow_verify_ended_test.go
index f8b76d1c..cf345d8b 100644
--- a/transport/internet/splithttp/h2flow_verify_ended_test.go
+++ b/transport/internet/splithttp/h2flow_verify_ended_test.go
@@ -61,6 +61,37 @@ func TestFlowNoUploadCreditForEndedRequest(t *testing.T) {
 	}
 }
 
+// TestFlowGuardForgetsEndedDownload has the server end a download with the
+// frame that uses the last of its window while the client's side stays open,
+// as in stream-one: the frame arms the guard for the stream before it ends.
+// The stream waits for nothing, so the guard sends no PING, gives it no
+// credit, and leaves the connection's send window where it was.
+func TestFlowGuardForgetsEndedDownload(t *testing.T) {
+	h := openStreams(t, flowServerSendWindow, 4<<20, 1)
+	t.Cleanup(func() { h.c.Close() })
+	n := int(h.toServer.streams[1])
+	h.fromServer(func(fr *http2.Framer) {
+		writeDataSplit(fr, 1, n-1)
+		fr.WriteData(1, true, []byte{0})
+	})
+	h.c.mu.Lock()
+	if h.c.guard != nil {
+		h.c.guard.Stop()
+	}
+	waiting := h.c.anyWaiting()
+	out := h.c.unstick(time.Now().Add(time.Hour), nil)
+	sendWindow := h.c.sendWindow
+	h.c.mu.Unlock()
+	if waiting || len(out) != 0 || sendWindow != flowServerSendWindow {
+		t.Fatalf("after the download ended: waiting %v, guard wrote %d bytes, send window %d, want %d", waiting, len(out), sendWindow, flowServerSendWindow)
+	}
+	h.c.fireGuard()
+	h.sync()
+	if got := len(pings(t, h.conn.take())); got != 0 {
+		t.Fatalf("guard sent %d PINGs for a download the server ended", got)
+	}
+}
+
 // TestFlowGuardProbesOnlyWaitingStreams fires the guard with no stream
 // waiting for credit any more, then with one waiting: only the second may
 // send a PING.
-- 
