+type btProcess struct {
+	command *exec.Cmd
+	done    chan error
+	logsMu  sync.Mutex
+	logsBuf bytes.Buffer
+}
+
+func (p *btProcess) logs() string {
+	p.logsMu.Lock()
+	defer p.logsMu.Unlock()
+	return p.logsBuf.String()
+}
