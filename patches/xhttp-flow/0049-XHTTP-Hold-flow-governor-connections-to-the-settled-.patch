From 3a919a3775b6d945fb03d7d716a4d5cad766e61b Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Tue, 13 Oct 2026 21:29:30 +0300
Subject: [PATCH] XHTTP: Hold flow governor connections to the settled rule in
 tests

With the kernel vouching for the path, an upload on a server and a download on a governed client that are one low round into their start have to keep their caps, and to follow the path model after a second such round. A reader that grows a tenth a round has flat rounds and has not ended its ramp: it is not settled.
---
 .../internet/splithttp/h2flow_ramp_test.go    |  22 ++++
 .../internet/splithttp/h2flow_settled_test.go | 116 ++++++++++++++++++
 2 files changed, 138 insertions(+)
 create mode 100644 transport/internet/splithttp/h2flow_settled_test.go

diff --git a/transport/internet/splithttp/h2flow_ramp_test.go b/transport/internet/splithttp/h2flow_ramp_test.go
index 113967a2f..5e7545170 100644
--- a/transport/internet/splithttp/h2flow_ramp_test.go
+++ b/transport/internet/splithttp/h2flow_ramp_test.go
@@ -73,6 +73,28 @@ func TestFlowWindowSettles(t *testing.T) {
 	}
 }
 
+// TestFlowWindowGrowingSlowlyIsNotSettled is a reader a tenth faster every
+// round trip. Its rounds are flat, under a quarter more each, but none has
+// ended the ramp: it still speeds up, and stays with adjust, which follows
+// it at twice its rate, as before.
+func TestFlowWindowGrowingSlowlyIsNotSettled(t *testing.T) {
+	const rtt = 50 * time.Millisecond
+	start := time.Unix(0, 0)
+	w := flowWindow{cap: flowStartWindow}
+	credit := int64(400 << 10)
+	for i := 0; i < 6; i++ {
+		w.returned += credit
+		w.adjust(start.Add(time.Duration(i)*rtt), rtt, h2InitWindow, 1<<30, true, false)
+		credit += credit / 10
+	}
+	if w.flat < flowSettledRounds {
+		t.Fatalf("%d flat rounds counted for a reader that grows a tenth a round, want at least %d", w.flat, flowSettledRounds)
+	}
+	if w.ramped || w.settled() {
+		t.Fatalf("a reader that still speeds up counts as ramped %v, settled %v", w.ramped, w.settled())
+	}
+}
