From 1d038d67a79c42ed5eac0f4d00e4958f7e6ffadb Mon Sep 17 00:00:00 2001
From: Medium1992 <122653016+Medium1992@users.noreply.github.com>
Date: Tue, 6 Oct 2026 15:17:24 +0300
Subject: [PATCH] XHTTP: Tell a stuck flow governor goroutine from one passing
 a lock

The churn test failed once under load: its one stack snapshot caught a
governor goroutine merely waiting for a lock. Take up to three snapshots
200 ms apart and fail only if a goroutine is stuck in every one.
---
 transport/internet/splithttp/h2flow_test.go | 20 +++++++++++++++++---
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/transport/internet/splithttp/h2flow_test.go b/transport/internet/splithttp/h2flow_test.go
index 41facd6f..e57ae91c 100644
--- a/transport/internet/splithttp/h2flow_test.go
+++ b/transport/internet/splithttp/h2flow_test.go
@@ -755,11 +755,25 @@ func TestFlowChurnLeaves(t *testing.T) {
 		}
 		time.Sleep(100 * time.Millisecond)
 	}
+	// A snapshot can catch a goroutine that is only passing through a lock
+	// under load; one that is stuck shows up in every snapshot.
 	buf := make([]byte, 4<<20)
-	for _, g := range strings.Split(string(buf[:runtime.Stack(buf, true)]), "\n\n") {
-		if strings.Contains(g, "(*flowConn)") && (strings.Contains(g, "semacquire") || strings.Contains(g, "sync.(*Mutex)")) {
-			t.Fatalf("goroutine stuck in the governor after all requests finished:\n%s", g)
+	stuck := ""
+	for range 3 {
+		stuck = ""
+		for _, g := range strings.Split(string(buf[:runtime.Stack(buf, true)]), "\n\n") {
+			if strings.Contains(g, "(*flowConn)") && (strings.Contains(g, "semacquire") || strings.Contains(g, "sync.(*Mutex)")) {
+				stuck = g
+				break
+			}
 		}
+		if stuck == "" {
+			break
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+	if stuck != "" {
+		t.Fatalf("goroutine stuck in the governor after all requests finished:\n%s", stuck)
 	}
 	t.Logf("goroutines %d before, %d after (idle server connections included)", before, runtime.NumGoroutine())
 }
