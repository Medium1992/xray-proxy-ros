From b5ac850b8d11ece3212b2875d4820c7d90ad201f Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Sat, 14 Nov 2026 14:56:46 +0300
Subject: [PATCH] uTLS: Always send the hybrid key share from the randomized
 fingerprints

uTLS offers X25519MLKEM768 in supported_groups and sends its key share on
two independent draws, and Xray draws the seed of "randomized" and
"randomizednoalpn" once per process. Of 400 seeds, about half sent no
X25519MLKEM768 key share, which REALITY turns away, a third offered no
group, and half sent a P-256 key share. Through a real REALITY server,
7 and 5 of 10 client processes worked.

The presets now always offer X25519MLKEM768 with its key share and send
key shares for X25519MLKEM768 and X25519 only, as Chrome does; a server
that wants P-256 asks for it. The other drawn dimensions of a seed stay.
The raw hellorandomized* fingerprints keep uTLS's behaviour. 10 of 10
processes work. Ported from Jolymmiles/Xray-core 1ec1830f.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 transport/internet/reality/reality.go         |  4 ++
 .../internet/tls/randomized_hello_test.go     | 62 +++++++++++++++++++
 transport/internet/tls/tls.go                 | 56 +++++++++++++++--
 3 files changed, 117 insertions(+), 5 deletions(-)
 create mode 100644 transport/internet/tls/randomized_hello_test.go

diff --git a/transport/internet/reality/reality.go b/transport/internet/reality/reality.go
index 4431a176..e1d1c955 100644
--- a/transport/internet/reality/reality.go
+++ b/transport/internet/reality/reality.go
@@ -162,6 +162,10 @@ func UClient(c net.Conn, config *Config, ctx context.Context, dest net.Destinati
 	uConn.UConn = utls.UClient(c, utlsConfig, *fingerprint)
 	{
 		uConn.BuildHandshakeState()
+		if err := tls.FixRandomizedHello(uConn.UConn); err != nil {
+			c.Close()
+			return nil, errors.New("REALITY: failed to build the ClientHello").Base(err)
+		}
 		hello := uConn.HandshakeState.Hello
 		hello.SessionId = make([]byte, 32)
 		copy(hello.Raw[39:], hello.SessionId) // the fixed location of `Session ID`
diff --git a/transport/internet/tls/randomized_hello_test.go b/transport/internet/tls/randomized_hello_test.go
new file mode 100644
index 00000000..f2a2bf8c
--- /dev/null
+++ b/transport/internet/tls/randomized_hello_test.go
@@ -0,0 +1,62 @@
+package tls
+
+import (
+	gotls "crypto/tls"
+	"net"
+	"testing"
+
+	utls "github.com/refraction-networking/utls"
+)
+
+// Whatever seed a process draws, the "randomized" presets offer
+// X25519MLKEM768 together with its key share, and send no P-256 key share:
+// REALITY turns away a hello without the hybrid key share, and a hybrid key
+// share without its group breaks RFC 8446, Section 4.2.8.
+func TestRandomizedPresetsAlwaysSendTheHybridKeyShare(t *testing.T) {
+	for _, base := range []utls.ClientHelloID{utls.HelloRandomizedALPN, utls.HelloRandomizedNoALPN} {
+		var noGroup, noShare, p256 int
+		const seeds = 400
+		for range seeds {
+			id := base
+			id.Seed, _ = utls.NewPRNGSeed()
+			id.Weights = &randomizedWeights
+			client, server := net.Pipe()
+			server.Close()
+			uConn := UClient(client, &gotls.Config{ServerName: "example.com"}, &id).(*UConn)
+			if err := uConn.BuildHandshakeState(); err != nil {
+				t.Fatal(err)
+			}
+			group, share := false, false
+			for _, extension := range uConn.Extensions {
+				switch e := extension.(type) {
+				case *utls.SupportedCurvesExtension:
+					for _, curve := range e.Curves {
+						if curve == utls.X25519MLKEM768 {
+							group = true
+						}
+					}
+				case *utls.KeyShareExtension:
+					for _, ks := range e.KeyShares {
+						switch ks.Group {
+						case utls.X25519MLKEM768:
+							share = true
+						case utls.CurveP256:
+							p256++
+						}
+					}
+				}
+			}
+			if !group {
+				noGroup++
+			}
+			if !share {
+				noShare++
+			}
+			client.Close()
+		}
+		if noGroup+noShare+p256 != 0 {
+			t.Errorf("%s: of %d seeds, %d offer no X25519MLKEM768, %d send no X25519MLKEM768 key share, %d send a P-256 key share",
+				base.Client, seeds, noGroup, noShare, p256)
+		}
+	}
+}
diff --git a/transport/internet/tls/tls.go b/transport/internet/tls/tls.go
index 07c214b4..30b081c1 100644
--- a/transport/internet/tls/tls.go
+++ b/transport/internet/tls/tls.go
@@ -11,6 +11,7 @@ import (
 
 	utls "github.com/refraction-networking/utls"
 	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
 	"github.com/xtls/xray-core/common/net"
 	"github.com/xtls/xray-core/common/utils"
 )
@@ -174,6 +175,9 @@ func (c *UConn) ConnectionState() tls.ConnectionState {
 
 func UClient(c net.Conn, config *tls.Config, fingerprint *utls.ClientHelloID) net.Conn {
 	utlsConn := utls.UClient(c, copyConfig(config), *fingerprint)
+	if err := FixRandomizedHello(utlsConn); err != nil {
+		errors.LogInfoInner(context.Background(), err, "failed to build the ClientHello of fingerprint ", fingerprint.Str())
+	}
 	return &UConn{UConn: utlsConn}
 }
 
@@ -212,6 +216,51 @@ func copyConfig(c *tls.Config) *utls.Config {
 	return config
 }
 
+// randomizedWeights are the weights of the "randomized" and
+// "randomizednoalpn" presets, whose seed is drawn once per process. uTLS
+// offers X25519MLKEM768 in supported_groups (CurveIDs_Append_X25519) and sends
+// its key share (KeyShare_Append_RandomGroups) on two independent draws. The
+// group without its key share is turned away by REALITY and asked again by a
+// server that prefers it, which uTLS cannot answer; the key share without the
+// group breaks RFC 8446, Section 4.2.8. Both are always drawn, as current
+// browsers send them. The key share draw also adds a P-256 key share, which
+// FixRandomizedHello removes. The presets are recognized by this address.
+var randomizedWeights = func() utls.Weights {
+	weights := utls.DefaultWeights
+	weights.TLSVersMax_Set_VersionTLS13 = 1
+	weights.FirstKeyShare_Set_CurveP256 = 0
+	weights.CurveIDs_Append_X25519 = 1
+	weights.KeyShare_Append_RandomGroups = 1
+	return weights
+}()
+
+// FixRandomizedHello builds the ClientHello of a "randomized" or
+// "randomizednoalpn" client and drops its P-256 key share: X25519MLKEM768 and
+// X25519 with keys of their own is what Chrome sends, and a server that
+// wants P-256 asks for it. Other fingerprints are left as they are.
+func FixRandomizedHello(uConn *utls.UConn) error {
+	id := uConn.ClientHelloID
+	if id.Weights != &randomizedWeights {
+		return nil
+	}
+	if err := uConn.BuildHandshakeState(); err != nil {
+		return err
+	}
+	for _, extension := range uConn.Extensions {
+		if shares, ok := extension.(*utls.KeyShareExtension); ok {
+			count := len(shares.KeyShares)
+			shares.KeyShares = slices.DeleteFunc(shares.KeyShares, func(share utls.KeyShare) bool {
+				return share.Group == utls.CurveP256
+			})
+			if len(shares.KeyShares) != count {
+				return uConn.BuildHandshakeState()
+			}
+			return nil
+		}
+	}
+	return nil
+}
+
 func init() {
 	bigInt, _ := rand.Int(rand.Reader, big.NewInt(int64(len(ModernFingerprints))))
 	stopAt := int(bigInt.Int64())
@@ -223,15 +272,12 @@ func init() {
 		}
 		i++
 	}
-	weights := utls.DefaultWeights
-	weights.TLSVersMax_Set_VersionTLS13 = 1
-	weights.FirstKeyShare_Set_CurveP256 = 0
 	randomized := utls.HelloRandomizedALPN
 	randomized.Seed, _ = utls.NewPRNGSeed()
-	randomized.Weights = &weights
+	randomized.Weights = &randomizedWeights
 	randomizednoalpn := utls.HelloRandomizedNoALPN
 	randomizednoalpn.Seed, _ = utls.NewPRNGSeed()
-	randomizednoalpn.Weights = &weights
+	randomizednoalpn.Weights = &randomizedWeights
 	PresetFingerprints["randomized"] = &randomized
 	PresetFingerprints["randomizednoalpn"] = &randomizednoalpn
 }
