From 7057c5dfae9b059250623f718b394ab671bd4bd7 Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Mon, 26 Oct 2026 15:04:08 +0300
Subject: [PATCH 90/91] XHTTP: Say that the first PING's tag shows on plain TLS

A governed server's first PING carries a fixed upper half that any
client sees before its first request where h2Flow runs on plain TLS.
Under REALITY a client that cannot authenticate never reaches the
governor.
---
 transport/internet/splithttp/h2flow.go | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/transport/internet/splithttp/h2flow.go b/transport/internet/splithttp/h2flow.go
index 30d1a4803..ce784d731 100644
--- a/transport/internet/splithttp/h2flow.go
+++ b/transport/internet/splithttp/h2flow.go
@@ -1599,7 +1599,9 @@ type flowPing struct {
 // flowPingTag marks the first PING a governed server sends, with its first
 // SETTINGS: a governed client takes it, and no other early PING, for a
 // server that governs its downloads, see peerGoverned. The PING's payload is
-// inside TLS, seen by the two ends alone.
+// inside TLS, but on plain TLS any client that connects sees it before its
+// first request; under REALITY a client that cannot authenticate never
+// reaches the governor.
 const flowPingTag = 0x6b7a3f91
 
 func (c *flowConn) appendPingFrame(out []byte) []byte {
-- 
