+// A server cuts download caps against the queue the kernel sees, so that its
+// own data does not stand in front of other streams. pi does so gradually,
+// to hold the queue near its setpoint without jumping on jitter. A queue
+// that other traffic keeps full, on a link shared in the evening, does not
+// shorten when the server cuts: cut after cut only hands that traffic the
+// path, down to init per round trip, as little as a megabit per second where
+// that traffic stands for a second in the queue.
+//
+// The server's own queue is made of what it has in the network, so it
+// shortens when that does. So once a queue stands at twice a quarter of the
+// empty path's round trip, the server watches two things: what its
+// downloads to the client have in flight, which the cuts move, and what its
+// connections to the client have sent and not had acknowledged, as the
+// kernel counts it, which is what stands in the network. When both have
+// come down to half of the most they were, and the queue has not come down
+// by a quarter for flowSuspectRounds round trips, the queue is foreign; the
+// wait is for the kernel's round trip, which is smoothed and follows the
+// queue some way behind. The first alone halves as a reader catches up,
+// much of it waiting in buffers at either end; the second alone is small
+// whenever other traffic takes most of the path, cut or not.
+//
+// A foreign queue's downloads are neither cut nor held against it, and their
+// caps follow their readers as without a governor, so they keep the share a
+// server without one would. The queue counts as the server's own again once
+// it has stood drained under the bar for flowSuspectRounds round trips, and
+// after flowForeignRounds round trips, when the server cuts against it again
+// to see.
+//
+// A client's connections to the server share its bottleneck, and the queue
+// one of them sees is mostly the others' data; within a connection, so is
+// the queue one stream sees. So the queue is judged for all downloads to the
+// client's address at once, a flowPath, against the least round trip any of
+// its connections has had: a connection opened into a standing queue takes
+// that queue for its empty path. The path keeps its state for flowPathKeep
+// after its last connection closes, as a client opens new ones, and takes a
+// new floor as often, as the kernel does.
+const (
+	flowSuspectRounds = 2
+	flowForeignRounds = 32
+	flowPathKeep      = 5 * time.Minute
+)
+
+// flowPath is the queue state a server's connections from one address
+// share. Its lock is taken under a connection's, never the other way.
+type flowPath struct {
+	key    string
+	refs   int
+	idleAt time.Time
+
+	mu sync.Mutex
+	// floor is the least empty-path round trip of the path's connections
+	// since floorAt. inFlight is what each connection's open downloads have
+	// in flight and what it has in the network. cutQ is the queue when it
+	// first stood over the bar, zero while it does not, and cutIn the most
+	// of each since; suspectAt is when both halved with the queue where it
+	// was, zero while not. foreignAt is when
+	// the queue began to count as foreign, zero while it counts as the
+	// server's own.
+	floor     time.Duration
+	floorAt   time.Time
+	inFlight  map[*flowConn][2]int64
+	cutQ      time.Duration
+	cutIn     [2]int64
+	suspectAt time.Time
+	foreignAt time.Time
+}
+
+var (
+	flowPathsMu    sync.Mutex
+	flowPaths      = map[string]*flowPath{}
+	flowPathsSwept time.Time
+)
+
+// flowPathOf returns the queue state shared by connections from c's peer
+// address, taking a reference, or nil where c has none.
+func flowPathOf(c net.Conn) *flowPath {
+	addr, ok := c.RemoteAddr().(*net.TCPAddr)
+	if !ok {
+		return nil
+	}
+	key, now := addr.IP.String(), time.Now()
+	flowPathsMu.Lock()
+	defer flowPathsMu.Unlock()
+	if now.Sub(flowPathsSwept) >= flowPathKeep {
+		flowPathsSwept = now
+		for k, p := range flowPaths {
+			if p.refs == 0 && now.Sub(p.idleAt) >= flowPathKeep {
+				delete(flowPaths, k)
+			}
+		}
+	}
+	p := flowPaths[key]
+	if p == nil {
+		p = &flowPath{key: key, inFlight: map[*flowConn][2]int64{}}
+		flowPaths[key] = p
+	}
+	p.refs++
+	return p
+}
+
+// release drops c's reference to p and what it had in flight.
+func (p *flowPath) release(c *flowConn) {
+	p.mu.Lock()
+	delete(p.inFlight, c)
+	p.mu.Unlock()
+	flowPathsMu.Lock()
+	defer flowPathsMu.Unlock()
+	if p.refs--; p.refs == 0 {
+		p.idleAt = time.Now()
+	}
+}
+
+// sharedPath returns c's flowPath, looking it up the first time.
+func (c *flowConn) sharedPath() *flowPath {
+	if !c.pathSet {
+		c.pathSet = true
+		c.path = flowPathOf(c.Conn)
+	}
+	return c.path
+}
+
+// foreignQueue adds what c's downloads have in flight and the queue the
+// kernel reads now to its path's state, and reports whether the queue counts
+// as foreign now.
+func (c *flowConn) foreignQueue(now time.Time) bool {
+	if !c.kernelStats(now) {
+		return false
+	}
+	p := c.sharedPath()
+	if p == nil {
+		return false
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.floorAt.IsZero() || now.Sub(p.floorAt) >= flowPathKeep {
+		p.floor, p.floorAt = c.kstat.minRTT, now
+	}
+	p.floor = min(p.floor, c.kstat.minRTT)
+	st := c.kstat
+	st.minRTT = p.floor
+	// The bar leaves the jitter out, unlike pi's setpoint: a queue that
+	// other traffic keeps full swings the round trip by as much as it holds.
+	queue, bar := st.rtt-st.minRTT, 2*max(st.minRTT/4, flowPIMinSet)
+	if p.inFlight == nil {
+		p.inFlight = map[*flowConn][2]int64{}
+	}
+	p.inFlight[c] = [2]int64{max(0, c.downOpenSent-c.downOpenReturned), c.kstat.unacked}
+	var in [2]int64
+	for _, n := range p.inFlight {
+		in[0], in[1] = in[0]+n[0], in[1]+n[1]
+	}
+	switch {
+	case !p.foreignAt.IsZero():
+		// As a verdict waits for the smoothed round trip, so does its end:
+		// other traffic in a sawtooth lets its queue dip for a moment.
+		switch {
+		case now.Sub(p.foreignAt) >= flowForeignRounds*st.rtt:
+			p.foreignAt, p.suspectAt = time.Time{}, time.Time{}
+		case queue > bar:
+			p.suspectAt = time.Time{}
+		case p.suspectAt.IsZero():
+			p.suspectAt = now
+		case now.Sub(p.suspectAt) >= flowSuspectRounds*st.rtt:
+			p.foreignAt, p.suspectAt = time.Time{}, time.Time{}
+		}
+	case queue <= bar:
+		p.cutQ = 0
+	case p.cutQ == 0:
+		p.cutQ, p.cutIn, p.suspectAt = queue, in, time.Time{}
+	default:
+		p.cutIn = [2]int64{max(p.cutIn[0], in[0]), max(p.cutIn[1], in[1])}
+		switch {
+		case in[0] > p.cutIn[0]/2 || in[1] > p.cutIn[1]/2 || queue <= p.cutQ*3/4:
+			p.suspectAt = time.Time{}
+		case p.suspectAt.IsZero():
+			p.suspectAt = now
+		case now.Sub(p.suspectAt) >= flowSuspectRounds*st.rtt:
+			p.foreignAt, p.cutQ, p.suspectAt = now, 0, time.Time{}
+		}
+	}
+	return !p.foreignAt.IsZero()
+}
+
 // kernelStats refreshes the kernel's view of this TCP connection and reports
 // whether there is one.
 func (c *flowConn) kernelStats(now time.Time) bool {
@@ -778,7 +977,8 @@ func (c *flowConn) queueShrink(w *flowWindow, now time.Time, init int32) {
 }
 
 // NetConn returns the accepted connection, so that code which looks through
-// connection wrappers still finds it behind the governor.
+// connection wrappers, for the client's physical address or a PROXY header,
+// still finds it behind the governor.
 func (c *flowConn) NetConn() net.Conn {
 	return c.Conn
 }
@@ -875,6 +1075,11 @@ func (c *flowConn) releaseLocked() {
 	c.wqueue = nil
 	clear(c.wcredit)
 	c.closed = true
+	if c.path != nil {
+		c.path.release(c)
+		c.path = nil
+	}
+	c.pathSet = true
 	if c.guard != nil {
 		c.guard.Stop()
 	}
@@ -1572,10 +1777,14 @@ func (r *flowReader) control(f h2Frame, header, payload, out []byte) []byte {
 		default:
 			q = c.queueing(now)
 		}
+		foreign := !c.client && c.foreignQueue(now)
+		if foreign {
+			q = 0
+		}
 		switch {
 		case c.client && c.modelled(now) && s.down.settled():
 			s.down.model(now, c.currentRTT(), c.down.init, c.down.max)
-		case !c.client && c.incremental && s.down.flat >= flowFullRounds && c.modelled(now):
+		case !c.client && !foreign && c.incremental && s.down.flat >= flowFullRounds && c.modelled(now):
 			// Only clients that credit in small steps: one that waits for
 			// half of its own window could be held below that half. Only
 			// where the kernel sees the path: behind a TCP proxy it sees
diff --git a/transport/internet/splithttp/h2flow_foreign_test.go b/transport/internet/splithttp/h2flow_foreign_test.go
new file mode 100644
index 00000000..d4e9a662
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_foreign_test.go
@@ -0,0 +1,278 @@
+package splithttp
+
+import (
+	"net"
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// queuedPath makes c take the kernel's word for an empty path of minRTT and
+// a round trip of rtt now, until the test changes it, on a path of its own
+// unless it has one.
+func queuedPath(c *flowConn, minRTT, rtt time.Duration) {
+	c.tcp, c.kAt, c.kOK = fakeRawConn{}, time.Now().Add(time.Hour), true
+	c.kstat = tcpStats{rtt: rtt, minRTT: minRTT}
+	c.rttBase = minRTT
+	if c.path == nil {
+		c.path, c.pathSet = &flowPath{inFlight: map[*flowConn][2]int64{}}, true
+	}
+}
+
+// inFlight sets what c's open downloads have in flight and what c has in
+// the network, as its kernel reports it, to n each.
+func inFlight(c *flowConn, n int64) {
+	c.downOpenSent, c.downOpenReturned = 1<<30+n, 1<<30
+	c.kstat.unacked = n
+}
+
+// judged reads c's path at at and flowSuspectRounds round trips later, as
+// a verdict asks, and gives the second answer.
+func judged(c *flowConn, at time.Time) bool {
+	c.foreignQueue(at)
+	return c.foreignQueue(at.Add(flowSuspectRounds * c.kstat.rtt))
+}
+
+// queuedDownload is a server with one download whose reader takes all it is
+// sent, on a path whose round trip stands at 500 ms over an empty 50 ms: a
+// queue the server cuts against while it counts as its own. The cap is 1 MiB.
+func queuedDownload(t *testing.T) (h *flowHarness, s *flowStream) {
+	t.Helper()
+	const id = 1
+	h = newFlowHarness(t)
+	t.Cleanup(func() { h.c.Close() })
+	h.track()
+	h.openStream(4 << 20)
+	h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, id, 200<<10) })
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	queuedPath(h.c, 50*time.Millisecond, 500*time.Millisecond)
+	s = h.c.streams[id]
+	s.down.cap = 1 << 20
+	s.down.mark, s.down.markBase = time.Now(), s.down.returned
+	return h, s
+}
+
+// credit returns 4 KiB of the download's credit and gives the cap after it.
+func credit(h *flowHarness, s *flowStream) int32 {
+	h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(1, 4<<10) })
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	return s.down.cap
+}
+
+// TestFlowQueueThatStaysIsForeign is a queue of 450 ms over an empty 50 ms
+// that stays where it was while what the server has in flight comes down
+// from 4 to 2 MiB: no queue of the server's own does, so it counts as
+// foreign. At 2.1 MiB it does not yet.
+func TestFlowQueueThatStaysIsForeign(t *testing.T) {
+	c := &flowConn{streams: map[uint32]*flowStream{}}
+	queuedPath(c, 50*time.Millisecond, 500*time.Millisecond)
+	now := time.Now()
+	inFlight(c, 4<<20)
+	c.foreignQueue(now)
+	inFlight(c, 2100<<10)
+	if judged(c, now.Add(time.Second)) {
+		t.Fatal("foreign before what was in flight came down to half")
+	}
+	inFlight(c, 2<<20)
+	for _, d := range []time.Duration{0, time.Millisecond, flowSuspectRounds*c.kstat.rtt - time.Millisecond} {
+		if c.foreignQueue(now.Add(3*time.Second + d)) {
+			t.Fatalf("foreign %v after the halving, before the smoothed round trip could follow the queue", d)
+		}
+	}
+	if !c.foreignQueue(now.Add(3*time.Second + flowSuspectRounds*c.kstat.rtt)) {
+		t.Fatal("a queue that stayed while the server's own data halved is not foreign")
+	}
+}
+
+// TestFlowQueueThatShortensIsOwn is the server's own queue: when what it has
+// in flight halves, the queue comes down from 450 to 300 ms, by a third, and
+// it never counts as foreign.
+func TestFlowQueueThatShortensIsOwn(t *testing.T) {
+	c := &flowConn{streams: map[uint32]*flowStream{}}
+	queuedPath(c, 50*time.Millisecond, 500*time.Millisecond)
+	now := time.Now()
+	inFlight(c, 4<<20)
+	c.foreignQueue(now)
+	inFlight(c, 2<<20)
+	c.kstat.rtt = 350 * time.Millisecond
+	if judged(c, now.Add(time.Second)) {
+		t.Fatal("a queue that came down by a third with the server's data counts as foreign")
+	}
+}
+
+// TestFlowForeignQueueEnds is a foreign queue that drains, and one that does
+// not: the first counts as the server's own at once, the second after
+// flowForeignRounds round trips, when the server cuts against it again.
+func TestFlowForeignQueueEnds(t *testing.T) {
+	for _, drains := range []bool{true, false} {
+		c := &flowConn{streams: map[uint32]*flowStream{}}
+		queuedPath(c, 50*time.Millisecond, 500*time.Millisecond)
+		now := time.Now()
+		inFlight(c, 4<<20)
+		c.foreignQueue(now)
+		inFlight(c, 1<<20)
+		if !judged(c, now.Add(time.Second)) {
+			t.Fatalf("drains %v: not foreign", drains)
+		}
+		now = now.Add(flowSuspectRounds * c.kstat.rtt)
+		later := now.Add(2 * time.Second)
+		if drains {
+			c.kstat.rtt = 60 * time.Millisecond
+			if c.foreignQueue(later) {
+				later = later.Add(flowSuspectRounds * c.kstat.rtt)
+			} else {
+				t.Fatal("a queue that dipped under the bar for a moment ended the verdict")
+			}
+		} else {
+			later = now.Add(time.Second + flowForeignRounds*500*time.Millisecond)
+			if !c.foreignQueue(later.Add(-time.Millisecond)) {
+				t.Fatal("no longer foreign before flowForeignRounds round trips")
+			}
+		}
+		if c.foreignQueue(later) {
+			t.Fatalf("drains %v: still foreign", drains)
+		}
+	}
+}
+
+// TestFlowInFlightSpansConnections is a client with two connections, 2 MiB
+// in flight on each, behind a standing queue. When one of them is down to
+// 1 MiB the path holds 3 MiB, three quarters, and that says nothing; when
+// the other is down to 0.9 MiB as well, the path holds under half, and the
+// queue is foreign. A connection alone would have taken its own halving for
+// the verdict, with the other's data the queue.
+func TestFlowInFlightSpansConnections(t *testing.T) {
+	path := &flowPath{inFlight: map[*flowConn][2]int64{}}
+	a := &flowConn{streams: map[uint32]*flowStream{}, path: path, pathSet: true}
+	b := &flowConn{streams: map[uint32]*flowStream{}, path: path, pathSet: true}
+	queuedPath(a, 50*time.Millisecond, 500*time.Millisecond)
+	queuedPath(b, 50*time.Millisecond, 500*time.Millisecond)
+	now := time.Now()
+	inFlight(a, 2<<20)
+	inFlight(b, 2<<20)
+	a.foreignQueue(now)
+	b.foreignQueue(now)
+	inFlight(a, 1<<20)
+	if judged(a, now.Add(time.Second)) {
+		t.Fatal("one connection's halving counted for the path's")
+	}
+	inFlight(b, 900<<10)
+	if !judged(b, now.Add(3*time.Second)) {
+		t.Fatal("the path's data halved with the queue where it was, and it is not foreign")
+	}
+	path.release(a)
+	if _, ok := path.inFlight[a]; ok {
+		t.Fatal("a released connection still counts for the path")
+	}
+}
+
+// TestFlowPathFloor is a connection opened into a standing queue: its kernel
+// takes 450 ms for the empty path, and to it the queue looks small. The
+// path keeps the least empty-path round trip of all its connections, 50 ms,
+// and the queue counts as foreign all the same.
+func TestFlowPathFloor(t *testing.T) {
+	path := &flowPath{inFlight: map[*flowConn][2]int64{}}
+	early := &flowConn{streams: map[uint32]*flowStream{}, path: path, pathSet: true}
+	queuedPath(early, 50*time.Millisecond, 60*time.Millisecond)
+	now := time.Now()
+	early.foreignQueue(now)
+	path.release(early)
+	late := &flowConn{streams: map[uint32]*flowStream{}, path: path, pathSet: true}
+	queuedPath(late, 450*time.Millisecond, 500*time.Millisecond)
+	inFlight(late, 4<<20)
+	late.foreignQueue(now.Add(time.Second))
+	inFlight(late, 1<<20)
+	if !judged(late, now.Add(2*time.Second)) {
+		t.Fatal("a queue over the path's floor did not count as foreign for a connection with a higher one")
+	}
+}
+
+// tcpPeer is a connection whose peer is a TCP address.
+type tcpPeer struct {
+	net.Conn
+	addr *net.TCPAddr
+}
+
+func (c tcpPeer) RemoteAddr() net.Addr { return c.addr }
+
+// TestFlowPathOutlivesConnections is a client that closes its connection and
+// opens another: the new one gets the same path, with what it learnt, and a
+// client from another address does not.
+func TestFlowPathOutlivesConnections(t *testing.T) {
+	c := &flowConn{}
+	a := tcpPeer{addr: &net.TCPAddr{IP: net.IPv4(192, 0, 2, 7), Port: 40000}}
+	p := flowPathOf(a)
+	p.release(c)
+	a.addr = &net.TCPAddr{IP: net.IPv4(192, 0, 2, 7), Port: 40001}
+	q := flowPathOf(a)
+	defer q.release(c)
+	if q != p {
+		t.Fatal("a new connection from the same address got a new path")
+	}
+	b := flowPathOf(tcpPeer{addr: &net.TCPAddr{IP: net.IPv4(192, 0, 2, 8), Port: 40000}})
+	defer b.release(c)
+	if b == p {
+		t.Fatal("a connection from another address got the same path")
+	}
+}
+
+// TestFlowForeignQueueStopsCuts is a download against a standing queue: the
+// cap is cut while the queue counts as the server's own, and not while it
+// counts as foreign.
+func TestFlowForeignQueueStopsCuts(t *testing.T) {
+	for _, foreign := range []bool{false, true} {
+		h, s := queuedDownload(t)
+		if foreign {
+			h.c.mu.Lock()
+			h.c.path.foreignAt = time.Now()
+			h.c.mu.Unlock()
+		}
+		got := credit(h, s)
+		if cut := got < 1<<20; cut == foreign {
+			t.Fatalf("foreign %v: the cap went from 1 MiB to %d", foreign, got)
+		}
+	}
+}
+
+// TestFlowBothMustHalve is a queue that stands while only one of the two
+// halves: what the downloads have in flight, as a client drains its buffers
+// with the server's own data still filling the network, or what the
+// network holds, with the downloads' credit where it was. Neither says the
+// queue is foreign; both together do.
+func TestFlowBothMustHalve(t *testing.T) {
+	for _, half := range []string{"downloads", "network", "both"} {
+		c := &flowConn{streams: map[uint32]*flowStream{}}
+		queuedPath(c, 50*time.Millisecond, 500*time.Millisecond)
+		now := time.Now()
+		inFlight(c, 4<<20)
+		c.foreignQueue(now)
+		if half != "network" {
+			c.downOpenSent = c.downOpenReturned + 1<<20
+		}
+		if half != "downloads" {
+			c.kstat.unacked = 1 << 20
+		}
+		if got := judged(c, now.Add(time.Second)); got != (half == "both") {
+			t.Fatalf("%s halved: foreign %v", half, got)
+		}
+	}
+}
+
+// TestFlowBarLeavesJitterOut is a foreign queue of 600 ms on a path whose
+// round trip swings by 300 ms with it: pi's setpoint, four times that swing,
+// would take the queue for none and end the verdict at once.
+func TestFlowBarLeavesJitterOut(t *testing.T) {
+	c := &flowConn{streams: map[uint32]*flowStream{}}
+	queuedPath(c, 150*time.Millisecond, 750*time.Millisecond)
+	c.kstat.rttVar = 300 * time.Millisecond
+	now := time.Now()
+	inFlight(c, 4<<20)
+	c.foreignQueue(now)
+	inFlight(c, 1<<20)
+	if !judged(c, now.Add(time.Second)) {
+		t.Fatal("a queue of 600 ms that swings by 300 ms is not foreign")
+	}
+}
