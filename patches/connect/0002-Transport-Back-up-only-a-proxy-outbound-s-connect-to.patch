From 03d39bba63481ac6d68c8f0242670ad0d0e32c05 Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Sat, 14 Nov 2026 22:52:00 +0300
Subject: [PATCH] Transport: Back up only a proxy outbound's connect to an IP
 address

The backup connect ran on every TCP dial. For a domain the 250ms included
the DNS lookup Go makes within the connect, so a slow resolver started a
second lookup and connect, where Chrome starts no backup while it
resolves, and Go already races IPv6 and IPv4 for a domain. For freedom it
sent a second SYN to every target that answers late or not at all, which
on a server dialing many dead peers doubles the SYNs a hoster may take
for a scan. The backup now runs only for an IP address and not for
freedom: the connects to the proxy server it is for.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 transport/internet/dial_backup_test.go | 38 ++++++++++++++++++++++++++
 transport/internet/dialer.go           | 14 ++++++----
 2 files changed, 47 insertions(+), 5 deletions(-)

diff --git a/transport/internet/dial_backup_test.go b/transport/internet/dial_backup_test.go
index b36880b3..76e8d5fa 100644
--- a/transport/internet/dial_backup_test.go
+++ b/transport/internet/dial_backup_test.go
@@ -10,6 +10,7 @@ import (
 	"time"
 
 	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
 	. "github.com/xtls/xray-core/transport/internet"
 )
 
@@ -167,3 +168,40 @@ func TestDialSystemStartsNoBackupForUDP(t *testing.T) {
 		t.Fatalf("%d dials, want 1", n)
 	}
 }
+
+// Only a proxy outbound's connect to an IP address is backed up: freedom
+// dials whatever clients ask for, and a domain is resolved and raced over
+// IPv6 and IPv4 by the system dialer itself.
+func TestDialSystemStartsNoBackupForFreedomOrADomain(t *testing.T) {
+	for name, tc := range map[string]struct {
+		ctx  context.Context
+		dest net.Destination
+	}{
+		"freedom": {
+			session.ContextWithOutbounds(context.Background(), []*session.Outbound{{Name: "freedom"}}),
+			tcpDest,
+		},
+		"domain": {context.Background(), net.TCPDestination(net.DomainAddress("example.com"), 443)},
+	} {
+		t.Run(name, func(t *testing.T) {
+			d := &scriptedDialer{steps: []func(context.Context) (net.Conn, error){answer(&recordConn{}, 400*time.Millisecond)}}
+			useDialer(t, d)
+			if _, err := DialSystem(tc.ctx, tc.dest, nil); err != nil {
+				t.Fatal(err)
+			}
+			if n := d.calls.Load(); n != 1 {
+				t.Fatalf("%d connects, want 1", n)
+			}
+		})
+	}
+	// A proxy outbound to an IP address still gets its backup.
+	d := &scriptedDialer{steps: []func(context.Context) (net.Conn, error){answer(&recordConn{}, 400*time.Millisecond), answer(&recordConn{}, 0)}}
+	useDialer(t, d)
+	ctx := session.ContextWithOutbounds(context.Background(), []*session.Outbound{{Name: "vless"}})
+	if _, err := DialSystem(ctx, tcpDest, nil); err != nil {
+		t.Fatal(err)
+	}
+	if n := d.calls.Load(); n != 2 {
+		t.Fatalf("vless to an IP address: %d connects, want 2", n)
+	}
+}
diff --git a/transport/internet/dialer.go b/transport/internet/dialer.go
index d35eac52..6ceb9988 100644
--- a/transport/internet/dialer.go
+++ b/transport/internet/dialer.go
@@ -240,7 +240,7 @@ func DialSystem(ctx context.Context, dest net.Destination, sockopt *SocketConfig
 		}
 	}
 	if sockopt == nil {
-		return systemDial(ctx, src, dest, sockopt)
+		return systemDial(ctx, src, dest, sockopt, outboundName)
 	}
 
 	if newDest, err := checkAddressPortStrategy(ctx, dest, sockopt); err == nil && newDest != nil {
@@ -278,13 +278,17 @@ func DialSystem(ctx context.Context, dest net.Destination, sockopt *SocketConfig
 		return redirect(ctx, dest, sockopt.DialerProxy, h), nil
 	}
 
-	return systemDial(ctx, src, dest, sockopt)
+	return systemDial(ctx, src, dest, sockopt, outboundName)
 }
 
 // systemDial dials with the effective system dialer, backing a TCP connect up
-// as connectWithBackup does.
-func systemDial(ctx context.Context, src net.Address, dest net.Destination, sockopt *SocketConfig) (net.Conn, error) {
-	if dest.Network != net.Network_TCP {
+// as connectWithBackup does. Only a connect to an IP address by a proxy
+// outbound gets a backup: for a domain the system dialer resolves it within
+// the connect and races IPv6 and IPv4 itself, as Chrome starts no backup
+// while it resolves; and freedom dials whatever the clients ask for, where a
+// second SYN to every unreachable target would only double the SYNs.
+func systemDial(ctx context.Context, src net.Address, dest net.Destination, sockopt *SocketConfig, outboundName string) (net.Conn, error) {
+	if dest.Network != net.Network_TCP || !dest.Address.Family().IsIP() || outboundName == "freedom" {
 		return effectiveSystemDialer.Dial(ctx, src, dest, sockopt)
 	}
 	return connectWithBackup(ctx, func(ctx context.Context) (net.Conn, error) {
-- 
