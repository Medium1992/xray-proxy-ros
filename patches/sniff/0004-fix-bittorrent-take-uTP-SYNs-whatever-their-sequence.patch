From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Sat, 7 Nov 2026 01:50:58 +0300
Subject: [PATCH] fix(bittorrent): take uTP SYNs whatever their sequence number
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

SniffUTP took a ST_SYN only with sequence number 1 and no extensions, to
keep DNS queries out. libutp and libtorrent start the sequence number at
random (libtorrent's send_syn: m_seq_nr = random(0xffff)), so it missed
the SYNs of qBittorrent, Deluge, Transmission and µTorrent: a libutp
SYN captured from a real client was not sniffed, nor 199996 of 200000
SYNs with random sequence numbers.

The SYN is now told by what upstream's sniffer checked, no timestamp
difference and extensions that end the datagram, with the TURN and zero
connection id exclusions kept. DNS queries are kept out by their header:
one or two questions and at most one answer where a SYN carries its
timestamp. Every DNS query of 11 names, 3 query types, with and without
EDNS and every transaction id, 4.3 million in all, is now rejected,
where upstream's sniffer took 9 and the one before this 3; and none of
2 million random datagrams, RTP, WireGuard or game-like datagrams is
taken.

The end-to-end test's SYN now carries the sequence number of the
captured one; against v26.10.31-h2Flow-2 it is not blocked.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bittorrent_block_process_test.go          |  4 +-
 common/protocol/bittorrent/bittorrent.go      | 52 ++++++++++++++++---
 .../bittorrent/realworld_validation_test.go   |  9 +++-
 3 files changed, 56 insertions(+), 9 deletions(-)

diff --git a/app/dispatcher/bittorrent_block_process_test.go b/app/dispatcher/bittorrent_block_process_test.go
index 76e43b94..52c2a9fa 100644
--- a/app/dispatcher/bittorrent_block_process_test.go
+++ b/app/dispatcher/bittorrent_block_process_test.go
@@ -514,7 +514,9 @@ func btUTPSYN() []byte {
 	binary.BigEndian.PutUint32(packet[4:8], 0xD5396E1C)
 	binary.BigEndian.PutUint32(packet[8:12], 0)
 	binary.BigEndian.PutUint32(packet[12:16], 0x100000)
-	binary.BigEndian.PutUint16(packet[16:18], 1)
+	// libutp and libtorrent start the sequence number at random: this is
+	// the one a libutp ST_SYN carried in a capture.
+	binary.BigEndian.PutUint16(packet[16:18], 0x23C6)
 	return packet
 }
 
diff --git a/common/protocol/bittorrent/bittorrent.go b/common/protocol/bittorrent/bittorrent.go
index c674f57e..4ccfde0b 100644
--- a/common/protocol/bittorrent/bittorrent.go
+++ b/common/protocol/bittorrent/bittorrent.go
@@ -34,26 +34,27 @@ func SniffBittorrent(b []byte) (*SniffHeader, error) {
 // The uTP ST_SYN header layout per BEP 29:
 //
 //	0        type (4 bits, ST_SYN=4) and version (4 bits, always 1)
-//	1        extension id (0 for a connection-opening SYN)
+//	1        first extension id
 //	2-3      connection id
 //	4-7      sender timestamp
 //	8-11     timestamp difference (0 before the first response)
 //	12-15    receive window
-//	16-17    sequence number (1 for ST_SYN)
+//	16-17    sequence number
 //	18-19    ack number
 //
 // The dispatcher sniffs the opening payload of a new UDP flow. Accepting
 // established DATA, STATE, FIN or RESET headers here is unsafe because their
 // unconstrained fields collide with ordinary game discovery and real-time
-// media datagrams. A genuine new uTP flow starts with ST_SYN, whose fixed
-// initial state provides enough evidence to classify it without probabilistic
-// header matching.
+// media datagrams. A genuine new uTP flow starts with ST_SYN: no timestamp
+// difference yet, and extensions, if any, that end where the datagram does.
+// Its sequence number is no evidence: libutp and libtorrent start it at
+// random, as BEP 29 leaves them free to.
 func SniffUTP(b []byte) (*SniffHeader, error) {
 	if len(b) < 20 {
 		return nil, common.ErrNoClue
 	}
 
-	if b[0] != 0x41 || b[1] != 0 {
+	if b[0] != 0x41 {
 		return nil, errNotBittorrent
 	}
 
@@ -72,7 +73,44 @@ func SniffUTP(b []byte) (*SniffHeader, error) {
 		return nil, errNotBittorrent
 	}
 
-	if binary.BigEndian.Uint16(b[16:18]) != 1 {
+	// A DNS query with transaction id 0x41xx and no EDNS shares the fields
+	// above, and its question can end where a SYN's extensions would. Its
+	// QDCOUNT and ANCOUNT are where a SYN carries its timestamp: one or two
+	// questions and at most one answer is a DNS header, and a timestamp of
+	// that shape one in a billion.
+	if qd, an := binary.BigEndian.Uint16(b[4:6]), binary.BigEndian.Uint16(b[6:8]); qd >= 1 && qd <= 2 && an <= 1 {
+		return nil, errNotBittorrent
+	}
+
+	// Walk the extension chain: selective ack (1) and extension bits (2),
+	// which µTorrent sends in its ST_SYN.
+	extension, offset := b[1], 20
+	for extension != 0 {
+		if len(b) < offset+2 {
+			return nil, errNotBittorrent
+		}
+		length := int(b[offset+1])
+		switch extension {
+		case 1:
+			if length < 4 || length%4 != 0 {
+				return nil, errNotBittorrent
+			}
+		case 2:
+			if length != 8 {
+				return nil, errNotBittorrent
+			}
+		default:
+			return nil, errNotBittorrent
+		}
+		if len(b) < offset+2+length {
+			return nil, errNotBittorrent
+		}
+		extension = b[offset]
+		offset += 2 + length
+	}
+
+	// A SYN carries no data: its extensions end the datagram.
+	if len(b) != offset {
 		return nil, errNotBittorrent
 	}
 
diff --git a/common/protocol/bittorrent/realworld_validation_test.go b/common/protocol/bittorrent/realworld_validation_test.go
index db70fddf..d0ffa4eb 100644
--- a/common/protocol/bittorrent/realworld_validation_test.go
+++ b/common/protocol/bittorrent/realworld_validation_test.go
@@ -335,7 +335,10 @@ func TestSniffRealWorldUTP(t *testing.T) {
 		{"libutp-style timestamp", utpPacket(4, 0xC0A8, someTimestamp(), 0, 0x1FC000, 1, 0, nil, nil)},
 		{"zero timestamp", utpPacket(4, 0x07E1, 0, 0, 0x100000, 1, 0, nil, nil)},
 		{"wrapped timestamp", utpPacket(4, 0x1F90, math.MaxUint32, 0, 0x200000, 1, 0, nil, nil)},
-		{"DNS-shaped fixed header", utpPacket(4, 0x0100, 0x00010000, 0, 0x00000100, 1, 0, nil, nil)},
+		// libutp and libtorrent start the sequence number at random.
+		{"libtorrent random sequence number", utpPacket(4, 0x5A3C, someTimestamp(), 0, 0x100000, 0xB2E1, 0, nil, nil)},
+		{"libutp random sequence number", utpPacket(4, 0x4567, 0x793D3D96, 0, 0x100000, 0x23C6, 0, nil, nil)},
+		{"µTorrent extension bits", utpPacket(4, 0x07E1, someTimestamp(), 0, 0x100000, 0x7A10, 0, []utpExt{{id: 2, data: make([]byte, 8)}}, nil)},
 	}
 
 	for _, tc := range cases {
@@ -499,6 +502,10 @@ func TestSniffUTPRejectsNonUTPTraffic(t *testing.T) {
 		{"RakNet-style unconnected ping", rakNetUnconnectedPing()},
 		{"STUN binding success", stunBindingSuccessWithMappedAddress()},
 		{"TURN channel data", turnChannelData()},
+		// A SYN whose timestamp reads as QDCOUNT 1 and ANCOUNT 0 is taken
+		// for the DNS query it looks like: one timestamp in 2^32.
+		{"DNS-shaped fixed header", utpPacket(4, 0x0100, 0x00010000, 0, 0x00000100, 1, 0, nil, nil)},
+		{"SYN with data after it", utpPacket(4, 0x07E1, someTimestamp(), 0, 0x100000, 0x7A10, 0, nil, []byte("data"))},
 		{"TURN channel data matching ST_SYN fields", []byte{0x41, 0x00, 0x00, 0x10, 0x80, 0x60, 0x12, 0x34, 0x00, 0x00, 0x00, 0x00, 0xCA, 0xFE, 0xBA, 0xBE, 0x00, 0x01, 0x07, 0x08}},
 		{"utp-shaped junk with unknown extension id", append([]byte{0x01, 0x05}, blockPayload(r, 30)...)},
 		{"utp-shaped junk with type 5", append([]byte{0x51, 0x00, 0x12, 0x34}, blockPayload(r, 30)...)},
-- 
