+// chaosConn splits reads and writes at random byte offsets.
+type chaosConn struct {
+	net.Conn
+}
+
+func (c chaosConn) Read(b []byte) (int, error) {
+	return c.Conn.Read(b[:1+mrand.IntN(len(b))])
+}
+
+func (c chaosConn) Write(b []byte) (int, error) {
+	n := 0
+	for n < len(b) {
+		m, err := c.Conn.Write(b[n : n+min(len(b)-n, 1+mrand.IntN(4096))])
+		n += m
+		if err != nil {
+			return n, err
+		}
+	}
+	return n, nil
+}
+
+type testListener struct {
+	net.Listener
+	chaos bool
+	mu    sync.Mutex
+	conns []*flowConn
+	up    flowLimit
+	down  flowLimit
+}
+
+func (l *testListener) Accept() (net.Conn, error) {
+	c, err := l.Listener.Accept()
+	if err != nil {
+		return nil, err
+	}
+	if l.chaos {
+		c = chaosConn{c}
+	}
+	if !l.up.enabled() && !l.down.enabled() {
+		return c, nil
+	}
+	fc := newFlowConn(c, l.up, l.down)
+	l.mu.Lock()
+	l.conns = append(l.conns, fc)
+	l.mu.Unlock()
+	return fc, nil
+}
+
+func (l *testListener) each(f func(c *flowConn)) {
+	l.mu.Lock()
+	conns := append([]*flowConn(nil), l.conns...)
+	l.mu.Unlock()
+	for _, c := range conns {
+		c.mu.Lock()
+		f(c)
+		c.mu.Unlock()
+	}
+}
