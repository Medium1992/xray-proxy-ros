From 570b232bfa062697a3f6d734fdda6270e2380541 Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Sat, 24 Oct 2026 18:01:10 +0300
Subject: [PATCH] XHTTP: Keep the flow governor's guard armed for the first
 stream that waits

---
 transport/internet/splithttp/h2flow.go        | 14 ++++++-
 .../internet/splithttp/h2flow_guard_test.go   | 41 +++++++++++++++++++
 .../splithttp/h2flow_verify_control_test.go   |  1 -
 3 files changed, 53 insertions(+), 3 deletions(-)
 create mode 100644 transport/internet/splithttp/h2flow_guard_test.go

diff --git a/transport/internet/splithttp/h2flow.go b/transport/internet/splithttp/h2flow.go
index db85cf0f..2954e61b 100644
--- a/transport/internet/splithttp/h2flow.go
+++ b/transport/internet/splithttp/h2flow.go
@@ -674,6 +674,8 @@ type flowConn struct {
 	incremental bool
 	guard       *time.Timer
 	guardProbe  bool
+	// guardArmed says the guard is set to fire for a stream that waits.
+	guardArmed bool
 
 	rp       frameParser
 	rpending []byte
@@ -1052,6 +1054,7 @@ func (c *flowConn) releaseLocked() {
 	if c.guard != nil {
 		c.guard.Stop()
 	}
+	c.guardArmed = false
 }
 
 // giveUp marks the connection for closing at the next read or write and
@@ -1452,17 +1455,23 @@ func (c *flowConn) armGuard(s *flowStream) {
 		return
 	}
 	s.down.waiting = time.Now()
-	if c.guard == nil {
+	// A guard already armed for a stream that waits longer stays as it is:
+	// moved for each stream that gets stuck after it, it would never fire
+	// while they keep coming.
+	switch {
+	case c.guard == nil:
 		c.guard = time.AfterFunc(c.guardDelay(), c.fireGuard)
-	} else {
+	case !c.guardArmed:
 		c.guard.Reset(c.guardDelay())
 	}
+	c.guardArmed = true
 }
 
 // fireGuard asks the client for a PING: its ACK arrives on the read side,
 // where stuck streams can then be given more room in order with other frames.
 func (c *flowConn) fireGuard() {
 	c.mu.Lock()
+	c.guardArmed = false
 	if c.closed || c.incremental || !c.anyWaiting() {
 		c.mu.Unlock()
 		return
@@ -1516,6 +1525,7 @@ func (c *flowConn) unstick(now time.Time, out []byte) []byte {
 	}
 	if again && c.guard != nil {
 		c.guard.Reset(delay)
+		c.guardArmed = true
 	}
 	return out
 }
diff --git a/transport/internet/splithttp/h2flow_guard_test.go b/transport/internet/splithttp/h2flow_guard_test.go
new file mode 100644
index 00000000..5907ee08
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_guard_test.go
@@ -0,0 +1,41 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+)
+
+// TestFlowGuardNotPutOffByNewStreams has a stream run out of window with a
+// client that credits in large steps, and then another one every 40 ms,
+// sooner than the guard's delay: the guard still fires for the first.
+// Moved for each new stream, it fired only once they stopped coming.
+func TestFlowGuardNotPutOffByNewStreams(t *testing.T) {
+	defer func(d time.Duration) { flowGuardMin = d }(flowGuardMin)
+	flowGuardMin = 100 * time.Millisecond
+	c := newFlowConn(&scriptConn{}, flowDefault, flowDefault)
+	t.Cleanup(func() { c.Close() })
+	c.mu.Lock()
+	c.clientInit, c.clientShown = 1<<20, h2InitWindow
+	c.incremental = false
+	c.rtt = 20 * time.Millisecond
+	c.mu.Unlock()
+	stuck := func(id uint32) {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		s := &flowStream{downSent: h2InitWindow}
+		c.streams[id] = s
+		c.armGuard(s)
+	}
+	stuck(1)
+	for id := uint32(3); id < 23; id += 2 {
+		time.Sleep(40 * time.Millisecond)
+		c.mu.Lock()
+		fired := c.guardProbe
+		c.mu.Unlock()
+		if fired {
+			return
+		}
+		stuck(id)
+	}
+	t.Fatalf("stream 1 has waited %v with no probe, the guard's delay being %v", 400*time.Millisecond, flowGuardMin)
+}
diff --git a/transport/internet/splithttp/h2flow_verify_control_test.go b/transport/internet/splithttp/h2flow_verify_control_test.go
index d7900164..e8584a02 100644
--- a/transport/internet/splithttp/h2flow_verify_control_test.go
+++ b/transport/internet/splithttp/h2flow_verify_control_test.go
@@ -157,7 +157,6 @@ func TestFlowRecognisesEveryOutstandingPing(t *testing.T) {
 	}
 }
 
-
 // pingReaction connects to a server, answers the first PING it sends (or uses
 // a fixed payload when it sends none) with the frames build returns, and
 // reports how the server reacts, as h2Reaction does.
