+	if f.flags&h2FlagAck == 0 || binary.BigEndian.Uint32(payload) != flowPingMagic ||
+		binary.BigEndian.Uint32(payload[4:]) != c.pingSeq || c.pingSentAt.IsZero() {
+		return false
+	}
+	now := time.Now()
+	c.sampleRTT(now, now.Sub(c.pingSentAt))
+	c.pingSentAt = time.Time{}
+	return true
+}
