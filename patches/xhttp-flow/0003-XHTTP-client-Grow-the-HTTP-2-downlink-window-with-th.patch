+	c.pingSeq++
+	c.pingSentAt, c.lastPing = now, now
+	out = append(out, 0, 0, 8, h2Ping, 0, 0, 0, 0, 0)
+	out = binary.BigEndian.AppendUint32(out, flowPingMagic)
