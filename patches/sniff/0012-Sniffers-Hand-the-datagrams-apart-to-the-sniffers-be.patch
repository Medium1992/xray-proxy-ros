From 959fd3e4e00883df3998205410894675fa58a237 Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Sat, 14 Nov 2026 22:53:37 +0300
Subject: [PATCH] Sniffers: Hand the datagrams apart to the sniffers behind
 fakedns+others

With destOverride "fakedns+others", a flow to a fake address the engine
has no domain for is sniffed through a wrapper that called every other
sniffer with the datagrams read so far joined, so the uTP, STUN and
Discord sniffers, which read a flow's first datagram on its own, missed
a SYN or request that arrived in a batch. The wrapper now has a datagram
sniffer of its own and hands them the datagrams apart. Ported from
Jolymmiles/Xray-core 92ccc7bb.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/dispatcher/fakednssniffer.go              | 49 ++++++++++++-------
 .../sniffer_fakedns_datagrams_test.go         | 43 ++++++++++++++++
 2 files changed, 74 insertions(+), 18 deletions(-)
 create mode 100644 app/dispatcher/sniffer_fakedns_datagrams_test.go

diff --git a/app/dispatcher/fakednssniffer.go b/app/dispatcher/fakednssniffer.go
index 9476288c..f0e50a3b 100644
--- a/app/dispatcher/fakednssniffer.go
+++ b/app/dispatcher/fakednssniffer.go
@@ -91,31 +91,44 @@ func newFakeDNSThenOthers(ctx context.Context, fakeDNSSniffer protocolSnifferWit
 ) { // nolint: unparam
 	// ctx may be used in the future
 	_ = ctx
-	return protocolSnifferWithMetadata{
-		protocolSniffer: func(ctx context.Context, bytes []byte) (SniffResult, error) {
-			ipAddressInRangeValue := &ipAddressInRangeOpt{}
-			ctx = context.WithValue(ctx, ipAddressInRange, ipAddressInRangeValue)
-			result, err := fakeDNSSniffer.protocolSniffer(ctx, bytes)
-			if err == nil {
-				return result, nil
-			}
-			if ipAddressInRangeValue.addressInRange != nil {
-				if *ipAddressInRangeValue.addressInRange {
-					for _, v := range others {
-						if v.metadataSniffer || bytes != nil {
-							if result, err := v.protocolSniffer(ctx, bytes); err == nil {
-								return DNSThenOthersSniffResult{domainName: result.Domain(), protocolOriginalName: result.Protocol()}, nil
-							}
+	sniff := func(ctx context.Context, bytes []byte, datagrams [][]byte) (SniffResult, error) {
+		ipAddressInRangeValue := &ipAddressInRangeOpt{}
+		ctx = context.WithValue(ctx, ipAddressInRange, ipAddressInRangeValue)
+		result, err := fakeDNSSniffer.protocolSniffer(ctx, bytes)
+		if err == nil {
+			return result, nil
+		}
+		if ipAddressInRangeValue.addressInRange != nil {
+			if *ipAddressInRangeValue.addressInRange {
+				for _, v := range others {
+					if v.metadataSniffer || bytes != nil {
+						var result SniffResult
+						var err error
+						// Sniffers that read a UDP flow datagram by datagram
+						// get them apart here too, as SniffDatagrams gives them.
+						if v.datagramSniffer != nil && len(datagrams) != 0 {
+							result, err = v.datagramSniffer(ctx, bytes, datagrams)
+						} else {
+							result, err = v.protocolSniffer(ctx, bytes)
+						}
+						if err == nil {
+							return DNSThenOthersSniffResult{domainName: result.Domain(), protocolOriginalName: result.Protocol()}, nil
 						}
 					}
-					return nil, common.ErrNoClue
 				}
-				errors.LogDebug(ctx, "ip address not in fake dns range, return as is")
 				return nil, common.ErrNoClue
 			}
-			errors.LogWarning(ctx, "fake dns sniffer did not set address in range option, assume false.")
+			errors.LogDebug(ctx, "ip address not in fake dns range, return as is")
 			return nil, common.ErrNoClue
+		}
+		errors.LogWarning(ctx, "fake dns sniffer did not set address in range option, assume false.")
+		return nil, common.ErrNoClue
+	}
+	return protocolSnifferWithMetadata{
+		protocolSniffer: func(ctx context.Context, bytes []byte) (SniffResult, error) {
+			return sniff(ctx, bytes, nil)
 		},
+		datagramSniffer: sniff,
 		metadataSniffer: false,
 	}, nil
 }
diff --git a/app/dispatcher/sniffer_fakedns_datagrams_test.go b/app/dispatcher/sniffer_fakedns_datagrams_test.go
new file mode 100644
index 00000000..bcac8ab5
--- /dev/null
+++ b/app/dispatcher/sniffer_fakedns_datagrams_test.go
@@ -0,0 +1,43 @@
+package dispatcher
+
+import (
+	"bytes"
+	"context"
+	"testing"
+
+	"github.com/xtls/xray-core/common"
+)
+
+// With "fakedns+others", a flow to a fake address the engine has no domain
+// for is sniffed by the other sniffers through a wrapper, which must hand the
+// sniffers that read datagrams apart the datagrams too: two uTP SYNs or a
+// Discord request read in one batch are still told.
+func TestFakeDNSThenOthersSniffsDatagramsApart(t *testing.T) {
+	inRange := protocolSnifferWithMetadata{
+		protocolSniffer: func(ctx context.Context, _ []byte) (SniffResult, error) {
+			yes := true
+			ctx.Value(ipAddressInRange).(*ipAddressInRangeOpt).addressInRange = &yes
+			return nil, common.ErrNoClue
+		},
+		metadataSniffer: true,
+	}
+	wrapper, err := newFakeDNSThenOthers(context.Background(), inRange, defaultProtocolSniffers)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for name, tc := range map[string]struct {
+		datagrams [][]byte
+		protocol  string
+	}{
+		"uTP SYN twice":     {[][]byte{vUTPSYN(), vUTPSYN()}, "bittorrent"},
+		"Discord, then RTP": {[][]byte{discordIPDiscovery(), make([]byte, 60)}, "discordrtc"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			result, err := wrapper.datagramSniffer(context.Background(), bytes.Join(tc.datagrams, nil), tc.datagrams)
+			others, ok := result.(DNSThenOthersSniffResult)
+			if err != nil || !ok || others.protocolOriginalName != tc.protocol {
+				t.Fatalf("sniffed %v, %v; want %s", result, err, tc.protocol)
+			}
+		})
+	}
+}
