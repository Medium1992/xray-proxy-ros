@@ -0,0 +1,91 @@
+//go:build integration
+
+package dispatcher
+
+import (
+	"bytes"
+	"fmt"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// TestSTUNRouteProcessE2E is TestBitTorrentBlockProcessE2E for a routing rule
+// protocol ["stun"] -> block, on a real Xray process: STUN over UDP and TCP
+// never reaches the destination, while DNS, a plain datagram and a plain TCP
+// exchange through the same proxy are answered.
+func TestSTUNRouteProcessE2E(t *testing.T) {
+	workDir := t.TempDir()
+	xrayBin := btBuildXray(t, workDir)
+
+	udpEcho := btNewUDPResponder(t)
+	t.Cleanup(func() { _ = udpEcho.conn.Close() })
+	tcpEcho := btNewTCPResponder(t)
+	t.Cleanup(func() { _ = tcpEcho.listener.Close() })
+
+	socksPort := btFreeTCPPort(t)
+	config := fmt.Sprintf(`{
+		"log": {"loglevel": "warning"},
+		"inbounds": [{
+			"listen": "127.0.0.1",
+			"port": %d,
+			"protocol": "socks",
+			"settings": {"udp": true},
+			"sniffing": {"enabled": true}
+		}],
+		"outbounds": [
+			{"tag": "direct", "protocol": "freedom"},
+			{"tag": "block", "protocol": "blackhole", "settings": {"response": {"type": "none"}}}
+		],
+		"routing": {"rules": [
+			{"type": "field", "protocol": ["stun"], "outboundTag": "block"}
+		]}
+	}`, socksPort)
+	process := btStartXray(t, xrayBin, config, filepath.Join(workDir, "config.json"))
+	btWaitSOCKS(t, process, socksPort)
+
+	t.Run("dns query through proxy is answered", func(t *testing.T) {
+		response := btRoundTripUDP(t, socksPort, udpEcho.addr, btDNSQuery(0xBEEF), 5*time.Second)
+		if len(response) < 3 || response[2]&0x80 == 0 {
+			t.Fatalf("unexpected DNS response: % x", response)
+		}
+	})
+
+	t.Run("plain udp datagram through proxy is echoed", func(t *testing.T) {
+		payload := []byte("plain-udp-control")
+		if response := btRoundTripUDP(t, socksPort, udpEcho.addr, payload, 5*time.Second); !bytes.Equal(response, payload) {
+			t.Fatalf("echo mismatch: got %q", response)
+		}
+	})
+
+	t.Run("plain tcp exchange through proxy is echoed", func(t *testing.T) {
+		payload := []byte("plain-tcp-control")
+		if response := btRoundTripTCP(t, socksPort, tcpEcho.addr.Port, payload, 5*time.Second); !bytes.Equal(response, payload) {
+			t.Fatalf("echo mismatch: got %q", response)
+		}
+	})
+
+	t.Run("stun binding over udp is blocked", func(t *testing.T) {
+		btAssertBlockedUDP(t, socksPort, udpEcho, stunBinding(), "STUN binding")
+	})
+
+	t.Run("stun binding success over udp is blocked", func(t *testing.T) {
+		btAssertBlockedUDP(t, socksPort, udpEcho, btSTUNBindingSuccess(), "STUN binding success")
+	})
+
+	t.Run("stun over tcp is blocked", func(t *testing.T) {
+		message := stunBinding()
+		conn := btSOCKSConnect(t, socksPort, tcpEcho.addr.Port)
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+		if _, err := conn.Write(message); err != nil {
+			t.Fatalf("write STUN: %v\nserver logs:\n%s", err, process.logs())
+		}
+		if _, err := conn.Read(make([]byte, len(message))); err == nil {
+			t.Fatal("proxy echoed a STUN message over TCP")
+		}
+		if tcpEcho.recorded(message) {
+			t.Fatal("STUN over TCP reached the destination")
+		}
+	})
+}
diff --git a/common/protocol/stun/stun.go b/common/protocol/stun/stun.go
new file mode 100644
index 00000000..3013a757
--- /dev/null
+++ b/common/protocol/stun/stun.go
@@ -0,0 +1,112 @@
+// Package stun sniffs STUN (RFC 8489, RFC 5389) and the TURN messages that
+// share its header (RFC 8656): the binding requests of ICE in WebRTC and of
+// the calls in WhatsApp, Telegram and FaceTime, and their relay allocations.
+// In ICE the media follows the STUN checks on the same pair of ports, so a
+// rule on the first datagram routes the whole call.
+package stun
+
+import (
+	"encoding/binary"
+	"errors"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/protocol"
+)
+
+type SniffHeader struct{}
+
+func (h *SniffHeader) Protocol() string {
+	return "stun"
+}
+
+func (h *SniffHeader) Domain() string {
+	return ""
+}
+
+// The STUN header per RFC 8489, section 5:
+//
+//	0-1      type: two zero bits, then 14 bits of method and class
+//	2-3      length of the attributes that follow, a multiple of 4
+//	4-7      magic cookie 0x2112A442
+//	8-19     transaction id
+//
+// Each attribute is a 2-byte type and a 2-byte length, its value padded to a
+// multiple of 4.
+const (
+	headerLen   = 20
+	magicCookie = 0x2112A442
+)
+
+var errNotSTUN = errors.New("not stun")
+
+// SniffSTUN reads a STUN message at the start of b. It takes only messages
+// with the magic cookie: classic STUN (RFC 3489) has none, and without it a
+// header is a few bits any other datagram may carry.
+//
+// b may hold more than the message, as a stream or datagrams read together
+// do; SniffSTUNDatagram is for a datagram on its own.
+func SniffSTUN(b []byte) (*SniffHeader, error) {
+	n, err := message(b)
+	if err != nil {
+		return nil, err
+	}
+	if n > len(b) {
+		// The cookie is in place, so it is STUN: wait for the rest.
+		return nil, protocol.ErrProtoNeedMoreData
+	}
+	if !attributes(b[headerLen:n]) {
+		return nil, errNotSTUN
+	}
+	return &SniffHeader{}, nil
+}
+
+// SniffSTUNDatagram reads a datagram that is one STUN message, as it is over
+// UDP: its length says where the datagram ends.
+func SniffSTUNDatagram(d []byte) (*SniffHeader, error) {
+	n, err := message(d)
+	if err == common.ErrNoClue {
+		// A datagram is whole: one too short for the header is no STUN.
+		return nil, errNotSTUN
+	}
+	if err != nil {
+		return nil, err
+	}
+	if n != len(d) || !attributes(d[headerLen:]) {
+		return nil, errNotSTUN
+	}
+	return &SniffHeader{}, nil
+}
+
+// message checks the header at the start of b and returns the length of the
+// whole message.
+func message(b []byte) (int, error) {
+	if len(b) > 0 && b[0]&0xC0 != 0 {
+		return 0, errNotSTUN
+	}
+	if len(b) < 8 {
+		return 0, common.ErrNoClue
+	}
+	if binary.BigEndian.Uint32(b[4:8]) != magicCookie {
+		return 0, errNotSTUN
+	}
+	length := int(binary.BigEndian.Uint16(b[2:4]))
+	if length%4 != 0 {
+		return 0, errNotSTUN
+	}
+	return headerLen + length, nil
+}
+
+// attributes reports whether b is a run of attributes that ends where b does.
+func attributes(b []byte) bool {
+	for len(b) > 0 {
+		if len(b) < 4 {
+			return false
+		}
+		size := 4 + (int(binary.BigEndian.Uint16(b[2:4]))+3)&^3
+		if size > len(b) {
+			return false
+		}
+		b = b[size:]
+	}
+	return true
+}
diff --git a/common/protocol/stun/stun_test.go b/common/protocol/stun/stun_test.go
