From 8b4802b0153b4d300ee4fe633745de63f3991330 Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Sun, 11 Oct 2026 13:20:57 +0300
Subject: [PATCH 32/32] XHTTP: Take the flow governor's send window as
 configured, whatever the client announces

The limit was never below the stream window the client announced. That was
meant to leave a client with raised windows its own room, but a client with
a governor of its own announces the protocol default whatever its window, so
it told nothing; and it kept a value under the 4 MiB a Go client announces
from holding at all.
---
 transport/internet/splithttp/h2flow.go        | 14 +++---
 .../splithttp/h2flow_sendwindow_test.go       | 44 ++++++++++++++++---
 2 files changed, 44 insertions(+), 14 deletions(-)

diff --git a/transport/internet/splithttp/h2flow.go b/transport/internet/splithttp/h2flow.go
index ceada15e..b7be818a 100644
--- a/transport/internet/splithttp/h2flow.go
+++ b/transport/internet/splithttp/h2flow.go
@@ -1322,11 +1322,12 @@ func (c *flowConn) upRelease(s *flowStream) int64 {
 // follows its own reader, but many streams starting at once on a fast link
 // each look fast for a moment, and the client has to hold their sum: twenty
 // of them took a client past 40 MiB within a second. What the client holds
-// is clientHolds. A client that itself announces a stream window above
-// sendWindow has that room, so its window is the limit then. A stream always
-// has the window the server was shown at the start, flowShownLimited, so
-// none waits for the others; streams opened once the limit is used up add
-// that much each.
+// is clientHolds. The limit does not follow the window the client announces:
+// a client with a governor of its own announces the protocol default whatever
+// its window, so that says nothing, and a value under the 4 MiB a Go client
+// announces has to be able to hold. A stream always has the window the
+// server was shown at the start, flowShownLimited, so none waits for the
+// others; streams opened once the limit is used up add that much each.
 func (c *flowConn) downRelease(s *flowStream) int64 {
 	bank := int64(c.clientInit) + s.down.returned - int64(c.clientShown) - s.downForwarded
 	held := int64(c.clientShown) + s.downForwarded - s.down.returned
@@ -1334,8 +1335,7 @@ func (c *flowConn) downRelease(s *flowStream) int64 {
 	if rel <= 0 || c.client || c.sendWindow == 0 {
 		return rel
 	}
-	limit := max(c.sendWindow, int64(c.clientInit))
-	return min(rel, max(limit-c.clientHolds(), int64(c.clientShown)-held))
+	return min(rel, max(c.sendWindow-c.clientHolds(), int64(c.clientShown)-held))
 }
 
 func appendWindowUpdate(out []byte, stream uint32, n int64) []byte {
diff --git a/transport/internet/splithttp/h2flow_sendwindow_test.go b/transport/internet/splithttp/h2flow_sendwindow_test.go
index da2b5b6c..0db798ba 100644
--- a/transport/internet/splithttp/h2flow_sendwindow_test.go
+++ b/transport/internet/splithttp/h2flow_sendwindow_test.go
@@ -75,14 +75,44 @@ func TestFlowSendWindowBoundsManyStreams(t *testing.T) {
 	t.Logf("%d streams: %d in all with the limit, %d without", n, total, n*flowStartWindow)
 }
 
-// TestFlowSendWindowFollowsClientWindow gives the same streams to a client
-// that grants 16 MiB per stream, as a bridge with raised windows does: it has
-// room for more than the limit, so its own window is the limit.
-func TestFlowSendWindowFollowsClientWindow(t *testing.T) {
+// TestFlowSendWindowIgnoresClientWindow gives the same streams to a client
+// that grants 16 MiB per stream. The limit is what was configured, not what
+// the client announces: a client with a governor of its own announces the
+// protocol default whatever its window, so the announcement says nothing.
+func TestFlowSendWindowIgnoresClientWindow(t *testing.T) {
 	const n = 40
-	total, _ := granted(openStreams(t, flowServerSendWindow, 16<<20, n))
-	if total != n*flowStartWindow {
-		t.Fatalf("server may send %d to a client granting 16 MiB a stream, want %d", total, n*flowStartWindow)
+	with4, _ := granted(openStreams(t, flowServerSendWindow, 4<<20, n))
+	with16, _ := granted(openStreams(t, flowServerSendWindow, 16<<20, n))
+	if with16 != with4 {
+		t.Fatalf("server may send %d to a client granting 16 MiB a stream and %d to one granting 4 MiB", with16, with4)
+	}
+}
+
+// TestFlowSendWindowBelowClientWindow sets a limit under the 4 MiB a Go
+// client grants one stream: it holds, for forty streams and for one.
+func TestFlowSendWindowBelowClientWindow(t *testing.T) {
+	const limit = 1 << 20
+	h := openStreams(t, limit, 4<<20, 40)
+	total, atLeast := granted(h)
+	if above := total - int64(atLeast)*flowShownLimited; above > limit || above < limit-flowStartWindow {
+		t.Fatalf("streams above the least window may send %d, the limit is %d", above, limit)
+	}
+	// One stream alone grows as its reader takes, but not past the limit.
+	h = openStreams(t, limit, 4<<20, 1)
+	sent := int64(0)
+	for round := 0; round < 64; round++ {
+		w := h.toServer.streams[1] - sent
+		if w > limit {
+			t.Fatalf("round %d: one stream may be sent %d at once, the limit is %d", round, w, limit)
+		}
+		h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, 1, int(w)) })
+		sent += w
+		for left := w; left > 0; left -= min(left, 16<<10) {
+			h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(1, uint32(min(left, 16<<10))) })
+		}
+	}
+	if sent < 8*limit {
+		t.Fatalf("one stream was sent %d in 64 rounds: the limit stops it instead of pacing it", sent)
 	}
 }
 
