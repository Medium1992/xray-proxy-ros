+// TestFlowSiblingUploadAfterReadingStreamOverrun is
+// TestFlowSiblingUploadAfterDroppedOverrun with stream 1 read in part before
+// it sends past its window: stock and governed both take stream 3's body.
+// The governor's release after the drop gave nothing back once stream 1 had
+// read, and stream 3 closed the connection.
+func TestFlowSiblingUploadAfterReadingStreamOverrun(t *testing.T) {
+	run := func(t *testing.T, governed bool) error {
+		unblock1 := make(chan struct{})
+		defer close(unblock1)
+		read64Ready := make(chan struct{})
+		startRead3 := make(chan struct{})
+		siblingDone := make(chan error, 1)
+
+		handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if r.URL.Path == "/sibling" {
+				<-startRead3
+				rest := make([]byte, 320<<10)
+				_, err := io.ReadFull(r.Body, rest)
+				siblingDone <- err
+				return
+			}
+			buf := make([]byte, 64<<10)
+			if _, err := io.ReadFull(r.Body, buf); err != nil {
+				return
+			}
+			close(read64Ready)
+			<-unblock1
+		})
+
+		ln, err := net.Listen("tcp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer ln.Close()
+
+		var listener net.Listener = ln
+		// After reading 64 KiB on stream 1, stock has 960 KiB stream window left (total 1 MiB)
+		// and 1280 KiB connection window left, matching governed's advertised windows.
+		h2cfg := &http.HTTP2Config{
+			MaxReceiveBufferPerStream:     flowShownUp - (64 << 10),
+			MaxReceiveBufferPerConnection: flowConnFloor + 256<<10,
+		}
+		if governed {
+			h2cfg = (&Config{H2Flow: &H2FlowConfig{Mode: 1}}).h2ReceiveConfig(true)
+			listener = &flowListener{
+				Listener:   ln,
+				up:         flowDefault,
+				down:       flowDefault,
+				connWindow: h2ConnWindow(h2cfg),
+			}
+		}
+		protocols := new(http.Protocols)
+		protocols.SetUnencryptedHTTP2(true)
+		srv := &http.Server{Handler: handler, Protocols: protocols, HTTP2: h2cfg}
+		go srv.Serve(listener)
+		defer srv.Close()
+
+		conn, err := net.Dial("tcp", ln.Addr().String())
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		conn.SetDeadline(time.Now().Add(5 * time.Second))
+		conn.Write([]byte(h2Preface))
+		fr := http2.NewFramer(conn, conn)
+		fr.WriteSettings()
+		readServerPreface(t, fr)
+
+		encodeHeaders := func(path string) []byte {
+			var hb bytes.Buffer
+			enc := hpack.NewEncoder(&hb)
+			for _, kv := range [][2]string{
+				{":method", "POST"},
+				{":scheme", "http"},
+				{":path", path},
+				{":authority", "example.com"},
+			} {
+				enc.WriteField(hpack.HeaderField{Name: kv[0], Value: kv[1]})
+			}
+			return hb.Bytes()
+		}
+
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: encodeHeaders("/upload"), EndHeaders: true})
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 3, BlockFragment: encodeHeaders("/sibling"), EndHeaders: true})
+
+		chunk := make([]byte, 16384)
+		for i := 0; i < 4; i++ {
+			fr.WriteData(1, false, chunk)
+		}
+		<-read64Ready
+
+		ping1 := [8]byte{1, 2, 3, 4, 5, 6, 7, 8}
+		fr.WritePing(false, ping1)
+		for {
+			f, err := fr.ReadFrame()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if pf, ok := f.(*http2.PingFrame); ok && pf.IsAck() && pf.Data == ping1 {
+				break
+			}
+		}
+
+		// Stream 1 sends the remaining 960 KiB of its 1 MiB window, plus 16 KiB past it.
+		for sent := 64 << 10; sent < flowShownUp; sent += len(chunk) {
+			fr.WriteData(1, false, chunk)
+		}
+		fr.WriteData(1, false, chunk) // 16 KiB past stream 1's window
+
+		for {
+			f, err := fr.ReadFrame()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if rst, ok := f.(*http2.RSTStreamFrame); ok && rst.StreamID == 1 {
+				break
+			}
+		}
+
+		// Stream 3 sends the remaining 320 KiB (20 * 16 KiB) of the connection window granted to the client.
+		for i := 0; i < 20; i++ {
+			if err := fr.WriteData(3, i == 19, chunk); err != nil {
+				close(startRead3)
+				return err
+			}
+		}
+		ping2 := [8]byte{9, 8, 7, 6, 5, 4, 3, 2}
+		fr.WritePing(false, ping2)
+		for {
+			f, err := fr.ReadFrame()
+			if err != nil {
+				close(startRead3)
+				return err
+			}
+			if pf, ok := f.(*http2.PingFrame); ok && pf.IsAck() && pf.Data == ping2 {
+				break
+			}
+		}
+		close(startRead3)
+		return <-siblingDone
+	}
+
+	stockErr := run(t, false)
+	govErr := run(t, true)
+	t.Logf("two-stream self-read overrun -> stockErr=%v, govErr=%v", stockErr, govErr)
+	if stockErr != nil || govErr != nil {
+		t.Fatalf("stockErr=%v, govErr=%v (want both nil)", stockErr, govErr)
+	}
+}
+
+// TestFlowSiblingUploadAfterFinishedStreamOverrun has stream 3 widen the
+// connection window and finish before stream 1 sends past its window, and
+// stream 5 then upload within the connection window: stock and governed both
+// take stream 5's body.
+func TestFlowSiblingUploadAfterFinishedStreamOverrun(t *testing.T) {
+	run := func(t *testing.T, governed bool) error {
+		unblock1 := make(chan struct{})
+		defer close(unblock1)
+		bumpReady := make(chan struct{})
+		startRead5 := make(chan struct{})
+		siblingDone := make(chan error, 1)
+
+		handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			switch r.URL.Path {
+			case "/bump":
+				buf := make([]byte, 64<<10)
+				if _, err := io.ReadFull(r.Body, buf); err != nil {
+					return
+				}
+				close(bumpReady)
+				io.Copy(io.Discard, r.Body)
+			case "/sibling":
+				<-startRead5
+				rest := make([]byte, 256<<10)
+				_, err := io.ReadFull(r.Body, rest)
+				siblingDone <- err
+			default:
+				<-unblock1
+			}
+		})
+
+		ln, err := net.Listen("tcp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer ln.Close()
+
+		var listener net.Listener = ln
+		h2cfg := &http.HTTP2Config{
+			MaxReceiveBufferPerStream:     flowShownUp,
+			MaxReceiveBufferPerConnection: flowConnFloor + 256<<10,
+		}
+		if governed {
+			h2cfg = (&Config{H2Flow: &H2FlowConfig{Mode: 1}}).h2ReceiveConfig(true)
+			listener = &flowListener{
+				Listener:   ln,
+				up:         flowDefault,
+				down:       flowDefault,
+				connWindow: h2ConnWindow(h2cfg),
+			}
+		}
+		protocols := new(http.Protocols)
+		protocols.SetUnencryptedHTTP2(true)
+		srv := &http.Server{Handler: handler, Protocols: protocols, HTTP2: h2cfg}
+		go srv.Serve(listener)
+		defer srv.Close()
+
+		conn, err := net.Dial("tcp", ln.Addr().String())
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		conn.SetDeadline(time.Now().Add(5 * time.Second))
+		conn.Write([]byte(h2Preface))
+		fr := http2.NewFramer(conn, conn)
+		fr.WriteSettings()
+		readServerPreface(t, fr)
+
+		encodeHeaders := func(path string) []byte {
+			var hb bytes.Buffer
+			enc := hpack.NewEncoder(&hb)
+			for _, kv := range [][2]string{
+				{":method", "POST"},
+				{":scheme", "http"},
+				{":path", path},
+				{":authority", "example.com"},
+			} {
+				enc.WriteField(hpack.HeaderField{Name: kv[0], Value: kv[1]})
+			}
+			return hb.Bytes()
+		}
+
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: encodeHeaders("/upload"), EndHeaders: true})
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 3, BlockFragment: encodeHeaders("/bump"), EndHeaders: true})
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 5, BlockFragment: encodeHeaders("/sibling"), EndHeaders: true})
+
+		chunk := make([]byte, 16384)
+		for i := 0; i < 4; i++ {
+			fr.WriteData(3, false, chunk)
+		}
+		<-bumpReady
+
+		ping0 := [8]byte{0, 1, 2, 3, 4, 5, 6, 7}
+		fr.WritePing(false, ping0)
+		for {
+			f, err := fr.ReadFrame()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if pf, ok := f.(*http2.PingFrame); ok && pf.IsAck() && pf.Data == ping0 {
+				break
+			}
+		}
+
+		// Stream 3 finishes its upload (END_STREAM).
+		fr.WriteData(3, true, nil)
+
+		ping1 := [8]byte{1, 2, 3, 4, 5, 6, 7, 8}
+		fr.WritePing(false, ping1)
+		for {
+			f, err := fr.ReadFrame()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if pf, ok := f.(*http2.PingFrame); ok && pf.IsAck() && pf.Data == ping1 {
+				break
+			}
+		}
+
+		// Stream 1 sends 1 MiB + 16 KiB (overrunning its 1 MiB stream window).
+		for sent := 0; sent < flowShownUp; sent += len(chunk) {
+			fr.WriteData(1, false, chunk)
+		}
+		fr.WriteData(1, false, chunk) // 16 KiB past stream 1's 1 MiB window
+
+		for {
+			f, err := fr.ReadFrame()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if rst, ok := f.(*http2.RSTStreamFrame); ok && rst.StreamID == 1 {
+				break
+			}
+		}
+
+		// Stream 5 now sends 256 KiB, within the connection window that was already granted.
+		for i := 0; i < 16; i++ {
+			if err := fr.WriteData(5, i == 15, chunk); err != nil {
+				close(startRead5)
+				return err
+			}
+		}
+		ping2 := [8]byte{9, 8, 7, 6, 5, 4, 3, 2}
+		fr.WritePing(false, ping2)
+		for {
+			f, err := fr.ReadFrame()
+			if err != nil {
+				close(startRead5)
+				return err
+			}
+			if pf, ok := f.(*http2.PingFrame); ok && pf.IsAck() && pf.Data == ping2 {
+				break
+			}
+		}
+		close(startRead5)
+		return <-siblingDone
+	}
+
+	stockErr := run(t, false)
+	govErr := run(t, true)
+	t.Logf("stockErr=%v, govErr=%v", stockErr, govErr)
+	if stockErr != nil || govErr != nil {
+		t.Fatalf("stockErr=%v, govErr=%v (want both nil)", stockErr, govErr)
+	}
+}
+
+// TestFlowDataInHeaderBlockAsStock sends a DATA frame past the stream's window
+// inside an open header block: the governed server ends the connection as a
+// stock one does. The governor dropped the frame and reset the stream, and
+// the stack never saw the protocol error.
+func TestFlowDataInHeaderBlockAsStock(t *testing.T) {
+	run := func(t *testing.T, governed bool) (gotGoAway bool, errCode http2.ErrCode) {
+		unblock := make(chan struct{})
+		defer close(unblock)
+		handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if r.URL.Path == "/bump" {
+				io.Copy(io.Discard, r.Body)
+				return
+			}
+			<-unblock
+		})
+
+		ln, err := net.Listen("tcp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer ln.Close()
+
+		var listener net.Listener = ln
+		h2cfg := &http.HTTP2Config{
+			MaxReceiveBufferPerStream:     flowShownUp,
+			MaxReceiveBufferPerConnection: flowServerReceiveWindow,
+		}
+		if governed {
+			h2cfg = (&Config{H2Flow: &H2FlowConfig{Mode: 1}}).h2ReceiveConfig(true)
+			listener = &flowListener{
+				Listener:   ln,
+				up:         flowDefault,
+				down:       flowDefault,
+				connWindow: h2ConnWindow(h2cfg),
+			}
+		}
+		protocols := new(http.Protocols)
+		protocols.SetUnencryptedHTTP2(true)
+		srv := &http.Server{Handler: handler, Protocols: protocols, HTTP2: h2cfg}
+		go srv.Serve(listener)
+		defer srv.Close()
+
+		conn, err := net.Dial("tcp", ln.Addr().String())
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		conn.SetDeadline(time.Now().Add(2 * time.Second))
+		conn.Write([]byte(h2Preface))
+		fr := http2.NewFramer(conn, conn)
+		fr.WriteSettings()
+		connWin := readServerPreface(t, fr)
+
+		var hb1, hb3 bytes.Buffer
+		enc1 := hpack.NewEncoder(&hb1)
+		for _, kv := range [][2]string{{":method", "POST"}, {":scheme", "http"}, {":path", "/upload"}, {":authority", "example.com"}} {
+			enc1.WriteField(hpack.HeaderField{Name: kv[0], Value: kv[1]})
+		}
+		enc3 := hpack.NewEncoder(&hb3)
+		for _, kv := range [][2]string{{":method", "POST"}, {":scheme", "http"}, {":path", "/bump"}, {":authority", "example.com"}} {
+			enc3.WriteField(hpack.HeaderField{Name: kv[0], Value: kv[1]})
+		}
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: hb1.Bytes(), EndHeaders: true})
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 3, BlockFragment: hb3.Bytes(), EndHeaders: true})
+		for i := 0; i < 4; i++ {
+			fr.WriteData(3, false, make([]byte, 16384))
+		}
+		connWin -= 4 * 16384
+		for connWin < int64(flowShownUp)+16384 {
+			f, err := fr.ReadFrame()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if wu, ok := f.(*http2.WindowUpdateFrame); ok && wu.StreamID == 0 {
+				connWin += int64(wu.Increment)
+			}
+		}
+
+		chunk := make([]byte, 16384)
+		for sent := 0; sent < flowShownUp; sent += len(chunk) {
+			fr.WriteData(1, false, chunk)
+		}
+		// Start a trailer HEADERS block without END_HEADERS (p.inBlock = true),
+		// then send a DATA frame that exceeds stream 1's window.
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: hb1.Bytes(), EndHeaders: false})
+		fr.WriteData(1, false, make([]byte, 100))
+
+		for {
+			f, err := fr.ReadFrame()
+			if err != nil {
+				return gotGoAway, errCode
+			}
+			if ga, ok := f.(*http2.GoAwayFrame); ok {
+				return true, ga.ErrCode
+			}
+		}
+	}
+
+	stockGA, stockCode := run(t, false)
+	if !stockGA {
+		t.Fatal("the stock server sent no GOAWAY: the control proves nothing")
+	}
+	govGA, govCode := run(t, true)
+	t.Logf("data inside header block -> stock: goAway=%v code=%v; governed: goAway=%v code=%v",
+		stockGA, stockCode, govGA, govCode)
+	if govGA != stockGA || govCode != stockCode {
+		t.Fatalf("governed (goAway=%v, code=%v) differs from stock (goAway=%v, code=%v)",
+			govGA, govCode, stockGA, stockCode)
+	}
+}
+
+// readServerPreface reads the server's SETTINGS, acknowledges them, and reads
+// on to the server's first WINDOW_UPDATE on the connection. It returns the
+// connection window that the client then holds. A client that sends past
+// 65535 bytes before that WINDOW_UPDATE arrives is past the window.
+func readServerPreface(t *testing.T, fr *http2.Framer) int64 {
+	t.Helper()
+	connWin, settings := int64(h2InitWindow), false
+	for !settings || connWin == h2InitWindow {
+		f, err := fr.ReadFrame()
+		if err != nil {
+			t.Fatal(err)
+		}
+		switch f := f.(type) {
+		case *http2.SettingsFrame:
+			if !f.IsAck() {
+				fr.WriteSettingsAck()
+				settings = true
+			}
+		case *http2.WindowUpdateFrame:
+			if f.StreamID == 0 {
+				connWin += int64(f.Increment)
+			}
+		}
+	}
+	return connWin
+}
diff --git a/transport/internet/splithttp/h2flow_pi_test.go b/transport/internet/splithttp/h2flow_pi_test.go
new file mode 100644
index 00000000..3b64d3fb
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_pi_test.go
@@ -0,0 +1,95 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+)
+
+func TestFlowWindowPI(t *testing.T) {
+	ms := time.Millisecond
+	start := time.Unix(0, 0)
+	step := func(w *flowWindow, st tcpStats, copied int64) {
+		w.returned += copied
+		w.pi(w.mark.Add(st.minRTT), st, h2InitWindow, 1<<30, 1, 0)
+	}
+
+	// No queue: the cap grows, by at most half per round trip.
+	w := flowWindow{cap: 1 << 20, mark: start}
+	step(&w, tcpStats{rtt: 100 * ms, minRTT: 100 * ms}, 1<<20)
+	if w.cap < 5<<18 || w.cap > 3<<19 {
+		t.Fatalf("empty path: cap %d", w.cap)
+	}
+
+	// A queue of twice the setpoint shrinks it.
+	w = flowWindow{cap: 1 << 20, mark: start}
+	step(&w, tcpStats{rtt: 150 * ms, minRTT: 100 * ms}, 1<<20)
+	if w.cap >= 1<<20 {
+		t.Fatalf("queue at twice the setpoint: cap %d", w.cap)
+	}
+
+	// Jitter raises the setpoint: 30 ms over the floor with 20 ms variance
+	// is below it, so the cap still grows.
+	w = flowWindow{cap: 1 << 20, mark: start}
+	step(&w, tcpStats{rtt: 130 * ms, minRTT: 100 * ms, rttVar: 20 * ms}, 1<<20)
+	if w.cap <= 1<<20 {
+		t.Fatalf("jitter taken for queue: cap %d", w.cap)
+	}
+
+	// A reader taking less than a quarter of the window does not grow it,
+	// and after flowShrinkAfter rounds it shrinks.
+	w = flowWindow{cap: 4 << 20, mark: start}
+	for range flowShrinkAfter {
+		step(&w, tcpStats{rtt: 100 * ms, minRTT: 100 * ms}, 256<<10)
+	}
+	if w.cap >= 4<<20 {
+		t.Fatalf("self-limited reader: cap %d", w.cap)
+	}
+
+	// Never below init, never above the limit.
+	w = flowWindow{cap: h2InitWindow, mark: start}
+	step(&w, tcpStats{rtt: 500 * ms, minRTT: 100 * ms}, 0)
+	if w.cap != h2InitWindow {
+		t.Fatalf("below init: %d", w.cap)
+	}
+}
+
+// TestFlowWindowPISettles drives the controller against a model path, a
+// FIFO bottleneck whose queue is what the window holds beyond the
+// bandwidth-delay product, and checks it settles near the setpoint instead
+// of cycling.
+func TestFlowWindowPISettles(t *testing.T) {
+	for _, path := range []struct {
+		name   string
+		rate   int64 // bytes per second
+		minRTT time.Duration
+	}{
+		{"100 Mbit/s, 50 ms", 12_500_000, 50 * time.Millisecond},
+		{"100 Mbit/s, 150 ms", 12_500_000, 150 * time.Millisecond},
+		{"20 Mbit/s, 300 ms", 2_500_000, 300 * time.Millisecond},
+		{"1 Gbit/s, 20 ms", 125_000_000, 20 * time.Millisecond},
+	} {
+		bdp := path.rate * int64(path.minRTT) / int64(time.Second)
+		w := flowWindow{cap: int32(4 * bdp), mark: time.Unix(0, 0)}
+		var queue time.Duration
+		var tail []time.Duration
+		last := w.cap // the queue answers the window a round trip late
+		for round := range 200 {
+			queue = time.Duration(max(int64(last)-bdp, 0) * int64(time.Second) / path.rate)
+			last = w.cap
+			st := tcpStats{rtt: path.minRTT + queue, minRTT: path.minRTT}
+			w.returned += path.rate * int64(st.rtt) / int64(time.Second)
+			w.pi(w.mark.Add(st.rtt), st, h2InitWindow, 1<<30, 1, 0)
+			if round >= 150 {
+				tail = append(tail, queue)
+			}
+		}
+		set := max(path.minRTT/4, flowPIMinSet)
+		lo, hi := tail[0], tail[0]
+		for _, q := range tail {
+			lo, hi = min(lo, q), max(hi, q)
+		}
+		if hi > 2*set || lo < set/4 || hi-lo > set {
+			t.Errorf("%s: queue between %v and %v, setpoint %v", path.name, lo, hi, set)
+		}
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_ping_test.go b/transport/internet/splithttp/h2flow_ping_test.go
new file mode 100644
index 00000000..b4d818a6
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_ping_test.go
@@ -0,0 +1,148 @@
+package splithttp
+
+import (
+	"encoding/binary"
+	"testing"
+	"time"
+)
+
+func TestFlowPingIsRandom(t *testing.T) {
+	c := &flowConn{}
+	seen := map[uint64]bool{}
+	for range 64 {
+		frame := c.appendPingFrame(nil)
+		if len(frame) != 17 || frame[3] != h2Ping || frame[4] != 0 {
+			t.Fatalf("not a PING frame: %x", frame)
+		}
+		payload := binary.BigEndian.Uint64(frame[9:])
+		if seen[payload] {
+			t.Fatalf("PING payload %x repeated", payload)
+		}
+		seen[payload] = true
+	}
+
+	c.pingSentAt = time.Now()
+	ack := h2Frame{typ: h2Ping, flags: h2FlagAck}
+	other := binary.BigEndian.AppendUint64(nil, c.pingData+1)
+	if c.pingAck(ack, other) {
+		t.Fatal("took the ACK of someone else's PING for ours")
+	}
+	if !c.pingAck(ack, binary.BigEndian.AppendUint64(nil, c.pingData)) {
+		t.Fatal("did not recognize the ACK of our PING")
+	}
+}
+
+func TestFlowPingQueueing(t *testing.T) {
+	ms := time.Millisecond
+	now := time.Unix(100, 0)
+	for _, tc := range []struct {
+		floor, last, pending time.Duration
+		want                 int
+	}{
+		{50 * ms, 70 * ms, 0, 0},
+		{50 * ms, 80 * ms, 0, 1},
+		{50 * ms, 110 * ms, 0, 2},
+		{ms, 10 * ms, 0, 0},
+		{ms, 30 * ms, 0, 1},
+		{ms, 50 * ms, 0, 2},
+		{50 * ms, 60 * ms, 300 * ms, 2}, // an ACK long overdue is a queue too
+		{50 * ms, 60 * ms, 20 * ms, 0},
+	} {
+		c := &flowConn{rttBase: tc.floor, rttLast: tc.last}
+		if tc.pending > 0 {
+			c.pingSentAt = now.Add(-tc.pending)
+		}
+		if got := c.pingQueueing(now); got != tc.want {
+			t.Errorf("floor %v, last %v, pending %v: got %d, want %d", tc.floor, tc.last, tc.pending, got, tc.want)
+		}
+	}
+	if got := (&flowConn{}).pingQueueing(now); got != 0 {
+		t.Errorf("before any round trip: got %d", got)
+	}
+}
+
+func TestFlowFirstPingBeforeStreams(t *testing.T) {
+	c := &flowConn{pingReady: true}
+	if out := c.appendPing(time.Now(), nil); len(out) != 17 {
+		t.Fatal("no PING on a fresh connection without streams")
+	}
+	c.pingAck(h2Frame{typ: h2Ping, flags: h2FlagAck}, binary.BigEndian.AppendUint64(nil, c.pingData))
+	if c.rttBase == 0 {
+		t.Fatal("the first ACK did not set the floor")
+	}
+	c.lastPing = time.Time{}
+	if out := c.appendPing(time.Now(), nil); len(out) != 0 {
+		t.Fatal("idle connection keeps pinging once its floor is known")
+	}
+}
+
+func TestFlowPingFloor(t *testing.T) {
+	ms := time.Millisecond
+	now := time.Unix(100, 0)
+	for _, tc := range []struct {
+		name         string
+		ping, kernel time.Duration
+		want         time.Duration
+	}{
+		{"direct, first ACK held up by slow start", 300 * ms, 150 * ms, 150 * ms},
+		{"TCP proxy in front", 150 * ms, ms, 150 * ms},
+		{"kernel slower than the PING", 100 * ms, 120 * ms, 100 * ms},
+		{"no kernel view", 300 * ms, 0, 300 * ms},
+	} {
+		c := &flowConn{rttBase: tc.ping}
+		if tc.kernel > 0 {
+			c.tcp, c.kAt, c.kOK = fakeRawConn{}, now, true
+			c.kstat = tcpStats{rtt: tc.kernel, minRTT: tc.kernel}
+		}
+		if got := c.pingFloor(now); got != tc.want {
+			t.Errorf("%s: got %v, want %v", tc.name, got, tc.want)
+		}
+	}
+}
+
+func TestFlowQueueShrink(t *testing.T) {
+	ms := time.Millisecond
+	now := time.Unix(100, 0)
+	c := &flowConn{rttBase: 150 * ms, rtt: 300 * ms, rttSince: now, rttSamples: 1}
+	w := flowWindow{cap: 8 << 20, prev: 3 << 20}
+	c.queueShrink(&w, now, h2InitWindow)
+	if w.cap != 6<<20 {
+		t.Fatalf("first shrink: got %d, want a quarter off", w.cap)
+	}
+	c.queueShrink(&w, now, h2InitWindow)
+	if w.cap != 6<<20 {
+		t.Fatal("shrank twice on one PING sample")
+	}
+	for range 10 {
+		c.rttSamples++
+		c.queueShrink(&w, now, h2InitWindow)
+	}
+	// 3 MiB per 300 ms is 1.5 MiB per 150 ms round trip of the empty path.
+	if w.cap != 3<<19 {
+		t.Fatalf("shrank to %d, below what the reader takes per empty round trip", w.cap)
+	}
+}
+
+func TestFlowFloorConfirmed(t *testing.T) {
+	ms := time.Millisecond
+	now := time.Unix(100, 0)
+	for _, tc := range []struct {
+		name         string
+		ping, kernel time.Duration
+		want         bool
+	}{
+		{"direct", 300 * ms, 150 * ms, true},
+		{"direct, no PING yet", 0, 150 * ms, true},
+		{"TCP proxy in front", 150 * ms, ms, false},
+		{"no kernel view", 150 * ms, 0, false},
+	} {
+		c := &flowConn{rttBase: tc.ping}
+		if tc.kernel > 0 {
+			c.tcp, c.kAt, c.kOK = fakeRawConn{}, now, true
+			c.kstat = tcpStats{rtt: tc.kernel, minRTT: tc.kernel}
+		}
+		if got := c.floorConfirmed(now); got != tc.want {
+			t.Errorf("%s: got %v, want %v", tc.name, got, tc.want)
+		}
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_queuecuts_test.go b/transport/internet/splithttp/h2flow_queuecuts_test.go
new file mode 100644
index 00000000..3bb2cfe0
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_queuecuts_test.go
@@ -0,0 +1,173 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+)
+
+// queuedDownload is a server with one download whose reader takes all it is
+// sent, on a path whose round trip stands at 500 ms over an empty 50 ms: a
+// queue the server cuts against. The cap is 1 MiB.
+func queuedDownload(t *testing.T) (h *flowHarness, s *flowStream) {
+	t.Helper()
+	const id = 1
+	h = newFlowHarness(t)
+	t.Cleanup(func() { h.c.Close() })
+	h.track()
+	h.openStream(4 << 20)
+	h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, id, 200<<10) })
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	h.c.tcp, h.c.kAt, h.c.kOK = fakeRawConn{}, time.Now().Add(time.Hour), true
+	h.c.kstat = tcpStats{rtt: 500 * time.Millisecond, minRTT: 50 * time.Millisecond}
+	h.c.rttBase = 50 * time.Millisecond
+	s = h.c.streams[id]
+	s.down.cap = 1 << 20
+	s.down.mark, s.down.markBase = time.Now(), s.down.returned
+	return h, s
+}
+
+// credit returns 4 KiB of the download's credit and gives the cap after it.
+func credit(h *flowHarness, s *flowStream) int32 {
+	h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(1, 4<<10) })
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	return s.down.cap
+}
+
+// TestFlowNoQueueCuts is a download against a standing queue on a server
+// that leaves the queue to TCP: neither pi nor the cut at a long queue takes
+// its cap down, where the same server without the setting cuts it.
+func TestFlowNoQueueCuts(t *testing.T) {
+	for _, noCuts := range []bool{false, true} {
+		h, s := queuedDownload(t)
+		h.c.mu.Lock()
+		h.c.noQueueCuts = noCuts
+		h.c.mu.Unlock()
+		got := credit(h, s)
+		if cut := got < 1<<20; cut == noCuts {
+			t.Fatalf("noQueueCuts %v: the cap went from 1 MiB to %d", noCuts, got)
+		}
+	}
+}
+
+// TestFlowNoQueueCutsStopsPI is a queue of 60 ms over an empty 50 ms, short
+// of the cut at a long queue but well over pi's setpoint, on a download pi
+// governs: a client that returns credit in small steps, a reader that has
+// settled, a round trip measured. pi cuts it, unless the server leaves the
+// queue to TCP.
+func TestFlowNoQueueCutsStopsPI(t *testing.T) {
+	for _, noCuts := range []bool{false, true} {
+		h, s := queuedDownload(t)
+		h.c.mu.Lock()
+		h.c.noQueueCuts, h.c.incremental = noCuts, true
+		h.c.kstat.rtt = 110 * time.Millisecond
+		s.down.flat = flowFullRounds
+		s.down.mark = time.Now().Add(-200 * time.Millisecond)
+		h.c.mu.Unlock()
+		got := credit(h, s)
+		if cut := got < 1<<20; cut == noCuts {
+			t.Fatalf("noQueueCuts %v: pi took the cap from 1 MiB to %d", noCuts, got)
+		}
+	}
+}
+
+// TestFlowPIForgetsRoundTripOutside is a download pi does not govern for a
+// round, here one whose client credits in large steps: the round trip pi saw
+// last is dropped, so that pi, when the stream comes back to it, does not
+// take the change since then for one round's.
+func TestFlowPIForgetsRoundTripOutside(t *testing.T) {
+	h, s := queuedDownload(t)
+	h.c.mu.Lock()
+	s.down.piRTT = 100 * time.Millisecond
+	h.c.mu.Unlock()
+	credit(h, s)
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if s.down.piRTT != 0 {
+		t.Fatalf("pi's round trip %v kept outside pi", s.down.piRTT)
+	}
+}
+
+// TestFlowPIForgetsErrorOutside is the same for pi's last error: one taken
+// before the stream left pi is no derivative for its first step back.
+func TestFlowPIForgetsErrorOutside(t *testing.T) {
+	h, s := queuedDownload(t)
+	h.c.mu.Lock()
+	s.down.piPrev = 0.5
+	h.c.mu.Unlock()
+	credit(h, s)
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if s.down.piPrev != 0 {
+		t.Fatalf("pi's error %v kept outside pi", s.down.piPrev)
+	}
+}
+
+// TestFlowPIForgetsRateOutside is the same for the rate pi saw the reader
+// take and whether the cap held it: outside pi no cap of pi's holds it.
+func TestFlowPIForgetsRateOutside(t *testing.T) {
+	h, s := queuedDownload(t)
+	h.c.mu.Lock()
+	s.down.rate, s.down.capped = 10<<20, true
+	h.c.mu.Unlock()
+	credit(h, s)
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if s.down.rate != 0 || s.down.capped {
+		t.Fatalf("pi's rate %v, capped %v kept outside pi", s.down.rate, s.down.capped)
+	}
+}
+
+// TestFlowShareLeavesOutsideStreams is two downloads that both took data
+// lately: stream 1 has left pi, stream 3 is in it. The share stream 3 steps
+// up by is its own alone, not a mean with a rate stream 1 had in pi.
+func TestFlowShareLeavesOutsideStreams(t *testing.T) {
+	h, s1 := queuedDownload(t)
+	h.openRequest(3)
+	h.fromServer(func(fr *http2.Framer) { writeDataSplit(fr, 3, 200<<10) })
+	h.c.mu.Lock()
+	h.c.incremental = true
+	h.c.kstat.rtt = 110 * time.Millisecond
+	s3 := h.c.streams[3]
+	s3.down.cap = 1 << 20
+	s3.down.flat = flowFullRounds
+	s3.down.mark, s3.down.markBase = time.Now().Add(-200*time.Millisecond), s3.down.returned
+	s3.down.rate, s3.down.capped = 1<<20, true
+	s1.down.rate, s1.down.capped = 10<<20, true
+	h.c.mu.Unlock()
+	credit(h, s1) // flat 0: outside pi
+	h.fromClient(func(fr *http2.Framer) { fr.WriteWindowUpdate(3, 4<<10) })
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if h.c.downShare != 0 {
+		t.Fatalf("outside pi: s1.down.capped=%v s1.down.rate=%v c.downShare=%v; want false, 0, 0",
+			s1.down.capped, s1.down.rate, h.c.downShare)
+	}
+}
+
+// TestFlowCutsAreCounted is a download against a standing queue, cut by pi
+// and by the cut at a long queue in turn: each cut is noted for flowEffect
+// to judge by.
+func TestFlowCutsAreCounted(t *testing.T) {
+	for _, viaPI := range []bool{false, true} {
+		h, s := queuedDownload(t)
+		h.c.mu.Lock()
+		if viaPI {
+			h.c.incremental = true
+			h.c.kstat.rtt = 110 * time.Millisecond
+			s.down.flat = flowFullRounds
+			s.down.mark = time.Now().Add(-200 * time.Millisecond)
+		}
+		h.c.mu.Unlock()
+		got := credit(h, s)
+		h.c.mu.Lock()
+		cut := h.c.effect.cut
+		h.c.mu.Unlock()
+		if got >= 1<<20 || cut <= 0 {
+			t.Fatalf("pi %v: the cap went to %d and %v bytes of cut were noted", viaPI, got, cut)
+		}
+	}
+}
