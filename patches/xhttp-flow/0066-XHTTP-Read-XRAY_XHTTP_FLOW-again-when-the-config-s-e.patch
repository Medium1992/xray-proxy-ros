From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Fri, 23 Oct 2026 14:59:26 +0300
Subject: [PATCH] XHTTP: Read XRAY_XHTTP_FLOW again when the config's env
 changes, and take ON, true and 1 for on

---
 transport/internet/splithttp/h2flow.go        | 20 +++++++++++++++--
 .../internet/splithttp/h2flow_config_test.go  | 22 +++++++++++++++----
 .../internet/splithttp/h2flow_transport.go    |  2 +-
 .../splithttp/h2flow_verify_listener_test.go  |  6 ++---
 .../splithttp/h2flow_verify_memory_test.go    |  6 ++---
 .../splithttp/h2flow_verify_off_test.go       |  2 +-
 6 files changed, 44 insertions(+), 14 deletions(-)

diff --git a/transport/internet/splithttp/h2flow.go b/transport/internet/splithttp/h2flow.go
index 341dd6d8..08ac019f 100644
--- a/transport/internet/splithttp/h2flow.go
+++ b/transport/internet/splithttp/h2flow.go
@@ -7,6 +7,7 @@ import (
 	"errors"
 	"math/rand/v2"
 	"net"
+	"strings"
 	"sync"
 	"sync/atomic"
 	"syscall"
@@ -93,8 +94,23 @@ func (l flowLimit) enabled() bool {
 }
 
 // flowEnabled is the default for XHTTP connections whose "h2Flow" does not
-// say: off unless XRAY_XHTTP_FLOW=on.
-var flowEnabled = platform.NewEnvFlag(platform.XHTTPFlow).GetValue(func() string { return "" }) == "on"
+// say: off unless XRAY_XHTTP_FLOW is on, true or 1. It is read again when the
+// config's "env" changes the environment.
+var flowEnabled atomic.Bool
+
+func reloadFlowEnv() error {
+	switch strings.ToLower(strings.TrimSpace(platform.NewEnvFlag(platform.XHTTPFlow).GetValue(func() string { return "" }))) {
+	case "on", "true", "1":
+		flowEnabled.Store(true)
+	default:
+		flowEnabled.Store(false)
+	}
+	return nil
+}
+
+func init() {
+	platform.RegisterEnvReload(reloadFlowEnv)
+}
 
 // flowDefault never lets a window shrink below the initial window HTTP/2
 // itself defines, nor grow beyond what the peer really granted.
