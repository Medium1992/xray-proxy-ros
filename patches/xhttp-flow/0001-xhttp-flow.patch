+	}
+	resp, err := bulkClient.Get("http://x/bulk")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	go io.Copy(io.Discard, resp.Body)
+	time.Sleep(2 * time.Second)
+	var lat []time.Duration
+	for i := 0; i < 30; i++ {
+		start := time.Now()
+		r, err := pingClient.Get("http://x/ping")
+		if err != nil {
+			t.Fatal(err)
+		}
