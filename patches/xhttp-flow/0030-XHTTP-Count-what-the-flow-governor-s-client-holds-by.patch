 func (c *Config) h2SendWindow() int64 {
 	switch w := c.GetH2Flow().GetMaxConnectionSendWindow(); {
 	case w < 0:
diff --git a/transport/internet/splithttp/h2flow_verify_harness_test.go b/transport/internet/splithttp/h2flow_verify_harness_test.go
