-				b.Reset()
-				fr.WritePing(false, [8]byte{9})
-				_, werr := conn.Write(b.Bytes())
-				t.Logf("%d streams opened and reset: live heap grew by %d bytes; connection still writable: %v", churnRounds*40000, growth[governed], werr == nil)
-				return true
-			}
-			for i := 0; !attempt(); i++ {
-				if i == 2 {
