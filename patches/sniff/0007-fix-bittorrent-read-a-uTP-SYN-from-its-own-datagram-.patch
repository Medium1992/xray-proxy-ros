 	query := dnsQueryFor("tracker.example.com", 0x3100, 0x0100)
 	query[11] = 2 // ARCOUNT=2
@@ -502,9 +522,6 @@ func TestSniffUTPRejectsNonUTPTraffic(t *testing.T) {
 		{"RakNet-style unconnected ping", rakNetUnconnectedPing()},
