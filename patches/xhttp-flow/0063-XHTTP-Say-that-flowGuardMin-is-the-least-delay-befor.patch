From 2be055b2810d1ce8222a8a9d40d5617565e83c82 Mon Sep 17 00:00:00 2001
From: fUS1ONd <koskriv2006@gmail.com>
Date: Thu, 22 Oct 2026 23:08:43 +0000
Subject: [PATCH] XHTTP: Say that flowGuardMin is the least delay before the
 guard, not the most

The guard waits max(4 RTT, flowGuardMin), so a stream sits out of window at least that long before it steps in.
---
 transport/internet/splithttp/h2flow.go | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/transport/internet/splithttp/h2flow.go b/transport/internet/splithttp/h2flow.go
index 2306ac7d..341dd6d8 100644
--- a/transport/internet/splithttp/h2flow.go
+++ b/transport/internet/splithttp/h2flow.go
@@ -1328,7 +1328,7 @@ func (c *flowConn) pingAck(f h2Frame, payload []byte) bool {
 	return false
 }
 
-// flowGuardMin bounds how long a downlink stream may sit with the server out
+// flowGuardMin is the least time a downlink stream sits with the server out
 // of window and no credit from the client before the guard steps in.
 var flowGuardMin = 200 * time.Millisecond
 
-- 
