From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Sat, 24 Oct 2026 18:19:46 +0300
Subject: [PATCH] XHTTP: Find the TCP socket under connections that only embed
 it, as finalmask's do

---
 .../splithttp/h2flow_tcpinfo_linux.go         | 24 ++++++++++++-
 .../splithttp/h2flow_tcpinfo_linux_test.go    | 35 +++++++++++++++++++
 2 files changed, 58 insertions(+), 1 deletion(-)

diff --git a/transport/internet/splithttp/h2flow_tcpinfo_linux.go b/transport/internet/splithttp/h2flow_tcpinfo_linux.go
index 3b402b3b..29f31653 100644
--- a/transport/internet/splithttp/h2flow_tcpinfo_linux.go
+++ b/transport/internet/splithttp/h2flow_tcpinfo_linux.go
@@ -4,6 +4,7 @@ package splithttp
 
 import (
 	"net"
+	"reflect"
 	"syscall"
 	"time"
 
@@ -27,12 +28,33 @@ func rawTCP(c net.Conn) syscall.RawConn {
 		case interface{ Raw() net.Conn }:
 			c = v.Raw()
 		default:
-			return nil
+			if c = embeddedConn(c); c == nil {
+				return nil
+			}
 		}
 	}
 	return nil
 }
 
+// embeddedConn is the net.Conn a wrapper embeds, such as finalmask's, which
+// offer no NetConn: the kernel's view of the TCP socket under a mask is still
+// that connection's round trip and what it has in flight.
+func embeddedConn(c net.Conn) net.Conn {
+	v := reflect.ValueOf(c)
+	if v.Kind() == reflect.Pointer {
+		v = v.Elem()
+	}
+	if v.Kind() != reflect.Struct {
+		return nil
+	}
+	f := v.FieldByName("Conn")
+	if !f.IsValid() || !f.CanInterface() {
+		return nil
+	}
+	inner, _ := f.Interface().(net.Conn)
+	return inner
+}
+
 func readTCPStats(rc syscall.RawConn) (s tcpStats, ok bool) {
 	if rc == nil {
 		return
diff --git a/transport/internet/splithttp/h2flow_tcpinfo_linux_test.go b/transport/internet/splithttp/h2flow_tcpinfo_linux_test.go
index 6f794f87..dfe7c316 100644
--- a/transport/internet/splithttp/h2flow_tcpinfo_linux_test.go
+++ b/transport/internet/splithttp/h2flow_tcpinfo_linux_test.go
@@ -94,3 +94,38 @@ func TestFlowTCPStats(t *testing.T) {
 		})
 	}
 }
+
+// maskedConn wraps a connection the way finalmask's connections do: it
+// embeds it and offers no NetConn.
+type maskedConn struct {
+	net.Conn
+}
+
+// TestFlowRawTCPUnderMask finds the TCP socket under a wrapper that only
+// embeds it, as with finalmask, and under one that embeds such a wrapper.
+func TestFlowRawTCPUnderMask(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() {
+		if c, err := ln.Accept(); err == nil {
+			defer c.Close()
+			time.Sleep(time.Second)
+		}
+	}()
+	c, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	for _, w := range []net.Conn{&maskedConn{Conn: c}, &maskedConn{Conn: &maskedConn{Conn: c}}} {
+		if rawTCP(w) == nil {
+			t.Fatalf("no TCP socket found under %T", w)
+		}
+	}
+	if rawTCP(&maskedConn{}) != nil {
+		t.Fatal("a wrapper with no connection under it gave a socket")
+	}
+}
