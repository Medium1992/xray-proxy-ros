From 3b7d225196dbf903be01934eb2b5df5eec55b2f2 Mon Sep 17 00:00:00 2001
From: medium <medium@debian.debian>
Date: Thu, 12 Nov 2026 10:14:56 +0300
Subject: [PATCH] fix(bittorrent): read a tracker request's parameter names
 decoded

Trackers decode the query, so info%5Fhash and peer%5fid name the same
parameters, and a request that escaped them went out as HTTP. A name with
an escape is decoded before it is matched; others are matched as they are,
without allocating.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 common/protocol/bittorrent/bittorrent.go      | 7 +++++++
 common/protocol/bittorrent/signatures_test.go | 1 +
 2 files changed, 8 insertions(+)

diff --git a/common/protocol/bittorrent/bittorrent.go b/common/protocol/bittorrent/bittorrent.go
index eba24f79..7d9838cb 100644
--- a/common/protocol/bittorrent/bittorrent.go
+++ b/common/protocol/bittorrent/bittorrent.go
@@ -4,6 +4,7 @@ import (
 	"bytes"
 	"encoding/binary"
 	"errors"
+	"net/url"
 
 	"github.com/xtls/xray-core/common"
 )
@@ -165,6 +166,12 @@ func SniffHTTPTracker(b []byte) (*SniffHeader, error) {
 	var infoHash, peerID bool
 	for _, param := range bytes.Split(query, []byte("&")) {
 		name, _, _ := bytes.Cut(param, []byte("="))
+		// Trackers decode the names, so info%5Fhash is info_hash too.
+		if bytes.IndexByte(name, '%') >= 0 {
+			if decoded, err := url.QueryUnescape(string(name)); err == nil {
+				name = []byte(decoded)
+			}
+		}
 		switch string(name) {
 		case "info_hash":
 			infoHash = true
diff --git a/common/protocol/bittorrent/signatures_test.go b/common/protocol/bittorrent/signatures_test.go
index e4728dba..66cae03c 100644
--- a/common/protocol/bittorrent/signatures_test.go
+++ b/common/protocol/bittorrent/signatures_test.go
@@ -21,6 +21,7 @@ func TestSniffHTTPTracker(t *testing.T) {
 		"TorrentPier":         "GET /bt/announce.php?uk=abc&info_hash=%9a%81&peer_id=-qB4630-k8hj0wgej6ch HTTP/1.1\r\nHost: bt.example.org\r\n\r\n",
 		"root path":           "GET /?info_hash=%9a%81&peer_id=-qB4630-k8hj0wgej6ch&port=6881 HTTP/1.1\r\nHost: t.example.org\r\n\r\n",
 		"scrape.php":          "GET /scrape.php?info_hash=%9a%81 HTTP/1.1\r\nHost: t.example.org\r\n\r\n",
+		"escaped names":       "GET /announce?info%5Fhash=%9a%81&peer%5fid=-qB4630-k8hj0wgej6ch HTTP/1.1\r\nHost: t.example.org\r\n\r\n",
 	} {
 		if _, err := SniffHTTPTracker([]byte(request)); err != nil {
 			t.Errorf("%s: %v", name, err)
-- 
