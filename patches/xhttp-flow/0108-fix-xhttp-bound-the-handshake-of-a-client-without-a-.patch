From fd80937187cf1e28538aafcdd49ddc7274418c0c Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Thu, 12 Nov 2026 15:51:37 +0300
Subject: [PATCH] fix(xhttp): bound the handshake of a client without a uTLS
 fingerprint

With "unsafe" or an unknown fingerprint the client took crypto/tls, whose
handshake waited for the first write and ran after the dial, outside the
10s bound. The handshake now runs in the dial, under the same bound.
Test_DialBlackholedHandshake covers both paths and now requires the
ClientHello to reach the server and the dial to end at the bound, not
before; Test_ListenXHAndDial_TLS covers both on a working path.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 transport/internet/splithttp/dialer.go        |  7 +++-
 .../internet/splithttp/splithttp_test.go      | 42 ++++++++++++++++++-
 2 files changed, 47 insertions(+), 2 deletions(-)

diff --git a/transport/internet/splithttp/dialer.go b/transport/internet/splithttp/dialer.go
index 87a93f5b..7393758b 100644
--- a/transport/internet/splithttp/dialer.go
+++ b/transport/internet/splithttp/dialer.go
@@ -141,7 +141,12 @@ func createHTTPClient(dest net.Destination, streamSettings *internet.MemoryStrea
 					return nil, err
 				}
 			} else {
-				conn = tls.Client(conn, gotlsConfig)
+				tlsConn := tls.Client(conn, gotlsConfig).(*tls.Conn)
+				if err := tlsConn.HandshakeContext(ctxInner); err != nil {
+					tlsConn.Close()
+					return nil, err
+				}
+				conn = tlsConn
 			}
 		}
 
diff --git a/transport/internet/splithttp/splithttp_test.go b/transport/internet/splithttp/splithttp_test.go
index 3d80d8dd..81004076 100644
--- a/transport/internet/splithttp/splithttp_test.go
+++ b/transport/internet/splithttp/splithttp_test.go
@@ -8,6 +8,7 @@ import (
 	"io"
 	"net/http"
 	"runtime"
+	"strconv"
 	"testing"
 	"time"
 
@@ -127,6 +128,14 @@ func TestDialWithRemoteAddr(t *testing.T) {
 }
 
 func Test_ListenXHAndDial_TLS(t *testing.T) {
+	for _, fingerprint := range []string{"", "unsafe"} {
+		t.Run("fingerprint "+strconv.Quote(fingerprint), func(t *testing.T) {
+			testListenXHAndDialTLS(t, fingerprint)
+		})
+	}
+}
+
+func testListenXHAndDialTLS(t *testing.T, fingerprint string) {
 	if runtime.GOARCH == "arm64" {
 		return
 	}
@@ -146,6 +155,7 @@ func Test_ListenXHAndDial_TLS(t *testing.T) {
 		SecuritySettings: &tls.Config{
 			Certificate:          []*tls.Certificate{tls.ParseCertificate(ct)},
 			PinnedPeerCertSha256: [][]byte{ctHash[:]},
+			Fingerprint:          fingerprint,
 		},
 	}
 	listen, err := ListenXH(context.Background(), net.LocalHostIP, listenPort, streamSettings, func(conn stat.Connection) {
@@ -601,16 +611,36 @@ func Test_ServerMaxHeaderBytes(t *testing.T) {
 }
 
 func Test_DialBlackholedHandshake(t *testing.T) {
+	// "" takes the default uTLS fingerprint; "unsafe" takes Go's crypto/tls,
+	// whose handshake would otherwise wait for the first write.
+	for _, fingerprint := range []string{"", "unsafe"} {
+		t.Run("fingerprint "+strconv.Quote(fingerprint), func(t *testing.T) {
+			testDialBlackholedHandshake(t, fingerprint)
+		})
+	}
+}
+
+func testDialBlackholedHandshake(t *testing.T, fingerprint string) {
 	listener, err := net.Listen("tcp", "127.0.0.1:0")
 	common.Must(err)
 	defer listener.Close()
+	hello := make(chan struct{}, 1)
 	go func() {
 		for {
 			conn, err := listener.Accept()
 			if err != nil {
 				return
 			}
-			defer conn.Close() // the kernel takes the ClientHello, nobody answers
+			defer conn.Close()
+			go func() {
+				// take the ClientHello, answer nothing
+				if n, _ := conn.Read(make([]byte, 1024)); n > 0 {
+					select {
+					case hello <- struct{}{}:
+					default:
+					}
+				}
+			}()
 		}
 	}()
 
@@ -622,10 +652,12 @@ func Test_DialBlackholedHandshake(t *testing.T) {
 		SecuritySettings: &tls.Config{
 			Certificate:          []*tls.Certificate{tls.ParseCertificate(ct)},
 			PinnedPeerCertSha256: [][]byte{ctHash[:]},
+			Fingerprint:          fingerprint,
 		},
 	}
 	port := net.Port(listener.Addr().(*net.TCPAddr).Port)
 
+	start := time.Now()
 	done := make(chan error, 1)
 	go func() {
 		conn, err := Dial(context.Background(), net.TCPDestination(net.DomainAddress("localhost"), port), streamSettings)
@@ -640,6 +672,14 @@ func Test_DialBlackholedHandshake(t *testing.T) {
 		if err == nil {
 			t.Fatal("read through a blackholed handshake succeeded")
 		}
+		select {
+		case <-hello:
+		default:
+			t.Fatalf("dial failed before its ClientHello reached the server: %v", err)
+		}
+		if elapsed := time.Since(start); elapsed < 9*time.Second {
+			t.Fatalf("dial failed after %v, before the 10s handshake bound: %v", elapsed.Round(time.Millisecond), err)
+		}
 	case <-time.After(15 * time.Second):
 		t.Fatal("dial still waits on a handshake blackholed after ClientHello")
 	}
