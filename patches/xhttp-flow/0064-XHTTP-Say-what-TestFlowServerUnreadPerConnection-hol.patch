From 08b67eaaf33e7c79d0a04474312e0b2c03f058a7 Mon Sep 17 00:00:00 2001
From: fUS1ONd <koskriv2006@gmail.com>
Date: Thu, 22 Oct 2026 23:08:51 +0000
Subject: [PATCH] XHTTP: Say what TestFlowServerUnreadPerConnection holds the
 governor to

Its comment still described the governor as capping streams but not their sum. The governor now holds the connection to Go's 1 MiB, and the test fails if it holds more than 64 KiB over that; the comment says so.
---
 transport/internet/splithttp/h2flow_verify_memory_test.go | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/transport/internet/splithttp/h2flow_verify_memory_test.go b/transport/internet/splithttp/h2flow_verify_memory_test.go
index b4090bac..dc97314d 100644
--- a/transport/internet/splithttp/h2flow_verify_memory_test.go
+++ b/transport/internet/splithttp/h2flow_verify_memory_test.go
@@ -115,8 +115,8 @@ func (c *rawH2Client) pump(quiet time.Duration) {
 // the connection. Stock Go holds that to its 1 MiB connection window; the
 // PR states that a governed server reaches its 6 MiB only "while the outbound
 // keeps up" and that behind a proxy or without TCP_INFO windows never exceed
-// Go's 1 MiB. Neither holds for the connection: the governor caps streams,
-// not their sum.
+// Go's 1 MiB. The governor holds the connection to Go's 1 MiB as well, see
+// upConnRelease, and the test fails if it holds more than 64 KiB over that.
 func TestFlowServerUnreadPerConnection(t *testing.T) {
 	results := map[bool]int64{}
 	for _, governed := range []bool{false, true} {
-- 
2.52.0.windows.1

