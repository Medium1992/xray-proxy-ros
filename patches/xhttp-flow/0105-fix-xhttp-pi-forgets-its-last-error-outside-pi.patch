From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Mon, 2 Nov 2026 00:29:10 +0300
Subject: [PATCH 105/105] fix(xhttp): pi forgets its last error outside pi

pi's derivative term takes the error of its previous round. A stream that
left pi and came back took its first step from an error measured before it
left, as it did with pi's round trip before it was cleared there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 43c334bdf120046648f0632802383e64befc2441)
(cherry picked from commit a9303a6cf042e35b2b00429b168095e3cf0c4194)
---
 transport/internet/splithttp/h2flow.go            |  5 +++--
 .../internet/splithttp/h2flow_queuecuts_test.go   | 15 +++++++++++++++
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/transport/internet/splithttp/h2flow.go b/transport/internet/splithttp/h2flow.go
index a71cf313..2b0a97f0 100644
--- a/transport/internet/splithttp/h2flow.go
+++ b/transport/internet/splithttp/h2flow.go
@@ -2330,8 +2330,9 @@ func (c *flowConn) governDown(now time.Time, s *flowStream) {
 	default:
 		s.down.adjust(now, c.currentRTT(), c.down.init, c.down.max, c.client || c.incremental, q > 0)
 		// A round trip pi saw before the stream left it is no step to
-		// follow when it comes back.
-		s.down.piRTT = 0
+		// follow when it comes back, and its last error is no derivative
+		// for its first step back.
+		s.down.piRTT, s.down.piPrev = 0, 0
 	}
 	switch {
 	case c.client:
diff --git a/transport/internet/splithttp/h2flow_queuecuts_test.go b/transport/internet/splithttp/h2flow_queuecuts_test.go
index d871996b..4931b4ce 100644
--- a/transport/internet/splithttp/h2flow_queuecuts_test.go
+++ b/transport/internet/splithttp/h2flow_queuecuts_test.go
@@ -91,6 +91,21 @@ func TestFlowPIForgetsRoundTripOutside(t *testing.T) {
 	}
 }
 
+// TestFlowPIForgetsErrorOutside is the same for pi's last error: one taken
+// before the stream left pi is no derivative for its first step back.
+func TestFlowPIForgetsErrorOutside(t *testing.T) {
+	h, s := queuedDownload(t)
+	h.c.mu.Lock()
+	s.down.piPrev = 0.5
+	h.c.mu.Unlock()
+	credit(h, s)
+	h.c.mu.Lock()
+	defer h.c.mu.Unlock()
+	if s.down.piPrev != 0 {
+		t.Fatalf("pi's error %v kept outside pi", s.down.piPrev)
+	}
+}
+
 // TestFlowCutsAreCounted is a download against a standing queue, cut by pi
 // and by the cut at a long queue in turn: each cut is noted for flowEffect
 // to judge by.
-- 
