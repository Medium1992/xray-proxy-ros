From a6f222a1289073982f01cb8abd5428edb9813a88 Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Mon, 12 Oct 2026 21:51:19 +0300
Subject: [PATCH] XHTTP: Do not hold the flow governor credit of an upload that
 is still speeding up

Holding upload credit to quanta cost the start of an upload about a round
trip: while an upload speeds up its cap opens with every credit, and the
credit waited. At RTT 40 ms the first 4 MiB of a governed upload took 189 ms
where they took 155 ms, against 167 ms without the governor.

An upload that has not stopped speeding up is not held now, stream or
connection; one that has is, as before. What the quanta save is in the
steady state and stays.
---
 transport/internet/splithttp/h2flow.go        | 17 ++++--
 .../internet/splithttp/h2flow_hold_test.go    | 53 +++++++++++++++++++
 2 files changed, 65 insertions(+), 5 deletions(-)

diff --git a/transport/internet/splithttp/h2flow.go b/transport/internet/splithttp/h2flow.go
index 12176ea6..8f79dd4f 100644
--- a/transport/internet/splithttp/h2flow.go
+++ b/transport/internet/splithttp/h2flow.go
@@ -1137,9 +1137,12 @@ func (c *flowConn) upConnRelease() int64 {
 	return min(bank, flowConnFloor+reading-unread-window, h2MaxWindow)
 }
 
-func (c *flowConn) appendUpConnRelease(out []byte) []byte {
+// appendUpConnRelease hands the client what connection credit is due. It
+// waits for a quantum, see hold, unless ramping says the stream whose credit
+// brought it here is still speeding up.
+func (c *flowConn) appendUpConnRelease(out []byte, ramping bool) []byte {
 	rel := c.upConnRelease()
-	if rel <= 0 || hold(rel, h2InitWindow+c.upConnForwarded-c.upConnSent, flowQuantumMax) {
+	if rel <= 0 || !ramping && hold(rel, h2InitWindow+c.upConnForwarded-c.upConnSent, flowQuantumMax) {
 		return out
 	}
 	c.upConnForwarded += rel
@@ -1158,6 +1161,10 @@ func quantum(cap int32) int64 {
 // the sender still has a quantum of window it loses nothing by waiting, and
 // what it sends then brings the next credit; once it has less, all credit
 // goes out at once. No cap changes, so the reader holds no more than before.
+//
+// An upload that is still speeding up is not held, stream or connection: its
+// cap opens with every credit, and credit that waited for a quantum cost its
+// first megabytes a round trip.
 func hold(rel, window, quantum int64) bool {
 	return rel < quantum && window >= quantum
 }
@@ -1704,7 +1711,7 @@ func (w *flowWriter) control(f h2Frame, header, payload, out []byte) []byte {
 			if !c.upConnGrantKnown && c.upConnSent == 0 {
 				c.upConnGrant += inc
 			}
-			return c.appendUpConnRelease(out)
+			return c.appendUpConnRelease(out, false)
 		}
 		s := c.stream(f.stream)
 		if s == nil || inc == 0 || !c.up.enabled() {
@@ -1729,12 +1736,12 @@ func (w *flowWriter) control(f h2Frame, header, payload, out []byte) []byte {
 			s.up.cap = min(s.up.cap, flowUnconfirmedUp)
 		}
 		c.upLearned.note(now, c.up.init, s.up.cap)
-		if rel := c.upRelease(s); rel > 0 && !hold(rel, int64(c.serverShown)+s.upForwarded-s.upSent, quantum(s.up.cap)) {
+		if rel := c.upRelease(s); rel > 0 && (!s.up.ramped || !hold(rel, int64(c.serverShown)+s.upForwarded-s.upSent, quantum(s.up.cap))) {
 			s.upForwarded += rel
 			out = appendWindowUpdate(out, f.stream, rel)
 		}
 		// What the reader took also frees room on the connection.
-		return c.appendUpConnRelease(out)
+		return c.appendUpConnRelease(out, !s.up.ramped)
 	}
 	out = append(out, header...)
 	return append(out, payload...)
diff --git a/transport/internet/splithttp/h2flow_hold_test.go b/transport/internet/splithttp/h2flow_hold_test.go
index 5cbcca84..3765c963 100644
--- a/transport/internet/splithttp/h2flow_hold_test.go
+++ b/transport/internet/splithttp/h2flow_hold_test.go
@@ -113,6 +113,10 @@ func TestFlowUploadCreditGoesOnInQuanta(t *testing.T) {
 	for i := 0; i < 8; i++ {
 		credit()
 	}
+	// The upload has stopped speeding up: from here its credit is held.
+	h.c.mu.Lock()
+	h.c.streams[1].up.ramped = true
+	h.c.mu.Unlock()
 	count, sum := map[uint32]int{}, map[uint32]uint64{}
 	for i := 0; i < 32; i++ {
 		fr := http2.NewFramer(nil, bytes.NewReader(credit()))
@@ -136,3 +140,52 @@ func TestFlowUploadCreditGoesOnInQuanta(t *testing.T) {
 		}
 	}
 }
+
+// TestFlowUploadCreditNotHeldWhileRamping is the same upload while it is
+// still speeding up. Its cap opens with every credit, so each piece goes on
+// as it comes, for the stream and for the connection: held to a quantum, the
+// first megabytes of an upload took a round trip longer.
+func TestFlowUploadCreditNotHeldWhileRamping(t *testing.T) {
+	h := newFlowHarness(t)
+	t.Cleanup(func() { h.c.Close() })
+	h.c.up.init = flowShownUp
+	h.c.up.max = flowShownUp
+	h.track()
+	h.openStream(4 << 20)
+	h.fromServer(func(fr *http2.Framer) { fr.WriteWindowUpdate(0, 6<<20-h2InitWindow) })
+	h.fromClient(func(fr *http2.Framer) { writeDataSplit(fr, 1, 512<<10) })
+	if h.c.streams[1].up.ramped {
+		t.Fatal("a new upload counts as one that has stopped speeding up")
+	}
+	for i := 0; i < 8; i++ {
+		h.fromServer(func(fr *http2.Framer) {
+			fr.WriteWindowUpdate(0, 4<<10)
+			fr.WriteWindowUpdate(1, 4<<10)
+		})
+	}
+	count := map[uint32]int{}
+	for i := 0; i < 16; i++ {
+		got := h.fromServer(func(fr *http2.Framer) {
+			fr.WriteWindowUpdate(0, 4<<10)
+			fr.WriteWindowUpdate(1, 4<<10)
+		})
+		fr := http2.NewFramer(nil, bytes.NewReader(got))
+		for {
+			f, err := fr.ReadFrame()
+			if errors.Is(err, io.EOF) {
+				break
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if w, ok := f.(*http2.WindowUpdateFrame); ok {
+				count[w.StreamID]++
+			}
+		}
+	}
+	for _, id := range []uint32{0, 1} {
+		if count[id] != 16 {
+			t.Errorf("stream %d: %d updates for 16 pieces of credit while the upload speeds up, want each at once", id, count[id])
+		}
+	}
+}
