From a9ee11a8c4a1634e6af027026148b373643a6b1a Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Tue, 27 Oct 2026 13:41:09 +0300
Subject: [PATCH 098/100] XHTTP: Return a dropped frame's connection credit to
 the client

A DATA frame past a stream's shown upload window is dropped, and its
bytes count as returned on the connection. But WINDOW_UPDATE(0) went out
only along with the stack's own connection updates, and the stack never
saw those bytes, so the client was not given the credit back. A sibling
stream that then used the connection window the client was shown went
past the governor's count, and the connection was closed. The credit
now goes out with the reset.

TestFlowDroppedOverrunReturnsConnCredit checks that nothing is left
with the governor after the drop. TestFlowSiblingUploadAfterDroppedOverrun
compares the sibling's upload with a stock server's: stock takes it, and
the governed server reset the connection.
---
 transport/internet/splithttp/h2flow.go        |  13 +-
 .../internet/splithttp/h2flow_overrun_test.go | 188 ++++++++++++++++++
 2 files changed, 198 insertions(+), 3 deletions(-)

diff --git a/transport/internet/splithttp/h2flow.go b/transport/internet/splithttp/h2flow.go
index 9b0fe5d45..b1d35bda2 100644
--- a/transport/internet/splithttp/h2flow.go
+++ b/transport/internet/splithttp/h2flow.go
@@ -376,7 +376,8 @@ func (p *frameParser) feed(in, out []byte, h frameHandler) []byte {
 				length: int(p.hdr[0])<<16 | int(p.hdr[1])<<8 | int(p.hdr[2]),
 			}
 			// Inside a header block nothing but CONTINUATION may come;
-			// whatever does passes on unread for the stack to reject.
+			// whatever does passes on unread and whole for the stack to
+			// reject.
 			if !p.inBlock && p.f.control() {
 				p.collect = true
 				if p.f.length == 0 {
@@ -1961,8 +1962,8 @@ func (r *flowReader) frame(f h2Frame) (drop bool) {
 			// appendResets, and the connection goes on. The frame is dropped:
 			// a stack shown the window takes none of it into the body, and one
 			// that ended the stream would end the body cleanly before the
-			// reset. Its bytes count as returned on the connection, as a
-			// stack returns connection credit for data it refused.
+			// reset. Its bytes count as returned on the connection, and go
+			// back to the client with the reset, see appendResets.
 			// An empty frame takes no window and is past none, though a
 			// lowered window may leave what came before it past.
 			if up && f.length > 0 && s.upSent > int64(c.serverShown)+s.upForwarded {
@@ -2104,6 +2105,12 @@ func (c *flowConn) appendResets(out []byte) []byte {
 		c.wqueue = appendRSTStream(c.wqueue, id, h2ErrFlowControl)
 	}
 	c.resets = c.resets[:0]
+	// The stack never saw the frames dropped past a stream's window, so it
+	// will not return their connection credit: the governor does.
+	if rel := c.upConnRelease(); rel > 0 {
+		c.upConnForwarded += rel
+		c.creditClient(0, rel)
+	}
 	c.wakeQueue()
 	return out
 }
diff --git a/transport/internet/splithttp/h2flow_overrun_test.go b/transport/internet/splithttp/h2flow_overrun_test.go
index 39bec6283..68503054c 100644
--- a/transport/internet/splithttp/h2flow_overrun_test.go
+++ b/transport/internet/splithttp/h2flow_overrun_test.go
@@ -182,3 +182,191 @@ func TestFlowUploadPastWindowAsStock(t *testing.T) {
 		})
 	}
 }
+
+// TestFlowDroppedOverrunReturnsConnCredit sends a frame past a stream's shown
+// upload window: the connection credit for the dropped frame goes back to the
+// client. The stack never saw the frame, so it sent no WINDOW_UPDATE for it,
+// and the credit stayed with the governor.
+func TestFlowDroppedOverrunReturnsConnCredit(t *testing.T) {
+	h := newFlowHarness(t)
+	t.Cleanup(func() { h.c.Close() })
+	h.track()
+	h.openStream(4 << 20)
+	h.toClient.open(1)
+
+	h.fromServer(func(fr *http2.Framer) {
+		fr.WriteWindowUpdate(0, 8<<20)
+	})
+	h.fromClient(func(fr *http2.Framer) { writeDataSplit(fr, 1, flowShownUp) })
+	h.fromServer(func(fr *http2.Framer) {
+		fr.WriteWindowUpdate(0, flowShownUp)
+	})
+	h.conn.take()
+
+	// Stream 1 sends a 16 KiB DATA frame past stream 1's 1 MiB shown window.
+	h.fromClient(func(fr *http2.Framer) {
+		fr.WriteData(1, false, make([]byte, 16384))
+	})
+	h.sync()
+
+	h.c.mu.Lock()
+	rel := h.c.upConnRelease()
+	sent := h.c.upConnSent
+	ret := h.c.upConnReturned
+	fwd := h.c.upConnForwarded
+	h.c.mu.Unlock()
+	t.Logf("upConnSent=%d, upConnReturned=%d, upConnForwarded=%d, upConnRelease()=%d",
+		sent, ret, fwd, rel)
+	if rel > 0 {
+		t.Fatalf("the dropped frame left %d bytes of connection credit with the governor", rel)
+	}
+}
+
+// TestFlowSiblingUploadAfterDroppedOverrun has stream 1 send a frame past its
+// window and stream 3 then use the connection window the client was given, to
+// a stock server and to a governed one: both take stream 3's body. The
+// governor kept the dropped frame's connection credit, counted stream 3 past
+// the connection window, and closed the connection.
+func TestFlowSiblingUploadAfterDroppedOverrun(t *testing.T) {
+	run := func(t *testing.T, governed bool) error {
+		unblock1 := make(chan struct{})
+		defer close(unblock1)
+		bumpReady := make(chan struct{})
+		startRead3 := make(chan struct{})
+		bumpDone := make(chan error, 1)
+		handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if r.URL.Path == "/bump" {
+				buf := make([]byte, 64<<10)
+				if _, err := io.ReadFull(r.Body, buf); err != nil {
+					bumpDone <- err
+					return
+				}
+				close(bumpReady)
+				<-startRead3
+				rest := make([]byte, 256<<10)
+				_, err := io.ReadFull(r.Body, rest)
+				bumpDone <- err
+				return
+			}
+			<-unblock1
+		})
+
+		ln, err := net.Listen("tcp", "127.0.0.1:0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer ln.Close()
+
+		var listener net.Listener = ln
+		h2cfg := &http.HTTP2Config{
+			MaxReceiveBufferPerStream:     flowShownUp,
+			MaxReceiveBufferPerConnection: flowConnFloor + 256<<10,
+		}
+		if governed {
+			h2cfg = (&Config{H2Flow: &H2FlowConfig{Mode: 1}}).h2ReceiveConfig(true)
+			listener = &flowListener{
+				Listener:   ln,
+				up:         flowDefault,
+				down:       flowDefault,
+				connWindow: h2ConnWindow(h2cfg),
+			}
+		}
+		protocols := new(http.Protocols)
+		protocols.SetUnencryptedHTTP2(true)
+		srv := &http.Server{Handler: handler, Protocols: protocols, HTTP2: h2cfg}
+		go srv.Serve(listener)
+		defer srv.Close()
+
+		conn, err := net.Dial("tcp", ln.Addr().String())
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		conn.SetDeadline(time.Now().Add(5 * time.Second))
+		conn.Write([]byte(h2Preface))
+		fr := http2.NewFramer(conn, conn)
+		fr.WriteSettings()
+		for {
+			f, err := fr.ReadFrame()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if sf, ok := f.(*http2.SettingsFrame); ok && !sf.IsAck() {
+				fr.WriteSettingsAck()
+				break
+			}
+		}
+
+		var hb1, hb3 bytes.Buffer
+		enc1 := hpack.NewEncoder(&hb1)
+		for _, kv := range [][2]string{{":method", "POST"}, {":scheme", "http"}, {":path", "/upload"}, {":authority", "example.com"}} {
+			enc1.WriteField(hpack.HeaderField{Name: kv[0], Value: kv[1]})
+		}
+		enc3 := hpack.NewEncoder(&hb3)
+		for _, kv := range [][2]string{{":method", "POST"}, {":scheme", "http"}, {":path", "/bump"}, {":authority", "example.com"}} {
+			enc3.WriteField(hpack.HeaderField{Name: kv[0], Value: kv[1]})
+		}
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 1, BlockFragment: hb1.Bytes(), EndHeaders: true})
+		fr.WriteHeaders(http2.HeadersFrameParam{StreamID: 3, BlockFragment: hb3.Bytes(), EndHeaders: true})
+		for i := 0; i < 4; i++ {
+			fr.WriteData(3, false, make([]byte, 16384))
+		}
+		<-bumpReady
+
+		ping1 := [8]byte{1, 2, 3, 4, 5, 6, 7, 8}
+		fr.WritePing(false, ping1)
+		for {
+			f, err := fr.ReadFrame()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if pf, ok := f.(*http2.PingFrame); ok && pf.IsAck() && pf.Data == ping1 {
+				break
+			}
+		}
+
+		chunk := make([]byte, 16384)
+		for sent := 0; sent < flowShownUp; sent += len(chunk) {
+			fr.WriteData(1, false, chunk)
+		}
+		fr.WriteData(1, false, chunk) // 16 KiB past stream 1's 1 MiB window
+
+		for {
+			f, err := fr.ReadFrame()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if rst, ok := f.(*http2.RSTStreamFrame); ok && rst.StreamID == 1 {
+				break
+			}
+		}
+
+		for i := 0; i < 16; i++ {
+			if err := fr.WriteData(3, i == 15, chunk); err != nil {
+				close(startRead3)
+				return err
+			}
+		}
+		ping2 := [8]byte{9, 8, 7, 6, 5, 4, 3, 2}
+		fr.WritePing(false, ping2)
+		for {
+			f, err := fr.ReadFrame()
+			if err != nil {
+				close(startRead3)
+				return err
+			}
+			if pf, ok := f.(*http2.PingFrame); ok && pf.IsAck() && pf.Data == ping2 {
+				break
+			}
+		}
+		close(startRead3)
+		return <-bumpDone
+	}
+
+	stockErr := run(t, false)
+	govErr := run(t, true)
+	t.Logf("stream 3 256 KiB upload after stream 1 overrun -> stock err: %v; governed err: %v", stockErr, govErr)
+	if stockErr != nil || govErr != nil {
+		t.Fatalf("stockErr=%v, govErr=%v (want both nil)", stockErr, govErr)
+	}
+}
-- 
