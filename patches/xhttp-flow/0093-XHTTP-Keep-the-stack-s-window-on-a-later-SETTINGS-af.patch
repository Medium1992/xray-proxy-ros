From addf5a7650e4002624bfff7053fd66b861ab706e Mon Sep 17 00:00:00 2001
From: Medium1992 <Medium1992@users.noreply.github.com>
Date: Tue, 27 Oct 2026 04:38:22 +0300
Subject: [PATCH 93/97] XHTTP: Keep the stack's window on a later SETTINGS
 after restock

Once restock had shown a governing server the stack's own window, a
later SETTINGS from the stack with an initial window was shown the
protocol default again, and the server's windows went back down with
it. It is now shown as it is, less what changeInitialWindow takes off
for credit already forwarded. x/net's transport sends SETTINGS once, so
Xray's own client did not get here; TestFlowClientRestockedLaterSettings
fails without the change.
---
 transport/internet/splithttp/h2flow.go        |  7 +++
 .../internet/splithttp/h2flow_restock_test.go | 60 +++++++++++++++++++
 2 files changed, 67 insertions(+)

diff --git a/transport/internet/splithttp/h2flow.go b/transport/internet/splithttp/h2flow.go
index f40fe54c2..9153e4224 100644
--- a/transport/internet/splithttp/h2flow.go
+++ b/transport/internet/splithttp/h2flow.go
@@ -168,7 +168,14 @@ const flowShownFull = max(h2InitWindow, flowShownDown)
 // found says the frame carries an initial window at all. One that does not
 // changes nothing here: what the stack was shown stands, and shownLimited
 // with it.
+//
+// A client whose server governs, once restock has shown it the stack's own
+// window, shows a later one as it is, less what changeInitialWindow takes
+// off for credit already forwarded.
 func (c *flowConn) shownDown(real int32, found bool) int32 {
+	if c.client && c.peerGoverned && !c.restock {
+		return h2MaxWindow
+	}
 	if found {
 		c.shownLimited = !c.client && c.sendWindow != 0 && real > h2InitWindow
 	}
diff --git a/transport/internet/splithttp/h2flow_restock_test.go b/transport/internet/splithttp/h2flow_restock_test.go
index a404bc251..176f1982f 100644
--- a/transport/internet/splithttp/h2flow_restock_test.go
+++ b/transport/internet/splithttp/h2flow_restock_test.go
@@ -3,6 +3,7 @@ package splithttp
 import (
 	"context"
 	gotls "crypto/tls"
+	"encoding/binary"
 	"io"
 	"net"
 	"net/http"
@@ -10,6 +11,8 @@ import (
 	"sync/atomic"
 	"testing"
 	"time"
+
+	"golang.org/x/net/http2"
 )
 
 // TestFlowChainedPausedReaderKeepsConnection has a governed client behind a
@@ -116,3 +119,60 @@ func TestFlowChainedPausedReaderKeepsConnection(t *testing.T) {
 		})
 	}
 }
+
+// TestFlowClientRestockedLaterSettings has a governed client restock to a
+// governed server and its stack then send another SETTINGS with its initial
+// window: the window goes on as it is. Before, a later SETTINGS was shown
+// the protocol default again, as before restock.
+func TestFlowClientRestockedLaterSettings(t *testing.T) {
+	sc := &scriptConn{}
+	c := newFlowClientConn(sc)
+	t.Cleanup(func() { c.Close() })
+	c.mode.Store(flowH2)
+
+	// 1. Client sends initial SETTINGS(INITIAL_WINDOW_SIZE = 4 MiB).
+	if _, err := c.writeToServer(frames(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20})
+	})); err != nil {
+		t.Fatal(err)
+	}
+	// 2. Governed server replies with SETTINGS + tagged PING.
+	c.fromServer(frames(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 1 << 20})
+		fr.WritePing(false, [8]byte{0x6b, 0x7a, 0x3f, 0x91, 1, 2, 3, 4})
+	}), nil)
+	// 3. Client sends PING ACK; appendRestock restores clientShown = 4 MiB.
+	if _, err := c.writeToServer(frames(func(fr *http2.Framer) {
+		fr.WritePing(true, [8]byte{0x6b, 0x7a, 0x3f, 0x91, 1, 2, 3, 4})
+	})); err != nil {
+		t.Fatal(err)
+	}
+	c.mu.Lock()
+	if !c.peerGoverned || c.clientShown != 4<<20 {
+		c.mu.Unlock()
+		t.Fatalf("after restock: peerGoverned=%v clientShown=%d, want true and %d", c.peerGoverned, c.clientShown, 4<<20)
+	}
+	c.mu.Unlock()
+
+	// 4. Client stack later sends another SETTINGS with INITIAL_WINDOW_SIZE = 4 MiB.
+	sc.take()
+	if _, err := c.writeToServer(frames(func(fr *http2.Framer) {
+		fr.WriteSettings(http2.Setting{ID: http2.SettingInitialWindowSize, Val: 4 << 20})
+	})); err != nil {
+		t.Fatal(err)
+	}
+	sent := sc.take()
+	var wireWin uint32
+	for _, f := range rawFrames(t, sent) {
+		if f.typ == h2Settings && f.flags == 0 && len(f.payload) == 6 {
+			wireWin = binary.BigEndian.Uint32(f.payload[2:])
+		}
+	}
+	c.mu.Lock()
+	shown := c.clientShown
+	c.mu.Unlock()
+	t.Logf("after later client SETTINGS(4 MiB) on peerGoverned conn: wire INITIAL_WINDOW_SIZE=%d, clientShown=%d", wireWin, shown)
+	if wireWin != 4<<20 || shown != 4<<20 {
+		t.Fatalf("peerGoverned client rewrote later SETTINGS(4 MiB) down to wire=%d, clientShown=%d", wireWin, shown)
+	}
+}
