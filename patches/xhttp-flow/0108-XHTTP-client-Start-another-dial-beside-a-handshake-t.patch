diff --git a/transport/internet/splithttp/dial_hedge.go b/transport/internet/splithttp/dial_hedge.go
new file mode 100644
index 00000000..e8ee2720
--- /dev/null
+++ b/transport/internet/splithttp/dial_hedge.go
@@ -0,0 +1,133 @@
+package splithttp
+
+import (
+	"context"
+	gonet "net"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// maxDialAttempts bounds the attempts of one dial that run side by side.
+const maxDialAttempts = 4
+
+// hedgeDelay is how long an attempt's handshake may take before another one
+// starts: twice the last handshake that completed, within 250ms and 3s, or a
+// second before any has.
+func hedgeDelay(last time.Duration) time.Duration {
+	if last <= 0 {
+		return time.Second
+	}
+	return min(max(2*last, 250*time.Millisecond), 3*time.Second)
+}
+
+type dialResult struct {
+	conn gonet.Conn
+	err  error
+}
+
+// dialHedged dials with dial, and starts another attempt each time the
+// attempts in flight have gone delay without an answer, up to
+// maxDialAttempts. Every request queued behind a connection waits on its
+// dial, so one handshake lost on the way would hold them all until its
+// timeout; a fresh attempt gets through as soon as the path does. The first
+// connection made is returned and the other attempts are cancelled; a
+// connection one of them makes anyway is closed. An attempt's error ends the
+// dial when no other attempt is in flight: an error is an answer, and is not
+// retried here.
+func dialHedged(ctx context.Context, delay time.Duration, dial func(context.Context) (gonet.Conn, error)) (gonet.Conn, error) {
+	ctx, cancel := context.WithCancel(ctx)
+	results := make(chan dialResult, maxDialAttempts)
+	start := func() {
+		go func() {
+			conn, err := dial(ctx)
+			results <- dialResult{conn, err}
+		}()
+	}
+
+	start()
+	started, inFlight := 1, 1
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	for {
+		select {
+		case r := <-results:
+			inFlight--
+			if r.err == nil {
+				cancel()
+				go closeLate(results, inFlight)
+				return r.conn, nil
+			}
+			if inFlight == 0 {
+				cancel()
+				return nil, r.err
+			}
+		case <-timer.C:
+			if started < maxDialAttempts {
+				start()
+				started++
+				inFlight++
+				timer.Reset(delay)
+			}
+		case <-ctx.Done():
+			cancel()
+			go closeLate(results, inFlight)
+			return nil, ctx.Err()
+		}
+	}
+}
+
+// closeLate waits for the n attempts still in flight and closes any
+// connection they make.
+func closeLate(results <-chan dialResult, n int) {
+	for range n {
+		if r := <-results; r.conn != nil {
+			r.conn.Close()
+		}
+	}
+}
+
+// dialHistory is what the dials to a server have shown so far: how long its
+// last handshake took, and whether its last dial failed. XMUX replaces a
+// client whose connection failed, so it is kept per server, not per client.
+type dialHistory struct {
+	lastHandshake atomic.Int64
+	failed        atomic.Bool
+}
+
+var dialHistories sync.Map // server address -> *dialHistory
+
+func dialHistoryOf(server string) *dialHistory {
+	h, _ := dialHistories.LoadOrStore(server, new(dialHistory))
+	return h.(*dialHistory)
+}
+
+// hedgedDialer dials a server with dialHedged, timing the hedge by the last
+// handshake. Once a dial has failed it dials with one attempt until one
+// succeeds: a path that stays down past the handshake bound gains nothing
+// from more attempts, which would only multiply the dials during it.
+type hedgedDialer struct {
+	dial    func(context.Context) (gonet.Conn, error)
+	history *dialHistory
+}
+
+func (d *hedgedDialer) Dial(ctx context.Context) (gonet.Conn, error) {
+	h := d.history
+	timed := func(ctx context.Context) (gonet.Conn, error) {
+		start := time.Now()
+		conn, err := d.dial(ctx)
+		if err == nil {
+			h.lastHandshake.Store(int64(time.Since(start)))
+		}
+		return conn, err
+	}
+	var conn gonet.Conn
+	var err error
+	if h.failed.Load() {
+		conn, err = timed(ctx)
+	} else {
+		conn, err = dialHedged(ctx, hedgeDelay(time.Duration(h.lastHandshake.Load())), timed)
+	}
+	h.failed.Store(err != nil)
+	return conn, err
+}
diff --git a/transport/internet/splithttp/dial_hedge_test.go b/transport/internet/splithttp/dial_hedge_test.go
new file mode 100644
index 00000000..eeda805c
--- /dev/null
+++ b/transport/internet/splithttp/dial_hedge_test.go
@@ -0,0 +1,305 @@
+package splithttp
+
+import (
+	"context"
+	"errors"
+	"io"
+	gonet "net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol/tls/cert"
+	"github.com/xtls/xray-core/testing/servers/tcp"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/internet/tls"
+)
+
+// fakeConn is a net.Conn that records Close.
+type fakeConn struct {
+	gonet.Conn
+	closed atomic.Bool
+}
+
+func (c *fakeConn) Close() error {
+	c.closed.Store(true)
+	return nil
+}
+
+// A dial whose handshake hangs does not hold the dial: another attempt starts
+// after the hedge delay, its connection is returned, and the hung attempt is
+// cancelled.
+func TestDialHedgedTakesTheNextAttemptOverAStuckOne(t *testing.T) {
+	won := &fakeConn{}
+	var attempts atomic.Int32
+	stuckCancelled := make(chan struct{})
+	dial := func(ctx context.Context) (gonet.Conn, error) {
+		if attempts.Add(1) == 1 {
+			<-ctx.Done()
+			close(stuckCancelled)
+			return nil, ctx.Err()
+		}
+		return won, nil
+	}
+	start := time.Now()
+	conn, err := dialHedged(context.Background(), 50*time.Millisecond, dial)
+	if err != nil || conn != won {
+		t.Fatalf("dialHedged = %v, %v; want the second attempt's conn", conn, err)
+	}
+	if elapsed := time.Since(start); elapsed > time.Second {
+		t.Fatalf("took %v; the second attempt starts after 50ms", elapsed)
+	}
+	select {
+	case <-stuckCancelled:
+	case <-time.After(time.Second):
+		t.Fatal("the stuck attempt was not cancelled")
+	}
+}
+
+// A dial that answers in time starts no other attempt.
+func TestDialHedgedStartsNoAttemptWhileTheFirstIsInTime(t *testing.T) {
+	var attempts atomic.Int32
+	dial := func(ctx context.Context) (gonet.Conn, error) {
+		attempts.Add(1)
+		time.Sleep(20 * time.Millisecond)
+		return &fakeConn{}, nil
+	}
+	if _, err := dialHedged(context.Background(), 200*time.Millisecond, dial); err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(300 * time.Millisecond)
+	if n := attempts.Load(); n != 1 {
+		t.Fatalf("%d attempts, want 1", n)
+	}
+}
+
+// An error is the answer: it is returned at once and starts no attempt, so a
+// refusing server is dialed as often as before.
+func TestDialHedgedReturnsAnErrorWithoutRetrying(t *testing.T) {
+	refused := errors.New("refused")
+	var attempts atomic.Int32
+	dial := func(ctx context.Context) (gonet.Conn, error) {
+		attempts.Add(1)
+		return nil, refused
+	}
+	start := time.Now()
+	if _, err := dialHedged(context.Background(), 50*time.Millisecond, dial); err != refused {
+		t.Fatalf("err = %v, want refused", err)
+	}
+	time.Sleep(200 * time.Millisecond)
+	if n := attempts.Load(); n != 1 || time.Since(start) > 400*time.Millisecond {
+		t.Fatalf("%d attempts; want one, answered at once", n)
+	}
+}
+
+// While every attempt hangs, at most maxDialAttempts are in flight, and the
+// dial ends with the attempts' error once they have all ended.
+func TestDialHedgedBoundsTheAttempts(t *testing.T) {
+	var attempts atomic.Int32
+	hang := 300 * time.Millisecond
+	timeout := errors.New("handshake timeout")
+	dial := func(ctx context.Context) (gonet.Conn, error) {
+		attempts.Add(1)
+		select {
+		case <-time.After(hang):
+			return nil, timeout
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+	_, err := dialHedged(context.Background(), 20*time.Millisecond, dial)
+	if err != timeout {
+		t.Fatalf("err = %v, want the attempts' timeout", err)
+	}
+	if n := attempts.Load(); n != maxDialAttempts {
+		t.Fatalf("%d attempts, want %d", n, maxDialAttempts)
+	}
+}
+
+// A connection that an attempt makes after another attempt won is closed.
+func TestDialHedgedClosesALateWinner(t *testing.T) {
+	late := &fakeConn{}
+	release := make(chan struct{})
+	var attempts atomic.Int32
+	dial := func(ctx context.Context) (gonet.Conn, error) {
+		if attempts.Add(1) == 1 {
+			<-release // ignores ctx, as a dial past its last cancellation point does
+			return late, nil
+		}
+		return &fakeConn{}, nil
+	}
+	if _, err := dialHedged(context.Background(), 20*time.Millisecond, dial); err != nil {
+		t.Fatal(err)
+	}
+	close(release)
+	deadline := time.Now().Add(time.Second)
+	for !late.closed.Load() {
+		if time.Now().After(deadline) {
+			t.Fatal("the late connection was not closed")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+// Cancelling the dial's context ends it at once, with every attempt.
+func TestDialHedgedEndsWithItsContext(t *testing.T) {
+	var running atomic.Int32
+	dial := func(ctx context.Context) (gonet.Conn, error) {
+		running.Add(1)
+		defer running.Add(-1)
+		<-ctx.Done()
+		return nil, ctx.Err()
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	time.AfterFunc(100*time.Millisecond, cancel)
+	start := time.Now()
+	if _, err := dialHedged(ctx, 20*time.Millisecond, dial); !errors.Is(err, context.Canceled) {
+		t.Fatalf("err = %v, want context.Canceled", err)
+	}
+	if elapsed := time.Since(start); elapsed > 500*time.Millisecond {
+		t.Fatalf("returned after %v", elapsed)
+	}
+	deadline := time.Now().Add(time.Second)
+	for running.Load() != 0 {
+		if time.Now().After(deadline) {
+			t.Fatalf("%d attempts still run", running.Load())
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+// After a dial that failed, the next one makes a single attempt, also from a
+// new client to the same server; after a dial that succeeded, a slow attempt
+// is hedged again.
+func TestHedgedDialerStopsHedgingAfterAFailure(t *testing.T) {
+	var attempts atomic.Int32
+	var down atomic.Bool
+	down.Store(true)
+	d := &hedgedDialer{history: new(dialHistory), dial: func(ctx context.Context) (gonet.Conn, error) {
+		attempts.Add(1)
+		if down.Load() {
+			select {
+			case <-time.After(1500 * time.Millisecond):
+				return nil, errors.New("handshake timeout")
+			case <-ctx.Done():
+				return nil, ctx.Err()
+			}
+		}
+		return &fakeConn{}, nil
+	}}
+	if _, err := d.Dial(context.Background()); err == nil {
+		t.Fatal("dial through a down path succeeded")
+	}
+	if n := attempts.Swap(0); n < 2 {
+		t.Fatalf("first dial: %d attempts, want it hedged", n)
+	}
+	d = &hedgedDialer{history: d.history, dial: d.dial} // XMUX's next client
+	if _, err := d.Dial(context.Background()); err == nil {
+		t.Fatal("dial through a down path succeeded")
+	}
+	if n := attempts.Swap(0); n != 1 {
+		t.Fatalf("dial after a failure: %d attempts, want 1", n)
+	}
+	down.Store(false)
+	if _, err := d.Dial(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if !d.history.failed.Load() && d.history.lastHandshake.Load() > 0 {
+		return
+	}
+	t.Fatal("a successful dial did not turn hedging back on")
+}
+
+func TestHedgeDelay(t *testing.T) {
+	for _, tc := range []struct{ last, want time.Duration }{
+		{0, time.Second},
+		{50 * time.Millisecond, 250 * time.Millisecond},
+		{300 * time.Millisecond, 600 * time.Millisecond},
+		{time.Second, 2 * time.Second},
+		{5 * time.Second, 3 * time.Second},
+	} {
+		if got := hedgeDelay(tc.last); got != tc.want {
+			t.Errorf("hedgeDelay(%v) = %v, want %v", tc.last, got, tc.want)
+		}
+	}
+}
+
+// Through a path that blackholes the first connection after its ClientHello,
+// as a lost or dropped handshake does, the XHTTP client gets its answer from
+// a second connection within a few seconds, not after the handshake bound.
+func Test_DialRetriesAStuckHandshake(t *testing.T) {
+	listenPort := tcp.PickPort()
+	ct, ctHash := cert.MustGenerate(nil, cert.CommonName("localhost"))
+	streamSettings := &internet.MemoryStreamConfig{
+		ProtocolName:     "splithttp",
+		ProtocolSettings: &Config{Path: "shs"},
+		SecurityType:     "tls",
+		SecuritySettings: &tls.Config{
+			Certificate:          []*tls.Certificate{tls.ParseCertificate(ct)},
+			PinnedPeerCertSha256: [][]byte{ctHash[:]},
+		},
+	}
+	listen, err := ListenXH(context.Background(), net.LocalHostIP, listenPort, streamSettings, func(conn stat.Connection) {
+		go func() {
+			defer conn.Close()
+			var b [1024]byte
+			conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+			if _, err := conn.Read(b[:]); err != nil {
+				return
+			}
+			conn.Write([]byte("Response"))
+		}()
+	})
+	common.Must(err)
+	defer listen.Close()
+
+	relay, err := gonet.Listen("tcp", "127.0.0.1:0")
+	common.Must(err)
+	defer relay.Close()
+	var accepted atomic.Int32
+	go func() {
+		for {
+			c, err := relay.Accept()
+			if err != nil {
+				return
+			}
+			if accepted.Add(1) == 1 {
+				defer c.Close() // the kernel takes the ClientHello, nobody answers
+				continue
+			}
+			go func(c gonet.Conn) {
+				defer c.Close()
+				up, err := gonet.Dial("tcp", gonet.JoinHostPort("127.0.0.1", listenPort.String()))
+				if err != nil {
+					return
+				}
+				defer up.Close()
+				go io.Copy(up, c)
+				io.Copy(c, up)
+			}(c)
+		}
+	}()
+
+	start := time.Now()
+	relayPort := net.Port(relay.Addr().(*gonet.TCPAddr).Port)
+	conn, err := Dial(context.Background(), net.TCPDestination(net.DomainAddress("localhost"), relayPort), streamSettings)
+	common.Must(err)
+	defer conn.Close()
+	if _, err := conn.Write([]byte("Test")); err != nil {
+		t.Fatal(err)
+	}
+	var b [1024]byte
+	n, _ := io.ReadFull(conn, b[:len("Response")])
+	if string(b[:n]) != "Response" {
+		t.Fatalf("read %q", b[:n])
+	}
+	if elapsed := time.Since(start); elapsed > 4*time.Second {
+		t.Fatalf("answered after %v; a second connection starts after a second", elapsed.Round(time.Millisecond))
+	}
+	if n := accepted.Load(); n > maxDialAttempts+1 {
+		t.Fatalf("%d connections through the relay", n)
+	}
+}
