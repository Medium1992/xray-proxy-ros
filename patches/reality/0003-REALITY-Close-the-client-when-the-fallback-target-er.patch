From 5176b14575913dd6e53394f41b7098cd9b3f7a15 Mon Sep 17 00:00:00 2001
From: medium <medium@debian.debian>
Date: Thu, 12 Nov 2026 02:11:49 +0300
Subject: [PATCH] REALITY: Close the client when the fallback target errors

A fallback connection whose target reset it only half-closed the client.
A client that stayed silent then held Server and its goroutines until its
own socket timed out. This is XTLS/REALITY@8530a57 ("Try pass RST"), which
#6684 ran in production without the leak and which REALITY's main lacks.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 third_party/reality/fallback_close_test.go | 124 +++++++++++++++++++++
 third_party/reality/tls.go                 |  10 +-
 2 files changed, 131 insertions(+), 3 deletions(-)
 create mode 100644 third_party/reality/fallback_close_test.go

diff --git a/third_party/reality/fallback_close_test.go b/third_party/reality/fallback_close_test.go
new file mode 100644
index 00000000..773f6099
--- /dev/null
+++ b/third_party/reality/fallback_close_test.go
@@ -0,0 +1,124 @@
+package reality
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// fallbackServer runs Server on one accepted connection and returns the
+// client side of it together with the channel Server's error arrives on.
+func fallbackServer(t *testing.T, target net.Listener) (net.Conn, <-chan error) {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { ln.Close() })
+	config := &Config{
+		DialContext: new(net.Dialer).DialContext,
+		Type:        "tcp",
+		Dest:        target.Addr().String(),
+		ServerNames: map[string]bool{"example.com": true},
+	}
+	done := make(chan error, 1)
+	go func() {
+		conn, err := ln.Accept()
+		if err != nil {
+			done <- err
+			return
+		}
+		_, err = Server(context.Background(), conn, config)
+		done <- err
+	}()
+	client, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { client.Close() })
+	return client, done
+}
+
+// serveTarget accepts one connection, reads the request, answers with reply
+// and then ends the connection with a reset or a FIN.
+func serveTarget(t *testing.T, reply string, reset bool) net.Listener {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { ln.Close() })
+	go func() {
+		conn, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		buf := make([]byte, 1024)
+		conn.Read(buf)
+		conn.Write([]byte(reply))
+		if reset {
+			conn.(*net.TCPConn).SetLinger(0)
+		}
+		conn.Close()
+	}()
+	return ln
+}
+
+const fallbackReply = "HTTP/1.1 400 Bad Request\r\n\r\n"
+
+// A client that stays silent after the target reset the fallback connection
+// must not hold Server: the client side is closed instead of half-closed.
+func TestFallbackTargetResetClosesClient(t *testing.T) {
+	client, done := fallbackServer(t, serveTarget(t, fallbackReply, true))
+	if _, err := client.Write([]byte("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("Server() = nil error for a fallback connection")
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("Server() still runs 3s after the target reset, held by a silent client")
+	}
+	client.SetReadDeadline(time.Now().Add(3 * time.Second))
+	if _, err := io.ReadAll(client); err != nil && !isConnReset(err) {
+		t.Fatalf("client read after the target reset: %v", err)
+	}
+}
+
+// A target that ends with a FIN is still passed on as a half-close: the client
+// reads the reply and EOF, and Server ends once the client closes too.
+func TestFallbackTargetFINHalfClosesClient(t *testing.T) {
+	client, done := fallbackServer(t, serveTarget(t, fallbackReply, false))
+	if _, err := client.Write([]byte("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")); err != nil {
+		t.Fatal(err)
+	}
+	client.SetReadDeadline(time.Now().Add(3 * time.Second))
+	got, err := io.ReadAll(client)
+	if err != nil {
+		t.Fatalf("client read: %v", err)
+	}
+	if string(got) != fallbackReply {
+		t.Fatalf("client read %q, want %q", got, fallbackReply)
+	}
+	select {
+	case err := <-done:
+		t.Fatalf("Server() = %v before the client closed; the target's FIN must stay a half-close", err)
+	case <-time.After(300 * time.Millisecond):
+	}
+	client.Close()
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("Server() still runs 3s after the client closed")
+	}
+}
+
+func isConnReset(err error) bool {
+	return errors.Is(err, syscall.ECONNRESET)
+}
diff --git a/third_party/reality/tls.go b/third_party/reality/tls.go
index bc8b92ca..59a48b6a 100644
--- a/third_party/reality/tls.go
+++ b/third_party/reality/tls.go
@@ -454,11 +454,15 @@ func Server(ctx context.Context, conn net.Conn, config *Config) (*Conn, error) {
 				}()
 			}
 			conn.Write(s2cSaved)
-			io.Copy(underlying, NewRatelimitedConn(target, &config.LimitFallbackDownload))
+			_, err := io.Copy(underlying, NewRatelimitedConn(target, &config.LimitFallbackDownload))
 			// Here is bidirectional direct forwarding:
 			// client ---underlying--- server ---target--- dest
-			// Call `underlying.CloseWrite()` once `io.Copy()` returned
-			underlying.CloseWrite()
+			// Call `underlying.CloseWrite()` or `underlying.Close()` once `io.Copy()` returned
+			if err == nil {
+				underlying.CloseWrite()
+			} else {
+				underlying.Close()
+			}
 		}
 		waitGroup.Done()
 	}()
